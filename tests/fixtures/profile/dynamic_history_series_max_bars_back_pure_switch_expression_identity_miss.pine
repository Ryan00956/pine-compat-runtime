indicator("Profile dynamic series history pure switch expression identity miss", max_bars_back=10)
src = switch
    close > open =>
        base = close
        base
    =>
        open
same = switch
    close > open =>
        base = close
        base
    =>
        open
max_bars_back(src, 2)
offset = bar_index == 0 ? 0 : 3
plot(same[offset])
