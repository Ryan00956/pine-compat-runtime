//@version=5
indicator("Profile dynamic series history pure UDF named direct UDT arg expression max_bars_back miss", max_bars_back=10)
type Point
    float x
source(p, delta) => p.x + delta
src = source(delta=1, p=Point.new(close))
max_bars_back(src, 2)
offset = bar_index == 0 ? 0 : 3
plot(source(p=Point.new(close), delta=1)[offset])
