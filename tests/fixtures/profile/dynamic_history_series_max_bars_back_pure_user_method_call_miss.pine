//@version=5
indicator("Profile dynamic series history pure user method max_bars_back miss", max_bars_back=10)
type Point
    float x
method source(Point p, float value) => value + 1
p = Point.new(close)
src = p.source(close)
max_bars_back(src, 2)
offset = bar_index == 0 ? 0 : 3
plot(p.source(value=close)[offset])
