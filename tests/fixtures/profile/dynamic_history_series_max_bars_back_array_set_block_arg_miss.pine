//@version=5
indicator("Profile dynamic series history array.set block arg miss", max_bars_back=10)
src = close
offset = bar_index == 0 ? 0 : 3
values = array.new_float(1, 0.0)
values.set(0, switch
    bar_index >= 0 =>
        length = 2
        max_bars_back(src, length)
        src[offset]
    => src[offset]
)
plot(values.get(0))
