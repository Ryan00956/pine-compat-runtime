//@version=5
indicator("Profile dynamic series history nested pure UDF direct nested UDT arg expression max_bars_back miss", max_bars_back=10)
type Point
    float x
type Wrapper
    Point inner
adjust(w) => w.inner.x + 1
source(w) => adjust(w)
src = source(Wrapper.new(Point.new(close)))
max_bars_back(src, 2)
offset = bar_index == 0 ? 0 : 3
plot(source(Wrapper.new(Point.new(close)))[offset])
