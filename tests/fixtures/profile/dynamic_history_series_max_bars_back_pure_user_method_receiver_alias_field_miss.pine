indicator("Profile dynamic series history pure user method receiver alias field max_bars_back miss", max_bars_back=10)
type Point
    float x
method source(Point p) =>
    q = p
    q.x + 1
p = Point.new(close)
src = p.source()
max_bars_back(src, 2)
offset = bar_index == 0 ? 0 : 3
plot(p.source()[offset])
