//@version=5
indicator("Profile dynamic series history nested pure UDF named direct nested UDT arg expression max_bars_back miss", max_bars_back=10)
type Point
    float x
type Wrapper
    Point inner
adjust(w, delta) => w.inner.x + delta
source(w, delta) => adjust(delta=delta, w=w)
src = source(delta=1, w=Wrapper.new(Point.new(close)))
max_bars_back(src, 2)
offset = bar_index == 0 ? 0 : 3
plot(source(w=Wrapper.new(Point.new(close)), delta=1)[offset])
