indicator("Profile dynamic series history block result miss", max_bars_back=10)
src = close
offset = bar_index == 0 ? 0 : 3
plot(switch
    bar_index >= 0 =>
        length = 2
        switch
            bar_index >= 0 =>
                max_bars_back(src, length)
                src[offset]
            => src[offset]
    => src[offset]
)
