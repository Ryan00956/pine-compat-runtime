//@version=5
indicator("Profile dynamic series history pure UDF nested UDT field alias max_bars_back miss", max_bars_back=10)
type Point
    float x
type Wrapper
    Point inner
source(w) =>
    inner = w.inner
    inner.x + 1
p = Point.new(close)
w = Wrapper.new(p)
src = source(w)
max_bars_back(src, 2)
offset = bar_index == 0 ? 0 : 3
plot(source(w)[offset])
