//@version=5
indicator("Profile many callsites")
sma2 = ta.sma(close, 2)
sma3 = ta.sma(high, 3)
ema4 = ta.ema(low, 4)
ema5 = ta.ema(hl2, 5)
rma6 = ta.rma(volume, 6)
rsi7 = ta.rsi(close, 7)
highest8 = ta.highest(high, 8)
lowest9 = ta.lowest(low, 9)
changed = ta.change(close)
previous = ta.valuewhen(close > open, close, 0)
plot(nz(sma2) + nz(sma3) + nz(ema4) + nz(ema5) + nz(rma6) + nz(rsi7) + nz(highest8) + nz(lowest9) + nz(changed) + nz(previous))
