indicator("Profile dynamic series history pure user method named direct UDT arg expression max_bars_back miss", max_bars_back=10)
type Point
    float x
method shift(Point p, Point other, float delta) => other.x + delta
p = Point.new(open)
src = p.shift(delta=1, other=Point.new(close))
max_bars_back(src, 2)
offset = bar_index == 0 ? 0 : 3
plot(p.shift(other=Point.new(close), delta=1)[offset])
