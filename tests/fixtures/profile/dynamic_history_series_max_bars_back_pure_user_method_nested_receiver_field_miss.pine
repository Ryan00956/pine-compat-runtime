//@version=5
indicator("Profile dynamic series history pure user method nested receiver field max_bars_back miss", max_bars_back=10)
type Point
    float x
type Wrapper
    Point inner
method source(Wrapper w) => w.inner.x + 1
p = Point.new(close)
w = Wrapper.new(p)
src = w.source()
max_bars_back(src, 2)
offset = bar_index == 0 ? 0 : 3
plot(w.source()[offset])
