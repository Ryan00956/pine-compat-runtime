indicator("Profile dynamic series history matrix.set block arg miss", max_bars_back=10)
src = close
offset = bar_index == 0 ? 0 : 3
values = matrix.new<float>(1, 1, 0.0)
values.set(0, 0, switch
    bar_index >= 0 =>
        length = 2
        max_bars_back(src, length)
        src[offset]
    => src[offset]
)
plot(values.get(0, 0))
