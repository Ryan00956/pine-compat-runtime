//@version=5
indicator("Polyline array", overlay=true)

var points = array.new<chart.point>()
array.push(points, chart.point.from_index(bar_index, close))

first = polyline.new(points, line_color=color.red)
second = polyline.new(points, line_color=color.green)
third = polyline.new(points, line_color=color.blue)

values = array.new_polyline(1, first)
array.push(values, na)
array.set(values, 1, second)
array.insert(values, 1, third)
removed = array.remove(values, 2)
array.unshift(values, second)
shifted = array.shift(values)
array.fill(values, first, 1, 2)
from_values = array.from(first, third)
copied = array.copy(values)
array.reverse(copied)
joined = array.concat(copied, from_values)
slice = array.slice(joined, 1, 3)
last_index = array.lastindexof(joined, third)
first_index = array.indexof(joined, first)
has_removed = array.includes(joined, removed)
first_value = array.first(joined)
last_value = array.last(joined)
popped = array.pop(joined)

method_values = array.new_polyline()
method_values.push(first)
method_values.push(second)
method_values.set(1, third)
method_copy = method_values.copy()
method_copy.reverse()
method_slice = method_copy.slice(0, 1)
method_slice.concat(method_values)
method_first_index = method_slice.indexof(first)
method_last_index = method_slice.lastindexof(third)
method_has_second = method_slice.includes(second)
method_popped = method_slice.pop()
method_shifted = method_slice.shift()
method_slice.unshift(method_shifted)
method_slice.insert(1, method_popped)
method_slice.fill(first, 0, 1)
method_removed = method_slice.remove(1)
method_size_before_clear = method_slice.size()
method_first = method_slice.first()
method_last = method_slice.last()
method_slice.clear()
method_score = method_first_index == 1 and method_last_index == 2 and not method_has_second and method_size_before_clear == 2 and method_removed == third and method_first == first and method_last == first and method_slice.size() == 0 ? 1 : 0

plot(array.size(values))
plot(array.size(from_values))
plot(array.size(joined))
plot(array.size(slice))
plot(first_index)
plot(last_index)
plot(has_removed ? 1 : 0)
plot(first_value == first ? 1 : 0)
plot(last_value == third ? 1 : 0)
plot(popped == third ? 1 : 0)
plot(shifted == second ? 1 : 0)
plot(method_score)
