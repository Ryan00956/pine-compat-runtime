//@version=5
indicator("Pivot Point Levels edge cases")
unknown = ta.pivot_point_levels("Unknown", bar_index == 2)
fibonacci = ta.pivot_point_levels("Fibonacci", bar_index == 2)
dm = ta.pivot_point_levels("DM", bar_index == 2)
woodie = ta.pivot_point_levels("Woodie", bar_index == 2)
na_developing = ta.pivot_point_levels("Traditional", bar_index == 2, na)
plot(na(array.get(unknown, 0)) and na(array.get(unknown, 10)) ? 1 : 0)
plot(array.get(fibonacci, 0))
plot(array.get(fibonacci, 1))
plot(array.get(dm, 0))
plot(array.get(dm, 1))
plot(array.get(woodie, 0))
plot(array.get(woodie, 7))
plot(array.get(na_developing, 0))
