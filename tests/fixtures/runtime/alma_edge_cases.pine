//@version=5
indicator("ALMA edge cases")
missing_source = bar_index == 1 ? na : close
plot(ta.alma(close, 0, 0.85, 6))
plot(ta.alma(close, -1, 0.85, 6))
plot(ta.alma(missing_source, 3, 0.85, 6))
plot(ta.alma(close, 3, 0.85, 0))
plot(ta.alma(close, 3, 0.85, -1))
plot(ta.alma(close, 3, 0.85, 6, true))
plot(ta.alma(close, 3, 0.85, 6, false))
