//@version=5
indicator("Array sort UDT field")
type Point
    float x
    string tag

by_x = array.from(Point.new(3.0, "c"), Point.new(1.0, "a"), Point.new(2.0, "b"))
array.sort(by_x, order.ascending, "x")
first_by_x = by_x.get(0)
second_by_x = by_x.get(1)
third_by_x = by_x.get(2)
plot(first_by_x.x)
plot(second_by_x.x)
plot(third_by_x.x)

by_tag = array.from(Point.new(1.0, "b"), Point.new(2.0, "a"), Point.new(3.0, "c"))
by_tag.sort(order.descending, "tag")
first_by_tag = array.get(by_tag, 0)
second_by_tag = array.get(by_tag, 1)
third_by_tag = array.get(by_tag, 2)
plot(first_by_tag.x)
plot(second_by_tag.x)
plot(third_by_tag.x)

by_default = array.from(Point.new(3.0, "c"), Point.new(1.0, "a"), Point.new(2.0, "b"))
array.sort(by_default)
default_first = by_default.get(0)
default_second = by_default.get(1)
default_third = by_default.get(2)
plot(default_first.x)
plot(default_second.x)
plot(default_third.x)

field_base = 0
field_index = field_base + 1
by_index = array.from(Point.new(1.0, "b"), Point.new(2.0, "a"), Point.new(3.0, "c"))
array.sort(by_index, order.descending, field_index)
index_first = by_index.get(0)
index_second = by_index.get(1)
index_third = by_index.get(2)
plot(index_first.x)
plot(index_second.x)
plot(index_third.x)

by_named_index = array.from(Point.new(1.0, "b"), Point.new(2.0, "a"), Point.new(3.0, "c"))
by_named_index.sort(sort_field = 1)
named_index_first = by_named_index.get(0)
named_index_second = by_named_index.get(1)
named_index_third = by_named_index.get(2)
plot(named_index_first.x)
plot(named_index_second.x)
plot(named_index_third.x)

by_reordered_names = array.from(Point.new(1.0, "b"), Point.new(2.0, "a"), Point.new(3.0, "c"))
array.sort(sort_field = 1, id = by_reordered_names)
reordered_first = by_reordered_names.get(0)
reordered_second = by_reordered_names.get(1)
reordered_third = by_reordered_names.get(2)
plot(reordered_first.x)
plot(reordered_second.x)
plot(reordered_third.x)
