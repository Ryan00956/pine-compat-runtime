//@version=5
indicator("Chart point array slice history")
current = chart.point.from_index(bar_index, close)
source = array.new<chart.point>(2)
source.set(0, current)
window = source.slice(0, 1)
previous_window = window[1]
previous_point = na(previous_window) ? na : previous_window.get(0)
dynamic_offset = bar_index == 0 ? na : 1
dynamic_previous_window = window[dynamic_offset]
dynamic_sibling_window = window[dynamic_offset]
dynamic_previous_point = na(dynamic_previous_window) ? na : dynamic_previous_window.get(0)
if not na(dynamic_previous_window)
    dynamic_previous_window.set(0, chart.point.from_index(999, 999))
dynamic_sibling_point_after_dynamic_mutation = na(dynamic_sibling_window) ? na : dynamic_sibling_window.get(0)
plot(na(previous_window) ? 1 : 0)
plot(na(dynamic_previous_window) ? 1 : 0)
plot(na(previous_point) ? na : previous_point.index)
plot(na(dynamic_previous_point) ? na : dynamic_previous_point.index)
plot(na(dynamic_sibling_point_after_dynamic_mutation) ? na : dynamic_sibling_point_after_dynamic_mutation.index)
