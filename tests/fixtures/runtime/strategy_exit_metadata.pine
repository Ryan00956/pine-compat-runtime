//@version=5
strategy("Strategy exit metadata", overlay=true)
message = close > open ? "up" : "down"
if bar_index == 0
    strategy.entry("L", strategy.long, qty=2)
    strategy.exit("XL", "L", stop=2.5, comment="exit", comment_loss="loss", alert_message=message, alert_loss="loss alert", disable_alert=false)
plot(strategy.closedtrades)
