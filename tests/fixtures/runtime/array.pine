indicator("Array fixture")
var persisted = array.new_float()
fresh = array.new_float(2, close)
var persisted_int = array.new_int()
fresh_int = array.new_int(2, bar_index)
var persisted_bool = array.new_bool()
fresh_bool = array.new_bool(2, close > open)

array.push(persisted, close)
array.push(fresh, high)
array.set(fresh, 0, low)
array.push(persisted_int, bar_index)
array.push(fresh_int, 10)
array.set(fresh_int, 0, 3)
array.push(persisted_bool, bar_index == 0)
array.push(fresh_bool, true)
array.set(fresh_bool, 0, false)

plot(array.size(persisted))
plot(array.get(persisted, 0))
plot(array.get(fresh, 0) + array.pop(fresh) + array.size(fresh))
plot(array.size(persisted_int))
plot(array.get(persisted_int, 0))
plot(array.get(fresh_int, 0) + array.pop(fresh_int) + array.size(fresh_int))
plot(array.size(persisted_bool))
plot(array.get(persisted_bool, 0) ? 1 : 0)
plot((array.get(fresh_bool, 0) or array.pop(fresh_bool)) ? array.size(fresh_bool) : 0)
