indicator("Array fixture")
var persisted = array.new_float()
fresh = array.new_float(2, close)
var persisted_int = array.new_int()
fresh_int = array.new_int(2, bar_index)
var persisted_bool = array.new_bool()
fresh_bool = array.new_bool(2, close > open)
var persisted_string = array.new_string()
fresh_string = array.new_string(2, "seed")
var persisted_color = array.new_color()
fresh_color = array.new_color(2, color.red)

array.push(persisted, close)
array.push(fresh, high)
array.set(fresh, 0, low)
array.push(persisted_int, bar_index)
array.push(fresh_int, 10)
array.set(fresh_int, 0, 3)
array.push(persisted_bool, bar_index == 0)
array.push(fresh_bool, true)
array.set(fresh_bool, 0, false)
array.push(persisted_string, "seed")
array.push(fresh_string, "tail")
array.set(fresh_string, 0, "head")
array.push(persisted_color, color.red)
array.push(fresh_color, color.green)
array.set(fresh_color, 0, color.blue)

plot(array.size(persisted))
plot(array.get(persisted, 0))
plot(array.get(fresh, 0) + array.pop(fresh) + array.size(fresh))
empty_pop = array.new_float()
plot(na(array.pop(empty_pop)) and array.size(empty_pop) == 0 ? 1 : 0)
plot(array.size(persisted_int))
plot(array.get(persisted_int, 0))
plot(array.get(fresh_int, 0) + array.pop(fresh_int) + array.size(fresh_int))
plot(array.size(persisted_bool))
plot(array.get(persisted_bool, 0) ? 1 : 0)
plot((array.get(fresh_bool, 0) or array.pop(fresh_bool)) ? array.size(fresh_bool) : 0)
plot(array.size(persisted_string))
plot(array.get(persisted_string, 0) == "seed" ? 1 : 0)
plot((array.get(fresh_string, 0) == "head" and array.pop(fresh_string) == "tail") ? array.size(fresh_string) : 0)
plot(array.size(persisted_color))
plot(array.get(persisted_color, 0) == color.red ? 1 : 0)
plot((array.get(fresh_color, 0) == color.blue and array.pop(fresh_color) == color.green) ? array.size(fresh_color) : 0)

branch_pop_values = array.from(10, 20, 30)
branch_pop_score = bar_index * 0
if bar_index % 2 == 0
    branch_popped_even = array.pop(branch_pop_values)
    branch_pop_score := branch_popped_even * 100 + branch_pop_values.size() * 10 + branch_pop_values.get(1)
else
    branch_popped_odd = branch_pop_values.pop()
    branch_pop_score := branch_popped_odd * 100 + branch_pop_values.size() * 10 + branch_pop_values.get(1)
plot(branch_pop_score)

loop_pop_values = array.from(1, 2, 3)
loop_pop_score = bar_index * 0
for i = 0 to 1
    if i == 0
        loop_pop_score := loop_pop_score + array.pop(loop_pop_values)
    else
        loop_pop_score := loop_pop_score + loop_pop_values.pop()
plot(loop_pop_score * 100 + loop_pop_values.size() * 10 + loop_pop_values.get(0))

branch_set_values = array.from(1, 2, 3)
if bar_index % 2 == 0
    array.set(branch_set_values, 1, 20)
else
    branch_set_values.set(2, 30)
plot(branch_set_values.get(0) * 100 + branch_set_values.get(1) * 10 + branch_set_values.get(2))

loop_set_values = array.from(4, 5, 6)
for i = 0 to 1
    if i == 0
        array.set(loop_set_values, i, 40)
    else
        loop_set_values.set(i + 1, 60)
plot(loop_set_values.get(0) + loop_set_values.get(1) + loop_set_values.get(2))

branch_new_float_score = bar_index * 0.0
if bar_index % 2 == 0
    branch_new_float_values = array.new_float(2, bar_index + 1)
    branch_new_float_score := branch_new_float_values.size() * 100 + branch_new_float_values.get(0) * 10 + branch_new_float_values.get(1)
else
    branch_new_float_values = array.new_float(3, bar_index + 2)
    branch_new_float_score := branch_new_float_values.size() * 100 + branch_new_float_values.get(0) * 10 + branch_new_float_values.get(2)
plot(branch_new_float_score)

loop_new_float_score = bar_index * 0.0
for i = 0 to 1
    loop_new_float_values = array.new_float(i + 1, close + i)
    loop_new_float_score := loop_new_float_score + loop_new_float_values.size() * 10 + loop_new_float_values.get(i)
plot(loop_new_float_score)

branch_new_int_score = bar_index * 0
if bar_index % 2 == 0
    branch_new_int_values = array.new_int(2, bar_index + 1)
    branch_new_int_score := branch_new_int_values.size() * 100 + branch_new_int_values.get(0) * 10 + branch_new_int_values.get(1)
else
    branch_new_int_values = array.new_int(3, bar_index + 2)
    branch_new_int_score := branch_new_int_values.size() * 100 + branch_new_int_values.get(0) * 10 + branch_new_int_values.get(2)
plot(branch_new_int_score)

loop_new_int_score = bar_index * 0
for i = 0 to 1
    loop_new_int_values = array.new_int(i + 1, bar_index + i)
    loop_new_int_score := loop_new_int_score + loop_new_int_values.size() * 10 + loop_new_int_values.get(i)
plot(loop_new_int_score)

branch_new_bool_score = bar_index * 0
if bar_index % 2 == 0
    branch_new_bool_values = array.new_bool(2, bar_index % 2 == 0)
    branch_new_bool_score := branch_new_bool_values.size() * 100 + (branch_new_bool_values.get(0) ? 10 : 0) + (branch_new_bool_values.get(1) ? 1 : 0)
else
    branch_new_bool_values = array.new_bool(3, bar_index % 2 == 0)
    branch_new_bool_score := branch_new_bool_values.size() * 100 + (branch_new_bool_values.get(0) ? 10 : 0) + (branch_new_bool_values.get(2) ? 1 : 0)
plot(branch_new_bool_score)

loop_new_bool_score = bar_index * 0
for i = 0 to 1
    loop_new_bool_values = array.new_bool(i + 1, i == 0)
    loop_new_bool_score := loop_new_bool_score + loop_new_bool_values.size() * 10 + (loop_new_bool_values.get(i) ? 1 : 0)
plot(loop_new_bool_score)

branch_new_string_score = bar_index * 0
if bar_index % 2 == 0
    branch_new_string_values = array.new_string(2, "even")
    branch_new_string_score := branch_new_string_values.size() * 100 + (branch_new_string_values.get(0) == "even" ? 10 : 0) + (branch_new_string_values.get(1) == "even" ? 1 : 0)
else
    branch_new_string_values = array.new_string(3, "odd")
    branch_new_string_score := branch_new_string_values.size() * 100 + (branch_new_string_values.get(0) == "odd" ? 10 : 0) + (branch_new_string_values.get(2) == "odd" ? 1 : 0)
plot(branch_new_string_score)

loop_new_string_score = bar_index * 0
for i = 0 to 1
    loop_new_string_values = array.new_string(i + 1, i == 0 ? "first" : "second")
    loop_new_string_score := loop_new_string_score + loop_new_string_values.size() * 10 + (loop_new_string_values.get(i) == (i == 0 ? "first" : "second") ? 1 : 0)
plot(loop_new_string_score)
