//@version=5
indicator("UDF")
smooth(src, len) => ta.sma(src, len)
ma = smooth(len=2, src=close)
offset(src) =>
    shifted = src + 1
    shifted
chooseIf(src, flip) =>
    if flip
        src
    else
        src + 10
loopLast(n) =>
    for i = 0 to n
        i
plot(ma + offset(close))
plot(chooseIf(close, bar_index < 2))
plot(loopLast(2))
