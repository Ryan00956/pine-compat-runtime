//@version=5
indicator("DMI Edge Cases")
[plus, minus, adx] = ta.dmi(2, 2)
[zero_di_plus, zero_di_minus, zero_di_adx] = ta.dmi(0, 2)
[negative_di_plus, negative_di_minus, negative_di_adx] = ta.dmi(-1, 2)
[zero_adx_plus, zero_adx_minus, zero_adx_adx] = ta.dmi(2, 0)
[negative_adx_plus, negative_adx_minus, negative_adx_adx] = ta.dmi(2, -1)
plot(plus)
plot(minus)
plot(adx)
plot(na(zero_di_plus) and na(zero_di_minus) and na(zero_di_adx) ? 1 : 0)
plot(na(negative_di_plus) and na(negative_di_minus) and na(negative_di_adx) ? 1 : 0)
plot(na(zero_adx_plus) and na(zero_adx_minus) and na(zero_adx_adx) ? 1 : 0)
plot(na(negative_adx_plus) and na(negative_adx_minus) and na(negative_adx_adx) ? 1 : 0)
