//@version=5
strategy("Exit omitted trailing replacement")
if bar_index == 0
    strategy.entry("L", strategy.long, qty=2)
    strategy.exit("XT1", "L", trail_price=2.5, trail_offset=50)
if bar_index == 1
    strategy.exit("XT2", "L", trail_price=3.5, trail_offset=50)
plot(strategy.position_size)
plot(strategy.netprofit)
