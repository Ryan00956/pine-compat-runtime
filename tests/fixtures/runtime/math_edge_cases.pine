//@version=5
indicator("Math edge cases")
missing_number = bar_index == 1 ? na : close
missing_precision = bar_index == 1 ? na : 1
plot(math.sqrt(-1))
plot(math.log(0))
plot(math.log10(0))
plot(math.exp(1000))
plot(math.acos(2))
plot(math.asin(2))
plot(math.pow(-1, 0.5))
plot(math.max(na, 1))
plot(math.max(close, missing_number, high))
plot(math.min(na, 1))
plot(math.min(close, missing_number, low))
plot(math.avg(na, 1))
plot(math.avg(close, missing_number, high))
plot(math.pow(na, 2))
plot(math.pow(2, na))
plot(math.pow(missing_number, 2))
plot(math.hypot(na, close))
plot(math.hypot(close, na))
plot(math.hypot(close, missing_number))
plot(math.floor(missing_number))
plot(math.ceil(missing_number))
plot(math.trunc(missing_number))
plot(math.round(missing_number))
plot(math.round(close + 0.25, missing_precision))
plot(math.floor(na))
plot(math.ceil(na))
plot(math.trunc(na))
plot(math.round(na))
plot(math.round(close + 0.25, na))
plot(math.sqrt(na))
plot(math.cbrt(na))
plot(math.log(na))
plot(math.log10(na))
plot(math.exp(na))
plot(math.acos(na))
plot(math.asin(na))
plot(math.atan(na))
plot(math.sign(na))
plot(math.todegrees(na))
plot(math.toradians(na))
plot(math.sin(na))
plot(math.cos(na))
plot(math.tan(na))
plot(math.round_to_mintick(na))
plot(float(math.abs(na)))
plot(math.random(5, 5, 7))
plot(math.random(na, 1, 7))
plot(math.random(0, na, 7))
plot(math.random(0, 1, na))
plot(math.random(missing_number, close + 1, 7))
plot(math.sum(na, 2))
plot(math.round(1.5))
plot(math.round(-1.5))
plot(math.round(1.25, 1))
plot(math.round(-1.25, 1))
