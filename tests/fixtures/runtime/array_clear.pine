indicator("Array clear fixture")

floats = array.from(close, high, na)
array.clear(floats)
array.clear(floats)
array.push(floats, low)
plot(array.size(floats))
plot(array.get(floats, 0))

ints = array.from(bar_index, 10)
ints.clear()
ints.push(7)
plot(ints.size())
plot(ints.get(0))

flags = array.from(true, false)
array.clear(flags)
flags.push(bar_index == 0)
plot(flags.size())
plot(flags.get(0) ? 1 : 0)

words = array.from("a", "b")
words.clear()
words.push("z")
plot(words.size())
plot(words.get(0) == "z" ? 1 : 0)

colors = array.from(color.red, color.green)
array.clear(colors)
colors.push(color.blue)
plot(colors.size())
plot(colors.get(0) == color.blue ? 1 : 0)

empty = array.new_float()
empty.clear()
plot(empty.size())

branch_clear_values = array.from(1, 2, 3)
if bar_index % 2 == 0
    array.clear(branch_clear_values)
    branch_clear_values.push(4)
else
    branch_clear_values.clear()
    branch_clear_values.push(5)
plot(branch_clear_values.size())
plot(branch_clear_values.get(0))

loop_clear_values = array.from("a", "b")
loop_clear_results = array.new_int()
for i = 0 to 1
    if i == 0
        array.clear(loop_clear_values)
        loop_clear_values.push("x")
    else
        loop_clear_values.clear()
        loop_clear_values.push("y")
    loop_clear_results.push(loop_clear_values.size())
plot(loop_clear_results.get(0) + loop_clear_results.get(1))
plot(loop_clear_values.get(0) == "y" ? 1 : 0)
