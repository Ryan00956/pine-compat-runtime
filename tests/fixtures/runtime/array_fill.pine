//@version=5
indicator("Array fill fixture")
ints = array.new_int(4, 1)
array.fill(ints, 9, 1, 3)
plot(ints.get(0) * 1000 + ints.get(1) * 100 + ints.get(2) * 10 + ints.get(3))
ints.fill(2)
plot(ints.get(0) + ints.get(3))

floats = array.new_float(3, close)
floats.fill(high, 0, 2)
plot(floats.get(0) + floats.get(1) + floats.get(2))

words = array.new_string(3, "a")
words.fill("b", 1, 3)
plot(words.join("|") == "a|b|b" ? 1 : 0)

colors = array.new_color(2, color.red)
colors.fill(color.green)
plot(colors.get(0) == color.green and colors.get(1) == color.green ? 1 : 0)

flags = array.new_bool(2, false)
array.fill(flags, true, 0, 1)
plot(flags.get(0) and not flags.get(1) ? 1 : 0)

array.fill(flags, false, -1, 1)
array.fill(flags, false, 0, 3)
plot(flags.get(0) and not flags.get(1) ? 1 : 0)

fill_from = 1
fill_to = 3
computed_fill = array.new_int(4, 0)
computed_fill.fill(7, fill_from, fill_to + 0)
plot(computed_fill.get(0) * 1000 + computed_fill.get(fill_from) * 100 + computed_fill.get(fill_to - 1) * 10 + computed_fill.get(3))

branch_fill_values = array.from(1, 2, 3, 4)
if bar_index % 2 == 0
    array.fill(branch_fill_values, 8, 1, 3)
else
    branch_fill_values.fill(9)
plot(branch_fill_values.get(0) * 1000 + branch_fill_values.get(1) * 100 + branch_fill_values.get(2) * 10 + branch_fill_values.get(3))

loop_fill_values = array.from(0, 0, 0, 0)
for i = 0 to 1
    if i == 0
        array.fill(loop_fill_values, 5, i, i + 2)
    else
        loop_fill_values.fill(7, i + 1, i + 3)
plot(loop_fill_values.get(0) * 1000 + loop_fill_values.get(1) * 100 + loop_fill_values.get(2) * 10 + loop_fill_values.get(3))

independent_fill_values = array.from(1, 2, 3, 4)
independent_fill_score = bar_index * 0
independent_fill_i = 0
while independent_fill_i < 1
    array.fill(independent_fill_values, 8, 1, 3)
    independent_fill_values.fill(9, 0, 1)
    independent_fill_score := independent_fill_values.get(0) * 1000 + independent_fill_values.get(1) * 100 + independent_fill_values.get(2) * 10 + independent_fill_values.get(3)
    independent_fill_i := independent_fill_i + 1
plot(independent_fill_score)
