//@version=5
indicator("Chart point UDF values")

make_point(offset) =>
    chart.point.from_index(bar_index + offset, close + offset)

pass_point(point) =>
    point

point = pass_point(make_point(5))
copied = chart.point.copy(point)
previous = point[1]
dynamic_offset = bar_index == 0 ? na : 1
dynamic_previous = point[dynamic_offset]
dynamic_sibling = point[dynamic_offset]

float dynamic_previous_price = na
float dynamic_sibling_price_after_dynamic_mutation = na
if bar_index > 0
    dynamic_previous_price := dynamic_previous.price
    dynamic_previous.price := close + 700
    dynamic_sibling_price_after_dynamic_mutation := dynamic_sibling.price

plot(point.index)
plot(copied.price)
plot(na(previous) ? na : previous.index)
plot(na(dynamic_previous) ? 1 : 0)
plot(dynamic_previous_price)
plot(dynamic_sibling_price_after_dynamic_mutation)
