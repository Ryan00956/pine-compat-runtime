//@version=5
indicator("KC edge cases")
missing_source = bar_index == 1 ? na : close
[zero_middle, zero_upper, zero_lower] = ta.kc(close, 0, 2)
[negative_middle, negative_upper, negative_lower] = ta.kc(close, -1, 2)
[missing_source_middle, missing_source_upper, missing_source_lower] = ta.kc(missing_source, 2, 2)
[span_middle, span_upper, span_lower] = ta.kc(close, 2, 2, false)
[na_tr_middle, na_tr_upper, na_tr_lower] = ta.kc(close, 2, 2, na)
[zero_mult_middle, zero_mult_upper, zero_mult_lower] = ta.kc(close, 2, 0)
plot(na(zero_middle) and na(zero_upper) and na(zero_lower) ? 1 : 0)
plot(na(negative_middle) and na(negative_upper) and na(negative_lower) ? 1 : 0)
plot(missing_source_middle)
plot(missing_source_upper)
plot(missing_source_lower)
plot(span_middle)
plot(span_upper)
plot(span_lower)
plot(na_tr_middle)
plot(na_tr_upper)
plot(na_tr_lower)
plot(zero_mult_middle)
plot(zero_mult_upper)
plot(zero_mult_lower)
