//@version=6
indicator("Matrix submatrix")

values = matrix.new<float>(3, 4, na)
matrix.set(values, 0, 0, close + 0)
matrix.set(values, 0, 1, close + 1)
matrix.set(values, 0, 2, close + 2)
matrix.set(values, 0, 3, close + 3)
matrix.set(values, 1, 0, close + 10)
matrix.set(values, 1, 1, close + 11)
matrix.set(values, 1, 2, close + 12)
matrix.set(values, 1, 3, close + 13)
matrix.set(values, 2, 0, close + 20)
matrix.set(values, 2, 1, close + 21)
matrix.set(values, 2, 2, close + 22)
matrix.set(values, 2, 3, close + 23)

middle = matrix.submatrix(values, 1, 3, 1, 4)
full_copy = values.submatrix()
empty_rows = values.submatrix(3, 3, 0, 4)
empty_columns = matrix.submatrix(values, 0, 3, 2, 2)

slice_middle(src) =>
    src.submatrix(1, 3, 1, 3)

udf_slice = slice_middle(values)
matrix.set(values, 1, 1, close + 999)

plot(matrix.rows(middle), "middle_rows")
plot(matrix.columns(middle), "middle_columns")
plot(matrix.get(middle, 0, 0), "middle_r0c0")
plot(matrix.get(middle, 1, 2), "middle_r1c2")
plot(matrix.get(full_copy, 1, 1), "full_copy_r1c1")
plot(matrix.rows(empty_rows), "empty_rows_rows")
plot(matrix.columns(empty_rows), "empty_rows_columns")
plot(matrix.rows(empty_columns), "empty_columns_rows")
plot(matrix.columns(empty_columns), "empty_columns_columns")
plot(matrix.get(udf_slice, 0, 0), "udf_r0c0")
