//@version=5
indicator("Table cell")
var table_id = table.new(position.top_right, 2, 2)
if bar_index == 1
    table.cell(table_id, 0, 0, "A")
if bar_index == 2
    table.cell(table_id, column=1, row=0, text="B", bgcolor=color.green, text_color=color.white, tooltip="initial")
    table.cell(table_id, 0, 0, "C")
    table.cell_set_text(table_id, 1, 0, "B2")
    table.cell_set_bgcolor(table_id, 1, 0, color.red)
    table.cell_set_text_color(table_id, 1, 0, color.blue)
    table.cell_set_width(table_id, 1, 0, 25)
    table.cell_set_height(table_id, 1, 0, 40)
    table.cell_set_text_size(table_id, 1, 0, size.small)
    table.cell_set_text_halign(table_id, 1, 0, text.align_left)
    table.cell_set_text_valign(table_id, 1, 0, text.align_top)
    table.cell_set_tooltip(table_id, 1, 0, "updated")
    table.set_position(table_id, position.bottom_right)
    table.set_bgcolor(table_id, color.yellow)
    table.set_frame_color(table_id, color.black)
    table.set_frame_width(table_id, 3)
    table.set_border_color(table_id, color.white)
    table.set_border_width(table_id, 4)
table.cell(na, 0, 1, "noop")
table.set_position(na, position.top_left)
table.set_bgcolor(na, color.red)
table.set_frame_color(na, color.blue)
table.set_frame_width(na, 2)
table.set_border_color(na, color.green)
table.set_border_width(na, 5)
table.cell_set_text(na, 0, 1, "noop")
table.cell_set_bgcolor(na, 0, 1, color.red)
table.cell_set_text_color(na, 0, 1, color.blue)
table.cell_set_width(na, 0, 1, 25)
table.cell_set_height(na, 0, 1, 40)
table.cell_set_text_size(na, 0, 1, size.small)
table.cell_set_text_halign(na, 0, 1, text.align_left)
table.cell_set_text_valign(na, 0, 1, text.align_top)
table.cell_set_tooltip(na, 0, 1, "noop")
plot(close)
