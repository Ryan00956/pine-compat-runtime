//@version=6
indicator("Table cell")
var table_id = table.new(position.top_right, 2, 2)
var deleted_table = table.new(position.bottom_left, 1, 1)
if bar_index == 1
    table.delete(deleted_table)
    table.cell(table_id, 0, 0, "A")
    visible_tables = table.all
    if array.size(visible_tables) > 0
        table.cell(array.get(visible_tables, 0), 0, 1, "from_all")
if bar_index == 2
    table.cell(table_id, column=1, row=0, text="B", width=12, height=34, text_color=color.white, text_halign=text.align_left, text_valign=text.align_top, text_size=19, bgcolor=color.green, tooltip="initial", text_font_family=font.family_monospace, text_formatting=text.format_bold)
    table.cell(table_id, 0, 0, "C")
    table.cell_set_text(table_id, 1, 0, "B2")
    text_i = 0
    while text_i < 1
        table.cell_set_text(table_id, 1, 0, "B3")
        text_i := text_i + 1
    table.cell_set_bgcolor(table_id, 1, 0, color.red)
    bgcolor_i = 0
    while bgcolor_i < 1
        table.cell_set_bgcolor(table_id, 1, 0, color.blue)
        bgcolor_i := bgcolor_i + 1
    table.cell_set_text_color(table_id, 1, 0, color.blue)
    text_color_i = 0
    while text_color_i < 1
        table.cell_set_text_color(table_id, 1, 0, color.red)
        text_color_i := text_color_i + 1
    table.cell_set_width(table_id, 1, 0, 25)
    width_i = 0
    while width_i < 1
        table.cell_set_width(table_id, 1, 0, 30)
        width_i := width_i + 1
    table.cell_set_height(table_id, 1, 0, 40)
    height_i = 0
    while height_i < 1
        table.cell_set_height(table_id, 1, 0, 45)
        height_i := height_i + 1
    table.cell_set_text_size(table_id, 1, 0, 21)
    text_size_i = 0
    while text_size_i < 1
        table.cell_set_text_size(table_id, 1, 0, size.large)
        text_size_i := text_size_i + 1
    table.cell_set_text_halign(table_id, 1, 0, text.align_left)
    text_halign_i = 0
    while text_halign_i < 1
        table.cell_set_text_halign(table_id, 1, 0, text.align_right)
        text_halign_i := text_halign_i + 1
    table.cell_set_text_valign(table_id, 1, 0, text.align_top)
    text_valign_i = 0
    while text_valign_i < 1
        table.cell_set_text_valign(table_id, 1, 0, text.align_bottom)
        text_valign_i := text_valign_i + 1
    table.cell_set_text_wrap(table_id, 1, 0, text.wrap_auto)
    text_wrap_i = 0
    while text_wrap_i < 1
        table.cell_set_text_wrap(table_id, 1, 0, text.wrap_none)
        text_wrap_i := text_wrap_i + 1
    table.cell_set_tooltip(table_id, 1, 0, "updated")
    tooltip_i = 0
    while tooltip_i < 1
        table.cell_set_tooltip(table_id, 1, 0, "loop-updated")
        tooltip_i := tooltip_i + 1
    table.cell_set_text_font_family(table_id, 1, 0, font.family_default)
    text_font_family_i = 0
    while text_font_family_i < 1
        table.cell_set_text_font_family(table_id, 1, 0, font.family_monospace)
        text_font_family_i := text_font_family_i + 1
    table.cell_set_text_formatting(table_id, 1, 0, text.format_bold + text.format_italic)
    text_formatting_i = 0
    while text_formatting_i < 1
        table.cell_set_text_formatting(table_id, 1, 0, text.format_italic)
        text_formatting_i := text_formatting_i + 1
    table.set_position(table_id, position.bottom_right)
    table.set_bgcolor(table_id, color.yellow)
    table.set_frame_color(table_id, color.black)
    table.set_frame_width(table_id, 3)
    table.set_border_color(table_id, color.white)
    table.set_border_width(table_id, 4)
table.cell(na, 0, 1, "noop")
table.set_position(na, position.top_left)
table.set_bgcolor(na, color.red)
table.set_frame_color(na, color.blue)
table.set_frame_width(na, 2)
table.set_border_color(na, color.green)
table.set_border_width(na, 5)
table.cell_set_text(na, 0, 1, "noop")
table.cell_set_bgcolor(na, 0, 1, color.red)
table.cell_set_text_color(na, 0, 1, color.blue)
table.cell_set_width(na, 0, 1, 25)
table.cell_set_height(na, 0, 1, 40)
table.cell_set_text_size(na, 0, 1, size.small)
table.cell_set_text_halign(na, 0, 1, text.align_left)
table.cell_set_text_valign(na, 0, 1, text.align_top)
table.cell_set_text_wrap(na, 0, 1, text.wrap_none)
table.cell_set_tooltip(na, 0, 1, "noop")
table.cell_set_text_font_family(na, 0, 1, font.family_monospace)
table.cell_set_text_formatting(na, 0, 1, text.format_italic)
visible_table_count = array.size(table.all)
plot(visible_table_count)
plot(close)
loop_visible_table_count = visible_table_count
i = 0
while i < 1
    loop_visible_table_count := array.size(table.all)
    i := i + 1
plot(loop_visible_table_count)
