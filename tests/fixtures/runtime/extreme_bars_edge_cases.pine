//@version=5
indicator("Extreme Bars Edge Cases")
hi = ta.highestbars(close, 3)
lo = ta.lowestbars(close, 3)
default_hi = ta.highestbars(2)
default_lo = ta.lowestbars(2)
with_na_hi = ta.highestbars(bar_index == 3 ? na : close, 3)
with_na_lo = ta.lowestbars(bar_index == 3 ? na : close, 3)
tie_hi_source = bar_index == 2 ? 5 : bar_index == 3 ? 5 : close
tie_lo_source = bar_index == 2 ? 1 : bar_index == 3 ? 1 : close
tie_hi = ta.highestbars(tie_hi_source, 3)
tie_lo = ta.lowestbars(tie_lo_source, 3)
invalid_hi = ta.highestbars(close, 0)
invalid_lo = ta.lowestbars(close, 0)
plot(hi)
plot(lo)
plot(default_hi)
plot(default_lo)
plot(with_na_hi)
plot(with_na_lo)
plot(tie_hi)
plot(tie_lo)
plot(invalid_hi)
plot(invalid_lo)
