//@version=5
indicator("Array from UDT size")
type Point
    float x

points = array.from(Point.new(close), Point.new(open))
array.set(points, 0, Point.new(high))
points.set(1, Point.new(low))
array.push(points, Point.new(close + open))
points.push(Point.new(high + low))
first = array.get(points, 0)
second = points.get(1)
third = array.get(points, 2)
fourth = points.get(3)
first_reader = array.first(points)
method_first_reader = points.first()
last_reader = array.last(points)
method_last_reader = points.last()
popped = array.pop(points)
method_popped = points.pop()
shifted = array.shift(points)
method_shifted = points.shift()
cleared = array.from(Point.new(close), Point.new(open))
array.clear(cleared)
cleared_empty_size = array.size(cleared)
array.push(cleared, Point.new(high))
cleared_reader = array.get(cleared, 0)
method_cleared = array.from(Point.new(close), Point.new(open))
method_cleared.clear()
method_cleared_empty_size = method_cleared.size()
method_cleared.push(Point.new(low))
method_cleared_reader = method_cleared.get(0)
copy_source = array.from(Point.new(close), Point.new(open))
copied = array.copy(copy_source)
method_copied = copy_source.copy()
array.push(copied, Point.new(high))
method_copied.push(Point.new(low))
copy_reader = array.get(copied, 0)
copy_added = copied.get(2)
method_copy_added = method_copied.get(2)
reverse_points = array.from(Point.new(close), Point.new(open))
array.reverse(reverse_points)
reverse_first = array.get(reverse_points, 0)
reverse_second = reverse_points.get(1)
method_reverse_points = array.from(Point.new(high), Point.new(low))
method_reverse_points.reverse()
method_reverse_first = method_reverse_points.get(0)
method_reverse_second = method_reverse_points.get(1)
concat_left = array.from(Point.new(close))
concat_right = array.from(Point.new(open), Point.new(high))
concat_returned = array.concat(concat_left, concat_right)
concat_added = concat_returned.get(2)
method_concat_left = array.from(Point.new(low))
method_concat_right = array.from(Point.new(high), Point.new(open))
method_concat_returned = method_concat_left.concat(method_concat_right)
method_concat_added = method_concat_returned.get(2)
slice_source = array.from(Point.new(close), Point.new(open), Point.new(high))
slice_window = array.slice(slice_source, 1, 3)
slice_first = slice_window.get(0)
array.set(slice_window, 0, Point.new(low))
slice_parent = slice_source.get(1)
method_slice_source = array.from(Point.new(close), Point.new(open), Point.new(high))
method_slice_window = method_slice_source.slice(0, 2)
method_slice_source.set(1, Point.new(low))
method_slice_second = method_slice_window.get(1)
insert_points = array.from(Point.new(close), Point.new(high))
array.insert(insert_points, 1, Point.new(open))
insert_inserted = insert_points.get(1)
insert_tail = insert_points.get(2)
method_insert_points = array.from(Point.new(low), Point.new(close))
method_insert_points.insert(1, Point.new(high))
method_insert_inserted = method_insert_points.get(1)
method_insert_tail = method_insert_points.get(2)
remove_points = array.from(Point.new(close), Point.new(open), Point.new(high))
removed = array.remove(remove_points, 1)
remove_after = remove_points.get(1)
method_remove_points = array.from(Point.new(low), Point.new(close), Point.new(open))
method_removed = method_remove_points.remove(0)
method_remove_after = method_remove_points.get(0)
unshift_points = array.from(Point.new(close), Point.new(high))
array.unshift(unshift_points, Point.new(open))
unshift_first = unshift_points.get(0)
unshift_second = unshift_points.get(1)
method_unshift_points = array.from(Point.new(low), Point.new(close))
method_unshift_points.unshift(Point.new(high))
method_unshift_first = method_unshift_points.get(0)
method_unshift_second = method_unshift_points.get(1)
plot(array.size(points))
plot(points.size())
plot(first.x)
plot(second.x)
plot(third.x)
plot(fourth.x)
plot(first_reader.x)
plot(method_first_reader.x)
plot(last_reader.x)
plot(method_last_reader.x)
plot(popped.x)
plot(method_popped.x)
plot(shifted.x)
plot(method_shifted.x)
plot(cleared_empty_size)
plot(array.size(cleared))
plot(cleared_reader.x)
plot(method_cleared_empty_size)
plot(method_cleared.size())
plot(method_cleared_reader.x)
plot(array.size(copy_source))
plot(array.size(copied))
plot(method_copied.size())
plot(copy_reader.x)
plot(copy_added.x)
plot(method_copy_added.x)
plot(reverse_first.x)
plot(reverse_second.x)
plot(method_reverse_first.x)
plot(method_reverse_second.x)
plot(array.size(concat_returned))
plot(concat_added.x)
plot(array.size(concat_right))
plot(method_concat_returned.size())
plot(method_concat_added.x)
plot(method_concat_right.size())
plot(slice_window.size())
plot(slice_first.x)
plot(slice_parent.x)
plot(method_slice_window.size())
plot(method_slice_second.x)
plot(method_slice_source.size())
plot(insert_points.size())
plot(insert_inserted.x)
plot(insert_tail.x)
plot(method_insert_points.size())
plot(method_insert_inserted.x)
plot(method_insert_tail.x)
plot(remove_points.size())
plot(removed.x)
plot(remove_after.x)
plot(method_remove_points.size())
plot(method_removed.x)
plot(method_remove_after.x)
plot(unshift_points.size())
plot(unshift_first.x)
plot(unshift_second.x)
plot(method_unshift_points.size())
plot(method_unshift_first.x)
plot(method_unshift_second.x)
