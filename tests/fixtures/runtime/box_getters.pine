//@version=5
indicator("Box getters")
var id = box.new(bar_index, high, bar_index + 1, low)
var deleted_box = box.new(bar_index, low, bar_index + 1, high)
branch_left_value = bar_index * 0 - 1
branch_right_value = bar_index * 0 - 1
branch_top_value = close * 0 - 1
branch_bottom_value = close * 0 - 1
if bar_index == 1
    box.set_left(id, bar_index - 10)
    box.set_right(id, bar_index + 10)
    box.set_top(id, high + 10)
    box.set_bottom(id, low - 10)
    box.delete(deleted_box)
    branch_left_value := box.get_left(id)
    branch_right_value := box.get_right(id)
    branch_top_value := box.get_top(id)
    branch_bottom_value := box.get_bottom(id)
left_value = box.get_left(id)
flow_left_value = left_value
right_value = box.get_right(id)
flow_right_value = right_value
top_value = box.get_top(id)
flow_top_value = top_value
bottom_value = box.get_bottom(id)
flow_bottom_value = bottom_value
visible_boxes = box.all
visible_box_count = array.size(visible_boxes)
flow_visible_box_count = visible_box_count
visible_box_left = visible_box_count > 0 ? box.get_left(array.get(visible_boxes, 0)) : -1
missing_left = nz(box.get_left(na), -1)
missing_right = nz(box.get_right(na), -1)
missing_top = nz(box.get_top(na), -1)
missing_bottom = nz(box.get_bottom(na), -1)
branch_visible_box_count = bar_index * 0 - 1
if bar_index == 2
    box.delete(id)
    branch_visible_boxes = box.all
    branch_visible_box_count := array.size(branch_visible_boxes)
    all_i = 0
    while all_i < 1
        flow_visible_box_count := array.size(box.all)
        all_i := all_i + 1
if bar_index == 1
    get_left_i = 0
    while get_left_i < 1
        flow_left_value := box.get_left(id)
        get_left_i := get_left_i + 1
    get_right_i = 0
    while get_right_i < 1
        flow_right_value := box.get_right(id)
        get_right_i := get_right_i + 1
    get_top_i = 0
    while get_top_i < 1
        flow_top_value := box.get_top(id)
        get_top_i := get_top_i + 1
    get_bottom_i = 0
    while get_bottom_i < 1
        flow_bottom_value := box.get_bottom(id)
        get_bottom_i := get_bottom_i + 1
deleted_left = bar_index >= 2 ? nz(box.get_left(id), -1) : -1
deleted_right = bar_index >= 2 ? nz(box.get_right(id), -1) : -1
deleted_top = bar_index >= 2 ? nz(box.get_top(id), -1) : -1
deleted_bottom = bar_index >= 2 ? nz(box.get_bottom(id), -1) : -1
plot(left_value)
plot(flow_left_value)
plot(right_value)
plot(flow_right_value)
plot(top_value)
plot(flow_top_value)
plot(bottom_value)
plot(flow_bottom_value)
plot(visible_box_count)
plot(flow_visible_box_count)
plot(visible_box_left)
plot(missing_left)
plot(missing_right)
plot(missing_top)
plot(missing_bottom)
plot(deleted_left)
plot(deleted_right)
plot(deleted_top)
plot(deleted_bottom)
plot(branch_visible_box_count)
plot(branch_left_value)
plot(branch_right_value)
plot(branch_top_value)
plot(branch_bottom_value)
plot(close)
