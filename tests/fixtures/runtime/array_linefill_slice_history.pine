//@version=5
indicator("Linefill array slice history")
upper = line.new(bar_index, high, bar_index + 1, high)
lower = line.new(bar_index, low, bar_index + 1, low)
current = linefill.new(upper, lower, color.green)
source = array.new_linefill(2)
source.set(0, current)
window = source.slice(0, 1)
previous_window = window[1]
previous_id = na(previous_window) ? na : previous_window.get(0)
previous_line = na(previous_id) ? na : linefill.get_line1(previous_id)
dynamic_offset = bar_index == 0 ? na : 1
dynamic_previous_window = window[dynamic_offset]
dynamic_sibling_window = window[dynamic_offset]
dynamic_previous_id = na(dynamic_previous_window) ? na : dynamic_previous_window.get(0)
dynamic_previous_line = na(dynamic_previous_id) ? na : linefill.get_line1(dynamic_previous_id)
if not na(dynamic_previous_window)
    dynamic_previous_window.set(0, current)
dynamic_sibling_id_after_dynamic_replacement = na(dynamic_sibling_window) ? na : dynamic_sibling_window.get(0)
dynamic_sibling_line_after_dynamic_replacement = na(dynamic_sibling_id_after_dynamic_replacement) ? na : linefill.get_line1(dynamic_sibling_id_after_dynamic_replacement)
plot(na(previous_window) ? 1 : 0)
plot(na(dynamic_previous_window) ? 1 : 0)
plot(na(previous_line) ? na : line.get_x1(previous_line))
plot(na(dynamic_previous_line) ? na : line.get_x1(dynamic_previous_line))
plot(na(dynamic_sibling_line_after_dynamic_replacement) ? na : line.get_x1(dynamic_sibling_line_after_dynamic_replacement))
