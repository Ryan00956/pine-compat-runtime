//@version=5
indicator("Drawing typed declarations", overlay=true)

label marker = na
line upper = na
line lower = na
linefill fill = na
box range_box = na
table info = na
polyline path = na

upper := line.new(bar_index, high, bar_index + 1, high + 1, color=color.green)
lower := line.new(bar_index, low, bar_index + 1, low - 1, color=color.red)
fill := linefill.new(upper, lower, color.new(color.blue, 80))

marker := label.new(bar_index, close, "typed")
range_box := box.new(bar_index, high, bar_index + 1, low, bgcolor=color.new(color.green, 90))
info := table.new(position.top_right, 1, 1)
table.cell(info, 0, 0, "id")

points = array.new<chart.point>()
array.push(points, chart.point.from_index(bar_index, close))
array.push(points, chart.point.from_index(bar_index + 1, close + 1))
path := polyline.new(points, line_color=color.yellow)

marker := na
marker := label.new(bar_index + 1, close, "again")
linefill.set_color(fill, color.red)
polyline.delete(path)

plot(array.size(label.all))
plot(array.size(line.all))
plot(array.size(linefill.all))
plot(array.size(box.all))
plot(array.size(table.all))
plot(array.size(polyline.all))
