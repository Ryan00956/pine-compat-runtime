//@version=5
import user/udt/1 as lib
indicator("Imported UDT method while and switch return")

p = lib.Point.new(close)
other = lib.Point.new(close + 80)

sameTernary = p.sameTernary(bar_index % 2 == 0)
chosenTernary = p.chooseTernary(other, bar_index % 2 == 0)
sameWhile = p.sameWhile(close > 0)
chosenWhile = p.chooseWhile(other, close > 0)
sameSwitch = p.sameSwitch(bar_index % 2)
chosenSwitch = p.chooseSwitch(other, bar_index % 2)

plot(sameTernary.x + chosenTernary.x)
plot(sameWhile.x + chosenWhile.x)
plot(sameSwitch.x + chosenSwitch.x)
