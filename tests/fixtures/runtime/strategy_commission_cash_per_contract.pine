//@version=5
strategy("Commission cash per contract", commission_type=strategy.commission.cash_per_contract, commission_value=0.5)
if bar_index == 0
    strategy.entry("L", strategy.long, qty=2)
if bar_index == 2
    strategy.close("L")
plot(strategy.opentrades.commission(0))
plot(strategy.closedtrades.commission(0))
plot(strategy.netprofit)
plot(strategy.equity)
