plot(na(matrix.row(na_float_matrix, 0).min()) ? 1 : 0, "matrix_na_row_call_result_min")
plot(na(matrix.row(na_float_matrix, 0).max()) ? 1 : 0, "matrix_na_row_call_result_max")
plot(na(matrix.row(na_float_matrix, 0).sum()) ? 1 : 0, "matrix_na_row_call_result_sum")
