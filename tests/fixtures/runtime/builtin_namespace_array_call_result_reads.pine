plot(bool_value_last ? 1 : 0, "map_bool_value")
plot(bool_key_first ? 1 : 0, "map_bool_key")
plot(string_value_last == "on" ? 1 : 0, "map_string_value")
plot(string_key_first == "red" ? 1 : 0, "map_string_key")
plot(color_value_last == color.blue ? 1 : 0, "map_color_value")
plot(color_key_last == color.blue ? 1 : 0, "map_color_key")
plot(int_value_first, "map_int_value")
plot(map.keys(int_float).first() == 10 ? 1 : 0, "map_key_copy_independent")
plot(map.values(int_float).first(), "map_replace_order")
plot(map.values(int_float).first() == 3.5 ? 1 : 0, "map_value_copy_independent")
plot(map.values(int_float).copy().copy().last(), "map_value_nested_copy")
plot(map.keys(int_float).includes(20) and map.values(int_float).copy().includes(3.5) and map.keys(float_bool).includes(1.25) and map.values(bool_string).includes("on") and map.values(string_color).includes(color.blue) and map.values(color_int).includes(9) ? 1 : 0, "map_includes")
plot(map.keys(int_float).indexof(20) == 1 and map.values(int_float).copy().indexof(3.5) == 0 and map.keys(float_bool).indexof(1.25) == 0 and map.values(bool_string).indexof("on") == 1 and map.values(string_color).indexof(color.blue) == 1 and map.values(color_int).indexof(9) == 1 ? 1 : 0, "map_indexof")
plot(map.keys(int_float).lastindexof(20) == 1 and map.values(int_float).copy().lastindexof(3.5) == 0 and map.keys(float_bool).lastindexof(1.25) == 0 and map.values(bool_string).lastindexof("on") == 1 and map.values(string_color).lastindexof(color.blue) == 1 and map.values(color_int).lastindexof(9) == 1 ? 1 : 0, "map_lastindexof")
plot(map.keys(int_float).binary_search(20) == 1 and map.keys(float_bool).copy().binary_search(1.25) == 0 and map.values(color_int).binary_search(9) == 1 ? 1 : 0, "map_binary_search")
plot(map.keys(int_float).binary_search_leftmost(15) == 0 and map.keys(float_bool).copy().binary_search_leftmost(2.0) == 0 and map.values(color_int).binary_search_leftmost(8) == 0 ? 1 : 0, "map_binary_search_leftmost")
plot(map.keys(int_float).binary_search_rightmost(15) == 1 and map.keys(float_bool).copy().binary_search_rightmost(2.0) == 1 and map.values(color_int).binary_search_rightmost(8) == 1 ? 1 : 0, "map_binary_search_rightmost")
