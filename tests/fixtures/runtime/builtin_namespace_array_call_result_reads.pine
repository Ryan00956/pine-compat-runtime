plot(matrix.eigenvalues(float_diagonal).copy().binary_search_rightmost(2.5) == 1 ? 1 : 0, "eigen_binary_search_rightmost")
plot(matrix.eigenvalues(float_diagonal).abs().first() == 2.0 ? 1 : 0, "eigen_call_result_abs")
plot(matrix.eigenvalues(float_diagonal).min() == 2.0 ? 1 : 0, "eigen_call_result_min")
plot(matrix.eigenvalues(float_diagonal).max() == 3.0 ? 1 : 0, "eigen_call_result_max")
plot(matrix.eigenvalues(float_diagonal).sum() == 5.0 ? 1 : 0, "eigen_call_result_sum")
plot(matrix.eigenvalues(float_diagonal).avg() == 2.5 ? 1 : 0, "eigen_call_result_avg")
plot(matrix.eigenvalues(float_diagonal).range() == 1.0 ? 1 : 0, "eigen_call_result_range")
plot(matrix.eigenvalues(matrix.new<float>(0, 0)).size(), "eigen_empty_size")
plot(na(matrix.eigenvalues(matrix.new<float>(0, 0)).first()) ? 1 : 0, "eigen_empty_first")
matrix<float> na_eigen_matrix = na
all_na_eigen_matrix = matrix.new<float>(1, 1)
plot(na(matrix.eigenvalues(na_eigen_matrix).size()) ? 1 : 0, "eigen_na_matrix_size")
plot(na(matrix.eigenvalues(all_na_eigen_matrix).first()) ? 1 : 0, "eigen_na_cell_first")

