plot(matrix.eigenvalues(float_diagonal).copy().indexof(3.0) == 1 ? 1 : 0, "eigen_indexof")
plot(matrix.eigenvalues(float_diagonal).copy().lastindexof(3.0) == 1 ? 1 : 0, "eigen_lastindexof")
