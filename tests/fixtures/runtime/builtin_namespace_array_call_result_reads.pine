plot(readMatrixAndMap(float_matrix, int_float), "block_udf")

mult_matrix = matrix.new<float>(2, 2, 0.0)
mult_matrix.set(0, 0, 1.0)
mult_matrix.set(0, 1, 2.0)
mult_matrix.set(1, 0, 3.0)
mult_matrix.set(1, 1, 4.0)
mult_vector = array.from(5.0, 6.0)
mult_other = array.from(7.0, 8.0)

float mult_matrix_array_get = matrix.mult(mult_matrix, mult_vector).get(0)
float mult_matrix_array_first = matrix.mult(mult_matrix, mult_vector).first()
float mult_matrix_array_last = matrix.mult(mult_matrix, mult_vector).last()
float mult_matrix_array_negative = matrix.mult(mult_matrix, mult_vector).get(-1)
float mult_matrix_array_copy = matrix.mult(mult_matrix, mult_vector).copy().copy().last()
