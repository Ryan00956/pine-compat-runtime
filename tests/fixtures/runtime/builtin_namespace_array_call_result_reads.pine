//@version=6
indicator("Builtin namespace array call-result reads")

splitExpressionRead() => str.split("udf,left", ",").copy().last()

readMatrixAndMap(matrix_values, map_values) =>
    float row_first = matrix.row(matrix_values, 0).copy().first()
    int key_last = map.keys(map_values).copy().last()
    row_first + key_last

matrixMultExpressionRead(matrix_values, vector_values) => matrix.mult(matrix_values, vector_values).copy().last()

matrixMultBlockRead(matrix_values, vector_values) =>
    float first = matrix.mult(matrix_values, vector_values).copy().first()
    int count = matrix.mult(matrix_values, vector_values).size()
    first + count

int split_size = str.split("alpha,beta,gamma", ",").size()
string split_middle = str.split("alpha,beta,gamma", ",").get(index=1)
string split_first = str.split("alpha,beta,gamma", ",").first()
string split_last = str.split("alpha,beta,gamma", ",").last()
string split_negative_index = str.split("alpha,beta,gamma", ",").get(-1)
split_nested_copy = str.split("alpha,beta,gamma", ",").copy().copy()
split_nested_copy.set(0, "changed")
plot(split_size, "split_size")
plot(split_middle == "beta" ? 1 : 0, "split_get")
plot(split_first == "alpha" ? 1 : 0, "split_first")
plot(split_last == "gamma" ? 1 : 0, "split_last")
plot(split_negative_index == "gamma" ? 1 : 0, "split_negative_index")
plot(split_nested_copy.first() == "changed" ? 1 : 0, "split_nested_copy")
plot(str.split("alpha,beta,gamma", ",").first() == "alpha" ? 1 : 0, "split_copy_independent")
plot(str.split("", "").size(), "split_empty_size")
plot(na(str.split("", "").first()) ? 1 : 0, "split_empty_first")
plot(na(str.split(na, ",").size()) ? 1 : 0, "split_na_size")
plot(splitExpressionRead() == "left" ? 1 : 0, "split_expression_udf")
plot(str.split("alpha,beta,gamma", ",").copy().includes("beta") ? 1 : 0, "split_includes")
plot(not str.split("alpha,beta,gamma", ",").includes("missing") ? 1 : 0, "split_includes_missing")
plot(not str.split("", "").includes("missing") ? 1 : 0, "split_empty_includes")
plot(na(str.split(na, ",").includes("missing")) ? 1 : 0, "split_na_includes")
plot(str.split("alpha,beta,gamma", ",").copy().indexof("beta") == 1 ? 1 : 0, "split_indexof")
plot(str.split("alpha,beta,gamma", ",").indexof("missing") == -1 ? 1 : 0, "split_indexof_missing")
plot(str.split("", "").indexof("missing") == -1 ? 1 : 0, "split_empty_indexof")
plot(str.split(na, ",").indexof("missing") == -1 ? 1 : 0, "split_na_indexof")
plot(str.split("alpha,beta,alpha", ",").copy().lastindexof("alpha") == 2 ? 1 : 0, "split_lastindexof")
plot(str.split("alpha,beta,alpha", ",").lastindexof("missing") == -1 ? 1 : 0, "split_lastindexof_missing")
plot(str.split("", "").lastindexof("missing") == -1 ? 1 : 0, "split_empty_lastindexof")
plot(str.split(na, ",").lastindexof("missing") == -1 ? 1 : 0, "split_na_lastindexof")

int pivot_size = ta.pivot_point_levels("Traditional", true, true).size()
float pivot_get = ta.pivot_point_levels("Traditional", true, true).get(0)
float pivot_first = ta.pivot_point_levels("Traditional", true, true).first()
float pivot_last = ta.pivot_point_levels("Traditional", true, true).last()
float pivot_nested_copy = ta.pivot_point_levels("Traditional", true, true).copy().copy().get(0)
plot(pivot_size, "pivot_size")
plot(pivot_get, "pivot_get")
plot(pivot_first, "pivot_first")
plot(pivot_last, "pivot_last")
plot(pivot_nested_copy, "pivot_nested_copy")
plot(ta.pivot_point_levels("Traditional", true, true).includes(pivot_first) ? 1 : 0, "pivot_includes")
plot(ta.pivot_point_levels("Traditional", true, true).indexof(pivot_first) == 0 ? 1 : 0, "pivot_indexof")
plot(ta.pivot_point_levels("Traditional", true, true).lastindexof(pivot_first) >= 0 ? 1 : 0, "pivot_lastindexof")
pivot_abs_first = ta.pivot_point_levels("Traditional", true, true).abs().first()
plot(na(pivot_first) ? (na(pivot_abs_first) ? 1 : 0) : (pivot_abs_first == math.abs(pivot_first) ? 1 : 0), "pivot_call_result_abs")
pivot_min = ta.pivot_point_levels("Traditional", true, true).min()
pivot_namespace_min = array.min(ta.pivot_point_levels("Traditional", true, true))
plot(na(pivot_namespace_min) ? (na(pivot_min) ? 1 : 0) : (pivot_min == pivot_namespace_min ? 1 : 0), "pivot_call_result_min")
pivot_max = ta.pivot_point_levels("Traditional", true, true).max()
pivot_namespace_max = array.max(ta.pivot_point_levels("Traditional", true, true))
plot(na(pivot_namespace_max) ? (na(pivot_max) ? 1 : 0) : (pivot_max == pivot_namespace_max ? 1 : 0), "pivot_call_result_max")
pivot_sum = ta.pivot_point_levels("Traditional", true, true).sum()
pivot_namespace_sum = array.sum(ta.pivot_point_levels("Traditional", true, true))
plot(na(pivot_namespace_sum) ? (na(pivot_sum) ? 1 : 0) : (pivot_sum == pivot_namespace_sum ? 1 : 0), "pivot_call_result_sum")
pivot_avg = ta.pivot_point_levels("Traditional", true, true).avg()
pivot_namespace_avg = array.avg(ta.pivot_point_levels("Traditional", true, true))
plot(na(pivot_namespace_avg) ? (na(pivot_avg) ? 1 : 0) : (pivot_avg == pivot_namespace_avg ? 1 : 0), "pivot_call_result_avg")
pivot_range = ta.pivot_point_levels("Traditional", true, true).range()
pivot_namespace_range = array.range(ta.pivot_point_levels("Traditional", true, true))
plot(na(pivot_namespace_range) ? (na(pivot_range) ? 1 : 0) : (pivot_range == pivot_namespace_range ? 1 : 0), "pivot_call_result_range")

pivot_state_size = ta.pivot_point_levels("Traditional", bar_index == 2).size()
pivot_state_first = ta.pivot_point_levels("Traditional", bar_index == 2).first()
pivot_state_copy_first = ta.pivot_point_levels("Traditional", bar_index == 2).copy().first()
pivot_developing_last = ta.pivot_point_levels("Traditional", bar_index == 2, true).last()
plot(na(pivot_state_first) ? 1 : 0, "pivot_before_anchor_first_is_na")
plot(pivot_state_size, "pivot_state_size")
plot(pivot_state_first, "pivot_state_first")
plot(pivot_state_copy_first, "pivot_state_copy_first")
plot(pivot_developing_last, "pivot_developing_last")

float_matrix = matrix.new<float>(1, 2, 0.0)
float_matrix.set(0, 0, 1.5)
float_matrix.set(0, 1, 2.5)
int_matrix = matrix.new<int>(1, 2, 0)
int_matrix.set(0, 0, 10)
int_matrix.set(0, 1, 20)
bool_matrix = matrix.new<bool>(1, 2, false)
bool_matrix.set(0, 1, true)
string_matrix = matrix.new<string>(1, 2, "")
string_matrix.set(0, 0, "left")
string_matrix.set(0, 1, "right")
color_matrix = matrix.new<color>(1, 2, color.black)
color_matrix.set(0, 0, color.red)
color_matrix.set(0, 1, color.blue)

float float_row_first = matrix.row(float_matrix, 0).first()
float float_col_last = matrix.col(float_matrix, 1).last()
int int_row_last = matrix.row(int_matrix, 0).last()
int int_col_first = matrix.col(int_matrix, 0).first()
bool bool_row_last = matrix.row(bool_matrix, 0).last()
bool bool_col_first = matrix.col(bool_matrix, 1).first()
string string_row_get = matrix.row(string_matrix, 0).get(1)
string string_col_first = matrix.col(string_matrix, 0).first()
color color_row_first = matrix.row(color_matrix, 0).first()
color color_col_last = matrix.col(color_matrix, 1).last()
matrix_row_copy = matrix.row(float_matrix, 0).copy()
matrix_row_copy.set(0, 99.0)
plot(float_row_first, "matrix_float_row")
plot(float_col_last, "matrix_float_col")
plot(int_row_last, "matrix_int_row")
plot(int_col_first, "matrix_int_col")
plot(bool_row_last ? 1 : 0, "matrix_bool_row")
plot(bool_col_first ? 1 : 0, "matrix_bool_col")
plot(string_row_get == "right" ? 1 : 0, "matrix_string_row")
plot(string_col_first == "left" ? 1 : 0, "matrix_string_col")
plot(color_row_first == color.red ? 1 : 0, "matrix_color_row")
plot(color_col_last == color.blue ? 1 : 0, "matrix_color_col")
plot(matrix.get(float_matrix, 0, 0), "matrix_row_copy_independent")
plot(matrix.row(float_matrix, 0).includes(1.5) and matrix.col(int_matrix, 0).includes(10) and matrix.row(bool_matrix, 0).includes(true) and matrix.col(string_matrix, 0).includes("left") and matrix.row(color_matrix, 0).includes(color.blue) ? 1 : 0, "matrix_row_col_includes")
plot(matrix.row(float_matrix, 0).indexof(1.5) == 0 and matrix.col(int_matrix, 0).indexof(10) == 0 and matrix.row(bool_matrix, 0).indexof(true) == 1 and matrix.col(string_matrix, 0).indexof("left") == 0 and matrix.row(color_matrix, 0).indexof(color.blue) == 1 ? 1 : 0, "matrix_row_col_indexof")
plot(matrix.row(float_matrix, 0).lastindexof(1.5) == 0 and matrix.col(int_matrix, 0).lastindexof(10) == 0 and matrix.row(bool_matrix, 0).lastindexof(true) == 1 and matrix.col(string_matrix, 0).lastindexof("left") == 0 and matrix.row(color_matrix, 0).lastindexof(color.blue) == 1 ? 1 : 0, "matrix_row_col_lastindexof")
plot(matrix.row(float_matrix, 0).copy().binary_search(2.5) == 1 and matrix.row(int_matrix, 0).binary_search(10) == 0 ? 1 : 0, "matrix_row_binary_search")
plot(matrix.row(float_matrix, 0).copy().binary_search_leftmost(2.0) == 0 and matrix.row(int_matrix, 0).binary_search_leftmost(15) == 0 ? 1 : 0, "matrix_row_binary_search_leftmost")
plot(matrix.row(float_matrix, 0).copy().binary_search_rightmost(2.0) == 1 and matrix.row(int_matrix, 0).binary_search_rightmost(15) == 1 ? 1 : 0, "matrix_row_binary_search_rightmost")
plot(matrix.row(float_matrix, 0).abs().copy().last() == 2.5 and matrix.col(int_matrix, 0).abs().first() == 10 ? 1 : 0, "matrix_row_col_call_result_abs")
plot(matrix.row(float_matrix, 0).min(nth=1) == 2.5 and matrix.row(int_matrix, 0).min() == 10 ? 1 : 0, "matrix_row_col_call_result_min")
plot(matrix.row(float_matrix, 0).max(nth=1) == 1.5 and matrix.row(int_matrix, 0).max() == 20 ? 1 : 0, "matrix_row_col_call_result_max")
plot(matrix.row(float_matrix, 0).sum() == 4.0 and matrix.row(int_matrix, 0).sum() == 30 ? 1 : 0, "matrix_row_col_call_result_sum")
plot(matrix.row(float_matrix, 0).avg() == 2.0 and matrix.row(int_matrix, 0).avg() == 15.0 ? 1 : 0, "matrix_row_col_call_result_avg")
plot(matrix.row(float_matrix, 0).range() == 1.0 and matrix.row(int_matrix, 0).range() == 10 ? 1 : 0, "matrix_row_col_call_result_range")

matrix<float> na_float_matrix = na
na_cell_matrix = matrix.new<float>(1, 1)
plot(na(matrix.row(na_float_matrix, 0).size()) ? 1 : 0, "matrix_na_row_size")
