float_diagonal.set(1, 1, 3.0)
int_diagonal = matrix.new<int>(2, 2, 0)
int_diagonal.set(0, 0, 4)
int_diagonal.set(1, 1, 5)
int eigen_size = matrix.eigenvalues(float_diagonal).size()
float eigen_first = matrix.eigenvalues(float_diagonal).first()
float eigen_last = matrix.eigenvalues(float_diagonal).last()
float eigen_nested_copy = matrix.eigenvalues(float_diagonal).copy().copy().get(1)
