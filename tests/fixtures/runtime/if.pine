//@version=5
indicator("If")
x = close
if close > open
    x := close
else
    x := open
plot(x)
branch_value = if close > open
    spread = high - low
    spread + close
else
    open + close
plot(branch_value)
branch_loop_value = if close > open
    for i = 0 to 0
        close + 1
else
    for i = 0 to 0
        open + 1
plot(branch_loop_value)
