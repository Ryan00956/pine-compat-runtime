//@version=5
strategy("Exit OCA reduce shares group")
if bar_index == 0
    strategy.entry("L", strategy.long, qty=2)
if bar_index == 1
    strategy.exit("TP", "L", limit=3, qty=1, oca_name="g")
    strategy.exit("SL", "L", stop=3, oca_name="g")
plot(strategy.position_size)
plot(strategy.closedtrades)
plot(strategy.opentrades)
