//@version=6
import user/udt/1 as lib
indicator("Imported UDT array.new")

empty = array.new<lib.Point>()
empty.push(lib.Point.new(open))
empty_first = empty.get(0)

seeded = array.new<lib.Point>(2, lib.Point.new(close))
seeded.set(1, lib.Point.new(high))
seeded_first = seeded.first()
seeded_last = seeded.last()

array<lib.Point> typed = array.new<lib.Point>(1, lib.Point.new(low))
typed_first = typed.get(0)

wrappers = array.new<lib.Wrapper>(1, lib.Wrapper.new(lib.Point.new(close + 10)))
wrapper_first = wrappers.get(0)

mutated = array.new<lib.Point>(1, lib.Point.new(close))
mutated.push(lib.Point.new(close + 10))
array.unshift(mutated, lib.Point.new(close + 20))
mutated.insert(1, lib.Point.new(close + 30))
array.set(mutated, 2, lib.Point.new(close + 40))
mutated_first = mutated.first()
mutated_second = array.get(mutated, 1)
mutated_third = mutated.get(2)
mutated_last = array.last(mutated)

filled = array.new<lib.Point>(3, lib.Point.new(close))
filled.fill(lib.Point.new(close + 50), 1, 3)
filled_first = array.get(filled, 0)
filled_third = filled.get(2)

returned = array.new<lib.Point>(3, lib.Point.new(close))
returned.set(1, lib.Point.new(close + 60))
returned.set(2, lib.Point.new(close + 70))
popped = array.pop(returned)
shifted = returned.shift()
returned.push(lib.Point.new(close + 80))
removed = array.remove(returned, 1)

copied_source = array.new<lib.Point>(2, lib.Point.new(close + 90))
copied_source.set(1, lib.Point.new(close + 100))
copied = copied_source.copy()
copied_source.clear()
copied_reader = array.get(copied, 1)

reversed = array.new<lib.Point>(2, lib.Point.new(close + 110))
reversed.set(1, lib.Point.new(close + 120))
array.reverse(reversed)
reversed_first = reversed.get(0)

slice_source = array.new<lib.Point>(3, lib.Point.new(close + 130))
slice_source.set(1, lib.Point.new(close + 140))
slice_source.set(2, lib.Point.new(close + 150))
slice_window = slice_source.slice(1, 3)
slice_first = array.get(slice_window, 0)

concat_left = array.new<lib.Point>(1, lib.Point.new(close + 160))
concat_right = array.new<lib.Point>(2, lib.Point.new(close + 170))
concat_right.set(1, lib.Point.new(close + 180))
concat_returned = concat_left.concat(concat_right)
concat_reader = concat_returned.get(2)

search_points = array.new<lib.Point>(3, lib.Point.new(close))
search_points.set(1, lib.Point.new(close + 1))
search_same = lib.Point.new(close)
search_missing = lib.Point.new(close + 999)
includes_found = array.includes(search_points, search_same) ? 1 : 1000
includes_missing = search_points.includes(search_missing) ? 1000 : 2
index_found = search_points.indexof(search_same)
index_missing = array.indexof(search_points, search_missing) == -1 ? 3 : 1000
last_index_found = array.lastindexof(search_points, search_same)
last_index_missing = search_points.lastindexof(search_missing) == -1 ? 4 : 1000

join_points = array.new<lib.Point>(2, lib.Point.new(1.25))
join_points.set(1, lib.Point.new(2.5))
joined = array.join(join_points, "|") == "Point(1.25)|Point(2.5)" ? 1 : 0
method_joined = join_points.join() == "Point(1.25),Point(2.5)" ? 1 : 0

sort_points = array.new<lib.Point>(3, lib.Point.new(close + 3))
sort_points.set(1, lib.Point.new(close + 1))
sort_points.set(2, lib.Point.new(close + 2))
array.sort(sort_points, order.ascending, "x")
sort_first = sort_points.get(0)
method_sort_points = array.new<lib.Point>(3, lib.Point.new(close + 1))
method_sort_points.set(1, lib.Point.new(close + 3))
method_sort_points.set(2, lib.Point.new(close + 2))
method_sort_points.sort(order.descending, "x")
method_sort_first = array.get(method_sort_points, 0)
sort_index_points = array.new<lib.Point>(3, lib.Point.new(close + 2))
sort_index_points.set(1, lib.Point.new(close + 3))
sort_index_points.set(2, lib.Point.new(close + 1))
sort_indices = array.sort_indices(sort_index_points, order.ascending, "x")
method_sort_index_points = array.new<lib.Point>(3, lib.Point.new(close + 2))
method_sort_index_points.set(1, lib.Point.new(close + 3))
method_sort_index_points.set(2, lib.Point.new(close + 1))
method_sort_indices = method_sort_index_points.sort_indices(order.descending, "x")

cleared = array.new<lib.Point>(2, lib.Point.new(close))
array.clear(cleared)
method_cleared = array.new<lib.Point>(2, lib.Point.new(close))
method_cleared.clear()

plot(empty.size())
plot(empty_first.x)
plot(seeded.size())
plot(seeded_first.x)
plot(seeded_last.x)
plot(typed_first.x)
plot(wrapper_first.nested.x)
plot(mutated_first.x + mutated_second.x + mutated_third.x + mutated_last.x + mutated.size())
plot(filled_first.x + filled_third.x + filled.size())
plot(popped.x + shifted.x + removed.x + returned.size())
plot(copied_reader.x + copied_source.size() + copied.size())
plot(reversed_first.x + slice_first.x + concat_reader.x + concat_returned.size())
plot(includes_found + includes_missing + index_found + index_missing + last_index_found + last_index_missing)
plot(joined + method_joined)
plot(sort_first.x + method_sort_first.x + sort_indices.get(0) + array.get(sort_indices, 1) + sort_indices.get(2) + method_sort_indices.get(0) + array.get(method_sort_indices, 1) + method_sort_indices.get(2))
plot(cleared.size() + method_cleared.size())
