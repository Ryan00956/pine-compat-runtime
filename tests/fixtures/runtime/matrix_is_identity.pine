//@version=6
indicator("Matrix is_identity")

identity = matrix.new<float>(2, 2, 0)
matrix.set(identity, 0, 0, 1)
matrix.set(identity, 1, 1, 1)
rectangular = matrix.new<float>(2, 3, 0)
matrix.set(rectangular, 0, 0, 1)
matrix.set(rectangular, 1, 1, 1)
diagonal_two = matrix.new<float>(2, 2, 0)
matrix.set(diagonal_two, 0, 0, 1)
matrix.set(diagonal_two, 1, 1, 2)
off_diagonal = matrix.copy(identity)
matrix.set(off_diagonal, 0, 1, 1)
diagonal_na = matrix.copy(identity)
matrix.set(diagonal_na, 0, 0, na)
off_diagonal_na = matrix.copy(identity)
matrix.set(off_diagonal_na, 0, 1, na)
zero_square = matrix.new<float>(0, 0)

plot(matrix.is_identity(identity) ? 1 : 0, "identity")
plot(rectangular.is_identity() ? 1 : 0, "rectangular")
plot(matrix.is_identity(diagonal_two) ? 1 : 0, "diagonal_two")
plot(off_diagonal.is_identity() ? 1 : 0, "off_diagonal")
plot(matrix.is_identity(diagonal_na) ? 1 : 0, "diagonal_na")
plot(off_diagonal_na.is_identity() ? 1 : 0, "off_diagonal_na")
plot(zero_square.is_identity() ? 1 : 0, "zero_square")
