//@version=6
indicator("Matrix row/column loop read")

values = matrix.new<float>(2, 2, 0)
matrix.set(values, 0, 0, close + 1)
matrix.set(values, 0, 1, close + 10)
matrix.set(values, 1, 0, close + 100)
matrix.set(values, 1, 1, close + 1000)

row_total = close * 0
for i = 0 to 1
    row_values = matrix.row(values, i)
    row_total := row_total + row_values.get(i)

column_total = close * 0
for i = 0 to 1
    column_values = values.col(i)
    column_total := column_total + column_values.get(1 - i)

plot(row_total, "row_total")
plot(column_total, "column_total")
