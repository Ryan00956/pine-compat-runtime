//@version=5
strategy("Cancel shared id pending close and exit")
if bar_index == 0
    strategy.entry("L", strategy.long, qty=1)
if bar_index == 1
    strategy.exit("L", "L", stop=3)
    strategy.close("L")
    strategy.cancel("L")
plot(strategy.position_size)
plot(strategy.opentrades)
plot(strategy.closedtrades)
