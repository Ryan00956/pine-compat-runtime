//@version=5
indicator("For in zero iteration")

empty = array.new_int()
int empty_sum = 1
for value in empty
    empty_sum := empty_sum + value + 100

array<int> missing = na
int missing_sum = 2
for value in missing
    missing_sum := missing_sum + value + 100

plot(empty_sum)
plot(missing_sum)
plot(array.size(empty))
