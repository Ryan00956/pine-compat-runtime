//@version=5
indicator("Line array")
var lines = array.new_line()
if bar_index == 0
    first = line.new(bar_index, low, bar_index + 1, high)
    second = line.copy(first)
    array.push(lines, first)
    array.unshift(lines, second)
    array.insert(lines, 1, first)
    array.remove(lines, -1)
if bar_index == 1
    copied = array.copy(lines)
    saved = array.get(copied, 0)
    array.set(lines, 0, saved)
    line.set_color(saved, color.green)
    line.set_width(array.last(lines), 2)
    line.set_style(array.first(lines), line.style_dashed)
if bar_index == 2
    shifted = array.shift(lines)
    array.push(lines, shifted)
    array.reverse(lines)
    array.fill(lines, array.first(lines), 0, 1)
    sliced = array.slice(lines, 0, 1)
    array.concat(sliced, lines)
    line.set_extend(array.get(sliced, 0), extend.right)
    if array.includes(lines, array.first(lines))
        line.set_color(array.first(lines), color.blue)
    line.set_x2(array.get(lines, array.indexof(lines, array.first(lines))), bar_index + 2)
    line.set_y2(array.get(lines, array.lastindexof(lines, array.last(lines))), close)
if bar_index == 3
    from_values = array.from(array.get(lines, 0))
    line.set_style(from_values.get(0), line.style_dashed)
    popped = array.pop(lines)
    line.set_y1(popped, low)
    array.push(lines, popped)
    scratch = array.copy(lines)
    scratch.clear()
plot(array.size(lines))
plot(close)
