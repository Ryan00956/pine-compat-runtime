//@version=5
indicator("Line array")
var lines = array.new_line()
var line_concat_checks = array.new_bool()
var line_clear_checks = array.new_bool()
if bar_index == 0
    first = line.new(bar_index, low, bar_index + 1, high)
    second = line.copy(first)
    empty_slot = array.new_line(1)
    seeded = array.new_line(2, first)
    if na(empty_slot.get(0)) and seeded.size() == 2
        line.set_color(seeded.get(1), color.red)
    lines.push(first)
    lines.unshift(second)
    lines.insert(1, first)
    lines.remove(-1)
if bar_index == 1
    copied = lines.copy()
    saved = copied.get(0)
    lines.set(0, saved)
    line.set_color(saved, color.green)
    line.set_width(lines.last(), 2)
    line.set_style(lines.first(), line.style_dashed)
if bar_index == 2
    shifted = lines.shift()
    lines.push(shifted)
    lines.reverse()
    lines.fill(lines.first(), 0, 1)
    sliced = lines.slice(0, 1)
    sliced.concat(lines)
    empty_lines = array.new_line()
    before_empty_line_concat = lines.size()
    lines.concat(empty_lines)
    line_concat_checks.push(lines.size() == before_empty_line_concat and empty_lines.size() == 0)
    empty_line_target = array.new_line()
    source_line_size = lines.size()
    source_line_first = lines.get(0)
    empty_line_target.concat(lines)
    line_concat_checks.push(empty_line_target.size() == source_line_size and empty_line_target.get(0) == source_line_first and lines.size() == source_line_size and lines.get(0) == source_line_first)
    line.set_extend(sliced.get(0), extend.right)
    if lines.includes(lines.first())
        line.set_color(lines.first(), color.blue)
    line.set_x2(lines.get(lines.indexof(lines.first())), bar_index + 2)
    line.set_y2(lines.get(lines.lastindexof(lines.last())), close)
if bar_index == 3
    from_values = array.from(lines.get(0))
    line.set_style(from_values.get(0), line.style_dashed)
    popped = lines.pop()
    line.set_y1(popped, low)
    lines.push(popped)
    scratch = lines.copy()
    saved = scratch.get(0)
    scratch.clear()
    line_clear_checks.push(scratch.size() == 0 and lines.size() > 0 and not na(saved))
    scratch.push(saved)
    line.set_x1(scratch.get(0), bar_index)
    line_clear_checks.push(scratch.size() == 1 and lines.size() > 0 and line.get_x1(lines.get(0)) == bar_index)
plot(lines.size())
plot(close)
plot(line_concat_checks.size() == 2 and line_concat_checks.get(0) and line_concat_checks.get(1) ? 1 : 0)
plot(line_clear_checks.size() == 2 and line_clear_checks.get(0) and line_clear_checks.get(1) ? 1 : 0)
