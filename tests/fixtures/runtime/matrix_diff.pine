//@version=6
indicator("Matrix diff")

left = matrix.new<float>(2, 2, 0)
matrix.set(left, 0, 0, 8)
matrix.set(left, 0, 1, 6)
matrix.set(left, 1, 0, 4)
matrix.set(left, 1, 1, 2)

right = matrix.new<float>(2, 2, 0)
matrix.set(right, 0, 0, 1)
matrix.set(right, 0, 1, 2)
matrix.set(right, 1, 0, 3)
matrix.set(right, 1, 1, 4)

namespace_result = matrix.diff(left, right)
method_result = left.diff(right)
matrix.set(left, 0, 0, 99)
scalar_result = matrix.diff(right, 2)
left_scalar_result = matrix.diff(10, right)
scalar_method_result = right.diff(0.5)
scalar_na_result = matrix.diff(right, na)
left_scalar_na_result = matrix.diff(na, right)

na_left = matrix.new<float>(1, 2, 5)
matrix.set(na_left, 0, 1, na)
na_result = matrix.diff(na_left, matrix.new<float>(1, 2, 3))

empty_result = matrix.diff(matrix.new<float>(0, 2), matrix.new<float>(0, 2))

plot(matrix.rows(namespace_result), "namespace_rows")
plot(matrix.columns(namespace_result), "namespace_columns")
plot(matrix.get(namespace_result, 0, 0), "namespace_0_0")
plot(matrix.get(namespace_result, 0, 1), "namespace_0_1")
plot(matrix.get(namespace_result, 1, 0), "namespace_1_0")
plot(matrix.get(namespace_result, 1, 1), "namespace_1_1")
plot(matrix.get(method_result, 0, 0), "method_0_0")
plot(matrix.get(scalar_result, 0, 0), "scalar_0_0")
plot(matrix.get(scalar_result, 1, 1), "scalar_1_1")
plot(matrix.get(left_scalar_result, 0, 0), "left_scalar_0_0")
plot(matrix.get(left_scalar_result, 1, 1), "left_scalar_1_1")
plot(matrix.get(scalar_method_result, 0, 1), "scalar_method_0_1")
plot(na(matrix.get(scalar_na_result, 0, 0)) ? 1 : 0, "scalar_na_0_0")
plot(na(matrix.get(left_scalar_na_result, 0, 0)) ? 1 : 0, "left_scalar_na_0_0")
plot(matrix.get(na_result, 0, 0), "na_result_0_0")
plot(na(matrix.get(na_result, 0, 1)) ? 1 : 0, "na_result_0_1")
plot(matrix.rows(empty_result), "empty_rows")
plot(matrix.columns(empty_result), "empty_columns")
