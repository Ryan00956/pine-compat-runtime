//@version=5
indicator("Inputs")
threshold = input.price(2.5, "Price", minval=0.0, maxval=10.0, step=0.5, tooltip="Trigger", inline="row", group="Inputs", confirm=true, display=display.all)
start = input.time(2, "Start", tooltip="Start time", group="Inputs", confirm=false)
symbol = input.symbol("AAPL", "Symbol", options=["AAPL", "MSFT"], inline="row", group="Inputs")
timeframe = input.timeframe("D", "Timeframe", options=["D", "W"], tooltip="Resolution", display=display.none)
session = input.session("0930-1600", "Session", options=["0930-1600", "24x7"], tooltip="Trading hours", inline="row", group="Inputs")
notes = input.text_area("Plan", "Notes", tooltip="Long-form note", group="Inputs", confirm=false, display=display.all)

enabled = time >= start and symbol == "AAPL" and timeframe == "D" and session == "0930-1600" and notes == "Plan"
plot(enabled ? math.max(close, threshold) : 0)
