//@version=5
strategy("Strategy close_all")

if bar_index == 0
    strategy.close_all()
    strategy.entry("L", strategy.long, qty=2)

if bar_index == 2
    strategy.close_all()

if bar_index == 3
    strategy.close_all()

plot(strategy.position_size)
plot(strategy.closedtrades)
plot(strategy.opentrades)
