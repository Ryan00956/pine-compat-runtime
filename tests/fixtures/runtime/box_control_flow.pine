//@version=5
indicator("Box control flow")
var box_id = box.new(bar_index, high, bar_index, low)
var left_box = box.new(bar_index - 1, high + 1, bar_index, low - 1)
var top_box = box.new(bar_index - 2, high + 2, bar_index, low - 2)
if bar_index == 1
    left_i = 0
    while left_i < 1
        box.set_left(box_id, bar_index)
        left_i := left_i + 1
    top_i = 0
    while top_i < 1
        box.set_top(box_id, close + 10)
        top_i := top_i + 1
    right_i = 0
    while right_i < 1
        box.set_right(box_id, bar_index + 2)
        right_i := right_i + 1
    bottom_i = 0
    while bottom_i < 1
        box.set_bottom(box_id, close - 10)
        bottom_i := bottom_i + 1
    lefttop_i = 0
    while lefttop_i < 1
        box.set_lefttop(box_id, bar_index + 1, close + 20)
        lefttop_i := lefttop_i + 1
    rightbottom_i = 0
    while rightbottom_i < 1
        box.set_rightbottom(box_id, bar_index + 4, close - 20)
        rightbottom_i := rightbottom_i + 1
if bar_index == 2
    independent_left_i = 0
    while independent_left_i < 1
        box.set_left(left_box, bar_index - 2)
        independent_left_i := independent_left_i + 1
    independent_top_i = 0
    while independent_top_i < 1
        box.set_top(top_box, close + 30)
        independent_top_i := independent_top_i + 1
direction = close > open ? 1 : -1
bg_i = 0
while bg_i < 1
    if direction == 1
        box.set_bgcolor(box_id, color.green)
    else
        box.set_bgcolor(box_id, color.red)
    bg_i := bg_i + 1
border_color_i = 0
while border_color_i < 1
    if direction == 1
        box.set_border_color(box_id, color.white)
    else
        box.set_border_color(box_id, color.black)
    border_color_i := border_color_i + 1
border_width_i = 0
while border_width_i < 1
    if bar_index == 2
        box.set_border_width(box_id, 2)
    border_width_i := border_width_i + 1
border_style_i = 0
while border_style_i < 1
    if bar_index == 3
        box.set_border_style(box_id, line.style_dashed)
    border_style_i := border_style_i + 1
extend_i = 0
while extend_i < 1
    if bar_index == 3
        box.set_extend(box_id, extend.right)
    extend_i := extend_i + 1
xloc_i = 0
while xloc_i < 1
    if bar_index == 3
        box.set_xloc(box_id, bar_index - 2, bar_index + 3, xloc.bar_index)
    xloc_i := xloc_i + 1
text_i = 0
while text_i < 1
    if bar_index == 3
        box.set_text(box_id, "flow box")
    text_i := text_i + 1
text_color_i = 0
while text_color_i < 1
    if bar_index == 3
        box.set_text_color(box_id, color.white)
    text_color_i := text_color_i + 1
text_size_i = 0
while text_size_i < 1
    if bar_index == 3
        box.set_text_size(box_id, size.small)
    text_size_i := text_size_i + 1
text_halign_i = 0
while text_halign_i < 1
    if bar_index == 3
        box.set_text_halign(box_id, text.align_left)
    text_halign_i := text_halign_i + 1
text_valign_i = 0
while text_valign_i < 1
    if bar_index == 3
        box.set_text_valign(box_id, text.align_top)
    text_valign_i := text_valign_i + 1
text_wrap_i = 0
while text_wrap_i < 1
    if bar_index == 3
        box.set_text_wrap(box_id, text.wrap_auto)
    text_wrap_i := text_wrap_i + 1
text_font_family_i = 0
while text_font_family_i < 1
    if bar_index == 3
        box.set_text_font_family(box_id, font.family_monospace)
    text_font_family_i := text_font_family_i + 1
text_formatting_i = 0
while text_formatting_i < 1
    if bar_index == 3
        box.set_text_formatting(box_id, text.format_bold + text.format_italic)
    text_formatting_i := text_formatting_i + 1
delete_i = 0
while delete_i < 1
    if bar_index == 3
        box.delete(box_id)
    delete_i := delete_i + 1
plot(close)
