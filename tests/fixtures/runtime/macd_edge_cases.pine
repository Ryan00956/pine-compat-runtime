//@version=5
indicator("MACD Edge Cases")
missing_source = bar_index == 2 ? na : close
[macd, signal, hist] = ta.macd(close, 2, 3, 2)
[invalid_fast, invalid_fast_signal, invalid_fast_hist] = ta.macd(close, 0, 3, 2)
[invalid_slow, invalid_slow_signal, invalid_slow_hist] = ta.macd(close, 2, -1, 2)
[invalid_signal, invalid_signal_line, invalid_signal_hist] = ta.macd(close, 2, 3, 0)
[missing_fast, missing_fast_signal, missing_fast_hist] = ta.macd(close, na, 3, 2)
[missing_slow, missing_slow_signal, missing_slow_hist] = ta.macd(close, 2, na, 2)
[missing_signal_length, missing_signal_length_line, missing_signal_length_hist] = ta.macd(close, 2, 3, na)
[missing_macd, missing_signal, missing_hist] = ta.macd(missing_source, 2, 3, 2)
plot(macd)
plot(signal)
plot(hist)
plot(invalid_fast)
plot(invalid_fast_signal)
plot(invalid_fast_hist)
plot(invalid_slow)
plot(invalid_slow_signal)
plot(invalid_slow_hist)
plot(invalid_signal)
plot(invalid_signal_line)
plot(invalid_signal_hist)
plot(missing_fast)
plot(missing_fast_signal)
plot(missing_fast_hist)
plot(missing_slow)
plot(missing_slow_signal)
plot(missing_slow_hist)
plot(missing_signal_length)
plot(missing_signal_length_line)
plot(missing_signal_length_hist)
plot(missing_macd)
plot(missing_signal)
plot(missing_hist)
