//@version=5
indicator("MACD Edge Cases")
missing_source = bar_index == 2 ? na : close
[macd, signal, hist] = ta.macd(close, 2, 3, 2)
[invalid_fast, invalid_fast_signal, invalid_fast_hist] = ta.macd(close, 0, 3, 2)
[invalid_slow, invalid_slow_signal, invalid_slow_hist] = ta.macd(close, 2, -1, 2)
[invalid_signal, invalid_signal_line, invalid_signal_hist] = ta.macd(close, 2, 3, 0)
[missing_macd, missing_signal, missing_hist] = ta.macd(missing_source, 2, 3, 2)
plot(macd)
plot(signal)
plot(hist)
plot(invalid_fast)
plot(invalid_fast_signal)
plot(invalid_fast_hist)
plot(invalid_slow)
plot(invalid_slow_signal)
plot(invalid_slow_hist)
plot(invalid_signal)
plot(invalid_signal_line)
plot(invalid_signal_hist)
plot(missing_macd)
plot(missing_signal)
plot(missing_hist)
