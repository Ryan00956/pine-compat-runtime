//@version=5
indicator("User type varip")
type Point
    float x
type Wrapper
    Point inner

dyn = bar_index == 0 ? na : 1

varip Point from_na = na
if bar_index == 0
    from_na := Point.new(close)
else
    from_na.x := from_na.x + 1
plot(from_na.x)
from_na_prior = from_na[1]
from_na_dynamic_prior = from_na[dyn]
plot(from_na_prior.x)
plot(from_na_dynamic_prior.x)

varip Point constructed = Point.new(close + 10)
constructed.x := constructed.x + 1
plot(constructed.x)
constructed_prior = constructed[1]
constructed_dynamic_prior = constructed[dyn]
plot(constructed_prior.x)
plot(constructed_dynamic_prior.x)

varip inferred = Point.new(close + 20)
inferred.x := inferred.x + 1
plot(inferred.x)
inferred_prior = inferred[1]
inferred_dynamic_prior = inferred[dyn]
plot(inferred_prior.x)
plot(inferred_dynamic_prior.x)

aliasPointSource = Point.new(close + 25)
varip aliasPoint = aliasPointSource
aliasPoint.x := aliasPoint.x + 1
plot(aliasPoint.x)
aliasPoint_prior = aliasPoint[1]
aliasPoint_dynamic_prior = aliasPoint[dyn]
plot(aliasPoint_prior.x)
plot(aliasPoint_dynamic_prior.x)

varip Point typed_ternary = bar_index == 0 ? Point.new(close + 30) : Point.new(open + 30)
typed_ternary.x := typed_ternary.x + 1
plot(typed_ternary.x)
typed_ternary_prior = typed_ternary[1]
typed_ternary_dynamic_prior = typed_ternary[dyn]
plot(typed_ternary_prior.x)
plot(typed_ternary_dynamic_prior.x)

varip Point typed_switch = switch bar_index
    0 => Point.new(close + 40)
    => Point.new(open + 40)
typed_switch.x := typed_switch.x + 1
plot(typed_switch.x)
typed_switch_prior = typed_switch[1]
typed_switch_dynamic_prior = typed_switch[dyn]
plot(typed_switch_prior.x)
plot(typed_switch_dynamic_prior.x)

varip Point typed_if = if bar_index == 0
    Point.new(close + 50)
else
    Point.new(open + 50)
typed_if.x := typed_if.x + 1
plot(typed_if.x)
typed_if_prior = typed_if[1]
typed_if_dynamic_prior = typed_if[dyn]
plot(typed_if_prior.x)
plot(typed_if_dynamic_prior.x)

varip Point typed_for = for i = 0 to 1
    Point.new(close + 60 + i)
typed_for.x := typed_for.x + 1
plot(typed_for.x)
typed_for_prior = typed_for[1]
typed_for_dynamic_prior = typed_for[dyn]
plot(typed_for_prior.x)
plot(typed_for_dynamic_prior.x)

point_values = array.from(0, 1)
varip Point typed_for_in = for value in point_values
    Point.new(close + 100 + value)
typed_for_in.x := typed_for_in.x + 1
plot(typed_for_in.x)
typed_for_in_prior = typed_for_in[1]
typed_for_in_dynamic_prior = typed_for_in[dyn]
plot(typed_for_in_prior.x)
plot(typed_for_in_dynamic_prior.x)

counter = 0
varip Point typed_while = while counter < 2
    counter := counter + 1
    Point.new(close + 110 + counter)
typed_while.x := typed_while.x + 1
plot(typed_while.x)
typed_while_prior = typed_while[1]
typed_while_dynamic_prior = typed_while[dyn]
plot(typed_while_prior.x)
plot(typed_while_dynamic_prior.x)

varip Wrapper wrapped_ternary = bar_index == 0 ? Wrapper.new(Point.new(close + 120)) : Wrapper.new(Point.new(open + 120))
wrapped_ternary := Wrapper.new(Point.new(wrapped_ternary.inner.x + 1))
plot(wrapped_ternary.inner.x)
wrapped_ternary_prior = wrapped_ternary[1]
wrapped_ternary_dynamic_prior = wrapped_ternary[dyn]
plot(wrapped_ternary_prior.inner.x)
plot(wrapped_ternary_dynamic_prior.inner.x)

varip Wrapper wrapped_switch = switch bar_index
    0 => Wrapper.new(Point.new(close + 130))
    => Wrapper.new(Point.new(open + 130))
wrapped_switch := Wrapper.new(Point.new(wrapped_switch.inner.x + 1))
plot(wrapped_switch.inner.x)
wrapped_switch_prior = wrapped_switch[1]
wrapped_switch_dynamic_prior = wrapped_switch[dyn]
plot(wrapped_switch_prior.inner.x)
plot(wrapped_switch_dynamic_prior.inner.x)

varip Wrapper wrapped_if = if bar_index == 0
    Wrapper.new(Point.new(close + 140))
else
    Wrapper.new(Point.new(open + 140))
wrapped_if := Wrapper.new(Point.new(wrapped_if.inner.x + 1))
plot(wrapped_if.inner.x)
wrapped_if_prior = wrapped_if[1]
wrapped_if_dynamic_prior = wrapped_if[dyn]
plot(wrapped_if_prior.inner.x)
plot(wrapped_if_dynamic_prior.inner.x)

varip Wrapper wrapped_for = for i = 0 to 1
    Wrapper.new(Point.new(close + 150 + i))
wrapped_for := Wrapper.new(Point.new(wrapped_for.inner.x + 1))
plot(wrapped_for.inner.x)
wrapped_for_prior = wrapped_for[1]
wrapped_for_dynamic_prior = wrapped_for[dyn]
plot(wrapped_for_prior.inner.x)
plot(wrapped_for_dynamic_prior.inner.x)

wrapper_values = array.from(Wrapper.new(Point.new(close + 160)), Wrapper.new(Point.new(close + 161)))
varip Wrapper wrapped_for_in = for item in wrapper_values
    item
wrapped_for_in := Wrapper.new(Point.new(wrapped_for_in.inner.x + 1))
plot(wrapped_for_in.inner.x)
wrapped_for_in_prior = wrapped_for_in[1]
wrapped_for_in_dynamic_prior = wrapped_for_in[dyn]
plot(wrapped_for_in_prior.inner.x)
plot(wrapped_for_in_dynamic_prior.inner.x)

wrapped_counter = 0
varip Wrapper wrapped_while = while wrapped_counter < 2
    wrapped_counter := wrapped_counter + 1
    Wrapper.new(Point.new(close + 170 + wrapped_counter))
wrapped_while := Wrapper.new(Point.new(wrapped_while.inner.x + 1))
plot(wrapped_while.inner.x)
wrapped_while_prior = wrapped_while[1]
wrapped_while_dynamic_prior = wrapped_while[dyn]
plot(wrapped_while_prior.inner.x)
plot(wrapped_while_dynamic_prior.inner.x)

varip Wrapper wrapped = Wrapper.new(Point.new(close + 70))
wrapped.inner := Point.new(wrapped.inner.x + 1)
plot(wrapped.inner.x)
wrapped_prior = wrapped[1]
wrapped_dynamic_prior = wrapped[dyn]
plot(wrapped_prior.inner.x)
plot(wrapped_dynamic_prior.inner.x)

varip inferredWrapped = Wrapper.new(Point.new(close + 80))
inferredWrapped := Wrapper.new(Point.new(inferredWrapped.inner.x + 1))
plot(inferredWrapped.inner.x)
inferredWrapped_prior = inferredWrapped[1]
inferredWrapped_dynamic_prior = inferredWrapped[dyn]
plot(inferredWrapped_prior.inner.x)
plot(inferredWrapped_dynamic_prior.inner.x)

aliasSource = Wrapper.new(Point.new(close + 90))
varip aliasWrapped = aliasSource
aliasWrapped.inner := Point.new(aliasWrapped.inner.x + 1)
plot(aliasWrapped.inner.x)
aliasWrapped_prior = aliasWrapped[1]
aliasWrapped_dynamic_prior = aliasWrapped[dyn]
plot(aliasWrapped_prior.inner.x)
plot(aliasWrapped_dynamic_prior.inner.x)
