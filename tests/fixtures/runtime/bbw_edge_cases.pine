//@version=5
indicator("BBW edge cases")
missing_source = bar_index == 1 ? na : close
zero_length = ta.bbw(close, 0, 2)
negative_length = ta.bbw(close, -1, 2)
missing_source_width = ta.bbw(missing_source, 2, 2)
zero_mult = ta.bbw(close, 2, 0)
zero_basis = ta.bbw(close - close, 2, 2)
plot(na(zero_length) ? 1 : 0)
plot(na(negative_length) ? 1 : 0)
plot(missing_source_width)
plot(zero_mult)
plot(na(zero_basis) ? 1 : 0)
