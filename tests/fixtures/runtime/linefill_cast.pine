//@version=5
indicator("Linefill cast")
upper = line.new(bar_index, high, bar_index + 1, high + 1)
lower = line.new(bar_index, low, bar_index + 1, low - 1)
fill_id = linefill.new(upper, lower, color.green)
cast_fill = linefill(fill_id)
missing_fill = linefill(na)
plot(line.get_x1(linefill.get_line1(cast_fill)))
plot(na(missing_fill) ? 1 : 0)
