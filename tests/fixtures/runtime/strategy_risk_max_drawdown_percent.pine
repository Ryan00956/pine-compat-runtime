//@version=5
strategy("Max drawdown percent stop", initial_capital=1000)
strategy.risk.max_drawdown(4, strategy.percent_of_equity)
if bar_index == 0
    strategy.entry("L", strategy.long, qty=10)
if bar_index == 3
    strategy.entry("X", strategy.long, qty=1)
plot(strategy.position_size)
plot(strategy.max_drawdown)
