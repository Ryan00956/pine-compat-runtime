//@version=5
indicator("KCW edge cases")
missing_source = bar_index == 1 ? na : close
zero_length = ta.kcw(close, 0, 2)
negative_length = ta.kcw(close, -1, 2)
missing_source_width = ta.kcw(missing_source, 2, 2)
span_width = ta.kcw(close, 2, 2, false)
na_tr_width = ta.kcw(close, 2, 2, na)
zero_mult = ta.kcw(close, 2, 0)
zero_basis = ta.kcw(close - close, 2, 2)
plot(na(zero_length) ? 1 : 0)
plot(na(negative_length) ? 1 : 0)
plot(missing_source_width)
plot(span_width)
plot(na_tr_width)
plot(zero_mult)
plot(na(zero_basis) ? 1 : 0)
