//@version=5
strategy("Strategy profit state", initial_capital=1000)
identity(value) => value
plot(strategy.openprofit)
plot(strategy.netprofit)
plot(strategy.equity)
plot(strategy.max_runup)
plot(strategy.max_runup_percent)
plot(strategy.max_drawdown)
plot(strategy.max_drawdown_percent)
independent_openprofit = strategy.openprofit * 0
openprofit_i = 0
while openprofit_i < 1
    independent_openprofit := strategy.openprofit
    openprofit_i := openprofit_i + 1
plot(independent_openprofit)
if bar_index == 1
    strategy.entry("L", strategy.long, qty=2)
if bar_index == 3
    strategy.close("L")
if bar_index == 4
    strategy.entry("L2", strategy.long, qty=1)
if bar_index == 5
    strategy.close("L2")
plot(strategy.openprofit)
plot(strategy.netprofit)
plot(identity(strategy.netprofit))
plot(strategy.equity)
plot(strategy.max_runup)
plot(strategy.max_runup_percent)
plot(strategy.max_drawdown)
plot(strategy.max_drawdown_percent)
independent_netprofit = strategy.netprofit * 0
netprofit_i = 0
while netprofit_i < 1
    independent_netprofit := strategy.netprofit
    netprofit_i := netprofit_i + 1
plot(independent_netprofit)
independent_max_drawdown = strategy.max_drawdown * 0
max_drawdown_i = 0
while max_drawdown_i < 1
    independent_max_drawdown := strategy.max_drawdown
    max_drawdown_i := max_drawdown_i + 1
plot(independent_max_drawdown)
independent_equity = strategy.equity * 0
equity_i = 0
while equity_i < 1
    independent_equity := strategy.equity
    equity_i := equity_i + 1
plot(independent_equity)
plot(identity(strategy.max_drawdown))
plot(identity(strategy.equity))
plot(strategy.netprofit[1])
plot(strategy.equity[1])
plot(strategy.max_drawdown[1])
plot(strategy.initial_capital)
plot(identity(strategy.initial_capital))
plot(strategy.initial_capital[1])
