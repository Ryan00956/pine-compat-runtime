//@version=6
indicator("Matrix is_symmetric")

symmetric = matrix.new<float>(3, 3, 0)
matrix.set(symmetric, 0, 2, close)
matrix.set(symmetric, 2, 0, close)
rectangular = matrix.new<float>(2, 3, 0)
non_symmetric = matrix.new<float>(2, 2, 0)
matrix.set(non_symmetric, 0, 1, 1)
matrix.set(non_symmetric, 1, 0, 2)
diagonal_na = matrix.new<float>(2, 2, 0)
matrix.set(diagonal_na, 0, 0, na)
mirror_na = matrix.new<float>(2, 2, 0)
matrix.set(mirror_na, 0, 1, 3)
matrix.set(mirror_na, 1, 0, na)
zero_square = matrix.new<float>(0, 0)

plot(matrix.is_symmetric(symmetric) ? 1 : 0, "symmetric")
plot(rectangular.is_symmetric() ? 1 : 0, "rectangular")
plot(matrix.is_symmetric(non_symmetric) ? 1 : 0, "non_symmetric")
plot(diagonal_na.is_symmetric() ? 1 : 0, "diagonal_na")
plot(matrix.is_symmetric(mirror_na) ? 1 : 0, "mirror_na")
plot(zero_square.is_symmetric() ? 1 : 0, "zero_square")
