//@version=5
strategy("Exit reservation qty trailing clamp")
if bar_index == 0
    strategy.entry("L", strategy.long, qty=2)
    strategy.exit("XT1", "L", trail_price=2, trail_offset=50, qty=1.5)
    strategy.exit("XT2", "L", trail_price=2, trail_offset=60, qty=1)
plot(strategy.position_size)
plot(strategy.netprofit)
