//@version=5
indicator("Linefill getters")
var upper = line.new(bar_index, high, bar_index + 1, high + 1, color=color.green)
var lower = line.new(bar_index, low, bar_index + 1, low - 1, color=color.red)
var other = line.new(bar_index, close, bar_index + 1, close)
var channel = linefill.new(upper, lower, color.green)
first = linefill.get_line1(channel)
second = channel.get_line2()
missing_first = linefill.get_line1(na)
missing_second = linefill.get_line2(na)
if bar_index == 1
    replacement = linefill.new(upper, lower, color.blue)
replaced_first = bar_index >= 1 ? linefill.get_line1(channel) : first
other_channel = linefill.new(lower, other, color.new(color.red, 80))
other_second = linefill.get_line2(other_channel)
plot(line.get_x1(first))
plot(line.get_x2(second))
plot(nz(line.get_x1(missing_first), -1))
plot(nz(line.get_x2(missing_second), -1))
plot(nz(line.get_x1(replaced_first), -1))
plot(line.get_x2(other_second))
plot(close)
