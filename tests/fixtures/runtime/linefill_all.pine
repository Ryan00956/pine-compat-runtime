//@version=5
indicator("Linefill all")
var upper = line.new(bar_index, high, bar_index + 1, high + 1, color=color.green)
var lower = line.new(bar_index, low, bar_index + 1, low - 1, color=color.red)
var other = line.new(bar_index, close, bar_index + 1, close)
var channel = linefill.new(upper, lower, color.green)
if bar_index == 1
    replacement = linefill.new(upper, lower, color.blue)
if bar_index == 2
    second = linefill.new(lower, other, color.new(color.red, 80))
fills = linefill.all
visible_count = array.size(fills)
first_fill = array.get(fills, 0)
first_line1 = linefill.get_line1(first_fill)
first_line2 = first_fill.get_line2()
flow_visible_count = visible_count
if bar_index == 2
    i = 0
    while i < 1
        flow_visible_count := array.size(linefill.all)
        i := i + 1
plot(visible_count)
plot(flow_visible_count)
plot(line.get_x1(first_line1))
plot(line.get_x2(first_line2))
plot(close)
