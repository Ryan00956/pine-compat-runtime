//@version=6
indicator("Matrix add_col")

values = matrix.new<float>(2, 1, 1)
matrix.set(values, 1, 0, 6)
insert = array.from(2.0, 3.0)
matrix.add_col(values, 1, insert)
values.add_col(2, array.from(4.0, 5.0))

col_snapshot = matrix.col(values, 1)
array.set(insert, 0, 99.0)

plot(matrix.rows(values), "rows")
plot(matrix.columns(values), "columns")
plot(matrix.get(values, 0, 0), "r0c0")
plot(matrix.get(values, 0, 1), "r0c1")
plot(matrix.get(values, 0, 2), "r0c2")
plot(matrix.get(values, 1, 0), "r1c0")
plot(matrix.get(values, 1, 1), "r1c1")
plot(matrix.get(values, 1, 2), "r1c2")
plot(array.get(col_snapshot, 0), "col_snapshot")
