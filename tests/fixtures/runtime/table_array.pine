//@version=5
indicator("Table array")
var tables = array.new_table()
var table_concat_checks = array.new_bool()
var table_clear_checks = array.new_bool()
if bar_index == 0
    first = table.new(position.top_right, 1, 1)
    second = table.new(position.bottom_left, 1, 1)
    empty_slot = array.new_table(1)
    seeded = array.new_table(2, first)
    if na(empty_slot.get(0)) and seeded.size() == 2
        table.cell(seeded.get(1), 0, 0, "seeded")
    tables.push(first)
    tables.unshift(second)
    tables.insert(1, first)
    tables.remove(-1)
if bar_index == 1
    copied = tables.copy()
    saved = copied.get(0)
    tables.set(0, saved)
    table.cell(saved, 0, 0, "copied")
    table.set_bgcolor(tables.last(), color.green)
    table.set_position(tables.first(), position.middle_center)
if bar_index == 2
    shifted = tables.shift()
    tables.push(shifted)
    tables.reverse()
    tables.fill(tables.first(), 0, 1)
    sliced = tables.slice(0, 1)
    sliced.concat(tables)
    empty_tables = array.new_table()
    before_empty_table_concat = tables.size()
    tables.concat(empty_tables)
    table_concat_checks.push(tables.size() == before_empty_table_concat and empty_tables.size() == 0)
    empty_table_target = array.new_table()
    source_table_size = tables.size()
    source_table_first = tables.get(0)
    empty_table_target.concat(tables)
    table_concat_checks.push(empty_table_target.size() == source_table_size and empty_table_target.get(0) == source_table_first and tables.size() == source_table_size and tables.get(0) == source_table_first)
    table.cell(sliced.get(0), 0, 0, "slice")
    if tables.includes(tables.first())
        table.set_frame_color(tables.first(), color.blue)
    table.set_border_color(tables.get(tables.indexof(tables.first())), color.white)
    table.set_border_width(tables.get(tables.lastindexof(tables.last())), 2)
if bar_index == 3
    from_values = array.from(tables.get(0))
    table.set_frame_width(from_values.get(0), 3)
    popped = tables.pop()
    table.cell(popped, 0, 0, "popped")
    tables.push(popped)
    scratch = tables.copy()
    saved = scratch.get(0)
    scratch.clear()
    table_clear_checks.push(scratch.size() == 0 and tables.size() > 0 and not na(saved))
    scratch.push(saved)
    table.cell(scratch.get(0), 0, 0, "cleared")
    table_clear_checks.push(scratch.size() == 1 and tables.size() > 0 and scratch.get(0) == tables.get(0))
plot(tables.size())
plot(close)
plot(table_concat_checks.size() == 2 and table_concat_checks.get(0) and table_concat_checks.get(1) ? 1 : 0)
plot(table_clear_checks.size() == 2 and table_clear_checks.get(0) and table_clear_checks.get(1) ? 1 : 0)
