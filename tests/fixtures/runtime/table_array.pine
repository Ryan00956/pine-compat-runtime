//@version=5
indicator("Table array")
var tables = array.new_table()
if bar_index == 0
    first = table.new(position.top_right, 1, 1)
    second = table.new(position.bottom_left, 1, 1)
    array.push(tables, first)
    array.unshift(tables, second)
    array.insert(tables, 1, first)
    array.remove(tables, -1)
if bar_index == 1
    copied = array.copy(tables)
    saved = array.get(copied, 0)
    array.set(tables, 0, saved)
    table.cell(saved, 0, 0, "copied")
    table.set_bgcolor(array.last(tables), color.green)
    table.set_position(array.first(tables), position.middle_center)
if bar_index == 2
    shifted = array.shift(tables)
    array.push(tables, shifted)
    array.reverse(tables)
    array.fill(tables, array.first(tables), 0, 1)
    sliced = array.slice(tables, 0, 1)
    array.concat(sliced, tables)
    table.cell(array.get(sliced, 0), 0, 0, "slice")
    if array.includes(tables, array.first(tables))
        table.set_frame_color(array.first(tables), color.blue)
    table.set_border_color(array.get(tables, array.indexof(tables, array.first(tables))), color.white)
    table.set_border_width(array.get(tables, array.lastindexof(tables, array.last(tables))), 2)
if bar_index == 3
    from_values = array.from(array.get(tables, 0))
    table.set_frame_width(from_values.get(0), 3)
    popped = array.pop(tables)
    table.cell(popped, 0, 0, "popped")
    array.push(tables, popped)
    scratch = array.copy(tables)
    scratch.clear()
plot(array.size(tables))
plot(close)
