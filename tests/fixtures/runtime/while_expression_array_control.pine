//@version=5
indicator("While expression array control")

continue_i = 0
continue_items = while continue_i < 3
    continue_i := continue_i + 1
    if continue_i == 2
        continue
    array.from(close + continue_i, continue_i)

break_i = 0
break_items = while break_i < 3
    break_i := break_i + 1
    if break_i == 3
        break
    array.from(close + break_i, break_i)

plot(continue_items.get(0), "continue_current")
plot(continue_items.get(1), "continue_index")
plot(break_items.get(0), "break_current")
plot(break_items.get(1), "break_index")
