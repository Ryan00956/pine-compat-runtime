//@version=5
indicator("Table control flow")
var table_id = table.new(position.top_right, 2, 2)
var position_table = table.new(position.top_left, 1, 1)
var bgcolor_table = table.new(position.middle_left, 1, 1)
var frame_color_table = table.new(position.middle_right, 1, 1)
var frame_width_table = table.new(position.bottom_center, 1, 1)
var border_color_table = table.new(position.top_center, 1, 1)
var border_width_table = table.new(position.middle_center, 1, 1)
var independent_cell_table = table.new(position.top_left, 1, 1)
if bar_index == 1
    table.cell(table_id, 0, 0, "if")
direction = close > open ? 1 : -1
switch direction
    1 => table.cell(table_id, 1, 0, "up", bgcolor=color.green)
    => table.cell(table_id, 1, 0, "down", bgcolor=color.red)
for i = 0 to 0
    if bar_index == 2
        table.cell(table_id, 0, 1, "for")
if bar_index == 2
    independent_position_i = 0
    while independent_position_i < 1
        table.set_position(position_table, position.bottom_left)
        independent_position_i := independent_position_i + 1
    independent_bgcolor_i = 0
    while independent_bgcolor_i < 1
        table.set_bgcolor(bgcolor_table, color.blue)
        independent_bgcolor_i := independent_bgcolor_i + 1
    independent_frame_color_i = 0
    while independent_frame_color_i < 1
        table.set_frame_color(frame_color_table, color.white)
        independent_frame_color_i := independent_frame_color_i + 1
    independent_frame_width_i = 0
    while independent_frame_width_i < 1
        table.set_frame_width(frame_width_table, 5)
        independent_frame_width_i := independent_frame_width_i + 1
    independent_border_color_i = 0
    while independent_border_color_i < 1
        table.set_border_color(border_color_table, color.red)
        independent_border_color_i := independent_border_color_i + 1
    independent_border_width_i = 0
    while independent_border_width_i < 1
        table.set_border_width(border_width_table, 6)
        independent_border_width_i := independent_border_width_i + 1
    independent_cell_i = 0
    while independent_cell_i < 1
        table.cell(independent_cell_table, 0, 0, "independent")
        independent_cell_i := independent_cell_i + 1
cell_i = 0
while cell_i < 1
    if bar_index == 3
        table.cell(table_id, 1, 1, "while", text_color=color.white)
    cell_i := cell_i + 1
plot(close)
position_i = 0
while position_i < 1
    if bar_index == 3
        table.set_position(table_id, position.bottom_right)
    position_i := position_i + 1
bgcolor_i = 0
while bgcolor_i < 1
    if bar_index == 3
        table.set_bgcolor(table_id, color.yellow)
    bgcolor_i := bgcolor_i + 1
frame_color_i = 0
while frame_color_i < 1
    if bar_index == 3
        table.set_frame_color(table_id, color.black)
    frame_color_i := frame_color_i + 1
frame_width_i = 0
while frame_width_i < 1
    if bar_index == 3
        table.set_frame_width(table_id, 3)
    frame_width_i := frame_width_i + 1
border_color_i = 0
while border_color_i < 1
    if bar_index == 3
        table.set_border_color(table_id, color.white)
    border_color_i := border_color_i + 1
border_width_i = 0
while border_width_i < 1
    if bar_index == 3
        table.set_border_width(table_id, 4)
    border_width_i := border_width_i + 1
