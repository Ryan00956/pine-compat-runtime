//@version=5
indicator("Table control flow")
var table_id = table.new(position.top_right, 2, 2)
if bar_index == 1
    table.cell(table_id, 0, 0, "if")
direction = close > open ? 1 : -1
switch direction
    1 => table.cell(table_id, 1, 0, "up", bgcolor=color.green)
    => table.cell(table_id, 1, 0, "down", bgcolor=color.red)
for i = 0 to 0
    if bar_index == 2
        table.cell(table_id, 0, 1, "for")
cell_i = 0
while cell_i < 1
    if bar_index == 3
        table.cell(table_id, 1, 1, "while", text_color=color.white)
    cell_i := cell_i + 1
plot(close)
position_i = 0
while position_i < 1
    if bar_index == 3
        table.set_position(table_id, position.bottom_right)
    position_i := position_i + 1
bgcolor_i = 0
while bgcolor_i < 1
    if bar_index == 3
        table.set_bgcolor(table_id, color.yellow)
    bgcolor_i := bgcolor_i + 1
frame_color_i = 0
while frame_color_i < 1
    if bar_index == 3
        table.set_frame_color(table_id, color.black)
    frame_color_i := frame_color_i + 1
frame_width_i = 0
while frame_width_i < 1
    if bar_index == 3
        table.set_frame_width(table_id, 3)
    frame_width_i := frame_width_i + 1
k = 0
while k < 1
    if bar_index == 3
        table.set_border_color(table_id, color.white)
        table.set_border_width(table_id, 4)
    k := k + 1
