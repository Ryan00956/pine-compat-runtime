//@version=5
indicator("Table control flow")
var table_id = table.new(position.top_right, 2, 2)
var position_table = table.new(position.top_left, 1, 1)
var bgcolor_table = table.new(position.middle_left, 1, 1)
var frame_color_table = table.new(position.middle_right, 1, 1)
var frame_width_table = table.new(position.bottom_center, 1, 1)
var border_color_table = table.new(position.top_center, 1, 1)
var border_width_table = table.new(position.middle_center, 1, 1)
var independent_cell_table = table.new(position.top_left, 1, 1)
var independent_text_table = table.new(position.bottom_left, 1, 1)
var independent_cell_bgcolor_table = table.new(position.middle_left, 1, 1)
var independent_cell_text_color_table = table.new(position.middle_right, 1, 1)
var independent_cell_width_table = table.new(position.bottom_center, 1, 1)
var independent_cell_height_table = table.new(position.top_center, 1, 1)
var independent_cell_text_size_table = table.new(position.middle_center, 1, 1)
var independent_cell_text_halign_table = table.new(position.bottom_right, 1, 1)
var independent_cell_text_valign_table = table.new(position.top_right, 1, 1)
var independent_cell_text_wrap_table = table.new(position.bottom_left, 1, 1)
var independent_cell_tooltip_table = table.new(position.middle_left, 1, 1)
var independent_cell_text_font_family_table = table.new(position.middle_right, 1, 1)
var independent_cell_text_formatting_table = table.new(position.bottom_center, 1, 1)
var independent_delete_table = table.new(position.top_left, 1, 1)
var independent_clear_table = table.new(position.bottom_right, 1, 1)
var independent_merge_table = table.new(position.middle_center, 2, 1)
if bar_index == 1
    table.cell(table_id, 0, 0, "if")
direction = close > open ? 1 : -1
switch direction
    1 => table.cell(table_id, 1, 0, "up", bgcolor=color.green)
    => table.cell(table_id, 1, 0, "down", bgcolor=color.red)
for i = 0 to 0
    if bar_index == 2
        table.cell(table_id, 0, 1, "for")
if bar_index == 2
    independent_position_i = 0
    while independent_position_i < 1
        table.set_position(position_table, position.bottom_left)
        independent_position_i := independent_position_i + 1
    independent_bgcolor_i = 0
    while independent_bgcolor_i < 1
        table.set_bgcolor(bgcolor_table, color.blue)
        independent_bgcolor_i := independent_bgcolor_i + 1
    independent_frame_color_i = 0
    while independent_frame_color_i < 1
        table.set_frame_color(frame_color_table, color.white)
        independent_frame_color_i := independent_frame_color_i + 1
    independent_frame_width_i = 0
    while independent_frame_width_i < 1
        table.set_frame_width(frame_width_table, 5)
        independent_frame_width_i := independent_frame_width_i + 1
    independent_border_color_i = 0
    while independent_border_color_i < 1
        table.set_border_color(border_color_table, color.red)
        independent_border_color_i := independent_border_color_i + 1
    independent_border_width_i = 0
    while independent_border_width_i < 1
        table.set_border_width(border_width_table, 6)
        independent_border_width_i := independent_border_width_i + 1
    independent_cell_i = 0
    while independent_cell_i < 1
        table.cell(independent_cell_table, 0, 0, "independent")
        independent_cell_i := independent_cell_i + 1
    table.cell(independent_text_table, 0, 0, "seed")
    independent_text_i = 0
    while independent_text_i < 1
        table.cell_set_text(independent_text_table, 0, 0, "loop-text")
        independent_text_i := independent_text_i + 1
    table.cell(independent_cell_bgcolor_table, 0, 0, "bg")
    independent_cell_bgcolor_i = 0
    while independent_cell_bgcolor_i < 1
        table.cell_set_bgcolor(independent_cell_bgcolor_table, 0, 0, color.green)
        independent_cell_bgcolor_i := independent_cell_bgcolor_i + 1
    table.cell(independent_cell_text_color_table, 0, 0, "text-color")
    independent_cell_text_color_i = 0
    while independent_cell_text_color_i < 1
        table.cell_set_text_color(independent_cell_text_color_table, 0, 0, color.red)
        independent_cell_text_color_i := independent_cell_text_color_i + 1
    table.cell(independent_cell_width_table, 0, 0, "width")
    independent_cell_width_i = 0
    while independent_cell_width_i < 1
        table.cell_set_width(independent_cell_width_table, 0, 0, 35)
        independent_cell_width_i := independent_cell_width_i + 1
    table.cell(independent_cell_height_table, 0, 0, "height")
    independent_cell_height_i = 0
    while independent_cell_height_i < 1
        table.cell_set_height(independent_cell_height_table, 0, 0, 40)
        independent_cell_height_i := independent_cell_height_i + 1
    table.cell(independent_cell_text_size_table, 0, 0, "size")
    independent_cell_text_size_i = 0
    while independent_cell_text_size_i < 1
        table.cell_set_text_size(independent_cell_text_size_table, 0, 0, size.large)
        independent_cell_text_size_i := independent_cell_text_size_i + 1
    table.cell(independent_cell_text_halign_table, 0, 0, "halign")
    independent_cell_text_halign_i = 0
    while independent_cell_text_halign_i < 1
        table.cell_set_text_halign(independent_cell_text_halign_table, 0, 0, text.align_right)
        independent_cell_text_halign_i := independent_cell_text_halign_i + 1
    table.cell(independent_cell_text_valign_table, 0, 0, "valign")
    independent_cell_text_valign_i = 0
    while independent_cell_text_valign_i < 1
        table.cell_set_text_valign(independent_cell_text_valign_table, 0, 0, text.align_bottom)
        independent_cell_text_valign_i := independent_cell_text_valign_i + 1
    table.cell(independent_cell_text_wrap_table, 0, 0, "wrap")
    independent_cell_text_wrap_i = 0
    while independent_cell_text_wrap_i < 1
        table.cell_set_text_wrap(independent_cell_text_wrap_table, 0, 0, text.wrap_auto)
        independent_cell_text_wrap_i := independent_cell_text_wrap_i + 1
    table.cell(independent_cell_tooltip_table, 0, 0, "tooltip")
    independent_cell_tooltip_i = 0
    while independent_cell_tooltip_i < 1
        table.cell_set_tooltip(independent_cell_tooltip_table, 0, 0, "loop-tooltip")
        independent_cell_tooltip_i := independent_cell_tooltip_i + 1
    table.cell(independent_cell_text_font_family_table, 0, 0, "font")
    independent_cell_text_font_family_i = 0
    while independent_cell_text_font_family_i < 1
        table.cell_set_text_font_family(independent_cell_text_font_family_table, 0, 0, font.family_monospace)
        independent_cell_text_font_family_i := independent_cell_text_font_family_i + 1
    table.cell(independent_cell_text_formatting_table, 0, 0, "format")
    independent_cell_text_formatting_i = 0
    while independent_cell_text_formatting_i < 1
        table.cell_set_text_formatting(independent_cell_text_formatting_table, 0, 0, text.format_italic)
        independent_cell_text_formatting_i := independent_cell_text_formatting_i + 1
    independent_delete_i = 0
    while independent_delete_i < 1
        table.delete(independent_delete_table)
        independent_delete_i := independent_delete_i + 1
    table.cell(independent_clear_table, 0, 0, "clear")
    independent_clear_i = 0
    while independent_clear_i < 1
        table.clear(independent_clear_table, 0, 0, 0, 0)
        independent_clear_i := independent_clear_i + 1
    table.cell(independent_merge_table, 0, 0, "merge")
    independent_merge_i = 0
    while independent_merge_i < 1
        table.merge_cells(independent_merge_table, 0, 0, 1, 0)
        independent_merge_i := independent_merge_i + 1
cell_i = 0
while cell_i < 1
    if bar_index == 3
        table.cell(table_id, 1, 1, "while", text_color=color.white)
    cell_i := cell_i + 1
independent_all_count = array.size(table.all)
independent_all_i = 0
while independent_all_i < 1
    independent_all_count := array.size(table.all)
    independent_all_i := independent_all_i + 1
plot(independent_all_count)
plot(close)
position_i = 0
while position_i < 1
    if bar_index == 3
        table.set_position(table_id, position.bottom_right)
    position_i := position_i + 1
bgcolor_i = 0
while bgcolor_i < 1
    if bar_index == 3
        table.set_bgcolor(table_id, color.yellow)
    bgcolor_i := bgcolor_i + 1
frame_color_i = 0
while frame_color_i < 1
    if bar_index == 3
        table.set_frame_color(table_id, color.black)
    frame_color_i := frame_color_i + 1
frame_width_i = 0
while frame_width_i < 1
    if bar_index == 3
        table.set_frame_width(table_id, 3)
    frame_width_i := frame_width_i + 1
border_color_i = 0
while border_color_i < 1
    if bar_index == 3
        table.set_border_color(table_id, color.white)
    border_color_i := border_color_i + 1
border_width_i = 0
while border_width_i < 1
    if bar_index == 3
        table.set_border_width(table_id, 4)
    border_width_i := border_width_i + 1
independent_new_i = 0
while independent_new_i < 1
    if bar_index == 3
        table.new(position.bottom_right, 1, 1, bgcolor=color.yellow, frame_color=color.black, frame_width=2, border_color=color.white, border_width=1)
    independent_new_i := independent_new_i + 1
plot(array.size(table.all))
