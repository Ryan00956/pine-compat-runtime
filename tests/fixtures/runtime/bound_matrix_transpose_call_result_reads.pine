//@version=6
indicator("Bound matrix.transpose call-result reads")

transposeRows(id) => id.transpose().rows()

transposeBlockReads(id) =>
    int rows = id.transpose().rows()
    int columns = id.transpose().columns()
    float value = id.transpose().get(1, 0)
    rows * 100 + columns * 10 + value

values = matrix.new<float>(2, 3, 0.0)
values.set(0, 0, 1.0)
values.set(0, 1, 2.0)
values.set(0, 2, 3.0)
values.set(1, 0, 4.0)
values.set(1, 1, 5.0)
values.set(1, 2, 6.0)

transposed = values.transpose().copy()
transposed.set(0, 0, 9.0)

ints = matrix.new<int>(1, 1, 4)
bools = matrix.new<bool>(1, 1, true)
strings = matrix.new<string>(1, 1, "value")
colors = matrix.new<color>(1, 1, color.red)

plot(values.transpose().rows(), "transpose_rows")
plot(values.transpose().columns(), "transpose_columns")
plot(values.transpose().elements_count(), "transpose_elements")
plot(values.transpose().get(2, 1), "transpose_get")
plot(values.transpose().copy().get(1, 0), "transpose_copy_get")
plot(values.transpose().transpose().rows(), "transpose_chain_rows")
plot(values.transpose().transpose().columns(), "transpose_chain_columns")
plot(values.transpose().transpose().get(1, 2), "transpose_chain_get")
plot(values.transpose().copy().transpose().get(1, 2), "transpose_copy_chain_get")
plot(values.get(0, 0), "source_value")
plot(transposed.get(0, 0), "transposed_value")
plot(ints.transpose().get(0, 0), "int_get")
plot(bools.transpose().get(0, 0) ? 1 : 0, "bool_get")
plot(bools.transpose().transpose().get(0, 0) ? 1 : 0, "bool_transpose_chain_get")
plot(strings.transpose().get(0, 0) == "value" ? 1 : 0, "string_get")
plot(colors.transpose().get(0, 0) == color.red ? 1 : 0, "color_get")
plot(transposeRows(values), "expression_udf")
plot(transposeBlockReads(values), "block_udf")
values.transpose().set(0, 0, 102.0)
plot(values.get(0, 0) == 1.0 ? 1 : 0, "call_result_set_source_independent")
values.transpose().fill(302.0)
plot(values.get(0, 0) == 1.0 ? 1 : 0, "call_result_fill_source_independent")
values.transpose().reverse()
plot(values.get(0, 0) == 1.0 ? 1 : 0, "call_result_reverse_source_independent")
values.transpose().reshape(2, 3)
plot(values.rows() == 2 and values.columns() == 3 ? 1 : 0, "call_result_reshape_source_independent")
values.transpose().swap_rows(0, 1)
plot(values.get(0, 0) == 1.0 and values.get(1, 0) == 4.0 ? 1 : 0, "call_result_swap_rows_source_independent")
values.transpose().swap_columns(0, 1)
plot(values.get(0, 0) == 1.0 and values.get(1, 0) == 4.0 ? 1 : 0, "call_result_swap_columns_source_independent")
values.transpose().remove_row(0)
values.transpose().remove_col(0)
plot(values.rows() == 2 and values.get(0, 0) == 1.0 ? 1 : 0, "call_result_remove_row_source_independent")
values.transpose().add_row(0, array.from(7.0, 8.0))
plot(values.rows() == 2 and values.columns() == 3 and values.get(0, 0) == 1.0 ? 1 : 0, "call_result_add_row_source_independent")
values.transpose().add_col(0, array.from(7.0, 8.0, 9.0))
plot(values.rows() == 2 and values.columns() == 3 and values.get(0, 0) == 1.0 ? 1 : 0, "call_result_add_col_source_independent")
