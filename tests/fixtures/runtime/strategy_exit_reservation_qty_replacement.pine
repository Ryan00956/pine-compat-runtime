//@version=5
strategy("Exit reservation qty replacement")
if bar_index == 0
    strategy.entry("L", strategy.long, qty=2)
    strategy.exit("XR1", "L", limit=3, qty=0.5)
    strategy.exit("XR2", "L", limit=2, qty=0.5)
if bar_index == 1
    strategy.exit("XR1", "L", limit=3, qty=1)
plot(strategy.position_size)
plot(strategy.netprofit)
