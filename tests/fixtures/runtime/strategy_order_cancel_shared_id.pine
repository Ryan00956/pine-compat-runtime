//@version=5
strategy("Cancel shared id generic order and exit")
if bar_index == 0
    strategy.entry("L", strategy.long, qty=1)
if bar_index == 1
    strategy.exit("X", from_entry="L", stop=3)
    strategy.order("X", strategy.long, qty=1, limit=3)
    strategy.cancel("X")
plot(strategy.position_size)
plot(strategy.closedtrades)
plot(strategy.opentrades)
