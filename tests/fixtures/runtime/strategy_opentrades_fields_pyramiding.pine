//@version=5
strategy("Open trade fields pyramiding", pyramiding=2)
if bar_index == 0
    strategy.entry("L1", strategy.long, qty=1, comment="first")
if bar_index == 1
    strategy.entry("L2", strategy.long, qty=3, comment="second")

plot(strategy.opentrades)
plot(strategy.opentrades.entry_price(0))
plot(strategy.opentrades.entry_price(1))
plot(na(strategy.opentrades.entry_id(0)) ? na : strategy.opentrades.entry_id(0) == "L1" ? 1 : 0)
plot(na(strategy.opentrades.entry_id(1)) ? na : strategy.opentrades.entry_id(1) == "L2" ? 1 : 0)
plot(na(strategy.opentrades.entry_comment(0)) ? na : strategy.opentrades.entry_comment(0) == "first" ? 1 : 0)
plot(na(strategy.opentrades.entry_comment(1)) ? na : strategy.opentrades.entry_comment(1) == "second" ? 1 : 0)
plot(strategy.opentrades.entry_bar_index(0))
plot(strategy.opentrades.entry_bar_index(1))
plot(strategy.opentrades.entry_time(0))
plot(strategy.opentrades.entry_time(1))
plot(strategy.opentrades.size(0))
plot(strategy.opentrades.size(1))
plot(strategy.opentrades.profit(0))
plot(strategy.opentrades.profit(1))
plot(strategy.opentrades.commission(0))
plot(strategy.opentrades.commission(1))
plot(strategy.opentrades.max_runup(0))
plot(strategy.opentrades.max_runup(1))
plot(strategy.opentrades.max_drawdown(0))
plot(strategy.opentrades.max_drawdown(1))
plot(strategy.opentrades.entry_price(2))
plot(strategy.opentrades.commission(2))
plot(strategy.opentrades.max_runup(2))
plot(strategy.opentrades.max_drawdown(2))
