//@version=5
indicator("Dynamic history scopes", max_bars_back=3)

previous(src, offset) =>
    src[offset]

loop_offset = 0
for i = 0 to 2
    loop_offset := i

first_bar_loop_offset = bar_index == 0 ? 0 : loop_offset

plot(close[loop_offset])
plot(previous(close + open, loop_offset))
plot(previous(close, first_bar_loop_offset))
