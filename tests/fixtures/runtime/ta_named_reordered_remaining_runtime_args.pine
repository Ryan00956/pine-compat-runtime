//@version=5
indicator("TA named reordered remaining runtime args")
dema_value = ta.dema(length=2, source=close)
tema_value = ta.tema(length=2, source=close)
rsi_value = ta.rsi(length=2, source=close)
[macd_line, macd_signal, macd_hist] = ta.macd(siglen=2, slowlen=3, fastlen=2, source=close)
tsi_value = ta.tsi(long_length=3, short_length=2, source=close)
cmo_value = ta.cmo(length=2, source=close)
cci_value = ta.cci(length=3, source=hlc3)
cog_value = ta.cog(length=3, source=close)
cum_value = ta.cum(source=close)
max_value = ta.max(source=high)
min_value = ta.min(source=low)
vwap_value = ta.vwap(source=close)
[vwap_basis, vwap_upper, vwap_lower] = ta.vwap(stdev_mult=2.0, anchor=bar_index == 0, source=close)
mfi_value = ta.mfi(length=3, source=close)
swma_value = ta.swma(source=close)
stoch_value = ta.stoch(length=3, low=low, high=high, source=close)
wpr_value = ta.wpr(length=3)
tr_value = ta.tr(handle_na=false)
atr_value = ta.atr(length=3)
[supertrend_line, supertrend_direction] = ta.supertrend(atrPeriod=3, factor=2)
[plus_di, minus_di, adx] = ta.dmi(adxSmoothing=2, diLength=2)
sar_value = ta.sar(max=0.2, inc=0.02, start=0.02)
plot(dema_value)
plot(tema_value)
plot(rsi_value)
plot(macd_line)
plot(macd_signal)
plot(macd_hist)
plot(tsi_value)
plot(cmo_value)
plot(cci_value)
plot(cog_value)
plot(cum_value)
plot(max_value)
plot(min_value)
plot(vwap_value)
plot(vwap_basis)
plot(vwap_upper)
plot(vwap_lower)
plot(mfi_value)
plot(swma_value)
plot(stoch_value)
plot(wpr_value)
plot(tr_value)
plot(atr_value)
plot(supertrend_line)
plot(supertrend_direction)
plot(plus_di)
plot(minus_di)
plot(adx)
plot(sar_value)
