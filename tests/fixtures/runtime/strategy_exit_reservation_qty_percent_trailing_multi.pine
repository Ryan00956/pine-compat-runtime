//@version=5
strategy("Exit reservation qty percent trailing multi")
if bar_index == 0
    strategy.entry("L", strategy.long, qty=2)
    strategy.exit("XT1", "L", trail_price=2, trail_offset=50, qty_percent=25)
    strategy.exit("XT2", "L", trail_price=2, trail_offset=60, qty_percent=50)
plot(strategy.position_size)
plot(strategy.netprofit)
