//@version=5
indicator("Array join fixture")
ints = array.new_int()
ints.push(1)
ints.push(2)
plot(array.join(ints, "|") == "1|2" ? 1 : 0)

floats = array.new_float()
floats.push(1.25)
floats.push(2.5)
plot(floats.join() == "1.25,2.5" ? 1 : 0)
floats.push(na)
plot(array.join(floats, "|") == "1.25|2.5|NaN" ? 1 : 0)

flags = array.new_bool()
flags.push(false)
flags.push(true)
plot(array.join(flags, "/") == "false/true" ? 1 : 0)

words = array.new_string()
words.push("a")
words.push("b")
plot(words.join("-") == "a-b" ? 1 : 0)
plot(words.join(na) == "a,b" ? 1 : 0)
words.insert(1, "")
plot(words.join("|") == "a||b" ? 1 : 0)

colors = array.new_color()
colors.push(color.red)
colors.push(color.green)
plot(colors.join("|") == "15873605|5025616" ? 1 : 0)

empty = array.new_string()
plot(array.join(empty, "|") == "" ? 1 : 0)
empty_ints = array.new_int()
plot(empty_ints.join("|") == "" ? 1 : 0)
empty_floats = array.new_float()
plot(array.join(empty_floats, "|") == "" ? 1 : 0)
empty_flags = array.new_bool()
plot(empty_flags.join("|") == "" ? 1 : 0)
empty_colors = array.new_color()
plot(array.join(empty_colors, "|") == "" ? 1 : 0)

branch_join_words = array.from("x", "y")
branch_join_results = array.new_string()
if bar_index % 2 == 0
    branch_join_results.push(array.join(branch_join_words, "/"))
else
    branch_join_results.push(branch_join_words.join("|"))
plot((bar_index % 2 == 0 and branch_join_results.get(0) == "x/y") or (bar_index % 2 != 0 and branch_join_results.get(0) == "x|y") ? 1 : 0)

loop_join_values = array.from(1, 2, 3)
loop_join_results = array.new_string()
for i = 0 to 1
    if i == 0
        loop_join_results.push(array.join(loop_join_values, ":"))
    else
        loop_join_results.push(loop_join_values.join())
plot(loop_join_results.get(0) == "1:2:3" and loop_join_results.get(1) == "1,2,3" ? 1 : 0)

independent_join_values = array.from("left", "right")
independent_join_results = array.new_string()
independent_join_i = 0
while independent_join_i < 1
    independent_join_results.push(array.join(independent_join_values, "-"))
    independent_join_i := independent_join_i + 1
plot(independent_join_results.get(0) == "left-right" ? 1 : 0)
