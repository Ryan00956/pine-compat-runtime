//@version=6
indicator("Matrix pow")

values = matrix.new<float>(2, 2, 0)
matrix.set(values, 0, 0, 1)
matrix.set(values, 0, 1, 2)
matrix.set(values, 1, 0, 3)
matrix.set(values, 1, 1, 4)

namespace_square = matrix.pow(values, 2)
method_cube = values.pow(3)
identity = matrix.pow(values, 0)
copy = matrix.pow(values, 1)
matrix.set(values, 0, 0, 99)

na_values = matrix.new<float>(2, 2, 0)
matrix.set(na_values, 0, 0, 5)
matrix.set(na_values, 1, 1, na)
na_square = matrix.pow(na_values, 2)

empty_power = matrix.pow(matrix.new<float>(0, 0), 2)

plot(matrix.get(namespace_square, 0, 0), "square_0_0")
plot(matrix.get(namespace_square, 0, 1), "square_0_1")
plot(matrix.get(namespace_square, 1, 0), "square_1_0")
plot(matrix.get(namespace_square, 1, 1), "square_1_1")
plot(matrix.get(method_cube, 0, 0), "cube_0_0")
plot(matrix.get(method_cube, 0, 1), "cube_0_1")
plot(matrix.get(method_cube, 1, 0), "cube_1_0")
plot(matrix.get(method_cube, 1, 1), "cube_1_1")
plot(matrix.get(identity, 0, 0), "identity_0_0")
plot(matrix.get(identity, 0, 1), "identity_0_1")
plot(matrix.get(copy, 0, 0), "copy_0_0")
plot(na(matrix.get(na_square, 1, 1)) ? 1 : 0, "na_square_1_1")
plot(matrix.rows(empty_power), "empty_rows")
plot(matrix.columns(empty_power), "empty_columns")
