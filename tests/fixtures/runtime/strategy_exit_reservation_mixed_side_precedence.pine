//@version=5
strategy("Exit reservation mixed side precedence")
if bar_index == 0
    strategy.entry("L", strategy.long, qty=2)
    strategy.exit("XS", "L", stop=2.5, qty=0.5)
    strategy.exit("XL", "L", limit=1.5, qty=1.5)
plot(strategy.position_size)
plot(strategy.netprofit)
plot(strategy.closedtrades)
plot(strategy.opentrades)
