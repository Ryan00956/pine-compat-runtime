indicator("request.security same context")

identity = request.security(syminfo.tickerid, timeframe.period, close + open)
history = request.security(syminfo.tickerid, timeframe.period, na(close[1]) ? close : close[1])
sma = request.security(syminfo.tickerid, timeframe.period, ta.sma(close, 2))
ema = request.security(syminfo.tickerid, timeframe.period, ta.ema(close, 2))
max_offset = request.security(syminfo.tickerid, timeframe.period, math.max(close + 1, close - 1) - close)
stateless_math = request.security(syminfo.tickerid, timeframe.period, math.abs(close - 2) + math.floor(math.avg(close, close + 2)) + math.pow(2, 2))
sum_value = request.security(syminfo.tickerid, timeframe.period, math.sum(close, 2))
mintick_round = request.security(syminfo.tickerid, timeframe.period, math.round_to_mintick(close + 0.006))
rsi_value = request.security(syminfo.tickerid, timeframe.period, ta.rsi(close, 3))
atr_value = request.security(syminfo.tickerid, timeframe.period, ta.atr(3))
highest_value = request.security(syminfo.tickerid, timeframe.period, ta.highest(high, 3))
lowest_value = request.security(syminfo.tickerid, timeframe.period, ta.lowest(low, 3))
change_value = request.security(syminfo.tickerid, timeframe.period, ta.change(close))
mom_value = request.security(syminfo.tickerid, timeframe.period, ta.mom(close, 2))
roc_value = request.security(syminfo.tickerid, timeframe.period, ta.roc(close, 2))

plot(identity)
plot(history)
plot(sma)
plot(ema)
plot(max_offset)
plot(stateless_math)
plot(sum_value)
plot(mintick_round)
plot(rsi_value)
plot(atr_value)
plot(highest_value)
plot(lowest_value)
plot(change_value)
plot(mom_value)
plot(roc_value)
