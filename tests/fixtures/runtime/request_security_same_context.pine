indicator("request.security same context")

identity = request.security(syminfo.tickerid, timeframe.period, close + open)
history = request.security(syminfo.tickerid, timeframe.period, na(close[1]) ? close : close[1])
sma = request.security(syminfo.tickerid, timeframe.period, ta.sma(close, 2))
ema = request.security(syminfo.tickerid, timeframe.period, ta.ema(close, 2))
max_offset = request.security(syminfo.tickerid, timeframe.period, math.max(close + 1, close - 1) - close)
stateless_math = request.security(syminfo.tickerid, timeframe.period, math.abs(close - 2) + math.floor(math.avg(close, close + 2)) + math.pow(2, 2))
sum_value = request.security(syminfo.tickerid, timeframe.period, math.sum(close, 2))
mintick_round = request.security(syminfo.tickerid, timeframe.period, math.round_to_mintick(close + 0.006))
rsi_value = request.security(syminfo.tickerid, timeframe.period, ta.rsi(close, 3))
tr_value = request.security(syminfo.tickerid, timeframe.period, ta.tr())
tr_strict = request.security(syminfo.tickerid, timeframe.period, ta.tr(false))
atr_value = request.security(syminfo.tickerid, timeframe.period, ta.atr(3))
highest_value = request.security(syminfo.tickerid, timeframe.period, ta.highest(high, 3))
lowest_value = request.security(syminfo.tickerid, timeframe.period, ta.lowest(low, 3))
change_value = request.security(syminfo.tickerid, timeframe.period, ta.change(close))
mom_value = request.security(syminfo.tickerid, timeframe.period, ta.mom(close, 2))
roc_value = request.security(syminfo.tickerid, timeframe.period, ta.roc(close, 2))
range_value = request.security(syminfo.tickerid, timeframe.period, ta.range(close, 3))
dev_value = request.security(syminfo.tickerid, timeframe.period, ta.dev(close, 3))
rising_value = request.security(syminfo.tickerid, timeframe.period, ta.rising(close, 2) ? 1 : 0)
falling_value = request.security(syminfo.tickerid, timeframe.period, ta.falling(close, 2) ? 1 : 0)
cross_value = request.security(syminfo.tickerid, timeframe.period, ta.cross(close, 2.5) ? 1 : 0)
crossover_value = request.security(syminfo.tickerid, timeframe.period, ta.crossover(close, 2.5) ? 1 : 0)
crossunder_value = request.security(syminfo.tickerid, timeframe.period, ta.crossunder(close - time / 60000.0, 0.5) ? 1 : 0)
cum_value = request.security(syminfo.tickerid, timeframe.period, ta.cum(close))
stdev_value = request.security(syminfo.tickerid, timeframe.period, ta.stdev(close, 3))
stdev_sample = request.security(syminfo.tickerid, timeframe.period, ta.stdev(close, 3, false))
variance_value = request.security(syminfo.tickerid, timeframe.period, ta.variance(close, 3))
variance_sample = request.security(syminfo.tickerid, timeframe.period, ta.variance(close, 3, false))
wma_value = request.security(syminfo.tickerid, timeframe.period, ta.wma(close, 3))
swma_value = request.security(syminfo.tickerid, timeframe.period, ta.swma(close))
hma_value = request.security(syminfo.tickerid, timeframe.period, ta.hma(close, 4))
alma_value = request.security(syminfo.tickerid, timeframe.period, ta.alma(close, 4, 0.85, 6))
linreg_value = request.security(syminfo.tickerid, timeframe.period, ta.linreg(close, 3, 0))

plot(identity)
plot(history)
plot(sma)
plot(ema)
plot(max_offset)
plot(stateless_math)
plot(sum_value)
plot(mintick_round)
plot(rsi_value)
plot(tr_value)
plot(tr_strict)
plot(atr_value)
plot(highest_value)
plot(lowest_value)
plot(change_value)
plot(mom_value)
plot(roc_value)
plot(range_value)
plot(dev_value)
plot(rising_value)
plot(falling_value)
plot(cross_value)
plot(crossover_value)
plot(crossunder_value)
plot(cum_value)
plot(stdev_value)
plot(stdev_sample)
plot(variance_value)
plot(variance_sample)
plot(wma_value)
plot(swma_value)
plot(hma_value)
plot(alma_value)
plot(linreg_value)
