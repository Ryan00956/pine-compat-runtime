//@version=5
indicator("For in mutation")

values = array.from(1, 2, 3)
int sum = 0
for value in values
    if value == 1
        array.set(values, 1, 20)
        array.push(values, 40)
    sum := sum + value

alias_values = array.from(5, 6, 7)
alias_ref = alias_values
int alias_sum = 0
for value in alias_values
    if value == 5
        array.set(alias_ref, 2, 70)
    alias_sum := alias_sum + value

plot(sum)
plot(array.size(values))
plot(array.get(values, 3))
plot(alias_sum)
