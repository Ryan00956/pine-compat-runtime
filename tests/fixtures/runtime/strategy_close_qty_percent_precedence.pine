//@version=5
strategy("Close qty_percent precedence")
if bar_index == 0
    strategy.entry("L", strategy.long, qty=4)
if bar_index == 2
    strategy.close("L", qty_percent=25)
if bar_index == 3
    strategy.close("L", qty=1, qty_percent=90)
plot(strategy.position_size)
plot(strategy.netprofit)
plot(strategy.closedtrades)
plot(strategy.opentrades)
