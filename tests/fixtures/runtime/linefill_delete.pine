//@version=5
indicator("Linefill delete")
var upper = line.new(bar_index, high, bar_index + 1, high + 1, color=color.green)
var middle = line.new(bar_index, close, bar_index + 1, close)
var lower = line.new(bar_index, low, bar_index + 1, low - 1, color=color.red)
var other = line.new(bar_index, close + 1, bar_index + 1, close + 1)
var deleted_fill = linefill.new(upper, middle, color.green)
var loop_fill = linefill.new(middle, lower, color.red)
var independent_fill = linefill.new(lower, other, color.blue)
if bar_index == 1
    linefill.delete(deleted_fill)
if bar_index == 2
    linefill.set_color(deleted_fill, color.yellow)
    linefill.delete(deleted_fill)
if bar_index == 3
    delete_i = 0
    while delete_i < 1
        linefill.delete(loop_fill)
        delete_i := delete_i + 1
independent_delete_i = 0
while independent_delete_i < 1
    if bar_index == 3
        independent_fill.delete()
    independent_delete_i := independent_delete_i + 1
linefill.delete(na)
fills = linefill.all
visible_count = array.size(fills)
deleted_first_x = nz(line.get_x1(linefill.get_line1(deleted_fill)), -1)
plot(visible_count)
plot(deleted_first_x)
plot(close)
