//@version=6
indicator("Builtin array call-result reads")

type First
    float shared
    float other

type Second
    float other
    float shared

noneFirst() =>
    array<First> values = na
    values

noneInts() =>
    array<int> values = na
    values

constructor_sizes = array.new_float(1).size() + array.new_int(1).size() + array.new_bool(1).size() + array.new_string(1).size() + array.new_color(1).size() + array.new_line(1).size() + array.new_linefill(1).size() + array.new_polyline(1).size() + array.new_label(1).size() + array.new_box(1).size() + array.new_table(1).size() + array.new<chart.point>(1).size()
plot(constructor_sizes)
plot(array.new_float(1, 2.0).includes(2) and array.new_int(1, 7).includes(7) and array.new_bool(1, true).includes(true) and array.new_string(1, "pine").includes("pine") and array.new_color(1, color.red).includes(color.red) ? 1 : 0)
plot(array.new_float(1, 2.0).indexof(2) == 0 and array.new_int(1, 7).indexof(7) == 0 and array.new_bool(1, true).indexof(true) == 0 and array.new_string(1, "pine").indexof("pine") == 0 and array.new_color(1, color.red).indexof(color.red) == 0 ? 1 : 0)
plot(array.new_float(2, 2.0).lastindexof(2) == 1 and array.new_int(2, 7).lastindexof(7) == 1 and array.new_bool(2, true).lastindexof(true) == 1 and array.new_string(2, "pine").lastindexof("pine") == 1 and array.new_color(2, color.red).lastindexof(color.red) == 1 ? 1 : 0)
plot(array.new_float(3, 2.0).binary_search(2.0) == 0 and array.new_int(3, 7).binary_search(7) == 0 ? 1 : 0)
plot(array.new_float(3, 2.0).binary_search_leftmost(1.0) == 0 and array.new_int(3, 7).binary_search_leftmost(8) == 2 ? 1 : 0)
plot(array.new_float(3, 2.0).binary_search_rightmost(2.0) == 2 and array.new_int(3, 7).binary_search_rightmost(8) == 2 ? 1 : 0)

first_values = array.from(First.new(10.0, 100.0), First.new(11.0, 110.0))
second_values = array.from(Second.new(200.0, 20.0), Second.new(210.0, 21.0))
copy_size_first = array.copy(first_values).size()
copy_get_second = array.copy(second_values).get(index=0)
copy_first_again = array.copy(first_values).first()
copy_last_second = array.copy(second_values).last()
copy_nested_get = array.copy(first_values).copy().get(index=1)
copy_includes_first = array.copy(first_values).includes(First.new(10.0, 100.0))
copy_includes_second = array.copy(second_values).includes(Second.new(210.0, 21.0))
copy_includes_first_again = array.copy(first_values).copy().includes(First.new(11.0, 110.0))
copy_indexof_first = array.copy(first_values).indexof(First.new(10.0, 100.0))
copy_indexof_second = array.copy(second_values).indexof(Second.new(210.0, 21.0))
copy_indexof_first_again = array.copy(first_values).copy().indexof(First.new(11.0, 110.0))
copy_lastindexof_duplicate = array.copy(array.from(First.new(10.0, 100.0), First.new(11.0, 110.0), First.new(10.0, 100.0))).lastindexof(First.new(10.0, 100.0))
copy_lastindexof_second = array.copy(second_values).copy().lastindexof(Second.new(210.0, 21.0))
plot(copy_size_first)
plot(copy_get_second.shared)
plot(copy_first_again.shared)
plot(copy_last_second.shared)
plot(copy_nested_get.shared)
plot(copy_includes_first and copy_includes_second and copy_includes_first_again ? 1 : 0)
plot(copy_indexof_first == 0 and copy_indexof_second == 1 and copy_indexof_first_again == 1 ? 1 : 0)
plot(copy_lastindexof_duplicate == 2 and copy_lastindexof_second == 1 ? 1 : 0)
plot(array.copy(array.from(1, 2, 3)).copy().binary_search(2) == 1 ? 1 : 0)
plot(array.copy(array.from(1, 3, 3, 5)).copy().binary_search_leftmost(3) == 1 and array.copy(array.from(1, 3, 3, 5)).binary_search_leftmost(4) == 2 ? 1 : 0)
plot(array.copy(array.from(1, 3, 3, 5)).copy().binary_search_rightmost(3) == 2 and array.copy(array.from(1, 3, 3, 5)).binary_search_rightmost(4) == 3 ? 1 : 0)

from_get = array.from(First.new(30.0, 300.0), First.new(31.0, 310.0)).get(index=1)
new_first = array.new<First>(1, First.new(32.0, 320.0)).first()
new_second = array.new<Second>(2, Second.new(330.0, 33.0)).last()
new_first_again = array.new<First>(1, First.new(34.0, 340.0)).copy().last()
from_includes = array.from(First.new(35.0, 350.0)).includes(First.new(35.0, 350.0))
new_includes = array.new<Second>(1, Second.new(360.0, 36.0)).includes(Second.new(360.0, 36.0))
from_indexof = array.from(First.new(35.0, 350.0)).indexof(First.new(35.0, 350.0))
new_indexof = array.new<Second>(1, Second.new(360.0, 36.0)).indexof(Second.new(360.0, 36.0))
from_lastindexof = array.from(First.new(35.0, 350.0), First.new(36.0, 360.0), First.new(35.0, 350.0)).lastindexof(First.new(35.0, 350.0))
new_lastindexof = array.new<Second>(2, Second.new(360.0, 36.0)).lastindexof(Second.new(360.0, 36.0))
plot(from_get.shared)
plot(new_first.shared)
plot(new_second.shared)
plot(new_first_again.shared)
plot(from_includes and new_includes ? 1 : 0)
plot(from_indexof == 0 and new_indexof == 0 ? 1 : 0)
plot(from_lastindexof == 2 and new_lastindexof == 1 ? 1 : 0)
plot(array.from(1.0, 2.0, 3.0).binary_search(2.0) == 1 and array.from(1, 2, 3).binary_search(9) == -1 and array.new<int>(3, 4).binary_search(4) == 0 ? 1 : 0)
plot(array.from(1.0, 3.0, 5.0).binary_search_leftmost(4.0) == 1 and array.from(1, 3, 5).binary_search_leftmost(0) == 0 and array.new<int>(3, 4).binary_search_leftmost(9) == 2 ? 1 : 0)
plot(array.from(1.0, 3.0, 5.0).binary_search_rightmost(4.0) == 2 and array.from(1, 3, 5).binary_search_rightmost(0) == 0 and array.new<int>(3, 4).binary_search_rightmost(9) == 2 ? 1 : 0)

slice_source = array.from(1, 2, 3)
slice_direct_get = array.slice(id=slice_source, index_from=1, index_to=3).get(index=0)
slice_includes = array.slice(slice_source, 1, 3).includes(3)
slice_indexof = array.slice(slice_source, 1, 3).indexof(3)
slice_lastindexof = array.slice(array.from(1, 2, 1), 0, 3).lastindexof(1)
slice_independent_copy = array.slice(slice_source, 1, 3).copy()
slice_source.set(1, 20)
slice_live_first = array.slice(slice_source, 1, 3).first()
plot(slice_direct_get)
plot(slice_live_first)
plot(slice_independent_copy.first())
plot(slice_includes ? 1 : 0)
plot(slice_indexof == 1 ? 1 : 0)
plot(slice_lastindexof == 2 ? 1 : 0)
plot(array.slice(array.from(0, 1, 2, 3), 1, 4).binary_search(2) == 1 ? 1 : 0)
plot(array.slice(array.from(0, 1, 3, 3, 5), 1, 5).binary_search_leftmost(3) == 1 ? 1 : 0)
plot(array.slice(array.from(0, 1, 3, 3, 5), 1, 5).binary_search_rightmost(3) == 2 ? 1 : 0)

concat_left = array.from(40)
concat_right = array.from(41, 42)
concat_get = array.concat(id=concat_left, id2=concat_right).get(index=2)
concat_includes = array.concat(array.from(43), array.from(44)).includes(44)
concat_indexof = array.concat(array.from(43), array.from(44)).indexof(44)
concat_lastindexof = array.concat(array.from(43), array.from(44, 43)).lastindexof(43)
plot(concat_get)
plot(concat_left.size())
plot(concat_includes ? 1 : 0)
plot(concat_indexof == 1 ? 1 : 0)
plot(concat_lastindexof == 2 ? 1 : 0)
plot(array.concat(array.from(1), array.from(2, 3)).binary_search(2) == 1 ? 1 : 0)
plot(array.concat(array.from(1, 3), array.from(3, 5)).binary_search_leftmost(4) == 2 ? 1 : 0)
plot(array.concat(array.from(1, 3), array.from(3, 5)).binary_search_rightmost(4) == 3 ? 1 : 0)

abs_int_last = array.abs(array.from(-4, 2, -3)).last()
abs_float_first = array.abs(array.from(-1.5, 2.5)).first()
standardized_int_size = array.standardize(array.from(1, 2, 3)).size()
standardized_float_size = array.standardize(array.from(1.0, 2.0)).copy().size()
sort_indices_first = array.sort_indices(id=array.from(3, 1, 2), order=order.ascending).first()
sort_indices_last = array.sort_indices(array.from(3, 1, 2)).last()
udt_sort_values = array.from(First.new(3.0, 30.0), First.new(1.0, 10.0), First.new(2.0, 20.0))
udt_sort_middle = array.sort_indices(udt_sort_values, order.ascending, "shared").get(index=1)
abs_includes = array.abs(array.from(-4, 2, -3)).includes(4)
standardized_includes = array.standardize(array.from(1, 2, 3)).includes(0.0)
sort_indices_includes = array.sort_indices(array.from(3, 1, 2)).includes(2)
abs_indexof = array.abs(array.from(-4, 2, -3)).indexof(4)
standardized_indexof = array.standardize(array.from(1, 2, 3)).indexof(0.0)
sort_indices_indexof = array.sort_indices(array.from(3, 1, 2)).indexof(2)
abs_lastindexof = array.abs(array.from(-4, 2, -4)).lastindexof(4)
standardized_lastindexof = array.standardize(array.from(1, 2, 3)).lastindexof(0.0)
sort_indices_lastindexof = array.sort_indices(array.from(3, 1, 2)).lastindexof(2)
plot(abs_int_last)
plot(abs_float_first)
plot(standardized_int_size)
plot(standardized_float_size)
plot(sort_indices_first)
plot(sort_indices_last)
plot(udt_sort_middle)
plot(abs_includes and standardized_includes and sort_indices_includes ? 1 : 0)
plot(abs_indexof == 0 and standardized_indexof == 1 and sort_indices_indexof == 1 ? 1 : 0)
plot(abs_lastindexof == 2 and standardized_lastindexof == 1 and sort_indices_lastindexof == 1 ? 1 : 0)
plot(array.abs(array.from(-1, -2, -3)).binary_search(2) == 1 and array.standardize(array.from(1, 2, 3)).binary_search(0.0) == 1 and array.sort_indices(array.from(1, 2, 3)).binary_search(1) == 1 ? 1 : 0)
plot(array.abs(array.from(-1, -2, -3)).binary_search_leftmost(2) == 1 and array.standardize(array.from(1, 2, 3)).binary_search_leftmost(0.5) == 1 and array.sort_indices(array.from(1, 2, 3)).binary_search_leftmost(1) == 1 ? 1 : 0)
plot(array.abs(array.from(-1, -2, -3)).binary_search_rightmost(2) == 1 and array.standardize(array.from(1, 2, 3)).binary_search_rightmost(0.5) == 2 and array.sort_indices(array.from(1, 2, 3)).binary_search_rightmost(1) == 1 ? 1 : 0)
call_result_abs_source = array.from(-5, 2, -3)
call_result_abs_values = array.copy(call_result_abs_source).abs().copy()
plot(call_result_abs_values.first() == 5 and call_result_abs_values.get(1) == 2 and call_result_abs_values.last() == 3 ? 1 : 0, "call_result_abs_int")
plot(call_result_abs_source.first() == -5 ? 1 : 0, "call_result_abs_source_unchanged")
plot(array.from(-1.5, na, 2.5).abs().first() == 1.5 and na(array.from(-1.5, na, 2.5).abs().get(1)) and array.from(-1.5, na, 2.5).abs().last() == 2.5 ? 1 : 0, "call_result_abs_float_na")
plot(array.slice(array.from(-9, -8, -7), 1, 3).abs().get(0), "call_result_abs_slice")
plot(array.concat(array.from(-6), array.from(-4)).abs().includes(4) ? 1 : 0, "call_result_abs_concat")
plot(array.abs(array.from(-3, 2)).abs().last(), "call_result_abs_nested")
plot(array.new_int(3, 4).min() == 4 and array.from(na, 4, 1, 4, 2).min() == 1 and array.copy(array.from(na, 4, 1, 4, 2)).min(nth=2) == 4 ? 1 : 0, "call_result_min_int_nth")
plot(array.from(na, 3.5, -1.5, 2.0).min(nth=1) == 2.0 ? 1 : 0, "call_result_min_float_nth")
plot(array.slice(array.from(9, 8, 7), 1, 3).min() == 7 and array.concat(array.from(6), array.from(4, 5)).min() == 4 ? 1 : 0, "call_result_min_slice_concat")
plot(array.from(-4, 2, -3).abs().min() == 2 and array.sort_indices(array.from(3, 1, 2)).min() == 0 ? 1 : 0, "call_result_min_abs_sort_indices")
plot(array.standardize(array.from(1, 2, 3)).min() == array.min(array.standardize(array.from(1, 2, 3))) ? 1 : 0, "call_result_min_standardize")
dynamic_call_result_min = array.from(1, 2, 4).min(bar_index % 3)
plot(dynamic_call_result_min == (bar_index % 3 == 0 ? 1 : bar_index % 3 == 1 ? 2 : 4) ? 1 : 0, "call_result_min_dynamic_nth")
plot(array.new_int(3, 4).max() == 4 and array.from(na, 4, 1, 4, 2).max() == 4 and array.copy(array.from(na, 4, 1, 4, 2)).max(nth=2) == 2 ? 1 : 0, "call_result_max_int_nth")
plot(array.from(na, 3.5, -1.5, 2.0).max(nth=1) == 2.0 ? 1 : 0, "call_result_max_float_nth")
plot(array.slice(array.from(9, 8, 7), 1, 3).max() == 8 and array.concat(array.from(6), array.from(4, 5)).max() == 6 ? 1 : 0, "call_result_max_slice_concat")
plot(array.from(-4, 2, -3).abs().max() == 4 and array.sort_indices(array.from(3, 1, 2)).max() == 2 ? 1 : 0, "call_result_max_abs_sort_indices")
plot(array.standardize(array.from(1, 2, 3)).max() == array.max(array.standardize(array.from(1, 2, 3))) ? 1 : 0, "call_result_max_standardize")
dynamic_call_result_max = array.from(1, 2, 4).max(bar_index % 3)
plot(dynamic_call_result_max == (bar_index % 3 == 0 ? 4 : bar_index % 3 == 1 ? 2 : 1) ? 1 : 0, "call_result_max_dynamic_nth")
plot(array.new_int(3, 4).sum() == 12 and array.from(na, 4, 1, 4, 2).sum() == 11 and array.copy(array.from(na, 4, 1, 4, 2)).sum() == 11 ? 1 : 0, "call_result_sum_int")
plot(array.from(na, 3.5, -1.5, 2.0).sum() == 4.0 ? 1 : 0, "call_result_sum_float")
plot(array.slice(array.from(9, 8, 7), 1, 3).sum() == 15 and array.concat(array.from(6), array.from(4, 5)).sum() == 15 ? 1 : 0, "call_result_sum_slice_concat")
plot(array.from(-4, 2, -3).abs().sum() == 9 and array.sort_indices(array.from(3, 1, 2)).sum() == 3 ? 1 : 0, "call_result_sum_abs_sort_indices")
plot(array.standardize(array.from(1, 2, 3)).sum() == array.sum(array.standardize(array.from(1, 2, 3))) ? 1 : 0, "call_result_sum_standardize")
plot(array.new_int(3, 4).avg() == 4.0 and array.from(na, 4, 1, 4, 2).avg() == 2.75 and array.copy(array.from(na, 4, 1, 4, 2)).avg() == 2.75 ? 1 : 0, "call_result_avg_int")
plot(array.from(na, 3.5, -1.5, 2.0).avg() == 4.0 / 3.0 ? 1 : 0, "call_result_avg_float")
plot(array.slice(array.from(9, 8, 7), 1, 3).avg() == 7.5 and array.concat(array.from(6), array.from(4, 5)).avg() == 5.0 ? 1 : 0, "call_result_avg_slice_concat")
plot(array.from(-4, 2, -3).abs().avg() == 3.0 and array.sort_indices(array.from(3, 1, 2)).avg() == 1.0 ? 1 : 0, "call_result_avg_abs_sort_indices")
plot(array.standardize(array.from(1, 2, 3)).avg() == array.avg(array.standardize(array.from(1, 2, 3))) ? 1 : 0, "call_result_avg_standardize")
plot(na(array.from(1e308, 1e308).avg()) ? 1 : 0, "call_result_avg_non_finite")
plot(array.new_int(3, 4).range() == 0 and array.from(na, 4, 1, 4, 2).range() == 3 and array.copy(array.from(na, 4, 1, 4, 2)).range() == 3 ? 1 : 0, "call_result_range_int")
plot(array.from(na, 3.5, -1.5, 2.0).range() == 5.0 ? 1 : 0, "call_result_range_float")
plot(array.slice(array.from(9, 8, 7), 1, 3).range() == 1 and array.concat(array.from(6), array.from(4, 5)).range() == 2 ? 1 : 0, "call_result_range_slice_concat")
plot(array.from(-4, 2, -3).abs().range() == 2 and array.sort_indices(array.from(3, 1, 2)).range() == 2 ? 1 : 0, "call_result_range_abs_sort_indices")
plot(array.standardize(array.from(1, 2, 3)).range() == array.range(array.standardize(array.from(1, 2, 3))) ? 1 : 0, "call_result_range_standardize")
plot(na(array.from(-1e308, 1e308).range()) ? 1 : 0, "call_result_range_non_finite")
plot(array.new_int(3, 4).median() == 4 and array.from(na, 4, 1, 4, 2).median() == 3 and array.copy(array.from(na, 4, 1, 4, 2)).median() == 3 and array.from(1, 2).median() == 1 and array.from(-2, -1).median() == -1 ? 1 : 0, "call_result_median_int")
plot(array.from(na, 3.5, -1.5, 2.0).median() == 2.0 ? 1 : 0, "call_result_median_float")
plot(array.slice(array.from(9, 8, 7), 1, 3).median() == 7 and array.concat(array.from(6), array.from(4, 5)).median() == 5 ? 1 : 0, "call_result_median_slice_concat")
plot(array.from(-4, 2, -3).abs().median() == 3 and array.sort_indices(array.from(3, 1, 2)).median() == 1 ? 1 : 0, "call_result_median_abs_sort_indices")
plot(array.standardize(array.from(1, 2, 3)).median() == array.median(array.standardize(array.from(1, 2, 3))) ? 1 : 0, "call_result_median_standardize")
plot(na(array.from(1e308, 1e308).median()) ? 1 : 0, "call_result_median_non_finite")
plot(array.new_int(3, 4).mode() == 4 and array.from(na, 3, 3, 2, 2).mode() == 2 and array.copy(array.from(na, 3, 3, 2, 2)).mode() == 2 ? 1 : 0, "call_result_mode_int")
plot(array.from(na, 1.5, 1.5, 2.5).mode() == 1.5 ? 1 : 0, "call_result_mode_float")
plot(array.slice(array.from(9, 8, 8), 1, 3).mode() == 8 and array.concat(array.from(6, 6), array.from(4, 5)).mode() == 6 ? 1 : 0, "call_result_mode_slice_concat")
plot(array.from(-4, 4, -3).abs().mode() == 4 and na(array.sort_indices(array.from(3, 3, 1)).mode()) ? 1 : 0, "call_result_mode_abs_sort_indices")
plot(array.standardize(array.from(1, 1, 2)).mode() == array.mode(array.standardize(array.from(1, 1, 2))) ? 1 : 0, "call_result_mode_standardize")
plot(na(array.from(1, 2, 3).mode()) ? 1 : 0, "call_result_mode_unique")
plot(array.new_int(3, 4).percentile_nearest_rank(50) == 4 and array.from(na, 9, 1, 5, 7).percentile_nearest_rank(0) == 1 and array.from(na, 9, 1, 5, 7).percentile_nearest_rank(50) == 5 and array.from(na, 9, 1, 5, 7).percentile_nearest_rank(100) == 9 and array.copy(array.from(na, 9, 1, 5, 7)).percentile_nearest_rank(percentage=75) == 7 ? 1 : 0, "call_result_percentile_nearest_int")
plot(array.from(1.5, 4.5, 2.5).percentile_nearest_rank(50) == 2.5 ? 1 : 0, "call_result_percentile_nearest_float")
plot(array.slice(array.from(9, 8, 7), 1, 3).percentile_nearest_rank(50) == 7 and array.concat(array.from(6), array.from(4, 5)).percentile_nearest_rank(50) == 5 ? 1 : 0, "call_result_percentile_nearest_slice_concat")
plot(array.from(-4, 2, -3).abs().percentile_nearest_rank(50) == 3 and array.sort_indices(array.from(3, 1, 2)).percentile_nearest_rank(50) == 1 ? 1 : 0, "call_result_percentile_nearest_abs_sort_indices")
plot(array.standardize(array.from(1, 2, 3)).percentile_nearest_rank(50) == array.percentile_nearest_rank(array.standardize(array.from(1, 2, 3)), 50) ? 1 : 0, "call_result_percentile_nearest_standardize")
dynamic_percentile_nearest_percentage = bar_index * 25
plot(array.from(1, 2, 3, 4).percentile_nearest_rank(dynamic_percentile_nearest_percentage) == array.percentile_nearest_rank(array.from(1, 2, 3, 4), dynamic_percentile_nearest_percentage) ? 1 : 0, "call_result_percentile_nearest_dynamic_percentage")
plot(na(array.from(1, 2, 3).percentile_nearest_rank(-1)) and na(array.from(1, 2, 3).percentile_nearest_rank(101)) and na(array.from(1, 2, 3).percentile_nearest_rank(bar_index < 0 ? 50 : na)) ? 1 : 0, "call_result_percentile_nearest_invalid_percentage")
plot(array.new_int(3, 4).percentile_linear_interpolation(50) == 4.0 and array.from(na, 9, 1, 5).percentile_linear_interpolation(0) == 1.0 and array.from(na, 9, 1, 5).percentile_linear_interpolation(25) == 3.0 and array.from(na, 9, 1, 5).percentile_linear_interpolation(50) == 5.0 and array.from(na, 9, 1, 5).percentile_linear_interpolation(75) == 7.0 and array.from(na, 9, 1, 5).percentile_linear_interpolation(100) == 9.0 and array.copy(array.from(na, 9, 1, 5)).percentile_linear_interpolation(percentage=75) == 7.0 ? 1 : 0, "call_result_percentile_linear_int")
plot(array.from(7).percentile_linear_interpolation(35) == 7.0 and array.from(1.5, 4.5, 2.5).percentile_linear_interpolation(50) == 2.5 ? 1 : 0, "call_result_percentile_linear_float_single")
plot(array.slice(array.from(9, 8, 7), 1, 3).percentile_linear_interpolation(50) == 7.5 and array.concat(array.from(6), array.from(4, 5)).percentile_linear_interpolation(50) == 5.0 ? 1 : 0, "call_result_percentile_linear_slice_concat")
plot(array.from(-4, 2, -3).abs().percentile_linear_interpolation(50) == 3.0 and array.sort_indices(array.from(3, 1, 2)).percentile_linear_interpolation(50) == 1.0 ? 1 : 0, "call_result_percentile_linear_abs_sort_indices")
plot(array.standardize(array.from(1, 2, 3)).percentile_linear_interpolation(50) == array.percentile_linear_interpolation(array.standardize(array.from(1, 2, 3)), 50) ? 1 : 0, "call_result_percentile_linear_standardize")
dynamic_percentile_linear_percentage = bar_index * 25
plot(array.from(1, 2, 3, 4).percentile_linear_interpolation(dynamic_percentile_linear_percentage) == array.percentile_linear_interpolation(array.from(1, 2, 3, 4), dynamic_percentile_linear_percentage) ? 1 : 0, "call_result_percentile_linear_dynamic_percentage")
plot(na(array.from(-1e308, 1e308).percentile_linear_interpolation(50)) and na(array.from(1, 2, 3).percentile_linear_interpolation(-1)) and na(array.from(1, 2, 3).percentile_linear_interpolation(101)) and na(array.from(1, 2, 3).percentile_linear_interpolation(bar_index < 0 ? 50 : na)) ? 1 : 0, "call_result_percentile_linear_invalid")
