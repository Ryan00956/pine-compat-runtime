//@version=6
indicator("Builtin array call-result reads")

type First
    float shared
    float other

type Second
    float other
    float shared

noneFirst() =>
    array<First> values = na
    values

constructor_sizes = array.new_float(1).size() + array.new_int(1).size() + array.new_bool(1).size() + array.new_string(1).size() + array.new_color(1).size() + array.new_line(1).size() + array.new_linefill(1).size() + array.new_polyline(1).size() + array.new_label(1).size() + array.new_box(1).size() + array.new_table(1).size() + array.new<chart.point>(1).size()
plot(constructor_sizes)

first_values = array.from(First.new(10.0, 100.0), First.new(11.0, 110.0))
second_values = array.from(Second.new(200.0, 20.0), Second.new(210.0, 21.0))
copy_size_first = array.copy(first_values).size()
copy_get_second = array.copy(second_values).get(index=0)
copy_first_again = array.copy(first_values).first()
copy_last_second = array.copy(second_values).last()
copy_nested_get = array.copy(first_values).copy().get(index=1)
plot(copy_size_first)
plot(copy_get_second.shared)
plot(copy_first_again.shared)
plot(copy_last_second.shared)
plot(copy_nested_get.shared)

from_get = array.from(First.new(30.0, 300.0), First.new(31.0, 310.0)).get(index=1)
new_first = array.new<First>(1, First.new(32.0, 320.0)).first()
new_second = array.new<Second>(2, Second.new(330.0, 33.0)).last()
new_first_again = array.new<First>(1, First.new(34.0, 340.0)).copy().last()
plot(from_get.shared)
plot(new_first.shared)
plot(new_second.shared)
plot(new_first_again.shared)

slice_source = array.from(1, 2, 3)
slice_direct_get = array.slice(id=slice_source, index_from=1, index_to=3).get(index=0)
slice_independent_copy = array.slice(slice_source, 1, 3).copy()
slice_source.set(1, 20)
slice_live_first = array.slice(slice_source, 1, 3).first()
plot(slice_direct_get)
plot(slice_live_first)
plot(slice_independent_copy.first())

concat_left = array.from(40)
concat_right = array.from(41, 42)
concat_get = array.concat(id=concat_left, id2=concat_right).get(index=2)
plot(concat_get)
plot(concat_left.size())

abs_int_last = array.abs(array.from(-4, 2, -3)).last()
abs_float_first = array.abs(array.from(-1.5, 2.5)).first()
standardized_int_size = array.standardize(array.from(1, 2, 3)).size()
standardized_float_size = array.standardize(array.from(1.0, 2.0)).copy().size()
sort_indices_first = array.sort_indices(id=array.from(3, 1, 2), order=order.ascending).first()
sort_indices_last = array.sort_indices(array.from(3, 1, 2)).last()
udt_sort_values = array.from(First.new(3.0, 30.0), First.new(1.0, 10.0), First.new(2.0, 20.0))
udt_sort_middle = array.sort_indices(udt_sort_values, order.ascending, "shared").get(index=1)
plot(abs_int_last)
plot(abs_float_first)
plot(standardized_int_size)
plot(standardized_float_size)
plot(sort_indices_first)
plot(sort_indices_last)
plot(udt_sort_middle)

new_int_last = array.new<int>(size=2, initial_value=7).last()
new_int_direct_get = array.new_int(2, 8).get(0)
chart_point_first = array.new<chart.point>(1, chart.point.now(close)).first()
plot(new_int_last)
plot(new_int_direct_get)
plot(chart_point_first.price)

label_id = label.new(bar_index, high, "original")
copied_label = array.copy(array.from(label_id)).first()
label.set_text(copied_label, "shared")
plot(label.get_text(label_id) == "shared" ? 1 : 0)

empty_size = array.new<First>().size()
empty_last = array.new<First>().last()
none_size = array.copy(noneFirst()).size()
empty_standardized_size = array.standardize(array.new<int>()).size()
empty_sort_first = array.sort_indices(array.new<int>()).first()
plot(empty_size)
plot(na(empty_last) ? 1 : 0)
plot(na(none_size) ? 1 : 0)
plot(empty_standardized_size)
plot(na(empty_sort_first) ? 1 : 0)

copy_source = array.from(50, 51)
independent_copy = array.copy(copy_source).copy()
independent_copy.push(52)
plot(copy_source.size())
plot(independent_copy.size())
