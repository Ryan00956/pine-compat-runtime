plot(array.standardize(array.from(1, 2, 3)).covariance(array.from(2.0, 4.0, 6.0)) == array.covariance(array.standardize(array.from(1, 2, 3)), array.from(2.0, 4.0, 6.0)) and array.from(1, na, 3).covariance(array.from(2, 4, na)) == 0.0 and array.from(1, 2).covariance(array.from(2, 4), na) == 1.0 ? 1 : 0, "call_result_covariance_standardize_na")
