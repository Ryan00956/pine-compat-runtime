//@version=5
indicator("Object array typed declarations", overlay=true)

label marker = label.new(bar_index, close, "start")
line upper = line.new(bar_index, high, bar_index + 1, high + 1)
line lower = line.new(bar_index, low, bar_index + 1, low - 1)
linefill fill = linefill.new(upper, lower, color.new(color.blue, 80))
point_a = chart.point.from_index(bar_index, close)
point_b = chart.point.from_index(bar_index + 1, close + 1)
polyline path = polyline.new(array.from(point_a, point_b))
box range_box = box.new(bar_index, high, bar_index + 1, low)
table info = table.new(position.top_right, 1, 1)

array<label> labels = na
array<line> lines = array.new<line>()
array<linefill> fills = array.new<linefill>()
array<polyline> paths = array.new<polyline>()
array<box> boxes = array.new<box>()
array<table> tables = array.new<table>()

labels := array.new<label>()
labels.push(marker)
lines.push(upper)
lines.push(lower)
fills.push(fill)
paths.push(path)
boxes.push(range_box)
tables.push(info)

labels := na
labels := array.from(marker)

label.set_text(labels.get(0), "typed")
line.set_color(lines.get(0), color.green)
linefill.set_color(fills.get(0), color.red)
polyline.delete(paths.get(0))
box.set_bgcolor(boxes.get(0), color.new(color.green, 90))
table.cell(tables.get(0), 0, 0, "typed")

plot(labels.size())
plot(lines.size())
plot(fills.size())
plot(paths.size())
plot(boxes.size())
plot(tables.size())
