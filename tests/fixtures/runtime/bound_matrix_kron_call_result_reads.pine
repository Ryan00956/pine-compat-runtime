//@version=6
indicator("Bound matrix.kron call-result reads")

kronRows(left, right) => left.kron(right).rows()

kronBlockReads(left, right) =>
    int rows = left.kron(right).rows()
    int columns = left.kron(right).columns()
    float value = left.kron(right).get(1, 3)
    rows * 100 + columns * 10 + value

left = matrix.new<float>(2, 2, 0.0)
left.set(0, 0, 1.0)
left.set(0, 1, 2.0)
left.set(1, 0, 3.0)
left.set(1, 1, 4.0)
right = matrix.new<float>(1, 2, 0.0)
right.set(0, 0, 5.0)
right.set(0, 1, 6.0)

expanded = left.kron(right).copy()
expanded.set(0, 0, 99.0)

int_left = matrix.new<int>(1, 1, 2)
int_right = matrix.new<int>(1, 1, 3)
third = matrix.new<float>(2, 1, 0.0)
third.set(0, 0, 2.0)
third.set(1, 0, 3.0)
int_third = matrix.new<int>(1, 1, 2)
invalid = matrix.new<float>(1, 1)
empty = matrix.new<float>(0, 2)

rekroned = left.kron(right).kron(third)
rekroned.set(0, 0, 88.0)

plot(left.kron(right).rows(), "kron_rows")
plot(left.kron(right).columns(), "kron_columns")
plot(left.kron(right).elements_count(), "kron_elements")
plot(left.kron(right).get(1, 3), "kron_get")
plot(left.kron(right).copy().get(0, 2), "kron_copy_get")
plot(left.get(0, 0), "source_value")
plot(expanded.get(0, 0), "expanded_value")
plot(int_left.kron(int_right).get(0, 0), "int_kron_get")
plot(kronRows(left, right), "expression_udf")
plot(kronBlockReads(left, right), "block_udf")
plot(left.kron(right).kron(third).rows(), "kron_chain_rows")
plot(left.kron(right).kron(third).columns(), "kron_chain_columns")
plot(left.kron(right).kron(third).get(3, 3), "kron_chain_get")
plot(left.kron(right).copy().kron(third).transpose().get(3, 3), "kron_nested_get")
plot(int_left.kron(int_right).kron(int_third).get(0, 0), "kron_int_chain_get")
plot(na(invalid.kron(int_third).kron(int_third).get(0, 0)) ? 1 : 0, "kron_invalid_na")
plot(empty.kron(right).kron(third).rows() * 100 + empty.kron(right).kron(third).columns() * 10 + empty.kron(right).kron(third).elements_count(), "kron_empty_shape")
plot(rekroned.get(0, 0), "rekroned_value")
plot(left.get(0, 0), "rekron_source_value")
left.kron(right).set(0, 0, 104.0)
plot(left.get(0, 0) == 1.0 and right.get(0, 0) == 5.0 ? 1 : 0, "call_result_set_source_independent")
left.kron(right).fill(304.0)
plot(left.get(0, 0) == 1.0 and right.get(0, 0) == 5.0 ? 1 : 0, "call_result_fill_source_independent")
left.kron(right).reverse()
plot(left.get(0, 0) == 1.0 and right.get(0, 0) == 5.0 ? 1 : 0, "call_result_reverse_source_independent")
left.kron(right).reshape(1, 8)
plot(left.rows() == 2 and left.columns() == 2 and right.rows() == 1 and right.columns() == 2 ? 1 : 0, "call_result_reshape_source_independent")
