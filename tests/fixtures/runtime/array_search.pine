indicator("Array search fixture")
numbers = array.new_int()
array.push(numbers, 2)
array.push(numbers, 3)
array.push(numbers, 2)
plot(array.includes(numbers, 2) ? 1 : 0)
plot(array.indexof(numbers, 2))
plot(array.lastindexof(numbers, 2))
plot(numbers.indexof(9))
numbers.sort()
plot(array.binary_search(numbers, 2))
plot(numbers.binary_search(9))
plot(array.binary_search_leftmost(numbers, 4))
plot(array.binary_search_rightmost(numbers, 4))
plot(numbers.binary_search_leftmost(2))
plot(numbers.binary_search_rightmost(2))
plot(array.binary_search_leftmost(numbers, 1) == 0 and array.binary_search_rightmost(numbers, 1) == 0 and array.binary_search_leftmost(numbers, 9) == 2 and array.binary_search_rightmost(numbers, 9) == 2 ? 1 : 0)
empty_numbers = array.new_int()
plot(empty_numbers.binary_search(1))
plot(empty_numbers.binary_search_leftmost(1))
plot(empty_numbers.binary_search_rightmost(1))

truth_flags = array.from(true, true)
plot(array.every(truth_flags) and truth_flags.some() ? 1 : 0)
truth_flags.push(false)
plot(array.every(truth_flags) ? 99 : (array.some(truth_flags) ? 1 : 0))
truth_numbers = array.from(1, -2, 3)
plot(truth_numbers.every() and array.some(truth_numbers) ? 1 : 0)
truth_numbers.push(0)
plot(array.every(truth_numbers) ? 99 : 1)
truth_floats = array.new_float()
truth_floats.push(na)
truth_floats.push(0)
truth_floats.push(close)
plot(array.every(truth_floats) ? 99 : (truth_floats.some() ? 1 : 0))
empty_truth = array.new_bool()
plot(array.every(empty_truth) and not empty_truth.some() ? 1 : 0)
na_truth = array.new_int(2)
plot(array.every(na_truth) ? 99 : (array.some(na_truth) ? 98 : 1))

floats = array.new_float()
floats.push(close)
floats.push(high)
plot(floats.includes(close) ? floats.indexof(high) : 0)
floats.sort()
plot(array.binary_search(floats, close))
plot(floats.binary_search_leftmost(low))
plot(floats.binary_search_rightmost(high))

flags = array.new_bool()
flags.push(false)
flags.push(true)
plot(flags.includes(true) ? flags.indexof(true) : 0)

words = array.new_string()
words.push("a")
words.push("b")
words.push("a")
plot(words.includes("b") ? words.lastindexof("a") : 0)
plot(words.indexof("z") == -1 and words.lastindexof("z") == -1 ? 1 : 0)

colors = array.new_color()
colors.push(color.red)
colors.push(color.green)
plot(colors.includes(color.green) ? colors.indexof(color.green) : 0)

bool_search = array.from(true, true)
plot(bool_search.indexof(true) == 0 and bool_search.lastindexof(true) == 1 and bool_search.indexof(false) == -1 and bool_search.lastindexof(false) == -1 ? 1 : 0)
plot(not words.includes("z") and not bool_search.includes(false) ? 1 : 0)
empty_truth_ints = array.new_int()
empty_truth_floats = array.new_float()
plot(empty_truth_ints.every() and not empty_truth_ints.some() and array.every(empty_truth_floats) and not array.some(empty_truth_floats) ? 1 : 0)
empty_float_search = array.new_float()
plot(empty_float_search.binary_search(close) == -1 and empty_float_search.binary_search_leftmost(close) == -1 and empty_float_search.binary_search_rightmost(close) == -1 ? 1 : 0)

branch_search_source = array.from(2, 4, 2)
branch_search_results = array.new_int()
if bar_index % 2 == 0
    branch_search_results.push((array.includes(branch_search_source, 4) ? 10 : 0) + array.indexof(branch_search_source, 2) + branch_search_source.lastindexof(2))
else
    branch_search_results.push((branch_search_source.includes(9) ? 10 : 0) + array.indexof(branch_search_source, 9) + branch_search_source.lastindexof(9))
plot(branch_search_results.get(0))

loop_search_source = array.from("a", "b", "a")
loop_search_results = array.new_int()
for i = 0 to 1
    if i == 0
        loop_search_results.push((loop_search_source.includes("b") ? 10 : 0) + array.indexof(loop_search_source, "a"))
    else
        loop_search_results.push(loop_search_source.lastindexof("a") + (array.includes(loop_search_source, "z") ? 100 : 0))
plot(loop_search_results.get(0) + loop_search_results.get(1))

independent_includes_source = array.from("a", "b", "c")
independent_includes_score = bar_index * 0
independent_includes_i = 0
while independent_includes_i < 1
    independent_includes_hit = array.includes(independent_includes_source, "b")
    independent_includes_miss = independent_includes_source.includes("z")
    independent_includes_score := (independent_includes_hit ? 100 : 0) + (independent_includes_miss ? 10 : 0) + independent_includes_source.size()
    independent_includes_i := independent_includes_i + 1
plot(independent_includes_score)

independent_every_truthy = array.from(1, 2, 3)
independent_every_falsey = array.from(1, 0, 3)
independent_every_score = bar_index * 0
independent_every_i = 0
while independent_every_i < 1
    independent_every_all = array.every(independent_every_truthy)
    independent_every_not_all = independent_every_falsey.every()
    independent_every_score := (independent_every_all ? 100 : 0) + (independent_every_not_all ? 10 : 0) + independent_every_truthy.size()
    independent_every_i := independent_every_i + 1
plot(independent_every_score)

independent_some_truthy = array.from(0, 2, 0)
independent_some_falsey = array.from(false, false)
independent_some_score = bar_index * 0
independent_some_i = 0
while independent_some_i < 1
    independent_some_any = array.some(independent_some_truthy)
    independent_some_none = independent_some_falsey.some()
    independent_some_score := (independent_some_any ? 100 : 0) + (independent_some_none ? 10 : 0) + independent_some_truthy.size()
    independent_some_i := independent_some_i + 1
plot(independent_some_score)

branch_truth_source = array.from(true, bar_index % 2 == 0)
branch_truth_results = array.new_int()
if bar_index % 2 == 0
    branch_truth_results.push((array.every(branch_truth_source) ? 10 : 0) + (branch_truth_source.some() ? 1 : 0))
else
    branch_truth_results.push((branch_truth_source.every() ? 10 : 0) + (array.some(branch_truth_source) ? 1 : 0))
plot(branch_truth_results.get(0))

loop_truth_source = array.from(1, 0, 2)
loop_truth_results = array.new_int()
for i = 0 to 1
    if i == 0
        loop_truth_results.push(array.every(loop_truth_source) ? 100 : 1)
    else
        loop_truth_results.push(loop_truth_source.some() ? 10 : 100)
plot(loop_truth_results.get(0) + loop_truth_results.get(1))

branch_binary_source = array.from(1, 3, 3, 5)
branch_binary_results = array.new_int()
if bar_index % 2 == 0
    branch_binary_results.push(array.binary_search(branch_binary_source, 3) + branch_binary_source.binary_search_leftmost(3) + branch_binary_source.binary_search_rightmost(3))
else
    branch_binary_results.push(array.binary_search(branch_binary_source, 2) + array.binary_search_leftmost(branch_binary_source, 2) + branch_binary_source.binary_search_rightmost(2))
plot(branch_binary_results.get(0))

loop_binary_source = array.from(2.0, 4.0, 4.0, 8.0)
loop_binary_results = array.new_int()
for i = 0 to 1
    if i == 0
        loop_binary_results.push(array.binary_search(loop_binary_source, 4.0) + loop_binary_source.binary_search_rightmost(4.0))
    else
        loop_binary_results.push(array.binary_search_leftmost(loop_binary_source, 1.0) + loop_binary_source.binary_search_rightmost(9.0))
plot(loop_binary_results.get(0) * 10 + loop_binary_results.get(1))
