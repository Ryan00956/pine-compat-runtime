//@version=5
indicator("Array ordering control flow fixture")

var branch_values = array.from(3, 1, 2)
if bar_index % 2 == 0
    branch_values.sort()
else
    branch_values.reverse()
plot(branch_values.get(0) * 100 + branch_values.get(1) * 10 + branch_values.get(2))

var loop_values = array.from(2, 0, 1)
for i = 0 to 1
    if i == 0
        array.sort(loop_values)
    else
        array.reverse(loop_values)
plot(loop_values.get(0) * 100 + loop_values.get(1) * 10 + loop_values.get(2))

independent_sort_values = array.from(4, 2, 3)
independent_sort_i = 0
while independent_sort_i < 1
    array.sort(independent_sort_values)
    independent_sort_i := independent_sort_i + 1
plot(independent_sort_values.get(0) * 100 + independent_sort_values.get(1) * 10 + independent_sort_values.get(2))

var words = array.from("b", "a", "c")
if barstate.isfirst
    words.sort()
else
    words.reverse()
expected_first_word = bar_index % 2 == 0 ? "a" : "c"
plot(words.get(0) == expected_first_word ? 1 : 0)

var branch_index_source = array.from(30, 10, 20)
branch_indices = bar_index % 2 == 0 ? branch_index_source.sort_indices() : branch_index_source.sort_indices(order.descending)
expected_first_index = bar_index % 2 == 0 ? 1 : 0
plot(branch_indices.get(0) == expected_first_index and branch_index_source.get(0) == 30 ? 1 : 0)

loop_index_acc = array.new_int()
loop_index_source = array.from("b", "a", "c")
for i = 0 to 1
    loop_indices = i == 0 ? loop_index_source.sort_indices(order.ascending) : loop_index_source.sort_indices(order.descending)
    loop_index_acc.push(loop_indices.get(0))
plot(loop_index_acc.get(0) + loop_index_acc.get(1) == 3 and loop_index_source.get(0) == "b" ? 1 : 0)
