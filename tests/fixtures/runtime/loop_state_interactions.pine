//@version=5
indicator("Loop state interactions")

smooth_sum(src, limit) =>
    total = src * 0.0
    for i = 0 to limit
        sampled = switch i
            0 => ta.sma(src, 2)
            1 => ta.ema(src, 2)
            => src
        if i == 1 and src > open
            continue
        total := total + nz(sampled)
    total

var carried = close * 0.0
loops = close * 0.0
i = 0
while i < 3
    value = smooth_sum(close + i, 2)
    if i == 2 and close > 3
        break
    loops := loops + value
    i := i + 1

carried := carried + loops
plot(loops)
plot(carried)
