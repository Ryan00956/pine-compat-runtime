//@version=5
indicator("User-defined types")
type Point
    float x
    float y
type Wrapper
    Point inner
    float weight

p = Point.new(close, open)
plot(p.x + p.y)
Point typed_point = na
plot(typed_point.x)
typed_point := Point.new(high + 5, low)
plot(typed_point.x + typed_point.y)
p.x := high
plot(p.x + p.y)
branch = Point.new(close, open)
if bar_index < 2
    branch.x := branch.x + 10
else
    branch.y := branch.y + 20
plot(branch.x + branch.y)
loop_mutated = Point.new(close, open)
for i = 0 to 1
    loop_mutated.x := loop_mutated.x + i
plot(loop_mutated.x + loop_mutated.y)
while_mutated = Point.new(close, open)
while_i = 0
while while_i < 2
    while_mutated.y := while_mutated.y + while_i
    while_i := while_i + 1
plot(while_mutated.x + while_mutated.y)
looped = for i = 0 to 1
    Point.new(p.x + i, p.y)
plot(looped.x + looped.y)
wrapped = Wrapper.new(p, high)
plot(wrapped.inner.x + wrapped.inner.y + wrapped.weight)
inner = wrapped.inner
plot(inner.x + inner.y)
nestedScore(w) => w.inner.x + w.inner.y + w.weight
plot(nestedScore(wrapped))
wrapped.inner := Point.new(high + 10, low)
plot(wrapped.inner.x + wrapped.inner.y + wrapped.weight)
branch_wrapped = Wrapper.new(Point.new(close, open), high)
if bar_index < 2
    branch_wrapped.inner := Point.new(high + 20, low)
else
    branch_wrapped.inner := Point.new(high + 30, low)
plot(branch_wrapped.inner.x + branch_wrapped.inner.y + branch_wrapped.weight)
for_wrapped = Wrapper.new(Point.new(close, open), high)
for i = 0 to 1
    for_wrapped.inner := Point.new(for_wrapped.inner.x + i + 10, for_wrapped.inner.y + i)
plot(for_wrapped.inner.x + for_wrapped.inner.y + for_wrapped.weight)
while_wrapped = Wrapper.new(Point.new(close, open), high)
while_i_nested = 0
while while_i_nested < 2
    while_wrapped.inner := Point.new(while_wrapped.inner.x + while_i_nested + 20, while_wrapped.inner.y + while_i_nested)
    while_i_nested := while_i_nested + 1
plot(while_wrapped.inner.x + while_wrapped.inner.y + while_wrapped.weight)
