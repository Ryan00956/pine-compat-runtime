//@version=5
indicator("User-defined types")
type Point
    float x
    float y
type Wrapper
    Point inner
    float weight

p = Point.new(close, open)
plot(p.x + p.y)
Point typed_point = na
plot(typed_point.x)
typed_point := Point.new(high + 5, low)
plot(typed_point.x + typed_point.y)
Point typed_constructed = Point.new(high + 30, low)
plot(typed_constructed.x + typed_constructed.y)
typed_constructed := Point.new(high + 35, low)
plot(typed_constructed.x + typed_constructed.y)
Point typed_ternary = bar_index < 2 ? Point.new(high + 65, low) : Point.new(high + 70, low)
plot(typed_ternary.x + typed_ternary.y)
typed_ternary := bar_index == 3 ? Point.new(high + 75, low) : Point.new(high + 80, low)
plot(typed_ternary.x + typed_ternary.y)
Point typed_if = if bar_index < 2
    Point.new(high + 270, low)
else
    Point.new(high + 275, low)
plot(typed_if.x + typed_if.y)
typed_if := if bar_index == 3
    Point.new(high + 280, low)
else
    Point.new(high + 285, low)
plot(typed_if.x + typed_if.y)
Point typed_switch = switch bar_index
    0 => Point.new(high + 120, low)
    1 => Point.new(high + 125, low)
    => Point.new(high + 130, low)
plot(typed_switch.x + typed_switch.y)
typed_switch := switch bar_index
    3 => Point.new(high + 135, low)
    => Point.new(high + 140, low)
plot(typed_switch.x + typed_switch.y)
var Point typed_var_point = na
if bar_index == 0
    typed_var_point := Point.new(high + 20, low)
plot(typed_var_point.x + typed_var_point.y)
var Point typed_var_constructed = Point.new(high + 45, low)
if bar_index == 2
    typed_var_constructed := Point.new(high + 50, low)
plot(typed_var_constructed.x + typed_var_constructed.y)
var Point typed_var_if = if bar_index == 0
    Point.new(high + 350, low)
else
    Point.new(high + 355, low)
if bar_index == 2
    typed_var_if := Point.new(high + 360, low)
plot(typed_var_if.x + typed_var_if.y)
if bar_index >= 0
    Point block_typed_point = na
    block_typed_point := Point.new(high + 40, low)
    plot(block_typed_point.x + block_typed_point.y)
if bar_index >= 0
    Point block_typed_constructed = Point.new(high + 55, low)
    block_typed_constructed := Point.new(high + 60, low)
    plot(block_typed_constructed.x + block_typed_constructed.y)
if bar_index >= 0
    Point block_typed_ternary = bar_index < 2 ? Point.new(high + 145, low) : Point.new(high + 150, low)
    block_typed_ternary := bar_index == 3 ? Point.new(high + 155, low) : Point.new(high + 160, low)
    plot(block_typed_ternary.x + block_typed_ternary.y)
if bar_index >= 0
    Point block_typed_if = if bar_index < 2
        Point.new(high + 290, low)
    else
        Point.new(high + 295, low)
    block_typed_if := if bar_index == 3
        Point.new(high + 300, low)
    else
        Point.new(high + 305, low)
    plot(block_typed_if.x + block_typed_if.y)
if bar_index >= 0
    Point block_typed_switch = switch bar_index
        0 => Point.new(high + 165, low)
        1 => Point.new(high + 170, low)
        => Point.new(high + 175, low)
    block_typed_switch := switch bar_index
        3 => Point.new(high + 180, low)
        => Point.new(high + 185, low)
    plot(block_typed_switch.x + block_typed_switch.y)
loop_typed_sum = close > 0 ? 0.0 : 0.0
for typed_i = 0 to 1
    Point loop_typed_point = na
    loop_typed_point := Point.new(high + typed_i, low)
    loop_typed_sum := loop_typed_sum + loop_typed_point.x + loop_typed_point.y
plot(loop_typed_sum)
loop_typed_constructed_sum = close > 0 ? 0.0 : 0.0
for typed_constructed_i = 0 to 1
    Point loop_typed_constructed = Point.new(high + typed_constructed_i + 70, low)
    loop_typed_constructed := Point.new(high + typed_constructed_i + 75, low)
    loop_typed_constructed_sum := loop_typed_constructed_sum + loop_typed_constructed.x + loop_typed_constructed.y
plot(loop_typed_constructed_sum)
loop_typed_ternary_sum = close > 0 ? 0.0 : 0.0
for typed_ternary_i = 0 to 1
    Point loop_typed_ternary = typed_ternary_i == 0 ? Point.new(high + typed_ternary_i + 190, low) : Point.new(high + typed_ternary_i + 195, low)
    loop_typed_ternary := typed_ternary_i == 1 ? Point.new(high + typed_ternary_i + 200, low) : Point.new(high + typed_ternary_i + 205, low)
    loop_typed_ternary_sum := loop_typed_ternary_sum + loop_typed_ternary.x + loop_typed_ternary.y
plot(loop_typed_ternary_sum)
loop_typed_if_sum = close > 0 ? 0.0 : 0.0
for typed_if_i = 0 to 1
    Point loop_typed_if = if typed_if_i == 0
        Point.new(high + typed_if_i + 310, low)
    else
        Point.new(high + typed_if_i + 315, low)
    loop_typed_if := if typed_if_i == 1
        Point.new(high + typed_if_i + 320, low)
    else
        Point.new(high + typed_if_i + 325, low)
    loop_typed_if_sum := loop_typed_if_sum + loop_typed_if.x + loop_typed_if.y
plot(loop_typed_if_sum)
loop_typed_switch_sum = close > 0 ? 0.0 : 0.0
for typed_switch_i = 0 to 1
    Point loop_typed_switch = switch typed_switch_i
        0 => Point.new(high + typed_switch_i + 230, low)
        => Point.new(high + typed_switch_i + 235, low)
    loop_typed_switch := switch typed_switch_i
        1 => Point.new(high + typed_switch_i + 240, low)
        => Point.new(high + typed_switch_i + 245, low)
    loop_typed_switch_sum := loop_typed_switch_sum + loop_typed_switch.x + loop_typed_switch.y
plot(loop_typed_switch_sum)
while_typed_sum = close > 0 ? 0.0 : 0.0
while_typed_i = 0
while while_typed_i < 2
    Point while_typed_point = na
    while_typed_point := Point.new(high + while_typed_i + 10, low)
    while_typed_sum := while_typed_sum + while_typed_point.x + while_typed_point.y
    while_typed_i := while_typed_i + 1
plot(while_typed_sum)
while_typed_constructed_sum = close > 0 ? 0.0 : 0.0
while_typed_constructed_i = 0
while while_typed_constructed_i < 2
    Point while_typed_constructed = Point.new(high + while_typed_constructed_i + 85, low)
    while_typed_constructed := Point.new(high + while_typed_constructed_i + 90, low)
    while_typed_constructed_sum := while_typed_constructed_sum + while_typed_constructed.x + while_typed_constructed.y
    while_typed_constructed_i := while_typed_constructed_i + 1
plot(while_typed_constructed_sum)
while_typed_ternary_sum = close > 0 ? 0.0 : 0.0
while_typed_ternary_i = 0
while while_typed_ternary_i < 2
    Point while_typed_ternary = while_typed_ternary_i == 0 ? Point.new(high + while_typed_ternary_i + 210, low) : Point.new(high + while_typed_ternary_i + 215, low)
    while_typed_ternary := while_typed_ternary_i == 1 ? Point.new(high + while_typed_ternary_i + 220, low) : Point.new(high + while_typed_ternary_i + 225, low)
    while_typed_ternary_sum := while_typed_ternary_sum + while_typed_ternary.x + while_typed_ternary.y
    while_typed_ternary_i := while_typed_ternary_i + 1
plot(while_typed_ternary_sum)
while_typed_if_sum = close > 0 ? 0.0 : 0.0
while_typed_if_i = 0
while while_typed_if_i < 2
    Point while_typed_if = if while_typed_if_i == 0
        Point.new(high + while_typed_if_i + 330, low)
    else
        Point.new(high + while_typed_if_i + 335, low)
    while_typed_if := if while_typed_if_i == 1
        Point.new(high + while_typed_if_i + 340, low)
    else
        Point.new(high + while_typed_if_i + 345, low)
    while_typed_if_sum := while_typed_if_sum + while_typed_if.x + while_typed_if.y
    while_typed_if_i := while_typed_if_i + 1
plot(while_typed_if_sum)
while_typed_switch_sum = close > 0 ? 0.0 : 0.0
while_typed_switch_i = 0
while while_typed_switch_i < 2
    Point while_typed_switch = switch while_typed_switch_i
        0 => Point.new(high + while_typed_switch_i + 250, low)
        => Point.new(high + while_typed_switch_i + 255, low)
    while_typed_switch := switch while_typed_switch_i
        1 => Point.new(high + while_typed_switch_i + 260, low)
        => Point.new(high + while_typed_switch_i + 265, low)
    while_typed_switch_sum := while_typed_switch_sum + while_typed_switch.x + while_typed_switch.y
    while_typed_switch_i := while_typed_switch_i + 1
plot(while_typed_switch_sum)
p.x := high
plot(p.x + p.y)
branch = Point.new(close, open)
if bar_index < 2
    branch.x := branch.x + 10
else
    branch.y := branch.y + 20
plot(branch.x + branch.y)
loop_mutated = Point.new(close, open)
for i = 0 to 1
    loop_mutated.x := loop_mutated.x + i
plot(loop_mutated.x + loop_mutated.y)
while_mutated = Point.new(close, open)
while_i = 0
while while_i < 2
    while_mutated.y := while_mutated.y + while_i
    while_i := while_i + 1
plot(while_mutated.x + while_mutated.y)
looped = for i = 0 to 1
    Point.new(p.x + i, p.y)
plot(looped.x + looped.y)
Wrapper typed_wrapped = Wrapper.new(Point.new(high + 100, low), high)
plot(typed_wrapped.inner.x + typed_wrapped.inner.y + typed_wrapped.weight)
typed_wrapped := Wrapper.new(Point.new(high + 105, low), close)
plot(typed_wrapped.inner.x + typed_wrapped.inner.y + typed_wrapped.weight)
Wrapper typed_wrapped_na = na
typed_wrapped_na := Wrapper.new(Point.new(high + 110, low), close)
plot(typed_wrapped_na.inner.x + typed_wrapped_na.inner.y + typed_wrapped_na.weight)
wrapped = Wrapper.new(p, high)
plot(wrapped.inner.x + wrapped.inner.y + wrapped.weight)
inner = wrapped.inner
plot(inner.x + inner.y)
nestedScore(w) => w.inner.x + w.inner.y + w.weight
plot(nestedScore(wrapped))
wrapped.inner := Point.new(high + 10, low)
plot(wrapped.inner.x + wrapped.inner.y + wrapped.weight)
branch_wrapped = Wrapper.new(Point.new(close, open), high)
if bar_index < 2
    branch_wrapped.inner := Point.new(high + 20, low)
else
    branch_wrapped.inner := Point.new(high + 30, low)
plot(branch_wrapped.inner.x + branch_wrapped.inner.y + branch_wrapped.weight)
for_wrapped = Wrapper.new(Point.new(close, open), high)
for i = 0 to 1
    for_wrapped.inner := Point.new(for_wrapped.inner.x + i + 10, for_wrapped.inner.y + i)
plot(for_wrapped.inner.x + for_wrapped.inner.y + for_wrapped.weight)
while_wrapped = Wrapper.new(Point.new(close, open), high)
while_i_nested = 0
while while_i_nested < 2
    while_wrapped.inner := Point.new(while_wrapped.inner.x + while_i_nested + 20, while_wrapped.inner.y + while_i_nested)
    while_i_nested := while_i_nested + 1
plot(while_wrapped.inner.x + while_wrapped.inner.y + while_wrapped.weight)
