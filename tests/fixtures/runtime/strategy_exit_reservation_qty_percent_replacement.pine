//@version=5
strategy("Exit reservation qty percent replacement")
if bar_index == 0
    strategy.entry("L", strategy.long, qty=2)
    strategy.exit("XP1", "L", limit=3, qty_percent=25)
    strategy.exit("XP2", "L", limit=2, qty_percent=25)
if bar_index == 1
    strategy.exit("XP1", "L", limit=3, qty_percent=75)
plot(strategy.position_size)
plot(strategy.netprofit)
