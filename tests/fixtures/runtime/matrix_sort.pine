//@version=6
indicator("Matrix sort")

values = matrix.new<float>(4, 3, na)
matrix.set(values, 0, 0, close + 2)
matrix.set(values, 0, 1, close + 30)
matrix.set(values, 0, 2, close + 200)
matrix.set(values, 1, 0, close + 1)
matrix.set(values, 1, 1, close + 10)
matrix.set(values, 1, 2, close + 100)
matrix.set(values, 2, 0, close + 4)
matrix.set(values, 2, 1, close + 20)
matrix.set(values, 2, 2, close + 400)
matrix.set(values, 3, 0, close + 3)
matrix.set(values, 3, 1, close + 20)
matrix.set(values, 3, 2, close + 300)
matrix.sort(values, 1)

descending = matrix.new<float>(4, 2, na)
matrix.set(descending, 0, 0, close + 2)
matrix.set(descending, 0, 1, close + 20)
matrix.set(descending, 1, 1, close + 99)
matrix.set(descending, 2, 0, close + 3)
matrix.set(descending, 2, 1, close + 30)
matrix.set(descending, 3, 0, close + 1)
matrix.set(descending, 3, 1, close + 10)
descending.sort(0, order.descending)

default_column = matrix.copy(values)
default_column.sort()

plot(matrix.rows(values), "rows")
plot(matrix.columns(values), "columns")
plot(matrix.get(values, 0, 0), "r0c0")
plot(matrix.get(values, 1, 0), "r1c0")
plot(matrix.get(values, 2, 0), "r2c0")
plot(matrix.get(values, 3, 0), "r3c0")
plot(matrix.get(descending, 0, 0), "desc_r0c0")
plot(matrix.get(descending, 1, 0), "desc_r1c0")
plot(matrix.get(descending, 2, 0), "desc_r2c0")
plot(matrix.get(descending, 3, 0), "desc_r3c0")
plot(matrix.get(default_column, 0, 0), "default_r0c0")
plot(matrix.get(default_column, 3, 0), "default_r3c0")
