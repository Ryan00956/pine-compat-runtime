//@version=5
strategy("Exit reservation qty trailing points multi")
if bar_index == 0
    strategy.entry("L", strategy.long, qty=2)
    strategy.exit("XT1", "L", trail_points=100, trail_offset=50, qty=0.75)
    strategy.exit("XT2", "L", trail_points=100, trail_offset=60, qty=0.5)
plot(strategy.position_size)
plot(strategy.netprofit)
