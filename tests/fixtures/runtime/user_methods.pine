//@version=5
indicator("User-defined methods")
type Point
    float x

makePoint(x) => Point.new(x)
makePointNamed(x) => Point.new(x=x)

method shift(Point p, float delta) => p.x + delta
method keep(Point p) => p
method keepBlock(Point p) =>
    copy = p
    copy
method choose(Point p, Point other) => other
method chooseBlock(Point p, Point other) =>
    copy = other
    copy
method wrap(Point p, Point other) => p.choose(other)
method clone(Point p) => Point.new(p.x)
method cloneOther(Point p, Point other) => Point.new(other.x)
method cloneOtherNamed(Point p, Point other) => Point.new(x=other.x)
method cloneAlias(Point p) =>
    ax = p.x
    Point.new(ax)
method cloneOtherAlias(Point p, Point other) =>
    ox = other.x
    Point.new(ox)
method cloneOtherNamedAlias(Point p, Point other) =>
    ox = other.x
    Point.new(x=ox)
method cloneObjectAlias(Point p) =>
    copy = p
    Point.new(copy.x)
method cloneOtherObjectAlias(Point p, Point other) =>
    copy = other
    Point.new(copy.x)
method cloneOtherNamedObjectAlias(Point p, Point other) =>
    copy = other
    Point.new(x=copy.x)
method cloneViaMake(Point p) => makePoint(p.x)
method cloneOtherViaMake(Point p, Point other) => makePoint(other.x)
method cloneOtherViaMakeNamed(Point p, Point other) => makePointNamed(other.x)
method cloneTernary(Point p, bool flip) => flip ? Point.new(p.x) : Point.new(p.x + 10)
method cloneSwitch(Point p, int mode) =>
    switch mode
        0 => Point.new(p.x)
        1 => Point.new(p.x + 5)
        => Point.new(p.x + 10)
method make(Point p, float x) => Point.new(x)
method makeBlock(Point p, float x) =>
    ax = x
    Point.new(ax)
method makeNamed(Point p, float x) => Point.new(x=x)
method makeNamedBlock(Point p, float x) =>
    ax = x
    Point.new(x=ax)

p = Point.new(close)
q = Point.new(open)
same = p.keep()
sameBlock = p.keepBlock()
chosen = p.choose(q)
chosenBlock = p.chooseBlock(q)
wrapped = p.wrap(q)
cloned = p.clone()
clonedOther = p.cloneOther(q)
clonedOtherNamed = p.cloneOtherNamed(q)
clonedAlias = p.cloneAlias()
clonedOtherAlias = p.cloneOtherAlias(q)
clonedOtherNamedAlias = p.cloneOtherNamedAlias(q)
clonedObjectAlias = p.cloneObjectAlias()
clonedOtherObjectAlias = p.cloneOtherObjectAlias(q)
clonedOtherNamedObjectAlias = p.cloneOtherNamedObjectAlias(q)
clonedViaMake = p.cloneViaMake()
clonedOtherViaMake = p.cloneOtherViaMake(q)
clonedOtherViaMakeNamed = p.cloneOtherViaMakeNamed(q)
clonedTernary = p.cloneTernary(bar_index < 2)
clonedSwitch = p.cloneSwitch(bar_index)
made = p.make(open)
madeBlock = p.makeBlock(open)
madeNamed = p.makeNamed(open)
madeNamedBlock = p.makeNamedBlock(open)
plot(p.shift(open))
plot(same.x + close)
plot(sameBlock.x + close)
plot(chosen.x + close)
plot(chosenBlock.x + close)
plot(wrapped.x + close)
plot(cloned.x + close)
plot(clonedOther.x + close)
plot(clonedOtherNamed.x + close)
plot(clonedAlias.x + close)
plot(clonedOtherAlias.x + close)
plot(clonedOtherNamedAlias.x + close)
plot(clonedObjectAlias.x + close)
plot(clonedOtherObjectAlias.x + close)
plot(clonedOtherNamedObjectAlias.x + close)
plot(clonedViaMake.x + close)
plot(clonedOtherViaMake.x + close)
plot(clonedOtherViaMakeNamed.x + close)
plot(clonedTernary.x + close)
plot(clonedSwitch.x + close)
plot(made.x + close)
plot(madeBlock.x + close)
plot(madeNamed.x + close)
plot(madeNamedBlock.x + close)
