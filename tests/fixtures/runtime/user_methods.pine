//@version=5
indicator("User-defined methods")
type Point
    float x

method shift(Point p, float delta) => p.x + delta
method keep(Point p) => p
method choose(Point p, Point other) => other

p = Point.new(close)
q = Point.new(open)
same = p.keep()
chosen = p.choose(q)
plot(p.shift(open))
plot(same.x + close)
plot(chosen.x + close)
