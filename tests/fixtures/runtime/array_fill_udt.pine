//@version=5
indicator("Array fill UDT")
type Point
    float x
    string tag

points = array.from(Point.new(1.0, "a"), Point.new(2.0, "b"), Point.new(3.0, "c"))
array.fill(points, Point.new(9.0, "fill"), 1, 3)
first = points.get(0)
second = points.get(1)
third = points.get(2)
plot(first.x * 100 + second.x * 10 + third.x)
plot(str.length(first.tag) * 100 + str.length(second.tag) * 10 + str.length(third.tag))

method_points = array.from(Point.new(4.0, "left"), Point.new(5.0, "right"))
method_points.fill(Point.new(7.0, "all"))
method_first = method_points.get(0)
method_second = method_points.get(1)
plot(method_first.x * 10 + method_second.x)
plot(str.length(method_first.tag) * 10 + str.length(method_second.tag))
