//@version=6
indicator("Matrix float")

values = matrix.new<float>(2, 3, close)
first = matrix.get(values, 0, 0)
before = matrix.get(values, 1, 2)
matrix.set(values, 1, 2, close + 10)
after = matrix.get(values, 1, 2)
matrix.fill(values, close + 20)
filled_first = matrix.get(values, 0, 0)
filled_last = matrix.get(values, 1, 2)

default_values = matrix.new<float>(1, 2)
default_cell = matrix.get(default_values, 0, 1)
int_initial = matrix.new<float>(1, 1, 7)
int_cell = matrix.get(int_initial, 0, 0)
matrix.fill(int_initial, 9)
filled_int_cell = matrix.get(int_initial, 0, 0)

method_values = matrix.new<float>(1, 2, close)
method_values.fill(close + 30)
method_first = matrix.get(method_values, 0, 0)
method_last = matrix.get(method_values, 0, 1)
method_get_first = method_values.get(0, 0)
method_get_last = method_values.get(0, 1)
method_values.set(0, 1, close + 40)
method_set_first = matrix.get(method_values, 0, 0)
method_set_last = matrix.get(method_values, 0, 1)
method_rows = method_values.rows()
method_columns = method_values.columns()

plot(matrix.rows(values), "rows")
plot(matrix.columns(values), "columns")
plot(first, "first")
plot(before, "before")
plot(after, "after")
plot(filled_first, "filled_first")
plot(filled_last, "filled_last")
plot(default_cell, "default_cell")
plot(int_cell, "int_cell")
plot(filled_int_cell, "filled_int_cell")
plot(method_first, "method_first")
plot(method_last, "method_last")
plot(method_get_first, "method_get_first")
plot(method_get_last, "method_get_last")
plot(method_set_first, "method_set_first")
plot(method_set_last, "method_set_last")
plot(method_rows, "method_rows")
plot(method_columns, "method_columns")
