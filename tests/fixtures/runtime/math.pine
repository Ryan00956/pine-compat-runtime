//@version=5
indicator("Math")
x = math.max(math.abs(close - 3), math.round(close / 2), 1)
y = math.min(x, 3.5)
avg_value = math.avg(open, close, high, low)
avg_offset_relation = math.avg(close, close + 2, close + 4) - (close + 2)
floor_value = math.floor(close / 2)
ceil_value = math.ceil(close / 2 - 0.25)
trunc_value = math.trunc(close / 2 + 0.75)
sqrt_value = math.sqrt(close)
cbrt_value = math.cbrt(close)
log_value = math.log(close)
log10_value = math.log10(close)
exp_value = math.exp(close)
acos_value = math.acos(close - 2)
asin_value = math.asin(close - 2)
atan_value = math.atan(close)
sign_value = math.sign(close - 2)
degrees_value = math.todegrees(close)
radians_value = math.toradians(close)
constants = math.pi + math.e + math.phi + math.rphi
sin_value = math.sin(close)
cos_value = math.cos(close)
tan_value = math.tan(close)
pow_value = math.pow(close, 2)
hypot_value = math.hypot(close, close + 1)
rounded_precision = math.round(close / 3, 2)
rounded_mintick = math.round_to_mintick(close + 0.006)
mintick = syminfo.mintick
seeded_random = math.random(10, 20, 7)
default_random = math.random()
sum_value = math.sum(close, 3)
sum_after_na = math.sum(bar_index == 1 ? na : close, 2)
max_offset_relation = math.max(close - 1, close + 2, close) - (close + 2)
min_offset_relation = math.min(close + 1, close - 2, close) - (close - 2)
abs_symmetry_relation = math.abs(close - 2) - math.abs(2 - close)
sign_symmetry_relation = math.sign(close - 2) + math.sign(2 - close)
degree_radian_roundtrip = math.toradians(math.todegrees(close)) - close
pow_square_relation = math.pow(close, 2) - close * close
sqrt_square_relation = math.sqrt(close * close) - math.abs(close)
cbrt_cube_relation = math.cbrt(close * close * close) - close
log_exp_roundtrip = math.log(math.exp(close)) - close
log10_pow10_roundtrip = math.log10(math.pow(10, close)) - close
inverse_trig_input = math.min(1, math.max(-1, close - 2))
acos_asin_complement = math.acos(inverse_trig_input) + math.asin(inverse_trig_input) - math.pi / 2
atan_unit_relation = math.atan(close / close) * 4 - math.pi
e_exp_relation = math.exp(1) - math.e
pi_degrees_relation = math.todegrees(math.pi) - 180
phi_rphi_difference_relation = math.phi - math.rphi - 1
trig_zero_relation = math.sin(close - close) + math.tan(close - close) + math.cos(close - close) - 1
hypot_abs_relation = math.hypot(close, 0) - math.abs(close)
plot(x)
plot(y)
plot(avg_value)
plot(avg_offset_relation)
plot(floor_value + ceil_value)
plot(trunc_value)
plot(sqrt_value)
plot(cbrt_value)
plot(log_value)
plot(log10_value)
plot(exp_value)
plot(acos_value)
plot(asin_value)
plot(atan_value)
plot(sign_value)
plot(degrees_value)
plot(radians_value)
plot(constants)
plot(sin_value)
plot(cos_value)
plot(tan_value)
plot(pow_value)
plot(hypot_value)
plot(rounded_precision)
plot(rounded_mintick)
plot(mintick)
plot(seeded_random)
plot(default_random)
plot(sum_value)
plot(sum_after_na)
plot(max_offset_relation)
plot(min_offset_relation)
plot(abs_symmetry_relation)
plot(sign_symmetry_relation)
plot(degree_radian_roundtrip)
plot(pow_square_relation)
plot(sqrt_square_relation)
plot(cbrt_cube_relation)
plot(log_exp_roundtrip)
plot(log10_pow10_roundtrip)
plot(acos_asin_complement)
plot(atan_unit_relation)
plot(e_exp_relation)
plot(pi_degrees_relation)
plot(phi_rphi_difference_relation)
plot(trig_zero_relation)
plot(hypot_abs_relation)
