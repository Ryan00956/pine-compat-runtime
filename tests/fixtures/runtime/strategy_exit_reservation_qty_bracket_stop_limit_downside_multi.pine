//@version=5
strategy("Exit reservation qty bracket downside multi")
if bar_index == 0
    strategy.entry("L", strategy.long, qty=2)
    strategy.exit("XB1", "L", stop=2.5, limit=10, qty=0.75)
    strategy.exit("XB2", "L", stop=2.25, limit=11, qty=0.5)
plot(strategy.position_size)
plot(strategy.netprofit)
