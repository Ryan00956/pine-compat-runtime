//@version=5
indicator("Box array")
var boxes = array.new_box()
var box_concat_checks = array.new_bool()
if bar_index == 0
    first = box.new(bar_index, high, bar_index + 1, low)
    second = box.copy(first)
    empty_slot = array.new_box(1)
    seeded = array.new_box(2, first)
    if na(empty_slot.get(0)) and seeded.size() == 2
        box.set_text(seeded.get(1), "seeded")
    boxes.push(first)
    boxes.unshift(second)
    boxes.insert(1, first)
    boxes.remove(-1)
if bar_index == 1
    copied = boxes.copy()
    saved = copied.get(0)
    boxes.set(0, saved)
    box.set_text(saved, "copied")
    box.set_bgcolor(boxes.last(), color.green)
    box.set_left(boxes.first(), bar_index)
if bar_index == 2
    shifted = boxes.shift()
    boxes.push(shifted)
    boxes.reverse()
    boxes.fill(boxes.first(), 0, 1)
    sliced = boxes.slice(0, 1)
    sliced.concat(boxes)
    empty_boxes = array.new_box()
    before_empty_box_concat = boxes.size()
    boxes.concat(empty_boxes)
    box_concat_checks.push(boxes.size() == before_empty_box_concat and empty_boxes.size() == 0)
    empty_box_target = array.new_box()
    source_box_size = boxes.size()
    source_box_first = boxes.get(0)
    empty_box_target.concat(boxes)
    box_concat_checks.push(empty_box_target.size() == source_box_size and empty_box_target.get(0) == source_box_first and boxes.size() == source_box_size and boxes.get(0) == source_box_first)
    box.set_bottom(sliced.get(0), close)
    if boxes.includes(boxes.first())
        box.set_text(boxes.first(), "found")
    box.set_right(boxes.get(boxes.indexof(boxes.first())), bar_index + 2)
    box.set_border_color(boxes.get(boxes.lastindexof(boxes.last())), color.blue)
if bar_index == 3
    from_values = array.from(boxes.get(0))
    box.set_border_width(from_values.get(0), 2)
    popped = boxes.pop()
    box.set_top(popped, high)
    boxes.push(popped)
    scratch = boxes.copy()
    scratch.clear()
plot(boxes.size())
plot(close)
plot(box_concat_checks.size() == 2 and box_concat_checks.get(0) and box_concat_checks.get(1) ? 1 : 0)
