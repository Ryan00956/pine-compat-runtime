//@version=5
indicator("Box array")
var boxes = array.new_box()
if bar_index == 0
    first = box.new(bar_index, high, bar_index + 1, low)
    second = box.copy(first)
    array.push(boxes, first)
    array.unshift(boxes, second)
    array.insert(boxes, 1, first)
    array.remove(boxes, -1)
if bar_index == 1
    copied = array.copy(boxes)
    saved = array.get(copied, 0)
    array.set(boxes, 0, saved)
    box.set_text(saved, "copied")
    box.set_bgcolor(array.last(boxes), color.green)
    box.set_left(array.first(boxes), bar_index)
if bar_index == 2
    shifted = array.shift(boxes)
    array.push(boxes, shifted)
    array.reverse(boxes)
    array.fill(boxes, array.first(boxes), 0, 1)
    sliced = array.slice(boxes, 0, 1)
    array.concat(sliced, boxes)
    box.set_bottom(array.get(sliced, 0), close)
    if array.includes(boxes, array.first(boxes))
        box.set_text(array.first(boxes), "found")
    box.set_right(array.get(boxes, array.indexof(boxes, array.first(boxes))), bar_index + 2)
    box.set_border_color(array.get(boxes, array.lastindexof(boxes, array.last(boxes))), color.blue)
if bar_index == 3
    from_values = array.from(array.get(boxes, 0))
    box.set_border_width(from_values.get(0), 2)
    popped = array.pop(boxes)
    box.set_top(popped, high)
    array.push(boxes, popped)
    scratch = array.copy(boxes)
    scratch.clear()
plot(array.size(boxes))
plot(close)
