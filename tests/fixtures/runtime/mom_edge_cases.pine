//@version=5
indicator("Momentum edge cases")
value = ta.mom(close, 2)
index_value = ta.mom(bar_index, 2)
dynamic_length = bar_index == 0 ? 1 : 2
dynamic_value = ta.mom(close, dynamic_length)
udf_length() =>
    bar_index == 0 ? 1 : 2
udf_value = ta.mom(close, udf_length())
current_na = ta.mom(bar_index == 3 ? na : close, 2)
history_na = ta.mom(bar_index == 2 ? na : close, 2)
invalid = ta.mom(close, 0)
plot(value)
plot(index_value)
plot(dynamic_value)
plot(udf_value)
plot(current_na)
plot(history_na)
plot(invalid)
