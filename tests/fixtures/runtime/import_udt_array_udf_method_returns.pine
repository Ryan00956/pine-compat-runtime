builtin_empty_size = array.new<left.First>().size()
builtin_empty_last = array.new<left.First>().last()
builtin_none_size = array.copy(left.noneFirst()).size()
plot(builtin_empty_size)
plot(na(builtin_empty_last) ? 1 : 0)
plot(na(builtin_none_size) ? 1 : 0)

builtin_copy_source = array.from(left.First.new(80.0, 800.0))
builtin_independent_copy = array.copy(builtin_copy_source).copy()
