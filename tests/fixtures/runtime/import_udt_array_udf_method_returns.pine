//@version=6
import user/udt_array_returns/1 as left
import user/udt_array_returns/1 as right
indicator("Imported UDT array UDF and method returns")

readPostfix(values) =>
    item = left.direct(values).copy().first()
    item.shared

readAccessors(values) =>
    head = left.direct(values).get(index=0)
    tail = left.direct(values).last()
    left.direct(values).size() + head.shared + tail.shared

left_first_values = array.from(left.First.new(11.0, 101.0), left.First.new(12.0, 102.0))
left_second_values = array.from(left.Second.new(201.0, 21.0), left.Second.new(202.0, 22.0))
right_first_values = array.from(right.First.new(31.0, 301.0), right.First.new(32.0, 302.0))
right_second_values = array.from(right.Second.new(401.0, 41.0), right.Second.new(402.0, 42.0))

left_direct_first = left.direct(left_first_values)
left_direct_second = left.direct(left_second_values)
left_direct_first_again = left.direct(left_first_values)
right_direct_first = right.direct(right_first_values)
left_direct_after_right = left.direct(left_first_values)

left_alias_first = left.aliasReturn(left_first_values)
left_copy_second = left.copyReturn(left_second_values)
left_nested_first = left.nestedReturn(left_first_values)
left_nested_copy_second = left.nestedCopyReturn(left_second_values)
left_from_first = left.firstFrom(left.First.new(13.0, 103.0))
left_new_second = left.secondNew(left.Second.new(203.0, 23.0))
left_shadowed_typed = left.shadowedTyped(left.First.new(15.0, 105.0))
right_from_first = right.firstFrom(right.First.new(33.0, 303.0))
left_from_first_again = left.firstFrom(left.First.new(16.0, 106.0))
right_new_second = right.secondNew(right.Second.new(403.0, 43.0))
left_new_second_again = left.secondNew(left.Second.new(206.0, 26.0))
left_flow_first = left.flowReturn(left_first_values)
left_loop_second = left.loopReturn(left_second_values)

left_first_anchor = left.First.new(14.0, 104.0)
left_second_anchor = left.Second.new(204.0, 24.0)
right_first_anchor = right.First.new(34.0, 304.0)
right_second_anchor = right.Second.new(404.0, 44.0)
left_method_first = left_first_anchor.retainFirst(values=left_first_values)
left_method_second = left.retainSecond(left_second_anchor, values=left_second_values)
left_same_method_first = left_first_anchor.retain(copy_values=false, values=left_first_values)
left_same_method_second = left.retain(left_second_anchor, copy_values=true, values=left_second_values)
left_method_copy = left_first_anchor.copyFirst(left_first_values)
left_method_nested = left.nestedSecond(left_second_anchor, left_second_values)
left_method_from = left_first_anchor.fromFirst()
left_method_new = left.newSecond(left_second_anchor)
left_method_flow = left_first_anchor.flowFirst(left_first_values)
right_method_first = right_first_anchor.retainFirst(right_first_values)
right_method_second = right.retainSecond(right_second_anchor, right_second_values)

left_direct_first_item = array.first(left_direct_first)
left_direct_second_item = array.first(left_direct_second)
left_direct_first_again_item = array.first(left_direct_first_again)
right_direct_first_item = array.first(right_direct_first)
left_direct_after_right_item = array.first(left_direct_after_right)
plot(left_direct_first_item.shared)
plot(left_direct_second_item.shared)
plot(left_direct_first_again_item.shared)
plot(right_direct_first_item.shared)
plot(left_direct_after_right_item.shared)

left_alias_first_item = array.first(left_alias_first)
left_copy_second_item = array.first(left_copy_second)
left_nested_first_item = array.first(left_nested_first)
left_nested_copy_second_item = array.first(left_nested_copy_second)
left_from_first_item = array.first(left_from_first)
left_new_second_item = array.first(left_new_second)
left_shadowed_typed_item = array.first(left_shadowed_typed)
right_from_first_item = array.first(right_from_first)
left_from_first_again_item = array.first(left_from_first_again)
right_new_second_item = array.first(right_new_second)
left_new_second_again_item = array.first(left_new_second_again)
left_flow_first_item = array.first(left_flow_first)
left_loop_second_item = array.first(left_loop_second)
plot(left_alias_first_item.shared)
plot(left_copy_second_item.shared)
plot(left_nested_first_item.shared)
plot(left_nested_copy_second_item.shared)
plot(left_from_first_item.shared)
plot(left_new_second_item.shared)
plot(left_shadowed_typed_item.shared)
plot(right_from_first_item.shared)
plot(left_from_first_again_item.shared)
plot(right_new_second_item.shared)
plot(left_new_second_again_item.shared)
plot(left_flow_first_item.shared)
plot(left_loop_second_item.shared)

left_method_first_item = array.first(left_method_first)
left_method_second_item = array.first(left_method_second)
left_same_method_first_item = array.first(left_same_method_first)
left_same_method_second_item = array.first(left_same_method_second)
left_method_copy_item = array.first(left_method_copy)
left_method_nested_item = array.first(left_method_nested)
left_method_from_item = array.first(left_method_from)
left_method_new_item = array.first(left_method_new)
left_method_flow_item = array.first(left_method_flow)
right_method_first_item = array.first(right_method_first)
right_method_second_item = array.first(right_method_second)
plot(left_method_first_item.shared)
plot(left_method_second_item.shared)
plot(left_same_method_first_item.shared)
plot(left_same_method_second_item.shared)
plot(left_method_copy_item.shared)
plot(left_method_nested_item.shared)
plot(left_method_from_item.shared)
plot(left_method_new_item.shared)
plot(left_method_flow_item.shared)
plot(right_method_first_item.shared)
plot(right_method_second_item.shared)

float returned_total = 0.0
for item in left_nested_copy_second
    returned_total := returned_total + item.shared
plot(returned_total)

array<left.First> typed_left_first = left.flowReturn(left_first_values)
typed_left_first_item = array.first(typed_left_first)
plot(typed_left_first_item.shared)

direct_namespace_item = array.first(left.direct(left_first_values))
plot(direct_namespace_item.shared)

postfix_udf_first_item = left.direct(left_first_values).first()
postfix_udf_second_item = left.direct(left_second_values).first()
postfix_udf_first_again_item = left.direct(left_first_values).first()
postfix_right_first_item = right.direct(right_first_values).first()
postfix_left_after_right_item = left.direct(left_first_values).first()
plot(postfix_udf_first_item.shared)
plot(postfix_udf_second_item.shared)
plot(postfix_udf_first_again_item.shared)
plot(postfix_right_first_item.shared)
plot(postfix_left_after_right_item.shared)

postfix_method_first_item = left_first_anchor.retainFirst(left_first_values).first()
postfix_method_second_item = left_second_anchor.retainSecond(left_second_values).first()
postfix_method_first_again_item = left_first_anchor.retainFirst(left_first_values).first()
plot(postfix_method_first_item.shared)
plot(postfix_method_second_item.shared)
plot(postfix_method_first_again_item.shared)

postfix_copy_first_item = left.direct(left_first_values).copy().first()
postfix_copy_second_item = left.direct(left_second_values).copy().first()
postfix_copy_first_again_item = left.direct(left_first_values).copy().first()
postfix_method_copy = left_first_anchor.retainFirst(left_first_values).copy()
postfix_method_copy_item = array.first(postfix_method_copy)
plot(postfix_copy_first_item.shared)
plot(postfix_copy_second_item.shared)
plot(postfix_copy_first_again_item.shared)
plot(postfix_method_copy_item.shared)

explicit_first = left.first(left_first_values)
explicit_copy_item = array.first(left.copy(left_first_values))
plot(explicit_first)
plot(explicit_copy_item.shared)

scalar_method_first = left.First.new(30.0, 300.0).first()
scalar_method_copy = left.First.new(40.0, 400.0).copy()
plot(scalar_method_first)
plot(scalar_method_copy)

scalar_udf_result_first = left.scalar(left.First.new(50.0, 500.0)).first()
scalar_udf_result_copy = left.scalar(left.First.new(60.0, 600.0)).copy()
scalar_method_result_first = left.First.new(70.0, 700.0).scalar().first()
scalar_method_result_copy = left.First.new(80.0, 800.0).scalar().copy()
type_changed_method_result = left_first_anchor.toSecond().readShared()
plot(scalar_udf_result_first)
plot(scalar_udf_result_copy)
plot(scalar_method_result_first)
plot(scalar_method_result_copy)
plot(type_changed_method_result)

postfix_independent_copy = left.direct(left_first_values).copy()
array.push(postfix_independent_copy, left.First.new(17.0, 107.0))
plot(array.size(left_first_values))
plot(array.size(postfix_independent_copy))

postfix_wrapper_first = readPostfix(left_first_values)
postfix_wrapper_second = readPostfix(left_second_values)
postfix_wrapper_first_again = readPostfix(left_first_values)
plot(postfix_wrapper_first)
plot(postfix_wrapper_second)
plot(postfix_wrapper_first_again)

postfix_size_first = left.direct(left_first_values).size()
postfix_size_second = left.direct(left_second_values).size()
postfix_size_first_again = left.direct(left_first_values).size()
postfix_get_first = left.direct(left_first_values).get(index=0)
postfix_get_second = left.direct(left_second_values).get(0)
postfix_get_first_again = left.direct(left_first_values).get(0)
postfix_last_first = left.direct(left_first_values).last()
postfix_last_second = left.direct(left_second_values).last()
postfix_last_first_again = left.direct(left_first_values).last()
postfix_right_get = right.direct(right_first_values).get(index=0)
postfix_left_after_right_get = left.direct(left_first_values).get(0)
postfix_copy_get = left.direct(left_first_values).copy().get(index=1)
postfix_copy_last = left.direct(left_second_values).copy().last()
postfix_method_get = left.retainFirst(left_first_anchor, left_first_values).get(index=1)
postfix_method_last = left_second_anchor.retainSecond(values=left_second_values).last()
plot(postfix_size_first)
plot(postfix_size_second)
plot(postfix_size_first_again)
plot(postfix_get_first.shared)
plot(postfix_get_second.shared)
plot(postfix_get_first_again.shared)
plot(postfix_last_first.shared)
plot(postfix_last_second.shared)
plot(postfix_last_first_again.shared)
plot(postfix_right_get.shared)
plot(postfix_left_after_right_get.shared)
plot(postfix_copy_get.shared)
plot(postfix_copy_last.shared)
plot(postfix_method_get.shared)
plot(postfix_method_last.shared)

wrapped_access_first = readAccessors(left_first_values)
wrapped_access_second = readAccessors(left_second_values)
wrapped_access_first_again = readAccessors(left_first_values)
plot(wrapped_access_first)
plot(wrapped_access_second)
plot(wrapped_access_first_again)

explicit_size = left.size(left.direct(left_first_values))
explicit_get = left.get(left.direct(left_first_values), 0)
explicit_last = left.last(left.direct(left_first_values))
scalar_result_size = left.First.new(2.0, 20.0).size()
scalar_result_get = left.First.new(3.0, 30.0).get(index=1)
scalar_result_last = left.First.new(4.0, 40.0).last()
plot(explicit_size)
plot(explicit_get)
plot(explicit_last)
plot(scalar_result_size)
plot(scalar_result_get)
plot(scalar_result_last)

empty_size = left.emptyFirst().size()
empty_last = left.emptyFirst().last()
none_size = left.noneFirst().size()
none_get = left.noneFirst().get(0)
none_last = left.noneFirst().last()
na_index_get = left.direct(left_first_values).get(na)
negative_index_get = left.direct(left_first_values).get(-1)
plot(empty_size)
plot(na(empty_last) ? 1 : 0)
plot(na(none_size) and na(none_get) and na(none_last) ? 1 : 0)
plot(na(na_index_get) ? 1 : 0)
plot(negative_index_get.shared)

historical_return = left.direct(left_first_values)[1]
historical_item = array.first(historical_return)
plot(historical_item.shared)

alias_identity_source = array.from(left.First.new(70.0, 700.0))
alias_identity_return = left.aliasReturn(alias_identity_source)
array.push(alias_identity_return, left.First.new(71.0, 701.0))
plot(array.size(alias_identity_source))
plot(array.size(alias_identity_return))

copy_identity_source = array.from(left.Second.new(800.0, 80.0))
copy_identity_return = left.copyReturn(copy_identity_source)
array.push(copy_identity_return, left.Second.new(801.0, 81.0))
plot(array.size(copy_identity_source))
plot(array.size(copy_identity_return))
