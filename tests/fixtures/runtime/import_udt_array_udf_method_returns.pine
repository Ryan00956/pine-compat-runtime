local_first_item = localIdentity(left_first_values).first()
local_last_item = localIdentity(left_second_values).last()
local_copy_get = localIdentity(left_first_values).copy().get(index=1)
local_right_get = localIdentity(right_first_values).get(0)
local_left_after_right_get = localIdentity(left_first_values).get(0)
plot(local_size_first)
