builtin_concat_right_item = array.concat(builtin_concat_right_a, builtin_concat_right_b).get(index=1)
builtin_concat_left_again_item = array.concat(builtin_concat_left_again_a, builtin_concat_left_again_b).copy().last()
plot(builtin_concat_left_item.shared + builtin_concat_right_item.shared + builtin_concat_left_again_item.shared)

builtin_sort_left = array.sort_indices(left_first_values, order.ascending, "shared").last()
builtin_sort_right = array.sort_indices(right_first_values, order.ascending, "shared").first()
builtin_sort_left_again = array.sort_indices(left_first_values, order.ascending, "shared").last()
