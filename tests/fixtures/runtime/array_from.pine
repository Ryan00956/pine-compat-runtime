indicator("Array from fixture")
ints = array.from(1, 2, 3)
plot(ints.size())
plot(ints.sum())
ints.push(4)
plot(ints.last())

floats = array.from(1, close, na)
plot(floats.get(0) + floats.get(1))
plot(na(floats.get(2)) ? 1 : 0)

flags = array.from(true, false)
plot(flags.get(0) and not flags.get(1) ? 1 : 0)

words = array.from("a", "b")
plot(words.join("|") == "a|b" ? 1 : 0)

colors = array.from(color.red, color.green)
plot(colors.get(0) == color.red and colors.get(1) == color.green ? 1 : 0)

branch_from_score = bar_index * 0.0
if bar_index % 2 == 0
    branch_from_ints = array.from(1, 2, bar_index)
    branch_from_score := branch_from_ints.size() * 100 + branch_from_ints.get(0) * 10 + branch_from_ints.get(2)
else
    branch_from_floats = array.from(1, close, na)
    branch_from_score := branch_from_floats.get(0) * 100 + branch_from_floats.get(1) * 10 + (na(branch_from_floats.get(2)) ? 1 : 0)
plot(branch_from_score)

loop_from_score = bar_index * 0
for i = 0 to 2
    if i == 0
        loop_flags = array.from(i == 0, false)
        loop_from_score := loop_from_score + (loop_flags.get(0) and not loop_flags.get(1) ? 100 : 0)
    else if i == 1
        loop_words = array.from("a", "b")
        loop_from_score := loop_from_score + (loop_words.join("|") == "a|b" ? 10 : 0)
    else
        loop_colors = array.from(color.red, color.green)
        loop_from_score := loop_from_score + (loop_colors.get(0) == color.red and loop_colors.get(1) == color.green ? 1 : 0)
plot(loop_from_score)
