//@version=6
indicator("Matrix inverse")

values = matrix.new<float>(2, 2, na)
matrix.set(values, 0, 0, 4)
matrix.set(values, 0, 1, 7)
matrix.set(values, 1, 0, 2)
matrix.set(values, 1, 1, 6)

namespace_inv = matrix.inv(values)
method_inv = values.inv()
matrix.set(values, 0, 0, 99)

singular = matrix.new<float>(2, 2, na)
matrix.set(singular, 0, 0, 1)
matrix.set(singular, 0, 1, 2)
matrix.set(singular, 1, 0, 2)
matrix.set(singular, 1, 1, 4)

all_na = matrix.new<float>(1, 1)
empty_inv = matrix.inv(matrix.new<float>(0, 0))

plot(matrix.get(namespace_inv, 0, 0), "namespace_00")
plot(matrix.get(namespace_inv, 0, 1), "namespace_01")
plot(matrix.get(namespace_inv, 1, 0), "namespace_10")
plot(matrix.get(namespace_inv, 1, 1), "namespace_11")
plot(matrix.get(method_inv, 0, 0), "method_00")
plot(na(matrix.inv(singular)) ? 1 : 0, "singular_is_na")
plot(na(matrix.inv(all_na)) ? 1 : 0, "all_na_is_na")
plot(matrix.rows(empty_inv), "empty_rows")
plot(matrix.columns(empty_inv), "empty_columns")
plot(matrix.elements_count(empty_inv), "empty_cells")
