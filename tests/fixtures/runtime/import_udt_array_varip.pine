//@version=6
import user/udt/1 as lib
indicator("Imported UDT array varip")

varip array<lib.Point> points = array.from(lib.Point.new(close))
points.push(lib.Point.new(close + 10))

varip lib.Point[] alias = points
alias.push(lib.Point.new(close + 20))

varip copied = points.copy()
copied.push(lib.Point.new(close + 30))

varip array<lib.Wrapper> wrappers = array.from(lib.Wrapper.new(lib.Point.new(close + 100)))
wrappers.push(lib.Wrapper.new(lib.Point.new(close + 110)))

varip lib.Wrapper[] wrapper_alias = wrappers
wrapper_alias.push(lib.Wrapper.new(lib.Point.new(close + 120)))

varip array<lib.Point> new_points = array.new<lib.Point>(1, lib.Point.new(close + 200))
new_points.push(lib.Point.new(close + 210))

varip lib.Point[] new_alias = new_points
new_alias.push(lib.Point.new(close + 220))

varip array<lib.Wrapper> new_wrappers = array.new<lib.Wrapper>(1, lib.Wrapper.new(lib.Point.new(close + 300)))
new_wrappers.push(lib.Wrapper.new(lib.Point.new(close + 310)))

varip lib.Wrapper[] new_wrapper_alias = new_wrappers
new_wrapper_alias.push(lib.Wrapper.new(lib.Point.new(close + 320)))

first = points.get(0)
last = alias.last()
copy_last = copied.last()
wrapper_first = wrappers.get(0)
wrapper_last = wrapper_alias.last()
new_first = new_points.get(0)
new_last = new_alias.last()
new_wrapper_first = new_wrappers.get(0)
new_wrapper_last = new_wrapper_alias.last()

plot(points.size(), "points_size")
plot(first.x, "first_x")
plot(last.x, "last_x")
plot(copied.size(), "copied_size")
plot(copy_last.x, "copy_last_x")
plot(wrappers.size(), "wrapper_points_size")
plot(wrapper_first.nested.x, "wrapper_first_x")
plot(wrapper_last.nested.x, "wrapper_last_x")
plot(new_points.size(), "new_points_size")
plot(new_first.x, "new_first_x")
plot(new_last.x, "new_last_x")
plot(new_wrappers.size(), "new_wrapper_points_size")
plot(new_wrapper_first.nested.x, "new_wrapper_first_x")
plot(new_wrapper_last.nested.x, "new_wrapper_last_x")
