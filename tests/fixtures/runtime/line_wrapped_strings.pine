indicator("Line-wrapped strings")
double = "Pine
 Script"
many_spaces = "first
     second
  third"
single = 'alpha
    beta'
utf8 = "中
  文"
escaped = "line one
  line two\nend"
plot(double == "Pine Script" ? 1 : 0)
plot(many_spaces == "first second third" ? 1 : 0)
plot(single == "alpha beta" ? 1 : 0)
plot(utf8 == "中 文" ? 1 : 0)
plot(escaped == "line one line two\nend" ? 1 : 0)
