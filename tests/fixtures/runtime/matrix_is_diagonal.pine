//@version=6
indicator("Matrix is_diagonal")

diagonal = matrix.new<float>(2, 2, 0)
matrix.set(diagonal, 0, 0, close)
matrix.set(diagonal, 1, 1, close + 1)
rectangular = matrix.new<float>(2, 3, 0)
matrix.set(rectangular, 0, 0, 1)
matrix.set(rectangular, 1, 1, 2)
non_diagonal = matrix.copy(diagonal)
matrix.set(non_diagonal, 0, 1, 1)
off_diagonal_na = matrix.new<float>(2, 2, 0)
matrix.set(off_diagonal_na, 0, 1, na)
diagonal_na = matrix.new<float>(2, 2, 0)
matrix.set(diagonal_na, 0, 0, na)
zero_rows = matrix.new<float>(0, 2)

antidiagonal = matrix.new<float>(3, 3, 0)
matrix.set(antidiagonal, 0, 2, close)
matrix.set(antidiagonal, 1, 1, na)
matrix.set(antidiagonal, 2, 0, close + 1)
antidiagonal_outside_na = matrix.new<float>(2, 2, 0)
matrix.set(antidiagonal_outside_na, 0, 0, na)
antidiagonal_na = matrix.new<float>(2, 2, 0)
matrix.set(antidiagonal_na, 0, 1, na)
empty_antidiagonal = matrix.new<float>(0, 0)
int_antidiagonal = matrix.new<int>(2, 2, 0)
matrix.set(int_antidiagonal, 0, 1, 1)
matrix.set(int_antidiagonal, 1, 0, 2)

upper_triangular = matrix.new<float>(3, 3, 0)
matrix.set(upper_triangular, 0, 1, 1)
matrix.set(upper_triangular, 0, 2, 2)
matrix.set(upper_triangular, 1, 2, 3)
lower_triangular = matrix.new<float>(3, 3, 0)
matrix.set(lower_triangular, 1, 0, 1)
matrix.set(lower_triangular, 2, 0, 2)
matrix.set(lower_triangular, 2, 1, 3)
non_triangular = matrix.new<float>(2, 2, 0)
matrix.set(non_triangular, 0, 1, 1)
matrix.set(non_triangular, 1, 0, 1)
triangular_one_side_na = matrix.new<float>(2, 2, 0)
matrix.set(triangular_one_side_na, 0, 1, na)
triangular_two_side_invalid = matrix.new<float>(2, 2, 0)
matrix.set(triangular_two_side_invalid, 0, 1, na)
matrix.set(triangular_two_side_invalid, 1, 0, 1)
int_triangular = matrix.new<int>(2, 2, 0)
matrix.set(int_triangular, 1, 0, 2)

plot(matrix.is_diagonal(diagonal) ? 1 : 0, "diagonal")
plot(rectangular.is_diagonal() ? 1 : 0, "rectangular")
plot(matrix.is_diagonal(non_diagonal) ? 1 : 0, "non_diagonal")
plot(off_diagonal_na.is_diagonal() ? 1 : 0, "off_diagonal_na")
plot(matrix.is_diagonal(diagonal_na) ? 1 : 0, "diagonal_na")
plot(zero_rows.is_diagonal() ? 1 : 0, "zero_rows")
plot(matrix.is_antidiagonal(antidiagonal) ? 1 : 0, "antidiagonal")
plot(rectangular.is_antidiagonal() ? 1 : 0, "antidiagonal_rectangular")
plot(matrix.is_antidiagonal(diagonal) ? 1 : 0, "non_antidiagonal")
plot(antidiagonal_outside_na.is_antidiagonal() ? 1 : 0, "antidiagonal_outside_na")
plot(matrix.is_antidiagonal(antidiagonal_na) ? 1 : 0, "antidiagonal_na")
plot(empty_antidiagonal.is_antidiagonal() ? 1 : 0, "antidiagonal_empty")
plot(int_antidiagonal.is_antidiagonal() ? 1 : 0, "int_antidiagonal")
plot(matrix.is_triangular(upper_triangular) ? 1 : 0, "upper_triangular")
plot(lower_triangular.is_triangular() ? 1 : 0, "lower_triangular")
plot(matrix.is_triangular(non_triangular) ? 1 : 0, "non_triangular")
plot(rectangular.is_triangular() ? 1 : 0, "triangular_rectangular")
plot(matrix.is_triangular(diagonal_na) ? 1 : 0, "triangular_diagonal_na")
plot(triangular_one_side_na.is_triangular() ? 1 : 0, "triangular_one_side_na")
plot(matrix.is_triangular(triangular_two_side_invalid) ? 1 : 0, "triangular_two_side_invalid")
plot(int_triangular.is_triangular() ? 1 : 0, "int_triangular")
plot(matrix.is_triangular(empty_antidiagonal) ? 1 : 0, "triangular_empty")
