//@version=5
strategy("Closed trade fields pyramiding", pyramiding=2)
if bar_index == 0
    strategy.entry("L1", strategy.long, qty=1, comment="first")
if bar_index == 1
    strategy.entry("L2", strategy.long, qty=3, comment="second")
if bar_index == 2
    strategy.close_all(comment="closed")

plot(strategy.closedtrades)
plot(strategy.closedtrades.entry_price(0))
plot(strategy.closedtrades.entry_price(1))
plot(na(strategy.closedtrades.entry_id(0)) ? na : strategy.closedtrades.entry_id(0) == "L1" ? 1 : 0)
plot(na(strategy.closedtrades.entry_id(1)) ? na : strategy.closedtrades.entry_id(1) == "L2" ? 1 : 0)
plot(na(strategy.closedtrades.entry_comment(0)) ? na : strategy.closedtrades.entry_comment(0) == "first" ? 1 : 0)
plot(na(strategy.closedtrades.entry_comment(1)) ? na : strategy.closedtrades.entry_comment(1) == "second" ? 1 : 0)
plot(strategy.closedtrades.exit_price(0))
plot(strategy.closedtrades.exit_price(1))
plot(na(strategy.closedtrades.exit_id(0)) ? na : strategy.closedtrades.exit_id(0) == "L1" ? 1 : 0)
plot(na(strategy.closedtrades.exit_id(1)) ? na : strategy.closedtrades.exit_id(1) == "L2" ? 1 : 0)
plot(na(strategy.closedtrades.exit_comment(0)) ? na : strategy.closedtrades.exit_comment(0) == "closed" ? 1 : 0)
plot(na(strategy.closedtrades.exit_comment(1)) ? na : strategy.closedtrades.exit_comment(1) == "closed" ? 1 : 0)
plot(strategy.closedtrades.entry_bar_index(0))
plot(strategy.closedtrades.entry_bar_index(1))
plot(strategy.closedtrades.exit_bar_index(0))
plot(strategy.closedtrades.exit_bar_index(1))
plot(strategy.closedtrades.entry_time(0))
plot(strategy.closedtrades.entry_time(1))
plot(strategy.closedtrades.exit_time(0))
plot(strategy.closedtrades.exit_time(1))
plot(strategy.closedtrades.commission(0))
plot(strategy.closedtrades.commission(1))
plot(strategy.closedtrades.size(0))
plot(strategy.closedtrades.size(1))
plot(strategy.closedtrades.profit(0))
plot(strategy.closedtrades.profit(1))
plot(strategy.closedtrades.max_runup(0))
plot(strategy.closedtrades.max_runup(1))
plot(strategy.closedtrades.max_drawdown(0))
plot(strategy.closedtrades.max_drawdown(1))
plot(strategy.closedtrades.entry_price(2))
plot(strategy.closedtrades.exit_price(2))
plot(strategy.closedtrades.profit(2))
