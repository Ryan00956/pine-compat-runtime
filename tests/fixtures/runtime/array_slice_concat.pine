indicator("Array slice concat fixture")
ints = array.new_int()
ints.push(1)
ints.push(2)
ints.push(3)
part = array.slice(ints, 1, 3)
part.set(0, 20)
plot(part.size())
plot(part.get(0) + part.get(1))
plot(ints.get(1))

more = array.new_int()
more.push(4)
returned = ints.concat(more)
plot(array.size(ints))
plot(returned.size())
plot(returned.get(3))
empty_more = array.new_int()
ints.concat(empty_more)
plot(returned.size() == 4 and ints.size() == 4 and empty_more.size() == 0 ? 1 : 0)
empty_int_target = array.new_int()
source_int_size = more.size()
source_int_first = more.get(0)
empty_int_target.concat(more)
plot(empty_int_target.size() == source_int_size and empty_int_target.get(0) == source_int_first and more.size() == source_int_size and more.get(0) == source_int_first ? 1 : 0)

words = array.new_string()
words.push("a")
words.push("b")
words.push("c")
tail = words.slice(1, 3)
extra = array.new_string()
extra.push("d")
array.concat(words, extra)
plot(tail.join("|") == "b|c" and words.join("|") == "a|b|c|d" ? 1 : 0)
empty_extra = array.new_string()
words.concat(empty_extra)
plot(words.join("|") == "a|b|c|d" and empty_extra.size() == 0 ? 1 : 0)
empty_target = array.new_string()
source_string_size = extra.size()
source_string_first = extra.get(0)
empty_target.concat(extra)
plot(empty_target.size() == source_string_size and empty_target.get(0) == source_string_first and extra.size() == source_string_size and extra.get(0) == source_string_first ? 1 : 0)

colors = array.new_color()
colors.push(color.red)
colors.push(color.green)
colors_tail = colors.slice(1, 2)
colors.concat(colors_tail)
plot(colors.get(2) == color.green ? 1 : 0)
empty_colors_tail = array.new_color()
colors.concat(empty_colors_tail)
plot(colors.size() == 3 and empty_colors_tail.size() == 0 ? 1 : 0)
empty_color_target = array.new_color()
source_color_size = colors_tail.size()
source_color_first = colors_tail.get(0)
empty_color_target.concat(colors_tail)
plot(empty_color_target.size() == source_color_size and empty_color_target.get(0) == source_color_first and colors_tail.size() == source_color_size and colors_tail.get(0) == source_color_first ? 1 : 0)

floats = array.new_float()
floats.push(close)
floats.push(na)
floats.push(high)
float_head = array.slice(floats, 0, 2)
plot(float_head.size())
plot(float_head.get(0) == close and na(float_head.get(1)) ? 1 : 0)
float_more = array.from(na, high)
float_returned = floats.concat(float_more)
plot(float_returned.size() == 5 and floats.size() == 5 and na(floats.get(3)) and floats.get(4) == high and float_more.size() == 2 ? 1 : 0)
empty_float_more = array.new_float()
floats.concat(empty_float_more)
plot(float_returned.size() == 5 and floats.size() == 5 and empty_float_more.size() == 0 ? 1 : 0)
empty_float_target = array.new_float()
source_float_size = float_more.size()
source_float_second = float_more.get(1)
empty_float_target.concat(float_more)
plot(empty_float_target.size() == source_float_size and na(empty_float_target.get(0)) and empty_float_target.get(1) == source_float_second and float_more.size() == source_float_size and na(float_more.get(0)) and float_more.get(1) == source_float_second ? 1 : 0)

flags = array.from(true, false, true)
flag_tail = flags.slice(1, 3)
flag_tail.set(0, true)
plot(flag_tail.size())
plot(flag_tail.get(0) and flag_tail.get(1) and not flags.get(1) ? 1 : 0)
bool_more = array.from(false)
flags.concat(bool_more)
plot(flags.size() == 4 and not flags.get(3) and bool_more.size() == 1 ? 1 : 0)
empty_bool_more = array.new_bool()
flags.concat(empty_bool_more)
plot(flags.size() == 4 and empty_bool_more.size() == 0 ? 1 : 0)
empty_bool_target = array.new_bool()
source_bool_size = bool_more.size()
source_bool_first = bool_more.get(0)
empty_bool_target.concat(bool_more)
plot(empty_bool_target.size() == source_bool_size and empty_bool_target.get(0) == source_bool_first and bool_more.size() == source_bool_size and bool_more.get(0) == source_bool_first ? 1 : 0)

empty_window = ints.slice(2, 2)
plot(empty_window.size())
plot(na(array.slice(ints, -1, 1)) and na(ints.slice(1, 5)) and na(array.slice(ints, 2, 1)) ? 1 : 0)

slice_from = 1
slice_to = 3
computed_slice_source = array.from(4, 5, 6, 7)
computed_slice = computed_slice_source.slice(slice_from, slice_to + 0)
computed_slice.set(0, 50)
plot(computed_slice.size() * 100 + computed_slice.get(0) + computed_slice.get(1) + computed_slice_source.get(slice_from))

branch_concat_target = array.from(1)
branch_concat_even = array.from(2)
branch_concat_odd = array.from(3)
if bar_index % 2 == 0
    branch_concat_target.concat(branch_concat_even)
else
    branch_concat_target.concat(branch_concat_odd)
plot(branch_concat_target.get(0) * 10 + branch_concat_target.get(1))

loop_concat_target = array.new_int()
loop_concat_first = array.from(4)
loop_concat_second = array.from(5)
for i = 0 to 1
    if i == 0
        loop_concat_target.concat(loop_concat_first)
    else
        loop_concat_target.concat(loop_concat_second)
plot(loop_concat_target.get(0) * 10 + loop_concat_target.get(1) + loop_concat_first.size() + loop_concat_second.size())

branch_slice_source = array.from(10, 20, 30, 40)
branch_slice_score = bar_index * 0
if bar_index % 2 == 0
    branch_slice_even = array.slice(branch_slice_source, 1, 3)
    branch_slice_even.set(0, 200)
    branch_slice_score := branch_slice_even.size() * 100 + branch_slice_even.get(0) + branch_slice_even.get(1) + branch_slice_source.get(1)
else
    branch_slice_odd = branch_slice_source.slice(2, 4)
    branch_slice_odd.set(1, 400)
    branch_slice_score := branch_slice_odd.size() * 100 + branch_slice_odd.get(0) + branch_slice_odd.get(1) + branch_slice_source.get(3)
plot(branch_slice_score)

loop_slice_source = array.from(1, 2, 3, 4)
loop_slice_score = bar_index * 0
for i = 0 to 1
    if i == 0
        loop_slice_first = array.slice(loop_slice_source, i, i + 2)
        loop_slice_first.set(0, loop_slice_first.get(0) * 10)
        loop_slice_score := loop_slice_score + loop_slice_first.get(0) + loop_slice_first.get(1) + loop_slice_source.get(i)
    else
        loop_slice_second = loop_slice_source.slice(i + 1, i + 3)
        loop_slice_second.set(0, loop_slice_second.get(0) * 10)
        loop_slice_score := loop_slice_score + loop_slice_second.get(0) + loop_slice_second.get(1) + loop_slice_source.get(i)
plot(loop_slice_score)
