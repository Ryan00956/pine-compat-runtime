//@version=5
indicator("Mode edge cases")
repeated = ta.mode(close, 3)
unique = ta.mode(close + bar_index * 10, 3)
tie = ta.mode(close, 4)
simple = ta.mode(3, 3)
with_na = ta.mode(bar_index == 3 ? na : close, 3)
invalid = ta.mode(close, 0)
plot(repeated)
plot(unique)
plot(tie)
plot(simple)
plot(with_na)
plot(invalid)
