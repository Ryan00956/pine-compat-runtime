//@version=5
indicator("TA named reordered windows")
source = bar_index == 1 ? 3 : bar_index == 2 ? 2 : bar_index == 3 ? 4 : 1
highest_value = ta.highest(length=3, source=source)
lowest_value = ta.lowest(length=3, source=source)
highest_offset = ta.highestbars(length=3, source=source)
lowest_offset = ta.lowestbars(length=3, source=source)
rising_value = ta.rising(length=3, source=source)
falling_value = ta.falling(length=3, source=source)
default_highest = ta.highest(length=2)
default_lowest_offset = ta.lowestbars(length=2)
plot(highest_value)
plot(lowest_value)
plot(highest_offset)
plot(lowest_offset)
plot(rising_value ? 1 : 0)
plot(falling_value ? 1 : 0)
plot(default_highest)
plot(default_lowest_offset)
