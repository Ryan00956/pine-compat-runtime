//@version=6
indicator("While expression matrix kinds")

int_i = 0
int_values = while int_i < 2
    int_i := int_i + 1
    matrix.new<int>(1, 2, int_i)
int_values.set(0, 0, int_values.get(0, 0) + 10)

bool_i = 0
bool_values = while bool_i < 1
    bool_i := bool_i + 1
    matrix.new<bool>(1, 2, true)
bool_values.set(0, 1, false)

string_i = 0
string_values = while string_i < 1
    string_i := string_i + 1
    matrix.new<string>(1, 2, "a")
string_values.set(0, 1, "b")

color_i = 0
color_values = while color_i < 1
    color_i := color_i + 1
    matrix.new<color>(1, 2, color.green)
color_values.set(0, 1, color.red)

plot(int_values.get(0, 0), "int_first")
plot(matrix.get(int_values, 0, 1), "int_second")
plot(bool_values.get(0, 0) ? 1 : 0, "bool_first")
plot(matrix.get(bool_values, 0, 1) ? 1 : 0, "bool_second")
plot(string_values.get(0, 0) == "a" ? 1 : 0, "string_first")
plot(matrix.get(string_values, 0, 1) == "b" ? 1 : 0, "string_second")
plot(color_values.get(0, 0) == color.green ? 1 : 0, "color_first")
plot(matrix.get(color_values, 0, 1) == color.red ? 1 : 0, "color_second")
