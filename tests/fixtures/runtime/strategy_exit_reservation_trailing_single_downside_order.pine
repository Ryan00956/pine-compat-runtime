//@version=5
strategy("Exit reservation trailing single downside order")
if bar_index == 0
    strategy.entry("L", strategy.long, qty=2)
    strategy.exit("XT", "L", trail_price=2, trail_offset=50, qty=0.5)
    strategy.exit("XS", "L", stop=2.7, qty=0.75)
plot(strategy.position_size)
plot(strategy.netprofit)
plot(strategy.closedtrades)
plot(strategy.opentrades)
