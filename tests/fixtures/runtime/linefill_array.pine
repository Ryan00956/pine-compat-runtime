//@version=5
indicator("Linefill array")
var upper = line.new(bar_index, 10, bar_index + 1, 11, color=color.green)
var middle = line.new(bar_index, 20, bar_index + 1, 21)
var lower = line.new(bar_index, 30, bar_index + 1, 31, color=color.red)
var other = line.new(bar_index, 40, bar_index + 1, 41)
var first_fill = linefill.new(upper, middle, color.green)
var second_fill = linefill.new(middle, lower, color.red)
var third_fill = linefill.new(lower, other, color.blue)
values = array.new_linefill(1, first_fill)
array.push(values, na)
array.set(values, 1, second_fill)
array.insert(values, 1, third_fill)
removed = array.remove(values, 2)
array.unshift(values, second_fill)
shifted = array.shift(values)
array.fill(values, first_fill, 1, 2)
from_values = array.from(first_fill, third_fill)
copied = array.copy(values)
array.reverse(copied)
joined = array.concat(copied, from_values)
slice = array.slice(joined, 1, 3)
last_index = array.lastindexof(joined, third_fill)
first_index = array.indexof(joined, first_fill)
has_removed = array.includes(joined, removed)
first_value = array.first(joined)
last_value = array.last(joined)
popped = array.pop(joined)
plot(array.size(values))
plot(array.size(from_values))
plot(array.size(joined))
plot(array.size(slice))
plot(first_index)
plot(last_index)
plot(has_removed ? 1 : 0)
plot(line.get_y1(linefill.get_line1(first_value)))
plot(line.get_y1(linefill.get_line1(last_value)))
plot(line.get_y1(linefill.get_line1(popped)))
plot(close)
