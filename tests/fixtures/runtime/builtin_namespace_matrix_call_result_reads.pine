//@version=6
indicator("Builtin namespace matrix call-result reads")

matrixMultMatrixExpressionRead(left, right) => matrix.mult(left, right).copy().get(1, 1)

matrixCopyExpressionRead(values) => matrix.copy(values).copy().get(1, 0)

matrixTransposeExpressionRead(values) => matrix.transpose(values).copy().get(2, 1)

matrixSubmatrixExpressionRead(values) => matrix.submatrix(values, 0, 2, 1, 3).copy().get(1, 1)

matrixKronExpressionRead(left, right) => matrix.kron(left, right).copy().get(5, 5)

matrixDiffExpressionRead(left, right) => matrix.diff(left, right).copy().get(1, 2)

matrixPowExpressionRead(values) => matrix.pow(values, 2).copy().get(1, 1)

matrixInvExpressionRead(values) => matrix.inv(values).copy().get(0, 1)

matrixPinvExpressionRead(values) => matrix.pinv(values).copy().get(1, 1)

matrixMultMatrixBlockRead(values, scalar) =>
    int rows = matrix.mult(values, scalar).rows()
    int columns = matrix.mult(scalar, values).columns()
    float first = matrix.mult(values, scalar).copy().get(0, 0)
    rows * 100 + columns * 10 + first

matrixCopyBlockRead(values) =>
    int rows = matrix.copy(values).rows()
    int columns = matrix.copy(values).columns()
    float first = matrix.copy(values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixTransposeBlockRead(values) =>
    int rows = matrix.transpose(values).rows()
    int columns = matrix.transpose(values).columns()
    float first = matrix.transpose(values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixSubmatrixBlockRead(values) =>
    int rows = matrix.submatrix(values).rows()
    int columns = matrix.submatrix(values).columns()
    float first = matrix.submatrix(values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixKronBlockRead(left, right) =>
    int rows = matrix.kron(left, right).rows()
    int columns = matrix.kron(left, right).columns()
    float first = matrix.kron(left, right).get(0, 0)
    rows * 100 + columns * 10 + first

matrixDiffBlockRead(values, scalar) =>
    int rows = matrix.diff(values, scalar).rows()
    int columns = matrix.diff(scalar, values).columns()
    float first = matrix.diff(scalar, values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixPowBlockRead(values) =>
    int rows = matrix.pow(values, 2).rows()
    int columns = matrix.pow(values, 2).columns()
    float first = matrix.pow(values, 2).get(0, 0)
    rows * 100 + columns * 10 + first

matrixInvBlockRead(values) =>
    int rows = matrix.inv(values).rows()
    int columns = matrix.inv(values).columns()
    float first = matrix.inv(values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixPinvBlockRead(values) =>
    int rows = matrix.pinv(values).rows()
    int columns = matrix.pinv(values).columns()
    float first = matrix.pinv(values).get(0, 0)
    rows * 100 + columns * 10 + first

left = matrix.new<float>(2, 3, 0.0)
left.set(0, 0, 1.0)
left.set(0, 1, 2.0)
left.set(0, 2, 3.0)
left.set(1, 0, 4.0)
left.set(1, 1, 5.0)
left.set(1, 2, 6.0)

right = matrix.new<float>(3, 2, 0.0)
right.set(0, 0, 7.0)
right.set(0, 1, 8.0)
right.set(1, 0, 9.0)
right.set(1, 1, 10.0)
right.set(2, 0, 11.0)
right.set(2, 1, 12.0)

diff_right = matrix.new<float>(2, 3, 1.0)

pow_values = matrix.new<float>(2, 2, 0.0)
pow_values.set(0, 0, 1.0)
pow_values.set(0, 1, 2.0)
pow_values.set(1, 0, 3.0)
pow_values.set(1, 1, 4.0)

inv_values = matrix.new<float>(2, 2, 0.0)
inv_values.set(0, 0, 4.0)
inv_values.set(0, 1, 7.0)
inv_values.set(1, 0, 2.0)
inv_values.set(1, 1, 6.0)
inv_singular = matrix.new<float>(2, 2, 1.0)
inv_na = matrix.new<float>(1, 1)

pinv_values = matrix.new<float>(2, 3, 0.0)
pinv_values.set(0, 0, 1.0)
pinv_values.set(1, 1, 1.0)
pinv_singular = matrix.new<float>(2, 2, 1.0)
pinv_na = matrix.new<float>(1, 1)

matrix_matrix_shape = matrix.mult(left, right).rows() * 100 + matrix.mult(left, right).columns() * 10 + matrix.mult(left, right).elements_count()
matrix_matrix_get = matrix.mult(left, right).get(0, 0)
matrix_matrix_copy_get = matrix.mult(left, right).copy().copy().get(1, 1)
matrix_scalar_shape = matrix.mult(right, 2.0).rows() * 100 + matrix.mult(right, 2.0).columns() * 10 + matrix.mult(right, 2.0).elements_count()
matrix_scalar_get = matrix.mult(right, 2.0).get(0, 0)
matrix_scalar_copy_get = matrix.mult(right, 2.0).copy().copy().get(2, 1)
scalar_matrix_shape = matrix.mult(0.5, right).rows() * 100 + matrix.mult(0.5, right).columns() * 10 + matrix.mult(0.5, right).elements_count()
scalar_matrix_get = matrix.mult(0.5, right).get(1, 0)
scalar_matrix_copy_get = matrix.mult(0.5, right).copy().copy().get(2, 1)

plot(matrix_matrix_shape, "matrix_matrix_shape")
plot(matrix_matrix_get, "matrix_matrix_get")
plot(matrix_matrix_copy_get, "matrix_matrix_copy_get")
plot(matrix_scalar_shape, "matrix_scalar_shape")
plot(matrix_scalar_get, "matrix_scalar_get")
plot(matrix_scalar_copy_get, "matrix_scalar_copy_get")
plot(scalar_matrix_shape, "scalar_matrix_shape")
plot(scalar_matrix_get, "scalar_matrix_get")
plot(scalar_matrix_copy_get, "scalar_matrix_copy_get")

plot(matrix.copy(left).rows() * 100 + matrix.copy(left).columns() * 10 + matrix.copy(left).elements_count(), "matrix_copy_shape")
plot(matrix.copy(id=left).get(row=1, column=2), "matrix_copy_named_get")
plot(matrix.copy(left).copy().copy().get(0, 1), "matrix_copy_nested_get")
plot(matrix.transpose(left).rows() * 100 + matrix.transpose(left).columns() * 10 + matrix.transpose(left).elements_count(), "matrix_transpose_shape")
plot(matrix.transpose(id=left).get(row=2, column=1), "matrix_transpose_named_get")
plot(matrix.transpose(left).copy().copy().get(1, 0), "matrix_transpose_nested_get")
plot(matrix.submatrix(left, 0, 2, 1, 3).rows() * 100 + matrix.submatrix(left, 0, 2, 1, 3).columns() * 10 + matrix.submatrix(left, 0, 2, 1, 3).elements_count(), "matrix_submatrix_shape")
plot(matrix.submatrix(id=left, from_row=0, to_row=2, from_column=1, to_column=3).get(row=1, column=1), "matrix_submatrix_named_get")
plot(matrix.submatrix(left, 0, 1, 0, 2).copy().copy().get(0, 1), "matrix_submatrix_nested_get")
plot(matrix.submatrix(left).rows() * 100 + matrix.submatrix(left).columns() * 10 + matrix.submatrix(left).elements_count(), "matrix_submatrix_default_shape")
plot(matrix.kron(left, right).rows() * 100 + matrix.kron(left, right).columns() * 10 + matrix.kron(left, right).elements_count(), "matrix_kron_shape")
plot(matrix.kron(id1=left, id2=right).get(row=5, column=5), "matrix_kron_named_get")
plot(matrix.kron(left, right).copy().copy().get(1, 3), "matrix_kron_nested_get")
plot(matrix.diff(left, diff_right).rows() * 100 + matrix.diff(left, diff_right).columns() * 10 + matrix.diff(left, diff_right).elements_count(), "matrix_diff_shape")
plot(matrix.diff(id1=left, id2=diff_right).get(row=1, column=2), "matrix_diff_named_get")
plot(matrix.diff(left, diff_right).copy().copy().get(0, 1), "matrix_diff_nested_get")
plot(matrix.diff(left, 0.5).get(1, 2), "matrix_diff_matrix_scalar_get")
plot(matrix.diff(10.0, left).get(1, 2), "matrix_diff_scalar_matrix_get")
plot(matrix.pow(pow_values, 2).rows() * 100 + matrix.pow(pow_values, 2).columns() * 10 + matrix.pow(pow_values, 2).elements_count(), "matrix_pow_shape")
plot(matrix.pow(id=pow_values, power=2).get(row=1, column=1), "matrix_pow_named_get")
plot(matrix.pow(pow_values, 1).copy().copy().get(0, 1), "matrix_pow_nested_get")
plot(matrix.pow(pow_values, 0).get(1, 1), "matrix_pow_identity_get")
plot(matrix.pow(pow_values, 3).get(0, 0), "matrix_pow_cube_get")
plot(matrix.inv(inv_values).rows() * 100 + matrix.inv(inv_values).columns() * 10 + matrix.inv(inv_values).elements_count(), "matrix_inv_shape")
plot(matrix.inv(id=inv_values).get(row=0, column=0), "matrix_inv_named_get")
plot(matrix.inv(inv_values).copy().copy().get(0, 1), "matrix_inv_nested_get")
plot(matrix.pinv(pinv_values).rows() * 100 + matrix.pinv(pinv_values).columns() * 10 + matrix.pinv(pinv_values).elements_count(), "matrix_pinv_shape")
plot(matrix.pinv(id=pinv_values).get(row=1, column=1), "matrix_pinv_named_get")
plot(matrix.pinv(pinv_values).copy().copy().get(2, 0), "matrix_pinv_nested_get")

int_left = matrix.new<int>(2, 2, 0)
int_left.set(0, 0, 1)
int_left.set(0, 1, 2)
int_left.set(1, 0, 3)
int_left.set(1, 1, 4)
int_right = matrix.new<int>(2, 2, 0)
int_right.set(0, 0, 5)
int_right.set(0, 1, 6)
int_right.set(1, 0, 7)
int_right.set(1, 1, 8)

plot(matrix.mult(int_left, int_right).get(0, 0), "int_matrix_matrix_get")
plot(matrix.mult(int_left, int_right).copy().get(1, 1), "int_matrix_matrix_copy_get")
plot(matrix.mult(int_left, 3).get(0, 0), "int_matrix_scalar_get")
plot(matrix.mult(int_left, 3).copy().get(1, 1), "int_matrix_scalar_copy_get")
plot(matrix.mult(3, int_left).get(0, 0), "int_scalar_matrix_get")
plot(matrix.mult(3, int_left).copy().get(1, 1), "int_scalar_matrix_copy_get")
plot(matrix.copy(int_left).get(1, 1), "matrix_copy_int_get")
plot(matrix.transpose(int_left).get(1, 0), "matrix_transpose_int_get")
plot(matrix.submatrix(int_left, 0, 2, 0, 1).get(1, 0), "matrix_submatrix_int_get")
plot(matrix.kron(int_left, int_right).get(3, 3), "matrix_kron_int_get")
plot(matrix.diff(int_left, int_right).get(0, 0), "matrix_diff_int_get")
plot(matrix.pow(int_left, 2).get(1, 1), "matrix_pow_int_get")
plot(matrix.inv(int_left).get(1, 1), "matrix_inv_int_get")
plot(matrix.pinv(int_left).get(1, 1), "matrix_pinv_int_get")

bool_values = matrix.new<bool>(1, 1, true)
string_values = matrix.new<string>(1, 1, "copy")
color_values = matrix.new<color>(1, 1, color.red)
plot(matrix.copy(bool_values).copy().get(0, 0) ? 1 : 0, "matrix_copy_bool_get")
plot(matrix.copy(string_values).get(0, 0) == "copy" ? 1 : 0, "matrix_copy_string_get")
plot(matrix.copy(color_values).get(0, 0) == color.red ? 1 : 0, "matrix_copy_color_get")
plot(matrix.transpose(bool_values).copy().get(0, 0) ? 1 : 0, "matrix_transpose_bool_get")
plot(matrix.transpose(string_values).get(0, 0) == "copy" ? 1 : 0, "matrix_transpose_string_get")
plot(matrix.transpose(color_values).get(0, 0) == color.red ? 1 : 0, "matrix_transpose_color_get")
plot(matrix.submatrix(bool_values).copy().get(0, 0) ? 1 : 0, "matrix_submatrix_bool_get")
plot(matrix.submatrix(string_values).get(0, 0) == "copy" ? 1 : 0, "matrix_submatrix_string_get")
plot(matrix.submatrix(color_values).get(0, 0) == color.red ? 1 : 0, "matrix_submatrix_color_get")

na_left = matrix.new<float>(2, 2, 0.0)
na_left.set(0, 0, 1.0)
na_left.set(0, 1, na)
na_left.set(1, 0, 3.0)
na_left.set(1, 1, 4.0)
identity = matrix.new<float>(2, 2, 0.0)
identity.set(0, 0, 1.0)
identity.set(1, 1, 1.0)

plot(na(matrix.mult(na_left, identity).get(0, 0)) ? 1 : 0, "matrix_matrix_na")
plot(matrix.mult(na_left, identity).copy().get(1, 1), "matrix_matrix_na_valid")
plot(na(matrix.mult(right, na).get(0, 0)) ? matrix.mult(right, na).rows() * 100 + matrix.mult(right, na).columns() * 10 + matrix.mult(right, na).elements_count() : -1, "matrix_scalar_na")
plot(na(matrix.mult(na, right).get(2, 1)) ? matrix.mult(na, right).rows() * 100 + matrix.mult(na, right).columns() * 10 + matrix.mult(na, right).elements_count() : -1, "scalar_matrix_na")
plot(na(matrix.copy(na_left).get(0, 1)) ? 1 : 0, "matrix_copy_na_get")
plot(na(matrix.transpose(na_left).get(1, 0)) ? 1 : 0, "matrix_transpose_na_get")
plot(na(matrix.submatrix(na_left, 0, 1, 0, 2).get(0, 1)) ? 1 : 0, "matrix_submatrix_na_get")
plot(na(matrix.kron(na_left, identity).get(0, 2)) ? 1 : 0, "matrix_kron_na_get")
plot(na(matrix.diff(na_left, 1.0).get(0, 1)) ? 1 : 0, "matrix_diff_na_get")
plot(na(matrix.pow(na_left, 2).get(0, 0)) ? 1 : 0, "matrix_pow_na_get")
plot(na(matrix.inv(inv_singular).rows()) ? 1 : 0, "matrix_inv_singular_rows_na")
plot(na(matrix.inv(inv_na).rows()) ? 1 : 0, "matrix_inv_na_rows_na")
plot(matrix.pinv(pinv_singular).rows(), "matrix_pinv_singular_rows")
plot(na(matrix.pinv(pinv_na).rows()) ? 1 : 0, "matrix_pinv_na_rows_na")

empty_zero_rows_shape = matrix.mult(matrix.new<float>(0, 2), matrix.new<float>(2, 3, 1.0)).rows() * 100 + matrix.mult(matrix.new<float>(0, 2), matrix.new<float>(2, 3, 1.0)).columns() * 10 + matrix.mult(matrix.new<float>(0, 2), matrix.new<float>(2, 3, 1.0)).elements_count()
empty_inner_shape = matrix.mult(matrix.new<float>(2, 0), matrix.new<float>(0, 3)).rows() * 100 + matrix.mult(matrix.new<float>(2, 0), matrix.new<float>(0, 3)).columns() * 10 + matrix.mult(matrix.new<float>(2, 0), matrix.new<float>(0, 3)).elements_count()
empty_matrix_scalar_shape = matrix.mult(matrix.new<float>(0, 2), 2.0).rows() * 100 + matrix.mult(matrix.new<float>(0, 2), 2.0).columns() * 10 + matrix.mult(matrix.new<float>(0, 2), 2.0).elements_count()
empty_scalar_matrix_shape = matrix.mult(2.0, matrix.new<float>(3, 0)).rows() * 100 + matrix.mult(2.0, matrix.new<float>(3, 0)).columns() * 10 + matrix.mult(2.0, matrix.new<float>(3, 0)).elements_count()

plot(empty_zero_rows_shape, "empty_zero_rows_shape")
plot(empty_inner_shape + matrix.mult(matrix.new<float>(2, 0), matrix.new<float>(0, 3)).get(0, 0), "empty_inner_shape_and_zero")
plot(empty_matrix_scalar_shape, "empty_matrix_scalar_shape")
plot(empty_scalar_matrix_shape, "empty_scalar_matrix_shape")
plot(matrix.copy(matrix.new<float>(0, 2)).rows() * 100 + matrix.copy(matrix.new<float>(0, 2)).columns() * 10 + matrix.copy(matrix.new<float>(0, 2)).elements_count(), "matrix_copy_empty_shape")
plot(matrix.transpose(matrix.new<float>(0, 2)).rows() * 100 + matrix.transpose(matrix.new<float>(0, 2)).columns() * 10 + matrix.transpose(matrix.new<float>(0, 2)).elements_count(), "matrix_transpose_empty_shape")
plot(matrix.submatrix(left, 1, 1, 0, 3).rows() * 100 + matrix.submatrix(left, 1, 1, 0, 3).columns() * 10 + matrix.submatrix(left, 1, 1, 0, 3).elements_count(), "matrix_submatrix_empty_rows_shape")
plot(matrix.submatrix(left, 0, 2, 2, 2).rows() * 100 + matrix.submatrix(left, 0, 2, 2, 2).columns() * 10 + matrix.submatrix(left, 0, 2, 2, 2).elements_count(), "matrix_submatrix_empty_columns_shape")
plot(matrix.kron(matrix.new<float>(0, 2), right).rows() * 100 + matrix.kron(matrix.new<float>(0, 2), right).columns() * 10 + matrix.kron(matrix.new<float>(0, 2), right).elements_count(), "matrix_kron_empty_rows_shape")
plot(matrix.kron(left, matrix.new<float>(1, 0)).rows() * 100 + matrix.kron(left, matrix.new<float>(1, 0)).columns() * 10 + matrix.kron(left, matrix.new<float>(1, 0)).elements_count(), "matrix_kron_empty_columns_shape")
plot(matrix.diff(matrix.new<float>(0, 2), 1.0).rows() * 100 + matrix.diff(matrix.new<float>(0, 2), 1.0).columns() * 10 + matrix.diff(matrix.new<float>(0, 2), 1.0).elements_count(), "matrix_diff_empty_rows_shape")
plot(matrix.diff(1.0, matrix.new<float>(2, 0)).rows() * 100 + matrix.diff(1.0, matrix.new<float>(2, 0)).columns() * 10 + matrix.diff(1.0, matrix.new<float>(2, 0)).elements_count(), "matrix_diff_empty_columns_shape")
plot(matrix.pow(matrix.new<float>(0, 0), 2).rows() * 100 + matrix.pow(matrix.new<float>(0, 0), 2).columns() * 10 + matrix.pow(matrix.new<float>(0, 0), 2).elements_count(), "matrix_pow_empty_shape")
plot(matrix.inv(matrix.new<float>(0, 0)).rows() * 100 + matrix.inv(matrix.new<float>(0, 0)).columns() * 10 + matrix.inv(matrix.new<float>(0, 0)).elements_count(), "matrix_inv_empty_shape")
plot(matrix.pinv(matrix.new<float>(0, 3)).rows() * 100 + matrix.pinv(matrix.new<float>(0, 3)).columns() * 10 + matrix.pinv(matrix.new<float>(0, 3)).elements_count(), "matrix_pinv_empty_rows_shape")
plot(matrix.pinv(matrix.new<float>(2, 0)).rows() * 100 + matrix.pinv(matrix.new<float>(2, 0)).columns() * 10 + matrix.pinv(matrix.new<float>(2, 0)).elements_count(), "matrix_pinv_empty_columns_shape")

direct_copy = matrix.mult(left, right).copy().copy()
direct_copy.set(0, 0, 999.0)
plot(direct_copy.get(0, 0), "direct_copy_mutation")
plot(left.get(0, 0) * 100 + right.get(0, 0), "direct_copy_operands_unchanged")
plot(matrix.mult(left, right).get(0, 0), "direct_copy_fresh_product")

namespace_copy = matrix.copy(left).copy()
namespace_copy.set(0, 0, 777.0)
plot(namespace_copy.get(0, 0), "matrix_copy_mutation")
plot(left.get(0, 0), "matrix_copy_source_unchanged")

namespace_transpose = matrix.transpose(left).copy()
namespace_transpose.set(0, 0, 888.0)
plot(namespace_transpose.get(0, 0), "matrix_transpose_mutation")
plot(left.get(0, 0), "matrix_transpose_source_unchanged")

namespace_submatrix = matrix.submatrix(left, 0, 2, 0, 3).copy()
namespace_submatrix.set(0, 0, 666.0)
plot(namespace_submatrix.get(0, 0), "matrix_submatrix_mutation")
plot(left.get(0, 0), "matrix_submatrix_source_unchanged")

namespace_kron = matrix.kron(left, right).copy()
namespace_kron.set(0, 0, 555.0)
plot(namespace_kron.get(0, 0), "matrix_kron_mutation")
plot(left.get(0, 0) * 100 + right.get(0, 0), "matrix_kron_sources_unchanged")

namespace_diff = matrix.diff(left, diff_right).copy()
namespace_diff.set(0, 0, 444.0)
plot(namespace_diff.get(0, 0), "matrix_diff_mutation")
plot(left.get(0, 0) * 100 + diff_right.get(0, 0), "matrix_diff_sources_unchanged")

namespace_pow = matrix.pow(pow_values, 2).copy()
namespace_pow.set(0, 0, 333.0)
plot(namespace_pow.get(0, 0), "matrix_pow_mutation")
plot(pow_values.get(0, 0), "matrix_pow_source_unchanged")

namespace_inv = matrix.inv(inv_values).copy()
namespace_inv.set(0, 0, 222.0)
plot(namespace_inv.get(0, 0), "matrix_inv_mutation")
plot(inv_values.get(0, 0), "matrix_inv_source_unchanged")

namespace_pinv = matrix.pinv(pinv_values).copy()
namespace_pinv.set(0, 0, 111.0)
plot(namespace_pinv.get(0, 0), "matrix_pinv_mutation")
plot(pinv_values.get(0, 0), "matrix_pinv_source_unchanged")

bound_matrix_result = left.mult(right)
bound_scalar_result = right.mult(2.0)
plot(bound_matrix_result.rows() * 100 + bound_matrix_result.columns() * 10 + bound_matrix_result.elements_count() + bound_matrix_result.get(0, 0), "bound_matrix_result")
plot(bound_scalar_result.rows() * 100 + bound_scalar_result.columns() * 10 + bound_scalar_result.elements_count() + bound_scalar_result.get(0, 0), "bound_scalar_result")
plot(matrixMultMatrixExpressionRead(left, right), "matrix_expression_udf")
plot(matrixMultMatrixBlockRead(right, 2.0), "matrix_block_udf")
plot(matrixCopyExpressionRead(left), "matrix_copy_expression_udf")
plot(matrixCopyBlockRead(left), "matrix_copy_block_udf")
plot(matrixTransposeExpressionRead(left), "matrix_transpose_expression_udf")
plot(matrixTransposeBlockRead(left), "matrix_transpose_block_udf")
plot(matrixSubmatrixExpressionRead(left), "matrix_submatrix_expression_udf")
plot(matrixSubmatrixBlockRead(left), "matrix_submatrix_block_udf")
plot(matrixKronExpressionRead(left, right), "matrix_kron_expression_udf")
plot(matrixKronBlockRead(left, right), "matrix_kron_block_udf")
plot(matrixDiffExpressionRead(left, diff_right), "matrix_diff_expression_udf")
plot(matrixDiffBlockRead(left, 10.0), "matrix_diff_block_udf")
plot(matrixPowExpressionRead(pow_values), "matrix_pow_expression_udf")
plot(matrixPowBlockRead(pow_values), "matrix_pow_block_udf")
plot(matrixInvExpressionRead(inv_values), "matrix_inv_expression_udf")
plot(matrixInvBlockRead(inv_values), "matrix_inv_block_udf")
plot(matrixPinvExpressionRead(pinv_values), "matrix_pinv_expression_udf")
plot(matrixPinvBlockRead(pinv_values), "matrix_pinv_block_udf")
