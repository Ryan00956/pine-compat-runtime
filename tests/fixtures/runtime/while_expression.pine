//@version=5
indicator("While expression")

limit = bar_index + 2
i = bar_index
latest = while i < limit
    i := i + 1
    i

zero = while false
    1

j = 0
controlled = while j < 5
    j := j + 1
    if j == 2
        continue
    if j == 4
        break
    j * 10

nested_limit = bar_index == 0 ? 1 : 0
nested_i = 0
nested_loop = while nested_i < nested_limit
    nested_i := nested_i + 1
    for k = 0 to 0
        close + 3

plot(latest)
plot(zero)
plot(controlled)
plot(nested_loop)
