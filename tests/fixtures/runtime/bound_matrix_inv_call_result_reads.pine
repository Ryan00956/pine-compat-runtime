//@version=6
indicator("Bound matrix.inv call-result reads")

invRows(values) => values.inv().rows()

invBlockReads(values) =>
    int rows = values.inv().rows()
    int columns = values.inv().columns()
    float value = values.inv().get(0, 0)
    rows * 100 + columns * 10 + value

values = matrix.new<float>(2, 2, 0.0)
values.set(0, 0, 4.0)
values.set(0, 1, 7.0)
values.set(1, 0, 2.0)
values.set(1, 1, 6.0)

inverted = values.inv().copy()
inverted.set(0, 0, 99.0)
reinverted = values.inv().inv()
reinverted.set(0, 0, 88.0)

ints = matrix.new<int>(2, 2, 0)
ints.set(0, 0, 2)
ints.set(1, 1, 4)

singular = matrix.new<float>(2, 2, 1.0)
invalid = matrix.new<float>(1, 1)
empty = matrix.new<float>(0, 0)

plot(values.inv().rows(), "inv_rows")
plot(values.inv().columns(), "inv_columns")
plot(values.inv().elements_count(), "inv_elements")
plot(values.inv().get(0, 0), "inv_get")
plot(values.inv().copy().get(0, 1), "inv_copy_get")
plot(values.inv().inv().rows(), "inv_chain_rows")
plot(values.inv().inv().columns(), "inv_chain_columns")
plot(values.inv().inv().get(1, 0), "inv_chain_get")
plot(values.inv().transpose().inv().get(0, 1), "inv_transpose_chain_get")
plot(ints.inv().get(1, 1), "int_inv_get")
plot(ints.inv().inv().get(0, 0), "int_inv_chain_get")
plot(na(singular.inv().rows()) ? 1 : 0, "singular_rows_na")
plot(na(singular.inv().inv().rows()) ? 1 : 0, "singular_inv_chain_na")
plot(na(invalid.inv().rows()) ? 1 : 0, "invalid_rows_na")
plot(na(invalid.inv().inv().rows()) ? 1 : 0, "invalid_inv_chain_na")
plot(empty.inv().rows() * 100 + empty.inv().columns() * 10 + empty.inv().elements_count(), "empty_shape")
plot(empty.inv().inv().rows() * 100 + empty.inv().inv().columns() * 10 + empty.inv().inv().elements_count(), "empty_inv_chain_shape")
plot(values.get(0, 0), "source_value")
plot(inverted.get(0, 0), "inverted_value")
plot(reinverted.get(0, 0), "reinverted_value")
plot(invRows(values), "expression_udf")
plot(invBlockReads(values), "block_udf")
values.inv().set(0, 0, 107.0)
plot(values.get(0, 0) == 4.0 ? 1 : 0, "call_result_set_source_independent")
values.inv().fill(307.0)
plot(values.get(0, 0) == 4.0 ? 1 : 0, "call_result_fill_source_independent")
values.inv().reverse()
plot(values.get(0, 0) == 4.0 ? 1 : 0, "call_result_reverse_source_independent")
values.inv().reshape(1, 4)
plot(values.rows() == 2 and values.columns() == 2 ? 1 : 0, "call_result_reshape_source_independent")
values.inv().swap_rows(0, 1)
plot(values.get(0, 0) == 4.0 and values.get(1, 0) == 2.0 ? 1 : 0, "call_result_swap_rows_source_independent")
values.inv().swap_columns(0, 1)
plot(values.get(0, 0) == 4.0 and values.get(1, 0) == 2.0 ? 1 : 0, "call_result_swap_columns_source_independent")
values.inv().remove_row(0)
values.inv().remove_col(0)
plot(values.rows() == 2 and values.get(0, 0) == 4.0 ? 1 : 0, "call_result_remove_row_source_independent")
values.inv().add_row(0, array.from(7.0, 8.0))
plot(values.rows() == 2 and values.columns() == 2 and values.get(0, 0) == 4.0 ? 1 : 0, "call_result_add_row_source_independent")
values.inv().add_col(0, array.from(7.0, 8.0))
plot(values.rows() == 2 and values.columns() == 2 and values.get(0, 0) == 4.0 ? 1 : 0, "call_result_add_col_source_independent")
