//@version=6
import user/udt/1 as left
import user/udt/1 as right
indicator("Imported function matrix call-result reads")

source = left.exposeMatrixFunction()
copied = source.copy()
copied.set(0, 0, 99.0)
fresh_row = left.exposeMatrixFunction().row(0)
fresh_row.set(0, 77.0)
fresh_col = left.exposeMatrixFunction().col(0)
fresh_col.set(0, 66.0)
fresh_eigenvalues = left.exposeMatrixFunction().eigenvalues()
fresh_eigenvalues.set(0, 55.0)

plot(left.exposeMatrixFunction().rows(), "rows")
plot(left.exposeMatrixFunction().columns(), "columns")
plot(left.exposeMatrixFunction().elements_count(), "elements")
plot(left.exposeMatrixFunction().get(0, 1), "get")
plot(left.exposeMatrixFunction().copy().get(1, 1), "copy_chain")
plot(left.exposeMatrixFunction().row(1).first(), "row_float")
plot(left.exposeIntMatrixFunction().row(0).last(), "row_int")
plot(left.exposeStringMatrixFunction().row(0).first() == "pine" ? 1 : 0, "row_string")
plot(left.exposeBoolMatrixFunction().row(0).first() ? 1 : 0, "row_bool")
plot(left.exposeColorMatrixFunction().row(0).first() == color.red ? 1 : 0, "row_color")
plot(right.exposeMatrixFunction().row(0).copy().size(), "row_dual_alias")
plot(source.get(0, 0), "row_source_independent")
plot(fresh_row.get(0), "row_copy_independent")
plot(left.exposeMatrixFunction().col(1).last(), "col_float")
plot(left.exposeIntMatrixFunction().col(1).first(), "col_int")
plot(left.exposeStringMatrixFunction().col(0).first() == "pine" ? 1 : 0, "col_string")
plot(left.exposeBoolMatrixFunction().col(0).first() ? 1 : 0, "col_bool")
plot(left.exposeColorMatrixFunction().col(0).first() == color.red ? 1 : 0, "col_color")
plot(right.exposeMatrixFunction().col(0).copy().size(), "col_dual_alias")
plot(source.get(0, 0), "col_source_independent")
plot(fresh_col.get(0), "col_copy_independent")
plot(left.exposeMatrixFunction().eigenvalues().first(), "eigenvalues_float")
plot(right.exposeMatrixFunction().eigenvalues().copy().size(), "eigenvalues_dual_alias")
plot(source.get(0, 0), "eigenvalues_source_independent")
plot(fresh_eigenvalues.get(0), "eigenvalues_copy_independent")
plot(source.get(0, 0), "source_independent")
plot(copied.get(0, 0), "copy_independent")
plot(left.exposeIntMatrixFunction().get(0, 1), "int")
plot(left.exposeStringMatrixFunction().get(0, 0) == "pine" ? 1 : 0, "string")
plot(left.exposeBoolMatrixFunction().get(0, 0) ? 1 : 0, "bool")
plot(left.exposeColorMatrixFunction().get(0, 0) == color.red ? 1 : 0, "color")
plot(left.exposeEmptyMatrixFunction().rows() * 100 + left.exposeEmptyMatrixFunction().columns() * 10 + left.exposeEmptyMatrixFunction().elements_count(), "empty")
plot(left.exposeMatrixFunctionBlock().get(1, 1), "block")
plot(left.exposeMatrixFunctionNested().get(1, 0), "nested")
plot(left.exposeMatrixFunctionIf(other=true).get(0, 0), "control_flow")
plot(right.exposeMatrixFunction().get(0, 0), "dual_alias")
plot(left.exposeMatrixFunction().copy().copy().get(0, 1), "nested_copy")
