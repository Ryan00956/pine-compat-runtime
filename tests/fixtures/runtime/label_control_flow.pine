//@version=5
indicator("Label control flow")
var label_id = label.new(bar_index, high, "start")
x_i = 0
while x_i < 1
    if bar_index == 1
        label.set_x(label_id, bar_index)
    x_i := x_i + 1
y_i = 0
while y_i < 1
    if bar_index == 1
        label.set_y(label_id, low)
    y_i := y_i + 1
xy_i = 0
while xy_i < 1
    if bar_index == 1
        label.set_xy(label_id, bar_index + 1, close)
    xy_i := xy_i + 1
text_i = 0
while text_i < 1
    if bar_index == 1
        label.set_text(label_id, "if")
    text_i := text_i + 1
direction = close > open ? 1 : -1
color_i = 0
while color_i < 1
    if direction == 1
        label.set_color(label_id, color.green)
    else
        label.set_color(label_id, color.red)
    color_i := color_i + 1
textcolor_i = 0
while textcolor_i < 1
    if direction == 1
        label.set_textcolor(label_id, color.white)
    else
        label.set_textcolor(label_id, color.white)
    textcolor_i := textcolor_i + 1
style_i = 0
while style_i < 1
    if direction == 1
        label.set_style(label_id, label.style_label_up)
    else
        label.set_style(label_id, label.style_label_left)
    style_i := style_i + 1
textalign_i = 0
while textalign_i < 1
    if direction == 1
        label.set_textalign(label_id, text.align_right)
    else
        label.set_textalign(label_id, text.align_left)
    textalign_i := textalign_i + 1
text_font_family_i = 0
while text_font_family_i < 1
    if direction == 1
        label.set_text_font_family(label_id, font.family_monospace)
    else
        label.set_text_font_family(label_id, font.family_monospace)
    text_font_family_i := text_font_family_i + 1
text_formatting_i = 0
while text_formatting_i < 1
    if direction == 1
        label.set_text_formatting(label_id, text.format_bold)
    else
        label.set_text_formatting(label_id, text.format_bold + text.format_italic)
    text_formatting_i := text_formatting_i + 1
tooltip_i = 0
while tooltip_i < 1
    if bar_index == 2
        label.set_tooltip(label_id, "for")
    tooltip_i := tooltip_i + 1
size_i = 0
while size_i < 1
    if bar_index == 3
        label.set_size(label_id, size.small)
    size_i := size_i + 1
independent_get_x_value = label.get_x(label_id)
independent_get_x_i = 0
while independent_get_x_i < 1
    independent_get_x_value := label.get_x(label_id)
    independent_get_x_i := independent_get_x_i + 1
plot(independent_get_x_value)
independent_get_y_value = label.get_y(label_id)
independent_get_y_i = 0
while independent_get_y_i < 1
    independent_get_y_value := label.get_y(label_id)
    independent_get_y_i := independent_get_y_i + 1
plot(independent_get_y_value)
independent_get_text_length = str.length(label.get_text(label_id))
independent_get_text_i = 0
while independent_get_text_i < 1
    independent_get_text_length := str.length(label.get_text(label_id))
    independent_get_text_i := independent_get_text_i + 1
plot(independent_get_text_length)
independent_label_all_count = array.size(label.all)
independent_label_all_i = 0
while independent_label_all_i < 1
    independent_label_all_count := array.size(label.all)
    independent_label_all_i := independent_label_all_i + 1
plot(independent_label_all_count)
independent_set_x_i = 0
while independent_set_x_i < 1
    if bar_index == 3
        label.set_x(label_id, bar_index + 5)
    independent_set_x_i := independent_set_x_i + 1
plot(label.get_x(label_id))
independent_set_y_i = 0
while independent_set_y_i < 1
    if bar_index == 3
        label.set_y(label_id, close + 9)
    independent_set_y_i := independent_set_y_i + 1
plot(label.get_y(label_id))
independent_set_xy_i = 0
while independent_set_xy_i < 1
    if bar_index == 3
        label.set_xy(label_id, bar_index + 7, close + 11)
    independent_set_xy_i := independent_set_xy_i + 1
plot(label.get_x(label_id))
plot(label.get_y(label_id))
independent_set_text_i = 0
while independent_set_text_i < 1
    if bar_index == 3
        label.set_text(label_id, "loop-text")
    independent_set_text_i := independent_set_text_i + 1
plot(str.length(label.get_text(label_id)))
independent_set_color_i = 0
while independent_set_color_i < 1
    if bar_index == 3
        label.set_color(label_id, color.blue)
    independent_set_color_i := independent_set_color_i + 1
independent_set_textcolor_i = 0
while independent_set_textcolor_i < 1
    if bar_index == 3
        label.set_textcolor(label_id, color.yellow)
    independent_set_textcolor_i := independent_set_textcolor_i + 1
independent_set_style_i = 0
while independent_set_style_i < 1
    if bar_index == 3
        label.set_style(label_id, label.style_label_right)
    independent_set_style_i := independent_set_style_i + 1
independent_set_textalign_i = 0
while independent_set_textalign_i < 1
    if bar_index == 3
        label.set_textalign(label_id, text.align_center)
    independent_set_textalign_i := independent_set_textalign_i + 1
independent_set_text_font_family_i = 0
while independent_set_text_font_family_i < 1
    if bar_index == 3
        label.set_text_font_family(label_id, font.family_default)
    independent_set_text_font_family_i := independent_set_text_font_family_i + 1
independent_set_text_formatting_i = 0
while independent_set_text_formatting_i < 1
    if bar_index == 3
        label.set_text_formatting(label_id, text.format_none)
    independent_set_text_formatting_i := independent_set_text_formatting_i + 1
independent_set_tooltip_i = 0
while independent_set_tooltip_i < 1
    if bar_index == 3
        label.set_tooltip(label_id, "loop-tip")
    independent_set_tooltip_i := independent_set_tooltip_i + 1
independent_set_size_i = 0
while independent_set_size_i < 1
    if bar_index == 3
        label.set_size(label_id, size.large)
    independent_set_size_i := independent_set_size_i + 1
plot(close)
