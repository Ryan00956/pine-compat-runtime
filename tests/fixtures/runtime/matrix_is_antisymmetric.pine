//@version=6
indicator("Matrix is_antisymmetric")

antisymmetric = matrix.new<float>(3, 3, 0)
matrix.set(antisymmetric, 0, 2, close)
matrix.set(antisymmetric, 2, 0, -close)
rectangular = matrix.new<float>(2, 3, 0)
non_antisymmetric = matrix.new<float>(2, 2, 0)
matrix.set(non_antisymmetric, 0, 1, 1)
matrix.set(non_antisymmetric, 1, 0, 1)
non_zero_diagonal = matrix.new<float>(2, 2, 0)
matrix.set(non_zero_diagonal, 0, 0, 1)
diagonal_na = matrix.new<float>(2, 2, 0)
matrix.set(diagonal_na, 0, 0, na)
mirror_na = matrix.new<float>(2, 2, 0)
matrix.set(mirror_na, 0, 1, 3)
matrix.set(mirror_na, 1, 0, na)
zero_square = matrix.new<float>(0, 0)

plot(matrix.is_antisymmetric(antisymmetric) ? 1 : 0, "antisymmetric")
plot(rectangular.is_antisymmetric() ? 1 : 0, "rectangular")
plot(matrix.is_antisymmetric(non_antisymmetric) ? 1 : 0, "non_antisymmetric")
plot(non_zero_diagonal.is_antisymmetric() ? 1 : 0, "non_zero_diagonal")
plot(matrix.is_antisymmetric(diagonal_na) ? 1 : 0, "diagonal_na")
plot(mirror_na.is_antisymmetric() ? 1 : 0, "mirror_na")
plot(zero_square.is_antisymmetric() ? 1 : 0, "zero_square")
