//@version=5
strategy("Fill path calc on order fills resume", overlay=false, calc_on_order_fills=true, pyramiding=2, initial_capital=100000)

if bar_index == 0
    strategy.entry("A", strategy.long, qty=1, stop=10.8)
if strategy.position_size > 0
    strategy.entry("B", strategy.long, qty=1, limit=8.2)
