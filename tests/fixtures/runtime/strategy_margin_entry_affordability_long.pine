//@version=5
strategy("Margin entry affordability long", initial_capital=4, margin_long=100)
if bar_index == 0
    strategy.entry("too-big-market", strategy.long, qty=3)
if bar_index == 1
    strategy.entry("too-big-stop", strategy.long, qty=2, stop=3)
if bar_index == 2
    strategy.entry("covered-market", strategy.long, qty=1)
plot(strategy.position_size)
plot(strategy.opentrades.capital_held)
