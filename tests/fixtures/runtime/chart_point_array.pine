//@version=5
indicator("Chart point array")

current = chart.point.now(close)
indexed = chart.point.from_index(bar_index + 1, high)
timed = chart.point.from_time(time + 10, low)
full = chart.point.new(time + 20, bar_index + 2, close + 0.5)

points = array.from(current, indexed)
array.push(points, timed)
array.set(points, 1, full)
array.insert(points, 1, indexed)
removed = array.remove(points, 2)
array.unshift(points, chart.point.from_index(bar_index - 1, close + 10))
shifted = array.shift(points)
array.fill(points, current, 1, 2)

from_values = array.from(indexed, timed)
copied = array.copy(points)
array.reverse(copied)
joined = array.concat(copied, from_values)
slice = array.slice(joined, 1, 3)
cleared = array.copy(from_values)
array.clear(cleared)

last_index = array.lastindexof(joined, timed)
first_index = array.indexof(joined, current)
has_removed = array.includes(joined, removed)
first_value = array.first(joined)
last_value = array.last(joined)
popped = array.pop(joined)
slice_first = array.get(slice, 0)

plot(array.size(points))
plot(array.size(from_values))
plot(array.size(joined))
plot(array.size(slice))
plot(array.size(cleared))
plot(first_index)
plot(last_index)
plot(has_removed ? 1 : 0)
plot(first_value.time)
plot(first_value.index)
plot(last_value.price)
plot(popped.price)
plot(shifted.index)
plot(slice_first.price)
