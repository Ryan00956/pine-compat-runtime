//@version=5
indicator("Chart point array")

current = chart.point.now(close)
indexed = chart.point.from_index(bar_index + 1, high)
timed = chart.point.from_time(time + 10, low)
full = chart.point.new(time + 20, bar_index + 2, close + 0.5)

points = array.from(current, indexed)
array.push(points, timed)
array.set(points, 1, full)
array.insert(points, 1, indexed)
removed = array.remove(points, 2)
array.unshift(points, chart.point.from_index(bar_index - 1, close + 10))
shifted = array.shift(points)
array.fill(points, current, 1, 2)

from_values = array.from(indexed, timed)
copied = array.copy(points)
array.reverse(copied)
joined = array.concat(copied, from_values)
slice = array.slice(joined, 1, 3)
cleared = array.copy(from_values)
array.clear(cleared)
typed = array.new<chart.point>()
array.push(typed, current)
array.push(typed, indexed)
typed_seeded = array.new<chart.point>(2, timed)
array.set(typed_seeded, 1, full)
array.push(typed, array.get(typed_seeded, 1))

last_index = array.lastindexof(joined, timed)
first_index = array.indexof(joined, current)
has_removed = array.includes(joined, removed)
first_value = array.first(joined)
last_value = array.last(joined)
popped = array.pop(joined)
slice_first = array.get(slice, 0)
typed_first = array.first(typed)
typed_last = array.last(typed)
method_points = array.new<chart.point>()
method_points.push(current)
method_points.push(indexed)
method_points.set(1, timed)
method_copy = method_points.copy()
method_copy.reverse()
method_slice = method_copy.slice(0, 1)
method_slice.concat(method_points)
method_first_index = method_slice.indexof(current)
method_last_index = method_slice.lastindexof(timed)
method_has_indexed = method_slice.includes(indexed)
method_popped = method_slice.pop()
method_shifted = method_slice.shift()
method_slice.unshift(method_shifted)
method_slice.insert(1, method_popped)
method_slice.fill(current, 0, 1)
method_removed = method_slice.remove(1)
method_size_before_clear = method_slice.size()
method_first = method_slice.first()
method_last = method_slice.last()
method_slice.clear()
method_score = method_first_index == 1 and method_last_index == 2 and not method_has_indexed and method_size_before_clear == 2 and method_removed.price == timed.price and method_first.price == current.price and method_last.price == current.price and method_slice.size() == 0 ? 1 : 0

plot(array.size(points))
plot(array.size(from_values))
plot(array.size(joined))
plot(array.size(slice))
plot(array.size(cleared))
plot(array.size(typed))
plot(array.size(typed_seeded))
plot(first_index)
plot(last_index)
plot(has_removed ? 1 : 0)
plot(first_value.time)
plot(first_value.index)
plot(last_value.price)
plot(popped.price)
plot(shifted.index)
plot(slice_first.price)
plot(typed_first.price)
plot(typed_last.index)
plot(method_score)
