//@version=5
indicator("Drawing method syntax")
var label_id = label.new(bar_index, high, "start")
var line_id = line.new(bar_index, low, bar_index + 1, high)
var box_id = box.new(bar_index, high, bar_index + 1, low)
var table_id = table.new(position.top_right, 1, 1)
if bar_index == 1
    label_id.set_text("method")
    label_id.set_xy(bar_index, close)
    line_id.set_xy1(bar_index, low)
    line_id.set_color(color.green)
    box_id.set_lefttop(bar_index, high)
    box_id.set_xloc(bar_index - 1, bar_index + 1, xloc.bar_index)
    table_id.cell(0, 0, "A")
    table_id.set_bgcolor(color.green)
text_length = str.length(label_id.get_text())
line_x1 = line_id.get_x1()
box_right = box_id.get_right()
plot(text_length)
plot(line_x1)
plot(box_right)
plot(close)
