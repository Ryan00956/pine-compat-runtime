//@version=5
indicator("Label array")
var labels = array.new_label()
if bar_index == 0
    first = label.new(bar_index, high, "first")
    second = label.copy(first)
    array.push(labels, first)
    array.unshift(labels, second)
    array.insert(labels, 1, first)
    array.remove(labels, -1)
if bar_index == 1
    copied = array.copy(labels)
    saved = array.get(copied, 0)
    array.set(labels, 0, saved)
    label.set_text(saved, "copied")
    label.set_color(array.last(labels), color.green)
    label.set_x(array.first(labels), bar_index)
if bar_index == 2
    shifted = array.shift(labels)
    array.push(labels, shifted)
    array.reverse(labels)
    array.fill(labels, array.first(labels), 0, 1)
    sliced = array.slice(labels, 0, 1)
    array.concat(sliced, labels)
    label.set_y(array.get(sliced, 0), close)
    if array.includes(labels, array.first(labels))
        label.set_text(array.first(labels), "found")
    label.set_x(array.get(labels, array.indexof(labels, array.first(labels))), bar_index)
    label.set_textcolor(array.get(labels, array.lastindexof(labels, array.last(labels))), color.blue)
if bar_index == 3
    from_values = array.from(array.get(labels, 0))
    label.set_size(from_values.get(0), size.large)
    popped = array.pop(labels)
    label.set_text(popped, "popped")
    array.push(labels, popped)
    scratch = array.copy(labels)
    scratch.clear()
plot(array.size(labels))
plot(close)
