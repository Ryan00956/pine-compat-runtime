//@version=5
indicator("Label array")
var labels = array.new_label()
var label_concat_checks = array.new_bool()
if bar_index == 0
    first = label.new(bar_index, high, "first")
    second = label.copy(first)
    empty_slot = array.new_label(1)
    seeded = array.new_label(2, first)
    if na(empty_slot.get(0)) and seeded.size() == 2
        label.set_tooltip(seeded.get(1), "seeded")
    labels.push(first)
    labels.unshift(second)
    labels.insert(1, first)
    labels.remove(-1)
if bar_index == 1
    copied = labels.copy()
    saved = copied.get(0)
    labels.set(0, saved)
    label.set_text(saved, "copied")
    label.set_color(labels.last(), color.green)
    label.set_x(labels.first(), bar_index)
if bar_index == 2
    shifted = labels.shift()
    labels.push(shifted)
    labels.reverse()
    labels.fill(labels.first(), 0, 1)
    sliced = labels.slice(0, 1)
    sliced.concat(labels)
    empty_labels = array.new_label()
    before_empty_label_concat = labels.size()
    labels.concat(empty_labels)
    label_concat_checks.push(labels.size() == before_empty_label_concat and empty_labels.size() == 0)
    empty_label_target = array.new_label()
    source_label_size = labels.size()
    source_label_first = labels.get(0)
    empty_label_target.concat(labels)
    label_concat_checks.push(empty_label_target.size() == source_label_size and empty_label_target.get(0) == source_label_first and labels.size() == source_label_size and labels.get(0) == source_label_first)
    label.set_y(sliced.get(0), close)
    if labels.includes(labels.first())
        label.set_text(labels.first(), "found")
    label.set_x(labels.get(labels.indexof(labels.first())), bar_index)
    label.set_textcolor(labels.get(labels.lastindexof(labels.last())), color.blue)
if bar_index == 3
    from_values = array.from(labels.get(0))
    label.set_size(from_values.get(0), size.large)
    popped = labels.pop()
    label.set_text(popped, "popped")
    labels.push(popped)
    scratch = labels.copy()
    scratch.clear()
plot(labels.size())
plot(close)
plot(label_concat_checks.size() == 2 and label_concat_checks.get(0) and label_concat_checks.get(1) ? 1 : 0)
