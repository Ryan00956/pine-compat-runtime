//@version=5
strategy("Strategy close no-op")

if bar_index == 0
    strategy.close("L")

if bar_index == 1
    strategy.entry("L", strategy.long, qty=2)

if bar_index == 2
    strategy.close("other")

if bar_index == 3
    strategy.close("L")
    strategy.close("L")

plot(strategy.position_size)
plot(strategy.closedtrades)
plot(strategy.opentrades)
plot(strategy.netprofit)
