//@version=5
indicator("TA named reordered averages")
sma_value = ta.sma(length=3, source=close)
[bb_basis, bb_upper, bb_lower] = ta.bb(mult=2, length=3, source=close)
bbw_value = ta.bbw(mult=2, length=3, source=close)
[kc_middle, kc_upper, kc_lower] = ta.kc(useTrueRange=false, mult=2, length=2, source=close)
kcw_value = ta.kcw(useTrueRange=false, mult=2, length=2, source=close)
wma_value = ta.wma(length=3, source=close)
hma_value = ta.hma(length=2, source=close)
plot(sma_value)
plot(bb_upper)
plot(bbw_value)
plot(kc_upper)
plot(kcw_value)
plot(wma_value)
plot(hma_value)
