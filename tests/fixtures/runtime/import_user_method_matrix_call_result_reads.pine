//@version=6
import user/udt/1 as left
import user/udt/1 as right
indicator("Imported user-method matrix call-result reads")

left_point = left.Point.new(1.0)
right_point = right.Point.new(2.0)

source = left_point.exposeMatrix()
copied = source.copy()
copied.set(0, 0, 99.0)
fresh_row = left_point.exposeMatrix().row(0)
fresh_row.set(0, 77.0)
fresh_col = left_point.exposeMatrix().col(0)
fresh_col.set(0, 66.0)
fresh_eigenvalues = left_point.exposeMatrix().eigenvalues()
fresh_eigenvalues.set(0, 55.0)

plot(left_point.exposeMatrix().rows(), "rows")
plot(left_point.exposeMatrix().columns(), "columns")
plot(left_point.exposeMatrix().elements_count(), "elements")
plot(left_point.exposeMatrix().get(0, 1), "get")
plot(left_point.exposeMatrix().copy().get(1, 1), "copy_chain")
plot(left_point.exposeMatrix().row(1).first(), "row_float")
plot(left_point.exposeIntMatrix().row(0).last(), "row_int")
plot(left_point.exposeStringMatrix().row(0).first() == "pine" ? 1 : 0, "row_string")
plot(left_point.exposeBoolMatrix().row(0).first() ? 1 : 0, "row_bool")
plot(left_point.exposeColorMatrix().row(0).first() == color.red ? 1 : 0, "row_color")
plot(right_point.exposeMatrix().row(0).copy().size(), "row_dual_alias")
plot(source.get(0, 0), "row_source_independent")
plot(fresh_row.get(0), "row_copy_independent")
plot(left_point.exposeMatrix().col(1).last(), "col_float")
plot(left_point.exposeIntMatrix().col(1).first(), "col_int")
plot(left_point.exposeStringMatrix().col(0).first() == "pine" ? 1 : 0, "col_string")
plot(left_point.exposeBoolMatrix().col(0).first() ? 1 : 0, "col_bool")
plot(left_point.exposeColorMatrix().col(0).first() == color.red ? 1 : 0, "col_color")
plot(right_point.exposeMatrix().col(0).copy().size(), "col_dual_alias")
plot(source.get(0, 0), "col_source_independent")
plot(fresh_col.get(0), "col_copy_independent")
plot(left_point.exposeMatrix().eigenvalues().first(), "eigenvalues_float")
plot(right_point.exposeMatrix().eigenvalues().copy().size(), "eigenvalues_dual_alias")
plot(source.get(0, 0), "eigenvalues_source_independent")
plot(fresh_eigenvalues.get(0), "eigenvalues_copy_independent")
plot(left_point.exposeMatrix().is_square() ? 1 : 0, "is_square_float")
plot(right_point.exposeColorMatrix().is_square() ? 1 : 0, "is_square_color")
plot(left_point.exposeMatrix().is_zero() ? 1 : 0, "is_zero_float")
plot(right_point.exposeIntMatrix().is_zero() ? 1 : 0, "is_zero_int")
plot(left_point.exposeMatrix().is_binary() ? 1 : 0, "is_binary_float")
plot(right_point.exposeIntMatrix().is_binary() ? 1 : 0, "is_binary_int")
plot(source.get(0, 0), "source_independent")
plot(copied.get(0, 0), "copy_independent")
plot(left_point.exposeIntMatrix().get(0, 1), "int")
plot(left_point.exposeStringMatrix().get(0, 0) == "pine" ? 1 : 0, "string")
plot(left_point.exposeBoolMatrix().get(0, 0) ? 1 : 0, "bool")
plot(left_point.exposeColorMatrix().get(0, 0) == color.red ? 1 : 0, "color")
plot(left_point.exposeEmptyMatrix().rows() * 100 + left_point.exposeEmptyMatrix().columns() * 10 + left_point.exposeEmptyMatrix().elements_count(), "empty")
plot(left_point.exposeMatrixBlock().get(1, 1), "block")
plot(left_point.exposeMatrixNested().get(1, 0), "nested")
plot(left_point.exposeMatrixIf(other=true).get(0, 0), "control_flow")
plot(left.exposeMatrix(left_point).get(0, 0), "alias_qualified")
plot(left.Point.new(3.0).exposeMatrix().get(1, 1), "constructor_receiver")
plot(right_point.exposeMatrix().get(0, 0), "dual_alias")
plot(left_point.exposeMatrix().copy().copy().get(0, 1), "nested_copy")
