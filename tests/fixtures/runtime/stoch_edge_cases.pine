//@version=5
indicator("Stoch edge cases")
k = ta.stoch(close, high, low, 3)
source_na = ta.stoch(bar_index == 3 ? na : close, high, low, 3)
high_na = ta.stoch(close, bar_index == 3 ? na : high, low, 3)
low_na = ta.stoch(close, high, bar_index == 3 ? na : low, 3)
flat = ta.stoch(close, 1 + close * 0, 1 + close * 0, 2)
invalid = ta.stoch(close, high, low, 0)
plot(k)
plot(source_na)
plot(high_na)
plot(low_na)
plot(na(flat) ? 1 : 0)
plot(na(invalid) ? 1 : 0)
