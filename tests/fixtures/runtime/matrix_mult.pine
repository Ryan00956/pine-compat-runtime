//@version=6
indicator("Matrix mult")

left = matrix.new<float>(2, 3, 0)
matrix.set(left, 0, 0, 1)
matrix.set(left, 0, 1, 2)
matrix.set(left, 0, 2, 3)
matrix.set(left, 1, 0, 4)
matrix.set(left, 1, 1, 5)
matrix.set(left, 1, 2, 6)

right = matrix.new<float>(3, 2, 0)
matrix.set(right, 0, 0, 7)
matrix.set(right, 0, 1, 8)
matrix.set(right, 1, 0, 9)
matrix.set(right, 1, 1, 10)
matrix.set(right, 2, 0, 11)
matrix.set(right, 2, 1, 12)

namespace_result = matrix.mult(left, right)
method_result = left.mult(right)
matrix.set(left, 0, 0, 99)
scalar_result = matrix.mult(right, 2)
left_scalar_result = matrix.mult(2, right)
scalar_method_result = right.mult(0.5)
scalar_na_result = matrix.mult(right, na)
left_scalar_na_result = matrix.mult(na, right)
array_result = matrix.mult(right, array.from(1.0, 2.0))
array_method_result = right.mult(array.from(0.5, 1.0))
array_na_result = matrix.mult(right, array.from(1.0, na))
array_left_result = matrix.mult(array.from(1.0, 2.0, 3.0), right)
array_left_na_result = matrix.mult(array.from(1.0, na, 3.0), right)

na_left = matrix.new<float>(1, 2, 2)
matrix.set(na_left, 0, 1, na)
na_result = matrix.mult(na_left, matrix.new<float>(2, 1, 3))

empty_result = matrix.mult(matrix.new<float>(0, 2), matrix.new<float>(2, 1, 1))

plot(matrix.rows(namespace_result), "namespace_rows")
plot(matrix.columns(namespace_result), "namespace_columns")
plot(matrix.get(namespace_result, 0, 0), "namespace_0_0")
plot(matrix.get(namespace_result, 0, 1), "namespace_0_1")
plot(matrix.get(namespace_result, 1, 0), "namespace_1_0")
plot(matrix.get(namespace_result, 1, 1), "namespace_1_1")
plot(matrix.get(method_result, 0, 0), "method_0_0")
plot(matrix.get(scalar_result, 0, 0), "scalar_0_0")
plot(matrix.get(scalar_result, 2, 1), "scalar_2_1")
plot(matrix.get(left_scalar_result, 1, 1), "left_scalar_1_1")
plot(matrix.get(scalar_method_result, 1, 0), "scalar_method_1_0")
plot(na(matrix.get(scalar_na_result, 0, 0)) ? 1 : 0, "scalar_na_0_0")
plot(na(matrix.get(left_scalar_na_result, 0, 0)) ? 1 : 0, "left_scalar_na_0_0")
plot(array.get(array_result, 0), "array_0")
plot(array.get(array_result, 1), "array_1")
plot(array.get(array_method_result, 0), "array_method_0")
plot(na(array.get(array_na_result, 0)) ? 1 : 0, "array_na_0")
plot(array.get(array_left_result, 0), "array_left_0")
plot(array.get(array_left_result, 1), "array_left_1")
plot(na(array.get(array_left_na_result, 0)) ? 1 : 0, "array_left_na_0")
plot(na(matrix.get(na_result, 0, 0)) ? 1 : 0, "na_result_0_0")
plot(matrix.rows(empty_result), "empty_rows")
plot(matrix.columns(empty_result), "empty_columns")
