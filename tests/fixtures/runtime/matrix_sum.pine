//@version=6
indicator("Matrix sum")

values = matrix.new<float>(2, 3, na)
matrix.set(values, 0, 0, close)
matrix.set(values, 0, 1, close + 1)
matrix.set(values, 1, 2, close + 10)
namespace_sum = matrix.sum(values)
method_sum = values.sum()

empty = matrix.new<float>(0, 2)
all_na = matrix.new<float>(1, 2)

plot(namespace_sum, "namespace_sum")
plot(method_sum, "method_sum")
plot(na(matrix.sum(empty)) ? 1 : 0, "empty_sum_is_na")
plot(na(all_na.sum()) ? 1 : 0, "all_na_sum_is_na")
