//@version=5
indicator("Percentile linear interpolation edge cases")
middle = ta.percentile_linear_interpolation(close, 3, 50)
quarter = ta.percentile_linear_interpolation(close, 3, 25)
lowest = ta.percentile_linear_interpolation(close, 3, 0)
highest = ta.percentile_linear_interpolation(close, 3, 100)
simple = ta.percentile_linear_interpolation(3, 3, 50)
with_na = ta.percentile_linear_interpolation(bar_index == 3 ? na : close, 3, 50)
invalid_length = ta.percentile_linear_interpolation(close, 0, 50)
invalid_missing_percentage = ta.percentile_linear_interpolation(close, 3, na)
invalid_low = ta.percentile_linear_interpolation(close, 3, -1)
invalid_high = ta.percentile_linear_interpolation(close, 3, 150)
plot(middle)
plot(quarter)
plot(lowest)
plot(highest)
plot(simple)
plot(with_na)
plot(invalid_length)
plot(invalid_missing_percentage)
plot(invalid_low)
plot(invalid_high)
