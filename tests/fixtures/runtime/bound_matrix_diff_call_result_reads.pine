//@version=6
indicator("Bound matrix.diff call-result reads")

diffRows(left, right) => left.diff(right).rows()

diffBlockReads(left, right) =>
    int rows = left.diff(right).rows()
    int columns = left.diff(right).columns()
    float value = left.diff(right).get(1, 1)
    rows * 100 + columns * 10 + value

left = matrix.new<float>(2, 2, 0.0)
left.set(0, 0, 5.0)
left.set(0, 1, 6.0)
left.set(1, 0, 7.0)
left.set(1, 1, 8.0)
right = matrix.new<float>(2, 2, 0.0)
right.set(0, 0, 1.0)
right.set(0, 1, 2.0)
right.set(1, 0, 3.0)
right.set(1, 1, 4.0)

difference = left.diff(right).copy()
difference.set(0, 0, 99.0)

int_left = matrix.new<int>(1, 1, 7)
int_right = matrix.new<int>(1, 1, 2)
third = matrix.new<float>(2, 2, 1.0)
invalid = matrix.new<float>(1, 1)
empty = matrix.new<float>(0, 2)

redifference = left.diff(right).diff(third)
redifference.set(0, 0, 98.0)
remultiplied = left.diff(right).mult(2.0)
remultiplied.set(0, 0, 97.0)

plot(left.diff(right).rows(), "diff_rows")
plot(left.diff(right).columns(), "diff_columns")
plot(left.diff(right).elements_count(), "diff_elements")
plot(left.diff(right).get(1, 1), "diff_get")
plot(left.diff(1.5).copy().get(1, 1), "scalar_diff_get")
plot(left.get(0, 0), "source_value")
plot(difference.get(0, 0), "difference_value")
plot(int_left.diff(int_right).get(0, 0), "int_diff_get")
plot(diffRows(left, right), "expression_udf")
plot(diffBlockReads(left, right), "block_udf")
plot(left.diff(right).diff(third).rows(), "diff_chain_rows")
plot(left.diff(right).diff(third).columns(), "diff_chain_columns")
plot(left.diff(right).diff(third).get(1, 1), "diff_chain_get")
plot(left.diff(right).diff(1.5).get(0, 0), "diff_scalar_chain_get")
plot(int_left.diff(int_right).diff(1).get(0, 0), "diff_int_chain_get")
plot(na(left.diff(right).diff(na).get(0, 0)) ? 1 : 0, "diff_scalar_na")
plot(na(invalid.diff(1.0).diff(1.0).get(0, 0)) ? 1 : 0, "diff_invalid_na")
plot(empty.diff(1.0).diff(1.0).rows() * 100 + empty.diff(1.0).diff(1.0).columns() * 10 + empty.diff(1.0).diff(1.0).elements_count(), "diff_empty_shape")
plot(left.diff(right).copy().diff(1.0).kron(matrix.new<float>(1, 1, 2.0)).get(0, 0), "diff_nested_get")
plot(redifference.get(0, 0), "redifference_value")
plot(left.get(0, 0), "redifference_source_value")
plot(left.diff(right).mult(2.0).rows(), "mult_chain_rows")
plot(left.diff(right).mult(2.0).columns(), "mult_chain_columns")
plot(left.diff(right).mult(2.0).get(1, 1), "mult_scalar_chain_get")
plot(left.diff(right).mult(third).get(0, 0), "mult_matrix_chain_get")
plot(left.diff(right).mult(array.from(1.0, 1.0)).copy().get(1), "mult_array_chain_get")
plot(int_left.diff(int_right).mult(3).get(0, 0), "mult_int_chain_get")
plot(na(left.diff(right).mult(na).get(0, 0)) ? 1 : 0, "mult_scalar_na")
plot(na(invalid.diff(1.0).mult(2.0).get(0, 0)) ? 1 : 0, "mult_invalid_na")
plot(empty.diff(1.0).mult(2.0).rows() * 100 + empty.diff(1.0).mult(2.0).columns() * 10 + empty.diff(1.0).mult(2.0).elements_count(), "mult_empty_shape")
plot(empty.diff(1.0).mult(array.from(1.0, 1.0)).size(), "mult_empty_array_size")
plot(left.diff(right).copy().mult(2.0).kron(matrix.new<float>(1, 1, 2.0)).get(0, 0), "mult_nested_get")
plot(remultiplied.get(0, 0), "remultiplied_value")
plot(left.diff(right).get(0, 0), "remultiplied_source_value")
left.diff(right).set(0, 0, 105.0)
plot(left.get(0, 0) == 5.0 and right.get(0, 0) == 1.0 ? 1 : 0, "call_result_set_source_independent")
left.diff(right).fill(305.0)
plot(left.get(0, 0) == 5.0 and right.get(0, 0) == 1.0 ? 1 : 0, "call_result_fill_source_independent")
left.diff(right).reverse()
plot(left.get(0, 0) == 5.0 and right.get(0, 0) == 1.0 ? 1 : 0, "call_result_reverse_source_independent")
left.diff(right).reshape(1, 4)
plot(left.rows() == 2 and left.columns() == 2 and right.rows() == 2 and right.columns() == 2 ? 1 : 0, "call_result_reshape_source_independent")
left.diff(right).swap_rows(0, 1)
plot(left.get(0, 0) == 5.0 and right.get(0, 0) == 1.0 ? 1 : 0, "call_result_swap_rows_source_independent")
left.diff(right).swap_columns(0, 1)
plot(left.get(0, 0) == 5.0 and right.get(0, 0) == 1.0 ? 1 : 0, "call_result_swap_columns_source_independent")
left.diff(right).remove_row(0)
left.diff(right).remove_col(0)
plot(left.rows() == 2 and right.rows() == 2 and left.get(0, 0) == 5.0 and right.get(0, 0) == 1.0 ? 1 : 0, "call_result_remove_row_source_independent")
left.diff(right).add_row(0, array.from(7.0, 8.0))
plot(left.rows() == 2 and right.rows() == 2 and left.get(0, 0) == 5.0 and right.get(0, 0) == 1.0 ? 1 : 0, "call_result_add_row_source_independent")
left.diff(right).add_col(0, array.from(7.0, 8.0))
plot(left.rows() == 2 and right.rows() == 2 and left.get(0, 0) == 5.0 and right.get(0, 0) == 1.0 ? 1 : 0, "call_result_add_col_source_independent")
