//@version=6
import user/udt/1 as lib
indicator("Imported UDT for-in expression")

points = array.from(lib.Point.new(close), lib.Point.new(close + 1), lib.Point.new(close + 2))

last = for point in points
    point

continued = for point in points
    if point.x == close + 1
        continue
    point

stopped = for point in points
    if point.x == close + 2
        break
    point

mutated_last = for point in points
    point.x := point.x + 10
    point

source_first = points.get(0)

lib.Point typed = for point in points
    point
typed := for point in points
    lib.Point.new(point.x + 20)

last_prior = last[1]
typed_prior = typed[1]

index_value_last = for index, point in points
    index + point.x

plot(last.x + continued.x + stopped.x + mutated_last.x + source_first.x + index_value_last)
plot(typed.x + last.x)
plot(last_prior.x)
plot(typed_prior.x)
