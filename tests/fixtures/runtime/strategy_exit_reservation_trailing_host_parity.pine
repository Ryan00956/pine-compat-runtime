//@version=5
strategy("Exit reservation trailing host parity")
if bar_index == 0
    strategy.entry("L", strategy.long, qty=2)
    strategy.exit("XT1", "L", trail_price=2, trail_offset=50, qty=0.75)
    strategy.exit("XT2", "L", trail_price=2, trail_offset=70, qty_percent=75)
plot(strategy.position_size)
plot(strategy.netprofit)
