//@version=5
indicator("Series history offset built-in return")

offset = ta.barssince(bar_index == 1)
first_bar_offset = ta.barssince(bar_index == 0)
first_bar_previous = close[first_bar_offset]
missing_offset = ta.barssince(bar_index == 99)

plot(offset)
plot(close[offset])
plot(first_bar_previous)
plot(close[missing_offset])
plot(na(first_bar_previous[1]) ? 1 : 0)
