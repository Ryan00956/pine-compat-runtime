//@version=5
indicator("Array type alias declarations", overlay=true)

int[] counts = na
float[] prices = array.new_float()
bool[] flags = array.new_bool()
string[] words = array.new_string()
color[] colors = array.new_color()

label[] labels = array.new_label()
line[] lines = array.new_line()
linefill[] fills = array.new_linefill()
polyline[] paths = array.new_polyline()
box[] boxes = array.new_box()
table[] tables = array.new_table()
chart.point[] points = array.new<chart.point>()
var float[] persistent = array.new_float()

counts := array.from(bar_index)
prices.push(close)
flags.push(close >= open)
words.push("alias")
colors.push(color.green)

marker = label.new(bar_index, close, "alias")
upper = line.new(bar_index, high, bar_index + 1, high + 1)
lower = line.new(bar_index, low, bar_index + 1, low - 1)
fill = linefill.new(upper, lower, color.new(color.blue, 80))
path = polyline.new(array.from(chart.point.from_index(bar_index, close), chart.point.from_index(bar_index + 1, close + 1)))
range_box = box.new(bar_index, high, bar_index + 1, low)
info = table.new(position.top_right, 1, 1)
point = chart.point.from_index(bar_index, close)

labels.push(marker)
lines.push(upper)
fills.push(fill)
paths.push(path)
boxes.push(range_box)
tables.push(info)
points.push(point)
first_point = points.first()
persistent.push(close)

plot(counts.get(0))
plot(prices.get(0))
plot(flags.get(0) ? 1 : 0)
plot(str.length(words.get(0)))
plot(colors.get(0) == color.green ? 1 : 0)
plot(labels.size())
plot(lines.size())
plot(fills.size())
plot(paths.size())
plot(boxes.size())
plot(tables.size())
plot(first_point.price)
plot(persistent.size())
