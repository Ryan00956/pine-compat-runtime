//@version=6
indicator("Matrix concat")

float_left = matrix.new<float>(1, 2, na)
matrix.set(float_left, 0, 0, close)
matrix.set(float_left, 0, 1, close + 1)
float_right = matrix.new<float>(1, 2, na)
matrix.set(float_right, 0, 0, close + 2)
float_result = matrix.concat(float_left, float_right)
matrix.set(float_result, 0, 0, close + 10)

int_left = matrix.new<int>(1, 2, 1)
matrix.set(int_left, 0, 1, 2)
int_right = matrix.new<int>(1, 2, 3)
matrix.set(int_right, 0, 1, 4)
int_result = int_left.concat(int_right)

bool_left = matrix.new<bool>(1, 1, true)
bool_right = matrix.new<bool>(1, 1, false)
bool_result = bool_left.concat(bool_right)
string_left = matrix.new<string>(1, 1, "a")
string_right = matrix.new<string>(1, 1, "b")
string_result = matrix.concat(string_left, string_right)
color_left = matrix.new<color>(1, 1, color.red)
color_right = matrix.new<color>(1, 1, color.blue)
color_result = color_left.concat(color_right)

self_values = matrix.new<int>(1, 2, 5)
matrix.set(self_values, 0, 1, 6)
self_result = matrix.concat(self_values, self_values)

zero_row = matrix.new<float>(0, 2)
zero_row_source = matrix.new<float>(1, 2, 7)
zero_row_result = zero_row.concat(zero_row_source)
zero_column = matrix.new<bool>(2, 0)
zero_column_source = matrix.new<bool>(3, 0)
zero_column_result = matrix.concat(zero_column, zero_column_source)
empty = matrix.new<string>(0, 0)
empty_source = matrix.new<string>(0, 0)
empty_result = empty.concat(empty_source)

var accumulated = matrix.new<int>(0, 1)
step = matrix.new<int>(1, 1, bar_index)
accumulated.concat(step)

plot(matrix.rows(float_left), "float_target_rows")
plot(matrix.rows(float_right), "float_source_rows")
plot(matrix.get(float_left, 0, 0), "float_alias_mutation")
plot(matrix.get(float_result, 1, 0), "float_appended_value")
plot(na(matrix.get(float_result, 1, 1)) ? 1 : 0, "float_appended_na")
plot(int_result.rows(), "int_rows")
plot(int_result.get(1, 1), "int_appended_value")
plot(not bool_result.get(1, 0) ? 1 : 0, "bool_appended_value")
plot(string_result.get(1, 0) == "b" ? 1 : 0, "string_appended_value")
plot(color_result.get(1, 0) == color.blue ? 1 : 0, "color_appended_value")
plot(self_result.rows(), "self_rows")
plot(self_result.get(1, 1), "self_appended_value")
plot(zero_row_result.rows() * 10 + zero_row_result.columns(), "zero_row_shape")
plot(zero_row_result.get(0, 1), "zero_row_appended_value")
plot(zero_column_result.rows() * 10 + zero_column_result.columns(), "zero_column_shape")
plot(empty_result.rows() * 10 + empty_result.columns(), "empty_shape")
plot(accumulated.rows(), "accumulated_rows")
plot(bar_index > 0 ? matrix.rows(accumulated[1]) : na, "previous_accumulated_rows")
