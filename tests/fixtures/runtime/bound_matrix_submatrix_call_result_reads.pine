//@version=6
indicator("Bound matrix.submatrix call-result reads")

submatrixRows(id) => id.submatrix(1, 3, 1, 4).rows()

submatrixBlockReads(id) =>
    int rows = id.submatrix(1, 3, 1, 4).rows()
    int columns = id.submatrix(1, 3, 1, 4).columns()
    float value = id.submatrix(1, 3, 1, 4).get(1, 2)
    rows * 100 + columns * 10 + value

values = matrix.new<float>(3, 4, 1.0)
values.set(2, 3, 9.0)

selected = values.submatrix(1, 3, 1, 4).copy()
selected.set(0, 0, 7.0)
resliced = values.submatrix(1, 3, 1, 4).submatrix(0, 1, 1, 3)
resliced.set(0, 0, 8.0)

ints = matrix.new<int>(1, 1, 4)
bools = matrix.new<bool>(1, 1, true)
strings = matrix.new<string>(1, 1, "value")
colors = matrix.new<color>(1, 1, color.red)

plot(values.submatrix(1, 3, 1, 4).rows(), "submatrix_rows")
plot(values.submatrix(1, 3, 1, 4).columns(), "submatrix_columns")
plot(values.submatrix(1, 3, 1, 4).elements_count(), "submatrix_elements")
plot(values.submatrix(1, 3, 1, 4).get(1, 2), "submatrix_get")
plot(values.submatrix().copy().get(2, 3), "submatrix_copy_get")
plot(values.submatrix(1, 3, 1, 4).submatrix().rows(), "submatrix_chain_rows")
plot(values.submatrix(1, 3, 1, 4).submatrix().columns(), "submatrix_chain_columns")
plot(values.submatrix(1, 3, 1, 4).submatrix(0, 2, 1, 3).get(1, 1), "submatrix_chain_get")
plot(values.submatrix().transpose().submatrix(1, 3, 0, 2).get(1, 1), "submatrix_transpose_chain_get")
plot(values.submatrix(3, 3, 0, 4).rows(), "empty_rows")
plot(values.submatrix(3, 3, 0, 4).columns(), "empty_rows_columns")
plot(values.get(1, 1), "source_value")
plot(selected.get(0, 0), "selected_value")
plot(resliced.get(0, 0), "resliced_value")
plot(ints.submatrix().get(0, 0), "int_get")
plot(bools.submatrix().get(0, 0) ? 1 : 0, "bool_get")
plot(strings.submatrix().get(0, 0) == "value" ? 1 : 0, "string_get")
plot(colors.submatrix().get(0, 0) == color.red ? 1 : 0, "color_get")
plot(ints.submatrix().submatrix().get(0, 0), "int_submatrix_chain_get")
plot(bools.submatrix().submatrix().get(0, 0) ? 1 : 0, "bool_submatrix_chain_get")
plot(submatrixRows(values), "expression_udf")
plot(submatrixBlockReads(values), "block_udf")
values.submatrix(1, 3, 1, 4).set(0, 0, 103.0)
plot(values.get(1, 1) == 1.0 ? 1 : 0, "call_result_set_source_independent")
