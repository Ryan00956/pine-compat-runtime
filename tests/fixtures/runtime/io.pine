//@version=5
indicator("IO", overlay=true)
src = input.source(close, "Source")
length = input.int(2, "Length")
scale = input.float(1.5, "Scale")
enabled = input.bool(true, "Enabled")
shade = input.color(color.orange, "Shade")
mode = input.string("SMA", "Mode")
p = plot(enabled and mode == "SMA" ? ta.sma(src, length) * scale : close, color=color.new(shade, 10), linewidth=2, style=plot.style_line, trackprice=false, histbase=0, offset=0, join=false, editable=true, show_last=10, display=display.all, format=format.price, precision=2, force_overlay=false)
h = hline(2, "Two", color=color.gray, linestyle=hline.style_dotted, linewidth=1, editable=true, display=display.all)
fill(p, h, color=color.new(shade, 80), title="MA fill", editable=false, show_last=10, fillgaps=true, display=display.all)
