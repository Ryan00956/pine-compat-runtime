//@version=5
indicator("IO", overlay=true, format=format.price, precision=2, scale=scale.right)
src = input.source(close, "Source", confirm=true)
length = input.int(2, "Length")
factor = input.float(1.5, "Scale")
enabled = input.bool(true, "Enabled")
shade = input.color(color.orange, "Shade")
mode = input.string("SMA", "Mode")
p = plot(enabled and mode == "SMA" ? ta.sma(src, length) * factor : close, color=color.new(shade, 10), linewidth=2, style=plot.style_line, trackprice=false, histbase=0, offset=0, join=false, editable=true, show_last=10, display=display.pane, format=format.price, precision=2, force_overlay=false)
h = hline(2, "Two", color=color.gray, linestyle=hline.style_dotted, linewidth=1, editable=true, display=display.price_scale)
fill(p, h, color=color.new(shade, 80), title="MA fill", editable=false, show_last=10, fillgaps=true, display=display.status_line)
plot(format.inherit == "format.inherit" and format.price == "format.price" and format.percent == "format.percent" and format.volume == "format.volume" and scale.left == "scale.left" and scale.right == "scale.right" and scale.none == "scale.none" and barmerge.gaps_off == "barmerge.gaps_off" and barmerge.gaps_on == "barmerge.gaps_on" and barmerge.lookahead_off == "barmerge.lookahead_off" and barmerge.lookahead_on == "barmerge.lookahead_on" ? 1 : 0)
