//@version=5
strategy("Exit reservation bracket single replacement")
if bar_index == 0
    strategy.entry("L", strategy.long, qty=2)
    strategy.exit("X", "L", stop=0.5, qty=1.5)
    strategy.exit("XB2", "L", stop=0.25, limit=3, qty=0.5)
if bar_index == 1
    strategy.exit("X", "L", stop=0.5, limit=4, qty=1.5)
plot(strategy.position_size)
plot(strategy.netprofit)
