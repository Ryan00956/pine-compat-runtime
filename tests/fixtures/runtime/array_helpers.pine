indicator("Array helpers fixture")
numbers = array.new_int()
array.unshift(numbers, 2)
array.unshift(numbers, 1)
number_first = array.first(numbers)
number_last = array.last(numbers)
number_shifted = array.shift(numbers)
plot(number_first + number_last + number_shifted + array.size(numbers))

floats = array.new_float()
floats.unshift(high)
floats.unshift(close)
float_first = floats.first()
float_shifted = floats.shift()
plot(float_first + float_shifted + floats.size())

words = array.new_string()
words.unshift("tail")
words.unshift("head")
word_first = words.first()
word_last = words.last()
word_shifted = words.shift()
plot(word_first == "head" and word_last == "tail" and word_shifted == "head" ? words.size() : 0)

shades = array.new_color()
shades.unshift(color.green)
shades.unshift(color.red)
shade_first = shades.first()
shade_last = shades.last()
shade_shifted = shades.shift()
plot(shade_first == color.red and shade_last == color.green and shade_shifted == color.red ? shades.size() : 0)

flags = array.new_bool()
flags.unshift(false)
flags.unshift(true)
flag_first = flags.first()
plot(flag_first and flags.shift() and flags.size() == 1 ? 1 : 0)

empty = array.new_bool()
plot(na(array.first(empty)) and na(array.last(empty)) and na(array.shift(empty)) ? 1 : 0)
