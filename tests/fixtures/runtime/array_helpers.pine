indicator("Array helpers fixture")
numbers = array.new_int()
array.unshift(numbers, 2)
array.unshift(numbers, 1)
number_first = array.first(numbers)
number_last = array.last(numbers)
number_shifted = array.shift(numbers)
plot(number_first + number_last + number_shifted + array.size(numbers))
plot(array.first(numbers) == 2 and array.size(numbers) == 1 ? 1 : 0)

floats = array.new_float()
floats.unshift(high)
floats.unshift(close)
float_first = floats.first()
float_last = floats.last()
float_shifted = floats.shift()
plot(float_first + float_last + float_shifted + floats.size())

words = array.new_string()
words.unshift("tail")
words.unshift("head")
word_first = words.first()
word_last = words.last()
word_shifted = words.shift()
plot(word_first == "head" and word_last == "tail" and word_shifted == "head" ? words.size() : 0)

shades = array.new_color()
shades.unshift(color.green)
shades.unshift(color.red)
shade_first = shades.first()
shade_last = shades.last()
shade_shifted = shades.shift()
plot(shade_first == color.red and shade_last == color.green and shade_shifted == color.red ? shades.size() : 0)

flags = array.new_bool()
flags.unshift(false)
flags.unshift(true)
flag_first = flags.first()
flag_last = flags.last()
plot(flag_first and not flag_last and flags.shift() and flags.size() == 1 ? 1 : 0)

empty = array.new_bool()
plot(na(array.first(empty)) and na(array.last(empty)) and na(array.shift(empty)) ? 1 : 0)

branch_shift_unshift = array.from(2, 3)
branch_shift_unshift_score = bar_index * 0
if bar_index % 2 == 0
    array.unshift(branch_shift_unshift, 1)
    branch_shifted_even = branch_shift_unshift.shift()
    branch_shift_unshift_score := branch_shifted_even * 100 + branch_shift_unshift.get(0) * 10 + branch_shift_unshift.get(1)
else
    branch_shift_unshift.unshift(4)
    branch_shifted_odd = array.shift(branch_shift_unshift)
    branch_shift_unshift_score := branch_shifted_odd * 100 + branch_shift_unshift.get(0) * 10 + branch_shift_unshift.get(1)
plot(branch_shift_unshift_score)

loop_shift_unshift = array.from(5)
loop_shift_unshift_score = bar_index * 0
for i = 0 to 1
    if i == 0
        array.unshift(loop_shift_unshift, i + 1)
        loop_shift_unshift_score := loop_shift_unshift_score + loop_shift_unshift.shift()
    else
        loop_shift_unshift.unshift(i + 1)
        loop_shift_unshift_score := loop_shift_unshift_score + array.shift(loop_shift_unshift)
plot(loop_shift_unshift_score * 100 + loop_shift_unshift.size() * 10 + loop_shift_unshift.get(0))

independent_shift_values = array.from(3, 4, 5)
independent_shift_score = bar_index * 0
independent_shift_i = 0
while independent_shift_i < 1
    independent_shift_first = array.shift(independent_shift_values)
    independent_shift_second = independent_shift_values.shift()
    independent_shift_score := independent_shift_first * 1000 + independent_shift_second * 100 + independent_shift_values.size() * 10 + independent_shift_values.get(0)
    independent_shift_i := independent_shift_i + 1
plot(independent_shift_score)

independent_unshift_values = array.from(3)
independent_unshift_score = bar_index * 0
independent_unshift_i = 0
while independent_unshift_i < 1
    array.unshift(independent_unshift_values, 2)
    independent_unshift_values.unshift(1)
    independent_unshift_score := independent_unshift_values.size() * 1000 + independent_unshift_values.get(0) * 100 + independent_unshift_values.get(1) * 10 + independent_unshift_values.get(2)
    independent_unshift_i := independent_unshift_i + 1
plot(independent_unshift_score)

branch_first_last = array.from(7, 8, 9)
branch_first_last_score = bar_index * 0
if bar_index % 2 == 0
    branch_first_last_score := array.first(branch_first_last) * 10 + branch_first_last.last()
else
    branch_first_last_score := branch_first_last.first() * 10 + array.last(branch_first_last)
plot(branch_first_last_score)

loop_first_last = array.from(1, 2, 3)
loop_first_last_score = bar_index * 0
for i = 0 to 1
    if i == 0
        loop_first_last_score := loop_first_last_score + array.first(loop_first_last) * 10 + loop_first_last.last()
    else
        loop_first_last_score := loop_first_last_score + loop_first_last.first() * 10 + array.last(loop_first_last)
plot(loop_first_last_score)

independent_first_values = array.from(6, 7, 8)
independent_first_score = bar_index * 0
independent_first_i = 0
while independent_first_i < 1
    independent_first_namespace = array.first(independent_first_values)
    independent_first_method = independent_first_values.first()
    independent_first_score := independent_first_namespace * 100 + independent_first_method * 10 + independent_first_values.size()
    independent_first_i := independent_first_i + 1
plot(independent_first_score)
