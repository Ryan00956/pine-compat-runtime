//@version=6
indicator("Matrix eigenvalues")

diagonal = matrix.new<float>(2, 2, 0)
matrix.set(diagonal, 0, 0, 2)
matrix.set(diagonal, 1, 1, 3)
namespace_values = matrix.eigenvalues(diagonal)
method_values = diagonal.eigenvalues()

upper = matrix.new<float>(2, 2, 0)
matrix.set(upper, 0, 0, 3)
matrix.set(upper, 0, 1, 1)
matrix.set(upper, 1, 1, 2)
upper_values = matrix.eigenvalues(upper)

negative_symmetric = matrix.new<float>(2, 2, 0)
matrix.set(negative_symmetric, 0, 1, 1)
matrix.set(negative_symmetric, 1, 0, 1)
negative_values = matrix.eigenvalues(negative_symmetric)

complex_values = matrix.new<float>(2, 2, 0)
matrix.set(complex_values, 0, 1, -1)
matrix.set(complex_values, 1, 0, 1)

all_na = matrix.new<float>(1, 1)
empty_values = matrix.eigenvalues(matrix.new<float>(0, 0))

plot(array.get(namespace_values, 0), "namespace_0")
plot(array.get(namespace_values, 1), "namespace_1")
plot(array.get(method_values, 0), "method_0")
plot(array.get(upper_values, 0), "upper_0")
plot(array.get(upper_values, 1), "upper_1")
plot(array.get(negative_values, 0), "negative_0")
plot(array.get(negative_values, 1), "negative_1")
plot(na(matrix.eigenvalues(complex_values)) ? 1 : 0, "complex_is_na")
plot(na(matrix.eigenvalues(all_na)) ? 1 : 0, "all_na_is_na")
plot(array.size(empty_values), "empty_size")
