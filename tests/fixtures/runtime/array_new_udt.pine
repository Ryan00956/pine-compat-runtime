//@version=5
indicator("Array new UDT")
type Point
    float x
    string tag

empty = array.new<Point>()
seeded = array.new<Point>(2, Point.new(close, "seed"))
array.push(empty, Point.new(open, "open"))
seeded.set(1, Point.new(high, "high"))
first_empty = empty.get(0)
first_seeded = array.get(seeded, 0)
second_seeded = seeded.get(1)
helpers = array.new<Point>()
helpers.push(Point.new(close, "close"))
helpers.push(Point.new(open, "open"))
helpers.insert(1, Point.new(high, "high"))
helper_first = helpers.first()
helper_last = array.last(helpers)
helper_removed = helpers.remove(1)
helper_after_remove = helpers.get(1)
helper_shifted = array.shift(helpers)
helper_popped = helpers.pop()
empty_helpers = array.new<Point>()
empty_first = array.first(empty_helpers)
empty_last = empty_helpers.last()
empty_popped = empty_helpers.pop()
empty_shifted = array.shift(empty_helpers)
plot(empty.size())
plot(seeded.size())
plot(first_empty.x)
plot(first_seeded.x)
plot(second_seeded.x)
plot(helpers.size())
plot(helper_first.x)
plot(helper_last.x)
plot(helper_removed.x)
plot(helper_after_remove.x)
plot(helper_shifted.x)
plot(helper_popped.x)
plot(na(empty_first) and na(empty_last) and na(empty_popped) and na(empty_shifted) ? 1 : 0)
