//@version=5
import user/udt/1 as lib
indicator("Imported UDT field mutation control flow")

branched = lib.Point.new(close)
if bar_index < 2
    branched.x := branched.x + 10
else
    branched.x := branched.x + 20
plot(branched.x)

looped_for = lib.Point.new(close)
for i = 0 to 1
    looped_for.x := looped_for.x + i + 1
plot(looped_for.x)

looped_while = lib.Point.new(close)
steps = 0
while steps < 2
    looped_while.x := looped_while.x + 2
    steps := steps + 1
plot(looped_while.x)

wrapped_branch = lib.Wrapper.new(lib.Point.new(close))
if bar_index < 2
    wrapped_branch.nested := lib.Point.new(wrapped_branch.nested.x + 30)
else
    wrapped_branch.nested := lib.Point.new(wrapped_branch.nested.x + 40)
plot(wrapped_branch.nested.x)

wrapped_loop = lib.Wrapper.new(lib.Point.new(close))
for i = 0 to 1
    wrapped_loop.nested := lib.Point.new(wrapped_loop.nested.x + i + 2)
plot(wrapped_loop.nested.x)
