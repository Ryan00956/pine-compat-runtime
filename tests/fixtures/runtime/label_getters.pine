//@version=5
indicator("Label getters")
var label_id = label.new(bar_index, high, "start")
var deleted_label = label.new(bar_index, low, "delete")
if bar_index == 0
    label.set_text(label_id, "first")
if bar_index == 1
    label.set_xy(label_id, bar_index, close)
    label.set_text(label_id, "moved")
    label.delete(deleted_label)
x_value = label.get_x(label_id)
y_value = label.get_y(label_id)
text_length = str.length(label.get_text(label_id))
visible_labels = label.all
visible_label_count = array.size(visible_labels)
visible_label_text_length = visible_label_count > 0 ? str.length(label.get_text(array.get(visible_labels, 0))) : -1
missing_x = label.get_x(na)
missing_text_length = str.length(label.get_text(na))
plot(x_value)
plot(y_value)
plot(text_length)
plot(visible_label_count)
plot(visible_label_text_length)
plot(nz(missing_x, -1))
plot(nz(missing_text_length, -1))
