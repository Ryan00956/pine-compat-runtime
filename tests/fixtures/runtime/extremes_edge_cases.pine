//@version=5
indicator("Extremes edge cases")
hi = ta.highest(close, 3)
lo = ta.lowest(close, 3)
default_hi = ta.highest(2)
default_lo = ta.lowest(2)
with_na_hi = ta.highest(bar_index == 3 ? na : close, 3)
with_na_lo = ta.lowest(bar_index == 3 ? na : close, 3)
invalid_hi = ta.highest(close, 0)
invalid_lo = ta.lowest(close, 0)
dynamic_length = bar_index < 2 ? 1 : bar_index == 5 ? 1 : bar_index == 6 ? 3 : 2
dynamic_hi = ta.highest(close, dynamic_length)
dynamic_lo = ta.lowest(close, dynamic_length)
dynamic_default_hi = ta.highest(dynamic_length)
dynamic_default_lo = ta.lowest(length=dynamic_length)
plot(hi)
plot(lo)
plot(default_hi)
plot(default_lo)
plot(with_na_hi)
plot(with_na_lo)
plot(invalid_hi)
plot(invalid_lo)
plot(dynamic_hi)
plot(dynamic_lo)
plot(dynamic_default_hi)
plot(dynamic_default_lo)
