//@version=5
indicator("Currency constants")
major = currency.USD == "USD" and currency.EUR == "EUR" and currency.JPY == "JPY" and currency.GBP == "GBP"
cross = currency.AUD == "AUD" and currency.CAD == "CAD" and currency.CHF == "CHF"
crypto = currency.BTC == "BTC" and currency.ETH == "ETH" and currency.USDT == "USDT"
plot(major and cross and crypto and currency.NONE == "NONE" ? 1 : 0)
