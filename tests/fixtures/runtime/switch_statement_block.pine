//@version=5
indicator("Switch statement block fixture")
value = switch
    close > open =>
        sample = ta.sma(close, 2)
        sample + 1
    => close
plot(value)
loop_value = switch
    close > open =>
        for i = 0 to 0
            close + 2
    =>
        for i = 0 to 0
            open + 2
plot(loop_value)
