//@version=6
indicator("Bound matrix.pow call-result reads")

powRows(values, power) => values.pow(power).rows()

powBlockReads(values, power) =>
    int rows = values.pow(power).rows()
    int columns = values.pow(power).columns()
    float value = values.pow(power).get(1, 1)
    rows * 100 + columns * 10 + value

values = matrix.new<float>(2, 2, 0.0)
values.set(0, 0, 2.0)
values.set(1, 1, 3.0)

powered = values.pow(2).copy()
powered.set(0, 0, 99.0)

repowered = values.pow(2).pow(2)
repowered.set(0, 0, 88.0)

ints = matrix.new<int>(1, 1, 2)
invalid = matrix.new<float>(1, 1)
empty = matrix.new<float>(0, 0)

plot(values.pow(2).rows(), "pow_rows")
plot(values.pow(2).columns(), "pow_columns")
plot(values.pow(2).elements_count(), "pow_elements")
plot(values.pow(2).get(1, 1), "pow_get")
plot(values.pow(0).copy().get(0, 0), "identity_get")
plot(values.pow(1).get(0, 0), "copy_get")
plot(values.get(0, 0), "source_value")
plot(powered.get(0, 0), "powered_value")
plot(ints.pow(3).get(0, 0), "int_pow_get")
plot(powRows(values, 2), "expression_udf")
plot(powBlockReads(values, 2), "block_udf")
plot(values.pow(2).pow(2).rows(), "pow_chain_rows")
plot(values.pow(2).pow(2).columns(), "pow_chain_columns")
plot(values.pow(2).pow(2).get(1, 1), "pow_chain_get")
plot(values.pow(2).pow(0).get(0, 0), "pow_chain_identity_get")
plot(values.pow(2).pow(1).get(1, 1), "pow_chain_copy_get")
plot(ints.pow(3).pow(2).get(0, 0), "int_pow_chain_get")
plot(na(invalid.pow(2).pow(2).get(0, 0)) ? 1 : 0, "invalid_pow_chain_na")
plot(empty.pow(2).pow(2).rows() * 100 + empty.pow(2).pow(2).columns() * 10 + empty.pow(2).pow(2).elements_count(), "empty_pow_chain_shape")
plot(values.pow(2).inv().pow(2).get(0, 0), "pow_nested_get")
plot(repowered.get(0, 0), "repowered_value")
values.pow(2).set(0, 0, 106.0)
plot(values.get(0, 0) == 2.0 ? 1 : 0, "call_result_set_source_independent")
values.pow(2).fill(306.0)
plot(values.get(0, 0) == 2.0 ? 1 : 0, "call_result_fill_source_independent")
values.pow(2).reverse()
plot(values.get(0, 0) == 2.0 ? 1 : 0, "call_result_reverse_source_independent")
values.pow(2).reshape(1, 4)
plot(values.rows() == 2 and values.columns() == 2 ? 1 : 0, "call_result_reshape_source_independent")
values.pow(2).swap_rows(0, 1)
plot(values.get(0, 0) == 2.0 and values.get(1, 0) == 0.0 ? 1 : 0, "call_result_swap_rows_source_independent")
values.pow(2).swap_columns(0, 1)
plot(values.get(0, 0) == 2.0 and values.get(1, 0) == 0.0 ? 1 : 0, "call_result_swap_columns_source_independent")
values.pow(2).remove_row(0)
values.pow(2).remove_col(0)
plot(values.rows() == 2 and values.get(0, 0) == 2.0 ? 1 : 0, "call_result_remove_row_source_independent")
values.pow(2).add_row(0, array.from(7.0, 8.0))
plot(values.rows() == 2 and values.columns() == 2 and values.get(0, 0) == 2.0 ? 1 : 0, "call_result_add_row_source_independent")
