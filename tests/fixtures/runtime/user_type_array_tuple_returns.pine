//@version=6
indicator("UDT array tuple returns")

type First
    float shared
    float other

type Second
    float other
    float shared

type Anchor
    int tag

pair(values) => [values, values.copy()]

tupleAliasPair(values) =>
    tuple_value = [values, values.copy()]
    tuple_value

typedNaPair() =>
    array<First> values = na
    [values]

selfAliasPair(values) =>
    tuple_value = [values, values.copy()]
    tuple_value = tuple_value
    tuple_value

sameIdentityReassignPair(values, replacement) =>
    tuple_value = [values, values]
    tuple_value := [replacement, values]
    tuple_value

sameIdentityBranchReassignPair(values, replacement) =>
    tuple_value = [values, values]
    if bar_index % 2 == 0
        tuple_value := [replacement, values]
    tuple_value

naReassignPair(values) =>
    tuple_value = [values]
    tuple_value := [na]
    tuple_value

readViaTuple(values) =>
    tuple_value = [values]
    [selected] = tuple_value
    item = array.first(selected)
    item.shared

localShadowPair(array<First> first, array<Second> second) =>
    tuple_value = [first]
    tuple_value = [second]
    tuple_value

scalarAfterTuple(values) =>
    local = [values]
    local = 1
    local

tupleDeclAfterTuple(values) =>
    local = [values]
    [local] = [1]
    local

loopAfterTuple(values) =>
    item = [values]
    for item in array.from(1)
        item

nestedPair(values) => pair(values)

outerPair(values) =>
    [direct, copied] = nestedPair(values)
    [copied, direct]

flowPair(values) =>
    if bar_index >= 0
        [values, values.copy()]
    else
        [na, values]

finalIfAliasPair(values) =>
    if bar_index >= 0
        tuple_value = [values, values.copy()]
        tuple_value
    else
        tuple_value = [values.copy(), values]
        tuple_value

baseTernaryPair(values, bool choose) =>
    base = [values, values.copy()]
    choose ? base : base

baseSwitchPair(values) =>
    base = [values, values.copy()]
    switch bar_index % 2
        0 => base
        => base

assignedIfAliasPair(values, bool choose) =>
    base = [values, values.copy()]
    selected = if choose
        base
    else
        base
    selected

arrayViaTuple(values) =>
    [alias] = [values]
    alias

arrayViaTupleAlias(values) =>
    tuple_value = [values]
    [alias] = tuple_value
    alias

method pair(Anchor self, array<First> values, bool reverse) => reverse ? [values.copy(), values] : [values, values.copy()]

method pairSecond(Anchor self, array<Second> values) => nestedPair(values)

method readViaTuple(First self, array<First> values) =>
    tuple_value = [values]
    [selected] = tuple_value
    item = array.first(selected)
    item.shared

method readViaTuple(Second self, array<Second> values) =>
    tuple_value = [values]
    [selected] = tuple_value
    item = array.first(selected)
    item.shared

first_values = array.from(First.new(10.0, 100.0), First.new(11.0, 101.0))
second_values = array.from(Second.new(200.0, 20.0), Second.new(201.0, 21.0))
first_replacement = array.from(First.new(12.0, 102.0))
second_replacement = array.from(Second.new(202.0, 22.0))
anchor = Anchor.new(1)

[root_first, root_second] = [first_values, second_values]
[scalar_before, middle_first, scalar_after] = [1, first_values, 2.0]
[first_direct, first_copy] = pair(first_values)
[second_direct, second_copy] = pair(second_values)
[first_again, first_again_copy] = pair(first_values)
[tuple_alias_first, tuple_alias_first_copy] = tupleAliasPair(first_values)
[tuple_alias_second, tuple_alias_second_copy] = tupleAliasPair(second_values)
[tuple_alias_first_again, tuple_alias_first_again_copy] = tupleAliasPair(first_values)
[typed_na_first] = typedNaPair()
[self_alias_first, self_alias_first_copy] = selfAliasPair(first_values)
[self_alias_second, self_alias_second_copy] = selfAliasPair(second_values)
[self_alias_first_again, self_alias_first_again_copy] = selfAliasPair(first_values)
[reassigned_first, reassigned_first_copy] = sameIdentityReassignPair(first_values, first_replacement)
[reassigned_second, reassigned_second_copy] = sameIdentityReassignPair(second_values, second_replacement)
[reassigned_first_again, reassigned_first_again_copy] = sameIdentityReassignPair(first_values, first_replacement)
[branch_reassigned_first, branch_reassigned_first_copy] = sameIdentityBranchReassignPair(first_values, first_replacement)
[branch_reassigned_second, branch_reassigned_second_copy] = sameIdentityBranchReassignPair(second_values, second_replacement)
[branch_reassigned_first_again, branch_reassigned_first_again_copy] = sameIdentityBranchReassignPair(first_values, first_replacement)
[na_reassigned_first] = naReassignPair(first_values)
[shadow_second] = localShadowPair(first_values, second_values)
[outer_copy, outer_direct] = outerPair(first_values)
[flow_second, flow_second_copy] = flowPair(second_values)
[if_alias_first, if_alias_first_copy] = finalIfAliasPair(first_values)
[if_alias_second, if_alias_second_copy] = finalIfAliasPair(second_values)
[if_alias_first_again, if_alias_first_again_copy] = finalIfAliasPair(first_values)
[ternary_alias_first, ternary_alias_first_copy] = baseTernaryPair(first_values, true)
[ternary_alias_second, ternary_alias_second_copy] = baseTernaryPair(second_values, true)
[ternary_alias_first_again, ternary_alias_first_again_copy] = baseTernaryPair(first_values, true)
[switch_alias_first, switch_alias_first_copy] = baseSwitchPair(first_values)
[switch_alias_second, switch_alias_second_copy] = baseSwitchPair(second_values)
[switch_alias_first_again, switch_alias_first_again_copy] = baseSwitchPair(first_values)
[assigned_alias_first, assigned_alias_first_copy] = assignedIfAliasPair(first_values, true)
[assigned_alias_second, assigned_alias_second_copy] = assignedIfAliasPair(second_values, true)
[assigned_alias_first_again, assigned_alias_first_again_copy] = assignedIfAliasPair(first_values, true)
[method_first_copy, method_first] = anchor.pair(first_values, true)
[method_second, method_second_copy] = anchor.pairSecond(second_values)
first_reader = First.new(12.0, 102.0)
second_reader = Second.new(202.0, 22.0)
read_first = first_reader.readViaTuple(first_values)
read_second = second_reader.readViaTuple(second_values)
read_first_again = first_reader.readViaTuple(first_values)
function_read_first = readViaTuple(first_values)
function_read_second = readViaTuple(second_values)
function_read_first_again = readViaTuple(first_values)
scalar_shadow = scalarAfterTuple(first_values)
tuple_decl_shadow = tupleDeclAfterTuple(first_values)
loop_shadow = loopAfterTuple(first_values)
array_alias_first = arrayViaTuple(first_values)
array_alias_second = arrayViaTuple(second_values)
array_alias_first_again = arrayViaTuple(first_values)
array_via_alias_first = arrayViaTupleAlias(first_values)
array_via_alias_second = arrayViaTupleAlias(second_values)
array_via_alias_first_again = arrayViaTupleAlias(first_values)

top_level_first_tuple = [first_values]
[top_level_first] = top_level_first_tuple
top_level_second_tuple = [second_values]
[top_level_second] = top_level_second_tuple
top_level_first_again_tuple = [first_values]
[top_level_first_again] = top_level_first_again_tuple

global_self_tuple = [first_values]
global_self_tuple = global_self_tuple
[global_self] = global_self_tuple

array<First> typed_first = first_direct
Second[] typed_second = second_direct

float iterated = 0.0
for item in method_second
    iterated := iterated + item.shared

root_first_item = array.first(root_first)
root_second_item = array.first(root_second)
middle_first_item = array.first(middle_first)
typed_first_item = array.first(typed_first)
typed_second_item = array.first(typed_second)
first_again_item = array.first(first_again)
outer_copy_item = array.first(outer_copy)
flow_second_item = array.first(flow_second)
method_first_item = array.first(method_first)
array_alias_first_item = array.first(array_alias_first)
array_alias_second_item = array.first(array_alias_second)
array_alias_first_again_item = array.first(array_alias_first_again)
tuple_alias_first_item = array.first(tuple_alias_first)
tuple_alias_second_item = array.first(tuple_alias_second)
tuple_alias_first_again_item = array.first(tuple_alias_first_again)
if_alias_first_item = array.first(if_alias_first)
if_alias_second_item = array.first(if_alias_second)
if_alias_first_again_item = array.first(if_alias_first_again)
ternary_alias_first_item = array.first(ternary_alias_first)
ternary_alias_second_item = array.first(ternary_alias_second)
ternary_alias_first_again_item = array.first(ternary_alias_first_again)
switch_alias_first_item = array.first(switch_alias_first)
switch_alias_second_item = array.first(switch_alias_second)
switch_alias_first_again_item = array.first(switch_alias_first_again)
assigned_alias_first_item = array.first(assigned_alias_first)
assigned_alias_second_item = array.first(assigned_alias_second)
assigned_alias_first_again_item = array.first(assigned_alias_first_again)
array_via_alias_first_item = array.first(array_via_alias_first)
array_via_alias_second_item = array.first(array_via_alias_second)
array_via_alias_first_again_item = array.first(array_via_alias_first_again)
self_alias_first_item = array.first(self_alias_first)
self_alias_second_item = array.first(self_alias_second)
self_alias_first_again_item = array.first(self_alias_first_again)
reassigned_first_item = array.first(reassigned_first)
reassigned_second_item = array.first(reassigned_second)
reassigned_first_again_item = array.first(reassigned_first_again)
branch_reassigned_first_item = array.first(branch_reassigned_first)
branch_reassigned_second_item = array.first(branch_reassigned_second)
branch_reassigned_first_again_item = array.first(branch_reassigned_first_again)
shadow_second_item = array.first(shadow_second)
top_level_first_item = array.first(top_level_first)
top_level_second_item = array.first(top_level_second)
top_level_first_again_item = array.first(top_level_first_again)
global_self_item = array.first(global_self)

plot(root_first_item.shared)
plot(root_second_item.shared)
plot(middle_first_item.shared)
plot(typed_first_item.shared)
plot(typed_second_item.shared)
plot(first_again_item.shared)
plot(outer_copy_item.shared)
plot(flow_second_item.shared)
plot(method_first_item.shared)
plot(iterated)
plot(array_alias_first_item.shared)
plot(array_alias_second_item.shared)
plot(array_alias_first_again_item.shared)
plot(tuple_alias_first_item.shared)
plot(tuple_alias_second_item.shared)
plot(tuple_alias_first_again_item.shared)
plot(if_alias_first_item.shared)
plot(if_alias_second_item.shared)
plot(if_alias_first_again_item.shared)
plot(ternary_alias_first_item.shared)
plot(ternary_alias_second_item.shared)
plot(ternary_alias_first_again_item.shared)
plot(switch_alias_first_item.shared)
plot(switch_alias_second_item.shared)
plot(switch_alias_first_again_item.shared)
plot(assigned_alias_first_item.shared)
plot(assigned_alias_second_item.shared)
plot(assigned_alias_first_again_item.shared)
plot(array_via_alias_first_item.shared)
plot(array_via_alias_second_item.shared)
plot(array_via_alias_first_again_item.shared)
plot(na(typed_na_first) ? 1 : 0)
plot(self_alias_first_item.shared)
plot(self_alias_second_item.shared)
plot(self_alias_first_again_item.shared)
plot(reassigned_first_item.shared)
plot(reassigned_second_item.shared)
plot(reassigned_first_again_item.shared)
plot(branch_reassigned_first_item.shared)
plot(branch_reassigned_second_item.shared)
plot(branch_reassigned_first_again_item.shared)
plot(na(na_reassigned_first) ? 1 : 0)
plot(shadow_second_item.shared)
plot(function_read_first)
plot(function_read_second)
plot(function_read_first_again)
plot(read_first)
plot(read_second)
plot(read_first_again)
plot(scalar_shadow)
plot(tuple_decl_shadow)
plot(loop_shadow)
plot(top_level_first_item.shared)
plot(top_level_second_item.shared)
plot(top_level_first_again_item.shared)
plot(global_self_item.shared)

array.push(first_copy, First.new(12.0, 102.0))
plot(array.size(first_values))
plot(array.size(first_copy))
