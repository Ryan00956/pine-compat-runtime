//@version=5
indicator("Colors")
base = input.color(color.orange, "Base")
shade = color.new(base, 50)
opaque = color.new(color.blue)
opaque_blue = color.new(color.blue, 0)
opaque_blue_na = color.new(color.blue, na)
custom = color.rgb(255, 153, 0, 50)
clamped = color.rgb(260.4, -1.4, 127.5, 125)
opaque_rgb = color.rgb(0, 128, 0, 0)
clamped_base = #112233
clamped_opaque = color.new(clamped_base, -10)
clamped_clear = color.new(clamped_base, 120)
gradient = color.from_gradient(close, 1, 3, color.red, color.green)
gradient_low = color.from_gradient(0, 1, 3, color.red, color.green)
gradient_equal = color.from_gradient(2, 2, 2, color.red, color.green)
hex = #ff990080
channels = color.r(custom) + color.g(custom) + color.b(custom) + color.t(custom)
clamped_channels = color.r(clamped) + color.g(clamped) + color.b(clamped) + color.t(clamped)
clamped_transparency = color.t(clamped_opaque) + color.t(clamped_clear)
hex_channels = color.r(hex) + color.g(hex) + color.b(hex) + color.t(hex)
gradient_channels = color.r(gradient) + color.g(gradient) + color.b(gradient) + color.t(gradient)
official_named_colors = color.r(color.aqua) == 0 and color.g(color.aqua) == 188 and color.b(color.aqua) == 212 and color.t(color.aqua) == 0 and color.r(color.black) == 54 and color.g(color.black) == 58 and color.b(color.black) == 69 and color.r(color.blue) == 33 and color.g(color.blue) == 150 and color.b(color.blue) == 243 and color.r(color.fuchsia) == 224 and color.g(color.fuchsia) == 64 and color.b(color.fuchsia) == 251 and color.r(color.gray) == 120 and color.g(color.gray) == 123 and color.b(color.gray) == 134 and color.r(color.green) == 76 and color.g(color.green) == 175 and color.b(color.green) == 80 and color.r(color.lime) == 0 and color.g(color.lime) == 230 and color.b(color.lime) == 118 and color.r(color.maroon) == 136 and color.g(color.maroon) == 14 and color.b(color.maroon) == 79 and color.r(color.navy) == 49 and color.g(color.navy) == 27 and color.b(color.navy) == 146 and color.r(color.olive) == 128 and color.g(color.olive) == 128 and color.b(color.olive) == 0 and color.r(color.orange) == 255 and color.g(color.orange) == 152 and color.b(color.orange) == 0 and color.r(color.purple) == 156 and color.g(color.purple) == 39 and color.b(color.purple) == 176 and color.r(color.red) == 242 and color.g(color.red) == 54 and color.b(color.red) == 69 and color.r(color.silver) == 178 and color.g(color.silver) == 181 and color.b(color.silver) == 190 and color.r(color.teal) == 8 and color.g(color.teal) == 153 and color.b(color.teal) == 129 and color.r(color.white) == 255 and color.g(color.white) == 255 and color.b(color.white) == 255 and color.r(color.yellow) == 253 and color.g(color.yellow) == 216 and color.b(color.yellow) == 53
bgcolor(custom)
plot(close, color=shade)
plot(opaque == color.new(color.blue, 0) ? 1 : 0)
plot(opaque_blue == color.blue ? 1 : 0)
plot(opaque_blue_na == color.blue ? 1 : 0)
plot(official_named_colors ? 1 : 0)
plot(channels)
plot(clamped_channels)
plot(color.r(opaque_rgb) == 0 and color.g(opaque_rgb) == 128 and color.b(opaque_rgb) == 0 and color.t(opaque_rgb) == 0 ? 1 : 0)
plot(clamped_transparency)
plot(hex_channels)
plot(gradient_channels)
plot(color.r(gradient_low) == color.r(color.red) and color.g(gradient_low) == color.g(color.red) and color.b(gradient_low) == color.b(color.red) and color.t(gradient_low) == color.t(color.red) ? 1 : 0)
plot(color.r(gradient_equal) == color.r(color.green) and color.g(gradient_equal) == color.g(color.green) and color.b(gradient_equal) == color.b(color.green) and color.t(gradient_equal) == color.t(color.green) ? 1 : 0)
