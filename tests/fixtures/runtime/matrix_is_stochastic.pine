//@version=6
indicator("Matrix is_stochastic")

row_stochastic = matrix.new<float>(2, 3, 0)
matrix.set(row_stochastic, 0, 0, 0.25)
matrix.set(row_stochastic, 0, 1, 0.75)
matrix.set(row_stochastic, 1, 2, 1)
column_stochastic = matrix.new<float>(3, 2, 0)
matrix.set(column_stochastic, 0, 0, 0.5)
matrix.set(column_stochastic, 1, 0, 0.5)
matrix.set(column_stochastic, 1, 1, 0.25)
matrix.set(column_stochastic, 2, 1, 0.75)
negative = matrix.new<float>(1, 2, 0)
matrix.set(negative, 0, 0, 1.25)
matrix.set(negative, 0, 1, -0.25)
bad_sum = matrix.new<float>(2, 2, 0.25)
with_na = matrix.new<float>(1, 1, na)
zero_square = matrix.new<float>(0, 0)

plot(matrix.is_stochastic(row_stochastic) ? 1 : 0, "row_stochastic")
plot(column_stochastic.is_stochastic() ? 1 : 0, "column_stochastic")
plot(matrix.is_stochastic(negative) ? 1 : 0, "negative")
plot(bad_sum.is_stochastic() ? 1 : 0, "bad_sum")
plot(matrix.is_stochastic(with_na) ? 1 : 0, "with_na")
plot(zero_square.is_stochastic() ? 1 : 0, "zero_square")
