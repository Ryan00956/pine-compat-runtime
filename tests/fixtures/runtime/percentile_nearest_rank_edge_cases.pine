//@version=5
indicator("Percentile nearest rank edge cases")
middle = ta.percentile_nearest_rank(close, 3, 50)
quarter = ta.percentile_nearest_rank(close, 3, 25)
lowest = ta.percentile_nearest_rank(close, 3, 0)
highest = ta.percentile_nearest_rank(close, 3, 100)
simple = ta.percentile_nearest_rank(3, 3, 50)
with_na = ta.percentile_nearest_rank(bar_index == 3 ? na : close, 3, 50)
invalid_length = ta.percentile_nearest_rank(close, 0, 50)
invalid_low = ta.percentile_nearest_rank(close, 3, -1)
invalid_high = ta.percentile_nearest_rank(close, 3, 150)
plot(middle)
plot(quarter)
plot(lowest)
plot(highest)
plot(simple)
plot(with_na)
plot(invalid_length)
plot(invalid_low)
plot(invalid_high)
