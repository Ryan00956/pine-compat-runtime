//@version=5
indicator("Table array history")
current = table.new(position.top_right, 1, 1)
ids = array.new_table(1)
ids.set(0, current)
previous_ids = ids[1]
previous_id = na(previous_ids) ? na : previous_ids.get(0)
dynamic_offset = bar_index == 0 ? na : 1
dynamic_previous_ids = ids[dynamic_offset]
visible = table.all
plot(na(previous_ids) ? 1 : 0)
plot(na(dynamic_previous_ids) ? 1 : 0)
plot(na(previous_id) ? na : array.indexof(visible, previous_id))
