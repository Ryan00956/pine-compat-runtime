//@version=5
indicator("Linear Regression edge cases")
missing_source = bar_index == 1 ? na : close
flat_source = close - close + 3
plot(ta.linreg(close, 0, 0))
plot(ta.linreg(close, -1, 0))
plot(ta.linreg(missing_source, 2, 0))
plot(ta.linreg(close, 1, 0))
plot(ta.linreg(flat_source, 3, 0))
plot(ta.linreg(close, 3, 1))
plot(ta.linreg(close, 3, -1))
plot(ta.linreg(close, 3, na))
