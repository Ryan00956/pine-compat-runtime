//@version=5
indicator("User type functions")
type Point
    float x
    float y
type Wrapper
    Point point

identity(p) => p
wrap(p) =>
    copy = p
    copy
outer(p) => identity(p)
choose(delta, p) => p
cloneFrom(p) => Point.new(p.x, p.y)
cloneFromNamed(p) => Point.new(y=p.y, x=p.x)
cloneFromAlias(p) =>
    ax = p.x
    ay = p.y
    Point.new(ax, ay)
cloneFromNamedAlias(p) =>
    ax = p.x
    ay = p.y
    Point.new(y=ay, x=ax)
cloneFromObjectAlias(p) =>
    copy = p
    Point.new(copy.x, copy.y)
cloneFromNamedObjectAlias(p) =>
    copy = p
    Point.new(y=copy.y, x=copy.x)
make(x, y) => Point.new(x, y)
readPoint(p) => p.x
makeAlias(x, y) =>
    ax = x
    ay = y
    Point.new(ax, ay)
makeNamed(x, y) => Point.new(y=y, x=x)
makeNamedAlias(x, y) =>
    ax = x
    ay = y
    Point.new(y=ay, x=ax)
makeTyped(x, y) =>
    Point typed = na
    typed := Point.new(x, y)
    typed
makeTypedFrom(p) =>
    copy = p
    ax = copy.x
    ay = copy.y
    Point typed = na
    typed := Point.new(y=ay, x=ax + 25)
    typed
makeTypedConstructed(x, y) =>
    Point typed = Point.new(x + 30, y)
    typed := Point.new(typed.x + 5, typed.y)
    typed
makeTypedConstructedFrom(p) =>
    copy = p
    ax = copy.x
    ay = copy.y
    Point typed = Point.new(y=ay, x=ax + 35)
    typed := Point.new(y=typed.y, x=typed.x + 5)
    typed
makeTypedTernary(x, y, flip) =>
    Point typed = flip ? Point.new(x + 40, y) : Point.new(x + 45, y)
    typed := flip ? Point.new(typed.x + 5, typed.y) : Point.new(typed.x + 10, typed.y)
    typed
makeTypedTernaryFrom(p, flip) =>
    copy = p
    ax = copy.x
    ay = copy.y
    Point typed = flip ? Point.new(y=ay, x=ax + 70) : Point.new(y=copy.y, x=copy.x + 75)
    typed := flip ? Point.new(y=typed.y, x=typed.x + 5) : Point.new(y=typed.y, x=typed.x + 10)
    typed
makeTypedSwitch(x, y, mode) =>
    Point typed = switch mode
        0 => Point.new(x + 55, y)
        1 => Point.new(x + 60, y)
        => Point.new(x + 65, y)
    typed := switch mode
        3 => Point.new(typed.x + 5, typed.y)
        => Point.new(typed.x + 10, typed.y)
    typed
makeTypedSwitchFrom(p, mode) =>
    copy = p
    ax = copy.x
    ay = copy.y
    Point typed = switch mode
        0 => Point.new(y=ay, x=ax + 90)
        1 => Point.new(y=copy.y, x=copy.x + 95)
        => Point.new(y=p.y, x=p.x + 100)
    typed := switch mode
        3 => Point.new(y=typed.y, x=typed.x + 5)
        => Point.new(y=typed.y, x=typed.x + 10)
    typed
makeTypedIfFrom(p, flip) =>
    copy = p
    ax = copy.x
    ay = copy.y
    Point typed = if flip
        branch = Point.new(y=ay, x=ax + 120)
        branch
    else
        branch = Point.new(y=copy.y, x=copy.x + 125)
        branch
    typed := if flip
        Point.new(y=typed.y, x=typed.x + 5)
    else
        Point.new(y=typed.y, x=typed.x + 10)
    typed
makeTypedForFrom(p, count) =>
    copy = p
    ax = copy.x
    ay = copy.y
    Point typed = for i = 0 to count
        Point.new(y=ay, x=ax + i + 110)
    typed := for i = 0 to count
        Point.new(y=typed.y, x=typed.x + i + 5)
    typed
makeTypedForInFrom(p, values) =>
    copy = p
    ax = copy.x
    ay = copy.y
    Point typed = for value in values
        Point.new(y=ay, x=ax + value + 140)
    typed := for value in values
        Point.new(y=typed.y, x=typed.x + value + 5)
    typed
makeTypedWhileFrom(p, count) =>
    copy = p
    ax = copy.x
    ay = copy.y
    i = 0
    Point typed = while i < count
        i := i + 1
        Point.new(y=ay, x=ax + i + 150)
    j = 0
    typed := while j < count
        j := j + 1
        Point.new(y=typed.y, x=typed.x + j + 5)
    typed
makeWrapper(p) => Wrapper.new(p)
passWrapper(w) =>
    copy = w
    copy
outerWrapper(w) => passWrapper(w)
makeWrapperSwitch(p, mode) =>
    switch mode
        0 => Wrapper.new(Point.new(p.x + 170, p.y))
        1 => Wrapper.new(Point.new(p.x + 175, p.y))
        => Wrapper.new(Point.new(p.x + 180, p.y))
makeLocalMutated(x, y) =>
    local = Point.new(x + 130, y)
    local.x := local.x + 5
    local
cloneViaMake(p) => make(p.x, p.y)
cloneViaMakeNamed(p) => makeNamed(p.x, p.y)
makeWrapperViaMake(p) => makeWrapper(make(p.x, p.y))
cloneTernary(p, flip) => flip ? Point.new(p.x, p.y) : Point.new(p.x + 10, p.y)
cloneSwitch(p, mode) =>
    switch mode
        0 => Point.new(p.x, p.y)
        1 => Point.new(p.x + 5, p.y)
        => Point.new(p.x + 10, p.y)
cloneIf(p, flip) =>
    if flip
        Point.new(p.x, p.y)
    else
        Point.new(p.x + 10, p.y)
aliasIf(p, flip) =>
    if flip
        q = p
        q
    else
        q = p
        q
aliasTernary(p, flip) =>
    q = p
    flip ? q : p
aliasWhile(p, keepGoing) =>
    active = keepGoing
    while active
        q = p
        active := false
        q
aliasSwitch(p, mode) =>
    switch mode
        0 =>
            q = p
            q
        =>
            q = p
            q
cloneFor(p, count) =>
    for i = 0 to count
        Point.new(p.x + i, p.y)
cloneForAlias(p, count) =>
    for i = 0 to count
        q = p
        q
cloneForInAlias(p, values) =>
    for value in values
        q = p
        q
outerForIn(p, values) => cloneForInAlias(p, values)
outerTernary(p) => aliasTernary(p, bar_index % 2 == 0)
outerWhile(p) => aliasWhile(p, close > 0)
outerSwitch(p) => aliasSwitch(p, bar_index % 2)

p = Point.new(close, open)
steps = array.from(1, 2)
same = identity(p)
wrapped = wrap(p)
wrappedSource = Wrapper.new(p)
wrappedPassed = passWrapper(wrappedSource)
nested = outer(p)
nestedWrapped = outerWrapper(wrappedSource)
chosen = choose(p=p, delta=bar_index)
cloned = cloneFrom(p)
clonedNamed = cloneFromNamed(p)
clonedAlias = cloneFromAlias(p)
clonedNamedAlias = cloneFromNamedAlias(p)
clonedObjectAlias = cloneFromObjectAlias(p)
clonedNamedObjectAlias = cloneFromNamedObjectAlias(p)
clonedViaMake = cloneViaMake(p)
clonedViaMakeNamed = cloneViaMakeNamed(p)
clonedTernary = cloneTernary(p, bar_index < 2)
clonedSwitch = cloneSwitch(p, bar_index)
clonedIf = cloneIf(p, bar_index < 2)
aliasedIf = aliasIf(p, bar_index < 2)
aliasedTernary = aliasTernary(p, bar_index % 2 == 0)
aliasedWhile = aliasWhile(p, close > 0)
aliasedSwitch = aliasSwitch(p, bar_index % 2)
clonedFor = cloneFor(p, 2)
clonedForAlias = cloneForAlias(p, 2)
clonedForInAlias = cloneForInAlias(p, steps)
nestedForIn = outerForIn(p, steps)
nestedTernary = outerTernary(p)
nestedWhile = outerWhile(p)
nestedSwitch = outerSwitch(p)
made = make(close, open)
udfResultScalarPrior = readPoint(make(close, open))[1]
madeAlias = makeAlias(close, open)
madeNamed = makeNamed(close, open)
madeNamedAlias = makeNamedAlias(close, open)
madeTyped = makeTyped(close, open)
madeTypedFrom = makeTypedFrom(p)
madeTypedConstructed = makeTypedConstructed(close, open)
madeTypedConstructedFrom = makeTypedConstructedFrom(p)
madeTypedTernary = makeTypedTernary(close, open, bar_index < 2)
madeTypedTernaryFrom = makeTypedTernaryFrom(p, bar_index < 2)
madeTypedSwitch = makeTypedSwitch(close, open, bar_index)
madeTypedSwitchFrom = makeTypedSwitchFrom(p, bar_index)
madeTypedIfFrom = makeTypedIfFrom(p, bar_index < 2)
madeTypedForFrom = makeTypedForFrom(p, 2)
madeTypedForInFrom = makeTypedForInFrom(p, steps)
madeTypedWhileFrom = makeTypedWhileFrom(p, 2)
wrappedMade = makeWrapper(p)
wrappedViaMake = makeWrapperViaMake(p)
wrappedSwitch = makeWrapperSwitch(p, bar_index)
madeLocalMutated = makeLocalMutated(close, open)
samePrior = same[1]
aliasedSwitchPrior = aliasedSwitch[1]
clonedSwitchPrior = clonedSwitch[1]
clonedForInAliasPrior = clonedForInAlias[1]
madeTypedSwitchFromPrior = madeTypedSwitchFrom[1]
madeTypedForInFromPrior = madeTypedForInFrom[1]
madeTypedWhileFromPrior = madeTypedWhileFrom[1]
wrappedMadePrior = wrappedMade[1]
wrappedSwitchPrior = wrappedSwitch[1]
dyn = bar_index == 0 ? na : 1
sameDynamic = same[dyn]
sameDynamicSibling = same[dyn]
float sameDynamicX = na
float sameDynamicSiblingXAfterMutation = na
wrappedPassedDynamic = wrappedPassed[dyn]
wrappedPassedDynamicSibling = wrappedPassed[dyn]
float wrappedPassedDynamicX = na
float wrappedPassedDynamicSiblingXAfterMutation = na
nestedDynamic = nested[dyn]
nestedDynamicSibling = nested[dyn]
float nestedDynamicX = na
float nestedDynamicSiblingXAfterMutation = na
nestedWrappedDynamic = nestedWrapped[dyn]
nestedWrappedDynamicSibling = nestedWrapped[dyn]
float nestedWrappedDynamicX = na
float nestedWrappedDynamicSiblingXAfterMutation = na
clonedViaMakeDynamic = clonedViaMake[dyn]
clonedViaMakeDynamicSibling = clonedViaMake[dyn]
float clonedViaMakeDynamicX = na
float clonedViaMakeDynamicSiblingXAfterMutation = na
wrappedViaMakeDynamic = wrappedViaMake[dyn]
wrappedViaMakeDynamicSibling = wrappedViaMake[dyn]
float wrappedViaMakeDynamicX = na
float wrappedViaMakeDynamicSiblingXAfterMutation = na
madeDynamic = made[dyn]
madeDynamicSibling = made[dyn]
float madeDynamicX = na
float madeDynamicSiblingXAfterMutation = na
wrappedMadeDynamic = wrappedMade[dyn]
wrappedMadeDynamicSibling = wrappedMade[dyn]
float wrappedMadeDynamicX = na
float wrappedMadeDynamicSiblingXAfterMutation = na
if bar_index > 0
    sameDynamicX := sameDynamic.x
    sameDynamic.x := close + 900
    sameDynamicSiblingXAfterMutation := sameDynamicSibling.x
    wrappedPassedDynamicX := wrappedPassedDynamic.point.x
    wrappedPassedDynamic.point := Point.new(close + 1000, open)
    wrappedPassedDynamicSiblingXAfterMutation := wrappedPassedDynamicSibling.point.x
    nestedDynamicX := nestedDynamic.x
    nestedDynamic.x := close + 1100
    nestedDynamicSiblingXAfterMutation := nestedDynamicSibling.x
    nestedWrappedDynamicX := nestedWrappedDynamic.point.x
    nestedWrappedDynamic.point := Point.new(close + 1200, open)
    nestedWrappedDynamicSiblingXAfterMutation := nestedWrappedDynamicSibling.point.x
    clonedViaMakeDynamicX := clonedViaMakeDynamic.x
    clonedViaMakeDynamic.x := close + 1300
    clonedViaMakeDynamicSiblingXAfterMutation := clonedViaMakeDynamicSibling.x
    wrappedViaMakeDynamicX := wrappedViaMakeDynamic.point.x
    wrappedViaMakeDynamic.point := Point.new(close + 1400, open)
    wrappedViaMakeDynamicSiblingXAfterMutation := wrappedViaMakeDynamicSibling.point.x
    madeDynamicX := madeDynamic.x
    madeDynamic.x := close + 700
    madeDynamicSiblingXAfterMutation := madeDynamicSibling.x
    wrappedMadeDynamicX := wrappedMadeDynamic.point.x
    wrappedMadeDynamic.point := Point.new(close + 800, open)
    wrappedMadeDynamicSiblingXAfterMutation := wrappedMadeDynamicSibling.point.x
plot(same.x - same.y)
plot(same.x + same.y)
plot(wrapped.x + wrapped.y + bar_index)
plot(nested.x + nested.y + wrapped.x)
plot(chosen.x + chosen.y + bar_index)
plot(cloned.x + cloned.y + bar_index)
plot(clonedNamed.x + clonedNamed.y + bar_index)
plot(clonedAlias.x + clonedAlias.y + bar_index)
plot(clonedNamedAlias.x + clonedNamedAlias.y + bar_index)
plot(clonedObjectAlias.x + clonedObjectAlias.y + bar_index)
plot(clonedNamedObjectAlias.x + clonedNamedObjectAlias.y + bar_index)
plot(clonedViaMake.x + clonedViaMake.y + bar_index)
plot(clonedViaMakeNamed.x + clonedViaMakeNamed.y + bar_index)
plot(clonedTernary.x + clonedTernary.y + bar_index)
plot(clonedSwitch.x + clonedSwitch.y + bar_index)
plot(clonedIf.x + clonedIf.y + bar_index)
plot(aliasedIf.x + aliasedIf.y + bar_index + 20)
plot(aliasedTernary.x + aliasedTernary.y + bar_index + 25)
plot(aliasedWhile.x + aliasedWhile.y + bar_index + 30)
plot(aliasedSwitch.x + aliasedSwitch.y + bar_index + 40)
plot(clonedFor.x + clonedFor.y + bar_index)
plot(clonedForAlias.x + clonedForAlias.y + bar_index)
plot(clonedForInAlias.x + clonedForInAlias.y + bar_index + 70)
plot(nestedForIn.x + nestedForIn.y + bar_index + 80)
plot(nestedTernary.x + nestedTernary.y + bar_index + 85)
plot(nestedWhile.x + nestedWhile.y + bar_index + 50)
plot(nestedSwitch.x + nestedSwitch.y + bar_index + 60)
plot(made.x + made.y + bar_index)
plot(udfResultScalarPrior)
plot(madeAlias.x + madeAlias.y + bar_index)
plot(madeNamed.x + madeNamed.y + bar_index)
plot(madeNamedAlias.x + madeNamedAlias.y + bar_index)
plot(madeTyped.x + madeTyped.y + bar_index)
plot(madeTypedFrom.x + madeTypedFrom.y + bar_index)
plot(madeTypedConstructed.x + madeTypedConstructed.y + bar_index)
plot(madeTypedConstructedFrom.x + madeTypedConstructedFrom.y + bar_index)
plot(madeTypedTernary.x + madeTypedTernary.y + bar_index)
plot(madeTypedTernaryFrom.x + madeTypedTernaryFrom.y + bar_index)
plot(madeTypedSwitch.x + madeTypedSwitch.y + bar_index)
plot(madeTypedSwitchFrom.x + madeTypedSwitchFrom.y + bar_index)
plot(madeTypedIfFrom.x + madeTypedIfFrom.y + bar_index)
plot(madeTypedForFrom.x + madeTypedForFrom.y + bar_index)
plot(madeTypedForInFrom.x + madeTypedForInFrom.y + bar_index)
plot(madeTypedWhileFrom.x + madeTypedWhileFrom.y + bar_index)
plot(wrappedMade.point.x + wrappedMade.point.y + bar_index)
plot(wrappedViaMake.point.x + wrappedViaMake.point.y + bar_index)
plot(wrappedSwitch.point.x + wrappedSwitch.point.y + bar_index)
plot(madeLocalMutated.x + madeLocalMutated.y + bar_index)
plot(samePrior.x + samePrior.y)
plot(aliasedSwitchPrior.x + aliasedSwitchPrior.y + bar_index)
plot(clonedSwitchPrior.x + clonedSwitchPrior.y + bar_index)
plot(clonedForInAliasPrior.x + clonedForInAliasPrior.y + bar_index)
plot(madeTypedSwitchFromPrior.x + madeTypedSwitchFromPrior.y + bar_index)
plot(madeTypedForInFromPrior.x + madeTypedForInFromPrior.y + bar_index)
plot(madeTypedWhileFromPrior.x + madeTypedWhileFromPrior.y + bar_index)
plot(wrappedMadePrior.point.x + wrappedMadePrior.point.y + bar_index)
plot(wrappedSwitchPrior.point.x + wrappedSwitchPrior.point.y + bar_index)
plot(sameDynamicX)
plot(sameDynamicSiblingXAfterMutation)
plot(wrappedPassedDynamicX)
plot(wrappedPassedDynamicSiblingXAfterMutation)
plot(nestedDynamicX)
plot(nestedDynamicSiblingXAfterMutation)
plot(nestedWrappedDynamicX)
plot(nestedWrappedDynamicSiblingXAfterMutation)
plot(clonedViaMakeDynamicX)
plot(clonedViaMakeDynamicSiblingXAfterMutation)
plot(wrappedViaMakeDynamicX)
plot(wrappedViaMakeDynamicSiblingXAfterMutation)
plot(madeDynamicX)
plot(madeDynamicSiblingXAfterMutation)
plot(wrappedMadeDynamicX)
plot(wrappedMadeDynamicSiblingXAfterMutation)
