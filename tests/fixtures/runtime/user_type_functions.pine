//@version=5
indicator("User type functions")
type Point
    float x
    float y

identity(p) => p
wrap(p) =>
    copy = p
    copy
outer(p) => identity(p)
choose(delta, p) => p
cloneFrom(p) => Point.new(p.x, p.y)
cloneFromNamed(p) => Point.new(y=p.y, x=p.x)
cloneFromAlias(p) =>
    ax = p.x
    ay = p.y
    Point.new(ax, ay)
cloneFromNamedAlias(p) =>
    ax = p.x
    ay = p.y
    Point.new(y=ay, x=ax)
cloneFromObjectAlias(p) =>
    copy = p
    Point.new(copy.x, copy.y)
cloneFromNamedObjectAlias(p) =>
    copy = p
    Point.new(y=copy.y, x=copy.x)
make(x, y) => Point.new(x, y)
makeAlias(x, y) =>
    ax = x
    ay = y
    Point.new(ax, ay)
makeNamed(x, y) => Point.new(y=y, x=x)
makeNamedAlias(x, y) =>
    ax = x
    ay = y
    Point.new(y=ay, x=ax)
cloneViaMake(p) => make(p.x, p.y)
cloneViaMakeNamed(p) => makeNamed(p.x, p.y)
cloneTernary(p, flip) => flip ? Point.new(p.x, p.y) : Point.new(p.x + 10, p.y)
cloneSwitch(p, mode) =>
    switch mode
        0 => Point.new(p.x, p.y)
        1 => Point.new(p.x + 5, p.y)
        => Point.new(p.x + 10, p.y)

p = Point.new(close, open)
same = identity(p)
wrapped = wrap(p)
nested = outer(p)
chosen = choose(p=p, delta=bar_index)
cloned = cloneFrom(p)
clonedNamed = cloneFromNamed(p)
clonedAlias = cloneFromAlias(p)
clonedNamedAlias = cloneFromNamedAlias(p)
clonedObjectAlias = cloneFromObjectAlias(p)
clonedNamedObjectAlias = cloneFromNamedObjectAlias(p)
clonedViaMake = cloneViaMake(p)
clonedViaMakeNamed = cloneViaMakeNamed(p)
clonedTernary = cloneTernary(p, bar_index < 2)
clonedSwitch = cloneSwitch(p, bar_index)
made = make(close, open)
madeAlias = makeAlias(close, open)
madeNamed = makeNamed(close, open)
madeNamedAlias = makeNamedAlias(close, open)
plot(same.x - same.y)
plot(same.x + same.y)
plot(wrapped.x + wrapped.y + bar_index)
plot(nested.x + nested.y + wrapped.x)
plot(chosen.x + chosen.y + bar_index)
plot(cloned.x + cloned.y + bar_index)
plot(clonedNamed.x + clonedNamed.y + bar_index)
plot(clonedAlias.x + clonedAlias.y + bar_index)
plot(clonedNamedAlias.x + clonedNamedAlias.y + bar_index)
plot(clonedObjectAlias.x + clonedObjectAlias.y + bar_index)
plot(clonedNamedObjectAlias.x + clonedNamedObjectAlias.y + bar_index)
plot(clonedViaMake.x + clonedViaMake.y + bar_index)
plot(clonedViaMakeNamed.x + clonedViaMakeNamed.y + bar_index)
plot(clonedTernary.x + clonedTernary.y + bar_index)
plot(clonedSwitch.x + clonedSwitch.y + bar_index)
plot(made.x + made.y + bar_index)
plot(madeAlias.x + madeAlias.y + bar_index)
plot(madeNamed.x + madeNamed.y + bar_index)
plot(madeNamedAlias.x + madeNamedAlias.y + bar_index)
