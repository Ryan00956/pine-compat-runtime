//@version=5
indicator("Label array history")
current = label.new(bar_index, close, "id")
ids = array.new_label(1)
ids.set(0, current)
previous_ids = ids[1]
previous_id = na(previous_ids) ? na : previous_ids.get(0)
dynamic_offset = bar_index == 0 ? na : 1
dynamic_previous_ids = ids[dynamic_offset]
dynamic_sibling_ids = ids[dynamic_offset]
dynamic_previous_id = na(dynamic_previous_ids) ? na : dynamic_previous_ids.get(0)
if not na(dynamic_previous_ids)
    dynamic_previous_ids.set(0, current)
dynamic_sibling_id_after_dynamic_replacement = na(dynamic_sibling_ids) ? na : dynamic_sibling_ids.get(0)
plot(na(previous_ids) ? 1 : 0)
plot(na(dynamic_previous_ids) ? 1 : 0)
plot(na(previous_id) ? na : label.get_x(previous_id))
plot(na(dynamic_previous_id) ? na : label.get_x(dynamic_previous_id))
plot(na(dynamic_sibling_id_after_dynamic_replacement) ? na : label.get_x(dynamic_sibling_id_after_dynamic_replacement))
