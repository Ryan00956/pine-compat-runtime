//@version=6
indicator("Unsupported matrix fixed float collection return qualifier")

ints = matrix.new<int>(2, 2, 1)
floats = matrix.new<float>(2, 2, 1.0)
int_rows = matrix.new<int>(1, 2, 0)

matrix.add_row(int_rows, 0, matrix.eigenvalues(ints))
matrix.add_col(int_rows, 0, floats.eigenvalues())
matrix.add_row(int_rows, 0, matrix.eigenvalues(floats))
matrix.add_col(int_rows, 0, ints.eigenvalues())
matrix.fill(matrix.eigenvectors(ints), "bad")
matrix.fill(floats.eigenvectors(), "bad")
matrix.fill(matrix.eigenvectors(floats), "bad")
matrix.fill(ints.eigenvectors(), "bad")
matrix.fill(matrix.kron(ints, floats), "bad")
matrix.fill(ints.kron(floats), "bad")
matrix.fill(matrix.kron(floats, ints), "bad")
matrix.fill(floats.kron(ints), "bad")
matrix.fill(matrix.diff(ints, floats), "bad")
matrix.fill(floats.diff(ints), "bad")
matrix.fill(matrix.diff(floats, ints), "bad")
matrix.fill(ints.diff(floats), "bad")
matrix.fill(matrix.pow(ints, 2), "bad")
matrix.fill(floats.pow(2), "bad")
matrix.fill(matrix.pow(floats, 2), "bad")
matrix.fill(ints.pow(2), "bad")
matrix.fill(matrix.inv(ints), "bad")
matrix.fill(floats.inv(), "bad")
matrix.fill(matrix.inv(floats), "bad")
matrix.fill(ints.inv(), "bad")
matrix.fill(matrix.pinv(ints), "bad")
matrix.fill(floats.pinv(), "bad")
matrix.fill(matrix.pinv(floats), "bad")
matrix.fill(ints.pinv(), "bad")
