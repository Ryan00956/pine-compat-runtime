//@version=6
import user/udt/1 as lib
indicator("Unsupported imported user-method matrix call-result reads")

point = lib.Point.new(1.0)

bad_row = point.exposeMatrix().get("bad", 0)
set_result = point.exposeMatrix().set(0, 0, 2.0)
size_result = point.exposeMatrix().size()
terminal_chain = point.exposeMatrix().rows().copy()
none_rows = point.exposeNa().rows()
number_rows = point.shift(1.0).rows()
array_rows = point.exposeArray().rows()
map_rows = point.exposeMap().rows()

plot(close)
