//@version=6
indicator("Supported UDT array.from method return qualifier")

type Point
    float x
    float y

type Wrapper
    Point point

method first_x(Point anchor, array<Point> values) =>
    point = array.get(values, 0)
    anchor.x + point.x

method second_y(Point anchor, Point[] values) =>
    point = values.get(1)
    anchor.y + point.y

method first_nested_x(Wrapper anchor, array<Wrapper> values) =>
    wrapper = values.get(0)
    anchor.point.x + wrapper.point.x

anchor = Point.new(close, open)
nested = Wrapper.new(Point.new(high, low))
plot(anchor.first_x(array.from(Point.new(close + 1, open + 2))) + anchor.second_y(array.from(Point.new(close + 3, open + 4), Point.new(high + 5, low + 6))) + nested.first_nested_x(array.from(Wrapper.new(Point.new(close + 7, open + 8)))))
