//@version=6
indicator("Unsupported method final selector switch reassignment series selector qualifier")

type Box
    int seed

method choose_length(Box this, int mode, int x) =>
    local = x
    switch mode
        0 =>
            local := x
            local
        =>
            local

length = input.int(2, "Length")
box = Box.new(1)
chosen = box.choose_length(bar_index, length)

plot(ta.ema(close, chosen))
