//@version=6
indicator("Supported matrix fixed float collection return qualifier")

ints = matrix.new<int>(2, 2, 1)
floats = matrix.new<float>(2, 2, 1.0)
float_rows = matrix.new<float>(1, 2, 0.0)

matrix.add_row(float_rows, 0, matrix.eigenvalues(ints))
matrix.add_col(float_rows, 0, floats.eigenvalues())
matrix.add_row(float_rows, 0, matrix.eigenvalues(floats))
matrix.add_col(float_rows, 0, ints.eigenvalues())
matrix.fill(matrix.eigenvectors(ints), 1.0)
matrix.fill(floats.eigenvectors(), 1.0)
matrix.fill(matrix.eigenvectors(floats), 1.0)
matrix.fill(ints.eigenvectors(), 1.0)
matrix.fill(matrix.kron(ints, floats), 1.0)
matrix.fill(ints.kron(floats), 1.0)
matrix.fill(matrix.kron(floats, ints), 1.0)
matrix.fill(floats.kron(ints), 1.0)
matrix.fill(matrix.diff(ints, floats), 1.0)
matrix.fill(floats.diff(ints), 1.0)
matrix.fill(matrix.diff(floats, ints), 1.0)
matrix.fill(ints.diff(floats), 1.0)
matrix.fill(matrix.pow(ints, 2), 1.0)
matrix.fill(floats.pow(2), 1.0)
matrix.fill(matrix.pow(floats, 2), 1.0)
matrix.fill(ints.pow(2), 1.0)
matrix.fill(matrix.inv(ints), 1.0)
matrix.fill(floats.inv(), 1.0)
matrix.fill(matrix.inv(floats), 1.0)
matrix.fill(ints.inv(), 1.0)
matrix.fill(matrix.pinv(ints), 1.0)
matrix.fill(floats.pinv(), 1.0)
matrix.fill(matrix.pinv(floats), 1.0)
matrix.fill(ints.pinv(), 1.0)
