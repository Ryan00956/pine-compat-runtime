//@version=6
indicator("Supported matrix median")

int_values = matrix.new<int>(1, 3, 1)
float_values = matrix.new<float>(1, 3, close)

int int_namespace = matrix.median(int_values)
int int_method = int_values.median()
float float_namespace = matrix.median(float_values)
float float_method = float_values.median()

plot(int_namespace + int_method + float_namespace + float_method)
