//@version=6
indicator("Supported bound matrix.copy call-result reads")

copyRows(id) => id.copy().copy().rows()

floats = matrix.new<float>(2, 3, 1.5)
ints = matrix.new<int>(1, 1, 4)
bools = matrix.new<bool>(1, 1, true)
strings = matrix.new<string>(1, 1, "value")
colors = matrix.new<color>(1, 1, color.red)

int direct_rows = floats.copy().rows()
int direct_columns = floats.copy().columns()
int direct_elements = floats.copy().elements_count()
float direct_get = floats.copy().get(row=0, column=1)
matrix<float> nested_copy = floats.copy().copy()
int int_get = ints.copy().get(0, 0)
bool bool_get = bools.copy().get(0, 0)
string string_get = strings.copy().get(0, 0)
color color_get = colors.copy().get(0, 0)
array<float> direct_row = floats.copy().row(1).copy()
array<float> direct_col = floats.copy().col(1).copy()
array<float> direct_eigenvalues = floats.copy().eigenvalues().copy()

plot(direct_rows + direct_columns + direct_elements + direct_get + nested_copy.get(0, 0) + int_get + (bool_get ? 1 : 0) + (string_get == "value" ? 1 : 0) + (color_get == color.red ? 1 : 0) + direct_row.size() + direct_col.size() + direct_eigenvalues.size() + copyRows(floats))
