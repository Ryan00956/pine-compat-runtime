//@version=6
indicator("Unsupported method final while reassignment series condition qualifier")

type Box
    int seed

method checked_length(Box this, bool flag, int x) =>
    local = x
    while flag
        local := x
        ta.ema(close, local)

length = input.int(2, "Length")
box = Box.new(1)
plot(box.checked_length(close > open, length))
