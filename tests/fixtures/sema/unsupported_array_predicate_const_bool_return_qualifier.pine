//@version=6
indicator("Unsupported array predicate const bool return qualifier")

bools = array.from(true, false)
ints = array.from(1, 2, 3)
floats = array.from(1.0, 2.0, 3.0)

input.bool(defval=array.includes(ints, 2))
input.bool(defval=array.every(bools))
input.bool(defval=array.some(bools))
input.bool(defval=array.every(ints))
input.bool(defval=array.some(ints))
input.bool(defval=array.every(floats))
input.bool(defval=array.some(floats))
input.bool(defval=ints.includes(2))
input.bool(defval=bools.every())
input.bool(defval=bools.some())
input.bool(defval=ints.every())
input.bool(defval=ints.some())
input.bool(defval=floats.every())
input.bool(defval=floats.some())
