//@version=6
indicator("Supported matrix.get series element return qualifier")

int_matrix = matrix.new<int>(1, 1, 1)
float_matrix = matrix.new<float>(1, 1, 1.0)
bool_matrix = matrix.new<bool>(1, 1, true)
string_matrix = matrix.new<string>(1, 1, "value")
color_matrix = matrix.new<color>(1, 1, color.green)

plot(matrix.get(int_matrix, 0, 0))
plot(int_matrix.get(0, 0))
plot(matrix.get(float_matrix, 0, 0))
plot(float_matrix.get(0, 0))
plot(matrix.get(bool_matrix, 0, 0) ? 1 : 0)
plot(bool_matrix.get(0, 0) ? 1 : 0)
plot(str.length(matrix.get(string_matrix, 0, 0)))
plot(str.length(string_matrix.get(0, 0)))
plot(close, color=matrix.get(color_matrix, 0, 0))
plot(open, color=color_matrix.get(0, 0))
