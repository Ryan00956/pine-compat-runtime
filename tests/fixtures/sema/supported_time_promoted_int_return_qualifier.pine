//@version=6
indicator("Supported time promoted int return qualifier")

source_ts = input.time(1612235045000, "Source timestamp")
timezone_value = input.string("UTC", "Timezone")
source_year = input.int(2021, "Source year")
source_month = input.int(2, "Source month")
source_day = input.int(2, "Source day")
source_hour = input.int(3, "Source hour")
source_minute = input.int(4, "Source minute")
source_second = input.int(5, "Source second")

year_value = year(source_ts, timezone_value)
month_value = month(source_ts, timezone_value)
week_value = weekofyear(source_ts, timezone_value)
day_value = dayofmonth(source_ts, timezone_value)
weekday_value = dayofweek(source_ts, timezone_value)
hour_value = hour(source_ts, timezone_value)
minute_value = minute(source_ts, timezone_value)
second_value = second(source_ts, timezone_value)
timestamp_value = timestamp(timezone=timezone_value, year=source_year, month=source_month, day=source_day, hour=source_hour, minute=source_minute, second=source_second)

plot(close, show_last=year_value)
plot(open, show_last=month_value)
plot(high, show_last=week_value)
plot(low, show_last=day_value)
plot(close, show_last=weekday_value)
plot(open, show_last=hour_value)
plot(high, show_last=minute_value)
plot(low, show_last=second_value)
plot(close, show_last=timestamp_value)
