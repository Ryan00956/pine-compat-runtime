//@version=5
strategy("Strategy state request")
plot(request.security(syminfo.tickerid, timeframe.period, strategy.account_currency) == "USD" ? 1 : 0)
plot(request.security(syminfo.tickerid, timeframe.period, strategy.default_entry_qty(close)))
plot(request.security(syminfo.tickerid, timeframe.period, strategy.convert_to_account(close)))
plot(request.security(syminfo.tickerid, timeframe.period, strategy.convert_to_symbol(close)))
plot(request.security(syminfo.tickerid, timeframe.period, strategy.position_size))
plot(request.security(syminfo.tickerid, timeframe.period, strategy.position_avg_price))
plot(na(request.security(syminfo.tickerid, timeframe.period, strategy.position_entry_name)) ? na : 1)
plot(request.security(syminfo.tickerid, timeframe.period, strategy.initial_capital))
plot(request.security(syminfo.tickerid, timeframe.period, strategy.openprofit))
plot(request.security(syminfo.tickerid, timeframe.period, strategy.openprofit_percent))
