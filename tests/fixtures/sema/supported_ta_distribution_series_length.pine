//@version=5
indicator("Supported TA distribution series length")
length = bar_index % 2 + 2
plot(ta.median(close, length))
plot(ta.mode(close, length))
plot(ta.percentrank(close, length))
plot(ta.median(source=3, length=length))
plot(ta.mode(length=length, source=3))
plot(ta.percentrank(length=length, source=3))
