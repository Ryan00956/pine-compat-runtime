//@version=5
indicator("Provider request context")
arithmetic = request.security("NYSE:IBM", timeframe.period, open + close)
history = request.security("NYSE:IBM", timeframe.period, close[1])
sma = request.security("NYSE:IBM", timeframe.period, ta.sma(close, 2))
ema = request.security("NYSE:IBM", timeframe.period, ta.ema(close, 2))
math_extremes = request.security("NYSE:IBM", timeframe.period, math.max(close, open) - math.min(close, open))
stateless_math = request.security("NYSE:IBM", timeframe.period, math.abs(open - close) + math.floor(math.avg(open, close)) + math.pow(2, 2))
sum_value = request.security("NYSE:IBM", timeframe.period, math.sum(close, 2))
mintick_round = request.security("NYSE:IBM", timeframe.period, math.round_to_mintick(close + 0.006))
rsi_value = request.security("NYSE:IBM", timeframe.period, ta.rsi(close, 3))
tr_value = request.security("NYSE:IBM", timeframe.period, ta.tr())
tr_strict = request.security("NYSE:IBM", timeframe.period, ta.tr(false))
atr_value = request.security("NYSE:IBM", timeframe.period, ta.atr(3))
highest_value = request.security("NYSE:IBM", timeframe.period, ta.highest(high, 3))
lowest_value = request.security("NYSE:IBM", timeframe.period, ta.lowest(low, 3))
change_value = request.security("NYSE:IBM", timeframe.period, ta.change(close))
mom_value = request.security("NYSE:IBM", timeframe.period, ta.mom(close, 2))
roc_value = request.security("NYSE:IBM", timeframe.period, ta.roc(close, 2))
range_value = request.security("NYSE:IBM", timeframe.period, ta.range(close, 3))
dev_value = request.security("NYSE:IBM", timeframe.period, ta.dev(close, 3))
rising_value = request.security("NYSE:IBM", timeframe.period, ta.rising(close, 2) ? 1 : 0)
falling_value = request.security("NYSE:IBM", timeframe.period, ta.falling(close, 2) ? 1 : 0)
cross_value = request.security("NYSE:IBM", timeframe.period, ta.cross(close, 20.5) ? 1 : 0)
crossover_value = request.security("NYSE:IBM", timeframe.period, ta.crossover(close, 20.5) ? 1 : 0)
crossunder_value = request.security("NYSE:IBM", timeframe.period, ta.crossunder(close - time / 60000.0, 19.5) ? 1 : 0)
cum_value = request.security("NYSE:IBM", timeframe.period, ta.cum(close))
stdev_value = request.security("NYSE:IBM", timeframe.period, ta.stdev(close, 3))
stdev_sample = request.security("NYSE:IBM", timeframe.period, ta.stdev(close, 3, false))
variance_value = request.security("NYSE:IBM", timeframe.period, ta.variance(close, 3))
variance_sample = request.security("NYSE:IBM", timeframe.period, ta.variance(close, 3, false))
wma_value = request.security("NYSE:IBM", timeframe.period, ta.wma(close, 3))
vwma_value = request.security("NYSE:IBM", timeframe.period, ta.vwma(close, 3))
swma_value = request.security("NYSE:IBM", timeframe.period, ta.swma(close))
hma_value = request.security("NYSE:IBM", timeframe.period, ta.hma(close, 4))
alma_value = request.security("NYSE:IBM", timeframe.period, ta.alma(close, 4, 0.85, 6))
linreg_value = request.security("NYSE:IBM", timeframe.period, ta.linreg(close, 3, 0))
bbw_value = request.security("NYSE:IBM", timeframe.period, ta.bbw(close, 3, 2))
correlation_value = request.security("NYSE:IBM", timeframe.period, ta.correlation(close, high, 3))
covariance_value = request.security("NYSE:IBM", timeframe.period, ta.covariance(close, high, 3))
median_value = request.security("NYSE:IBM", timeframe.period, ta.median(close, 3))
mode_value = request.security("NYSE:IBM", timeframe.period, ta.mode(close, 3))
percentile_nearest_rank_value = request.security("NYSE:IBM", timeframe.period, ta.percentile_nearest_rank(close, 3, 50))
percentile_linear_interpolation_value = request.security("NYSE:IBM", timeframe.period, ta.percentile_linear_interpolation(close, 3, 50))
percentrank_value = request.security("NYSE:IBM", timeframe.period, ta.percentrank(close, 3))
rma_value = request.security("NYSE:IBM", timeframe.period, ta.rma(close, 3))
dema_value = request.security("NYSE:IBM", timeframe.period, ta.dema(close, 3))
tema_value = request.security("NYSE:IBM", timeframe.period, ta.tema(close, 3))
tsi_value = request.security("NYSE:IBM", timeframe.period, ta.tsi(close, 2, 3))
cmo_value = request.security("NYSE:IBM", timeframe.period, ta.cmo(close, 3))
mfi_value = request.security("NYSE:IBM", timeframe.period, ta.mfi(close, 3))
stoch_value = request.security("NYSE:IBM", timeframe.period, ta.stoch(close, high, low, 3))
higher = request.security("NYSE:IBM", "5", close + open)
plot(arithmetic + nz(history) + nz(sma) + ema + dema_value + tema_value + rma_value + math_extremes + stateless_math + nz(sum_value) + mintick_round + nz(rsi_value) + nz(tsi_value) + nz(cmo_value) + nz(mfi_value) + nz(stoch_value) + tr_value + nz(tr_strict) + atr_value + nz(highest_value) - nz(lowest_value) + nz(change_value) + nz(mom_value) + nz(roc_value) + nz(range_value) + nz(dev_value) + nz(bbw_value) + nz(correlation_value) + nz(covariance_value) + nz(median_value) + nz(mode_value) + nz(percentile_nearest_rank_value) + nz(percentile_linear_interpolation_value) + nz(percentrank_value) + rising_value - falling_value + cross_value + crossover_value - crossunder_value + cum_value + nz(stdev_value) + nz(stdev_sample) + nz(variance_value) + nz(variance_sample) + nz(wma_value) + nz(vwma_value) + nz(swma_value) + nz(hma_value) + nz(alma_value) + nz(linreg_value) + higher)
