//@version=6
indicator("Unsupported bound matrix.copy call-result reads")

values = matrix.new<float>(2, 2, 1.0)
array_values = array.from(1.0, 2.0)

bad_row = values.copy().get("bad", 0)
bad_column = values.copy().get(0, "bad")
set_result = values.copy().set(0, 0, 2.0)
reverse_result = values.copy().reverse()
sum_result = values.copy().sum()
size_result = values.copy().size()
wrong_receiver = array_values.copy().rows()
transpose_result = values.transpose().rows()

plot(close)
