//@version=6
indicator("Unsupported builtin array call-result reads")

type First
    float shared
    float other

type Second
    float other
    float shared

type Nested
    label id

badConcat(left, right) => array.concat(left, right).size()

first_values = array.from(First.new(10.0, 100.0))
second_values = array.from(Second.new(200.0, 20.0))

copy_bad_get = array.copy(first_values).get("bad")
copy_pop = array.copy(first_values).pop()
from_transform = array.from(First.new(11.0, 110.0)).transform()
new_push = array.new<First>().push(First.new(12.0, 120.0))
slice_again = array.slice(first_values, 0, 1).slice(0, 1)
concat_clear = array.concat(first_values, array.from(First.new(13.0, 130.0))).clear()

mixed_from = array.from(First.new(14.0, 140.0), Second.new(150.0, 15.0)).copy()
mixed_concat = array.concat(first_values, second_values).copy()
non_scalar_new = array.new<Nested>().size()
unknown_new = array.new<Missing>().size()
all_na_from = array.from(na, na).size()
udt_abs = array.abs(first_values).size()
string_standardize = array.standardize(array.from("a", "b")).size()
udt_sort_missing_field = array.sort_indices(first_values).size()
bad_slice_index = array.slice(array.from(1, 2), "bad", 1).size()
copy_includes_wrong_identity = array.copy(first_values).includes(Second.new(200.0, 20.0))
from_includes_wrong_type = array.from(1, 2).includes("bad")
includes_extra_arg = array.copy(first_values).includes(First.new(10.0, 100.0), First.new(10.0, 100.0))
copy_indexof_wrong_identity = array.copy(first_values).indexof(Second.new(200.0, 20.0))
from_indexof_wrong_type = array.from(1, 2).indexof("bad")
indexof_extra_arg = array.copy(first_values).indexof(First.new(10.0, 100.0), First.new(10.0, 100.0))
copy_lastindexof_wrong_identity = array.copy(first_values).lastindexof(Second.new(200.0, 20.0))
from_lastindexof_wrong_type = array.from(1, 2).lastindexof("bad")
lastindexof_extra_arg = array.copy(first_values).lastindexof(First.new(10.0, 100.0), First.new(10.0, 100.0))
copy_binary_search_udt = array.copy(first_values).binary_search(First.new(10.0, 100.0))
string_binary_search = array.from("a", "b").binary_search("a")
bool_binary_search = array.new_bool(2, true).binary_search(true)
chart_point_binary_search = array.new<chart.point>(1, chart.point.now(close)).binary_search(chart.point.now(close))
binary_search_wrong_value = array.from(1, 2).binary_search("bad")
binary_search_extra_arg = array.copy(array.from(1, 2)).binary_search(1, 2)
copy_binary_search_leftmost_udt = array.copy(first_values).binary_search_leftmost(First.new(10.0, 100.0))
string_binary_search_leftmost = array.from("a", "b").binary_search_leftmost("a")
bool_binary_search_leftmost = array.new_bool(2, true).binary_search_leftmost(true)
chart_point_binary_search_leftmost = array.new<chart.point>(1, chart.point.now(close)).binary_search_leftmost(chart.point.now(close))
binary_search_leftmost_wrong_value = array.from(1, 2).binary_search_leftmost("bad")
binary_search_leftmost_extra_arg = array.copy(array.from(1, 2)).binary_search_leftmost(1, 2)
copy_binary_search_rightmost_udt = array.copy(first_values).binary_search_rightmost(First.new(10.0, 100.0))
string_binary_search_rightmost = array.from("a", "b").binary_search_rightmost("a")
bool_binary_search_rightmost = array.new_bool(2, true).binary_search_rightmost(true)
chart_point_binary_search_rightmost = array.new<chart.point>(1, chart.point.now(close)).binary_search_rightmost(chart.point.now(close))
binary_search_rightmost_wrong_value = array.from(1, 2).binary_search_rightmost("bad")
binary_search_rightmost_extra_arg = array.copy(array.from(1, 2)).binary_search_rightmost(1, 2)
copy_abs_udt = array.copy(first_values).abs()
string_call_result_abs = array.from("a", "b").abs()
bool_call_result_abs = array.new_bool(2, true).abs()
color_call_result_abs = array.new_color(1, color.red).abs()
chart_point_call_result_abs = array.new<chart.point>(1, chart.point.now(close)).abs()
call_result_abs_extra_arg = array.from(1, 2).abs(1)
copy_min_udt = array.copy(first_values).min()
string_call_result_min = array.from("a", "b").min()
bool_call_result_min = array.new_bool(2, true).min()
color_call_result_min = array.new_color(1, color.red).min()
chart_point_call_result_min = array.new<chart.point>(1, chart.point.now(close)).min()
call_result_min_float_nth = array.from(1, 2).min(1.5)
call_result_min_string_nth = array.copy(array.from(1, 2)).min(nth="1")
call_result_min_extra_arg = array.from(1, 2).min(0, 1)
copy_max_udt = array.copy(first_values).max()
string_call_result_max = array.from("a", "b").max()
bool_call_result_max = array.new_bool(2, true).max()
color_call_result_max = array.new_color(1, color.red).max()
chart_point_call_result_max = array.new<chart.point>(1, chart.point.now(close)).max()
call_result_max_float_nth = array.from(1, 2).max(1.5)
call_result_max_string_nth = array.copy(array.from(1, 2)).max(nth="1")
call_result_max_extra_arg = array.from(1, 2).max(0, 1)
copy_sum_udt = array.copy(first_values).sum()
string_call_result_sum = array.from("a", "b").sum()
bool_call_result_sum = array.new_bool(2, true).sum()
color_call_result_sum = array.new_color(1, color.red).sum()
chart_point_call_result_sum = array.new<chart.point>(1, chart.point.now(close)).sum()
call_result_sum_extra_arg = array.from(1, 2).sum(0)
copy_avg_udt = array.copy(first_values).avg()
string_call_result_avg = array.from("a", "b").avg()
bool_call_result_avg = array.new_bool(2, true).avg()
color_call_result_avg = array.new_color(1, color.red).avg()
chart_point_call_result_avg = array.new<chart.point>(1, chart.point.now(close)).avg()
call_result_avg_extra_arg = array.from(1, 2).avg(0)
copy_range_udt = array.copy(first_values).range()
string_call_result_range = array.from("a", "b").range()
bool_call_result_range = array.new_bool(2, true).range()
color_call_result_range = array.new_color(1, color.red).range()
chart_point_call_result_range = array.new<chart.point>(1, chart.point.now(close)).range()
call_result_range_extra_arg = array.from(1, 2).range(0)
copy_median_udt = array.copy(first_values).median()
string_call_result_median = array.from("a", "b").median()
bool_call_result_median = array.new_bool(2, true).median()
color_call_result_median = array.new_color(1, color.red).median()
chart_point_call_result_median = array.new<chart.point>(1, chart.point.now(close)).median()
call_result_median_extra_arg = array.from(1, 2).median(0)
copy_mode_udt = array.copy(first_values).mode()
string_call_result_mode = array.from("a", "b").mode()
bool_call_result_mode = array.new_bool(2, true).mode()
color_call_result_mode = array.new_color(1, color.red).mode()
chart_point_call_result_mode = array.new<chart.point>(1, chart.point.now(close)).mode()
call_result_mode_extra_arg = array.from(1, 1).mode(0)

concat_inside_udf = badConcat(array.from(1), array.from(2))
