//@version=6
indicator("Unsupported builtin array call-result reads")

type First
    float shared
    float other

type Second
    float other
    float shared

type Nested
    label id

badConcat(left, right) => array.concat(left, right).size()
badClear(values) =>
    array.copy(values).clear()
    array.size(values)
badReverse(values) =>
    array.copy(values).reverse()
    array.size(values)
badPop(values) =>
    array.copy(values).pop()
    array.size(values)
badShift(values) =>
    array.copy(values).shift()
    array.size(values)
badRemove(values) =>
    array.copy(values).remove(0)
    array.size(values)
badPush(values) =>
    array.copy(values).push(3)
    array.size(values)
badUnshift(values) =>
    array.copy(values).unshift(0)
    array.size(values)
badInsert(values) =>
    array.copy(values).insert(0, 3)
    array.size(values)
badSet(values) =>
    array.copy(values).set(0, 3)
    array.size(values)
badFill(values) =>
    array.copy(values).fill(3)
    array.size(values)

first_values = array.from(First.new(10.0, 100.0))
second_values = array.from(Second.new(200.0, 20.0))

copy_bad_get = array.copy(first_values).get("bad")
from_transform = array.from(First.new(11.0, 110.0)).transform()
postfix_slice_bad_from = array.copy(first_values).slice("bad", 1)
postfix_slice_bad_to = array.from(1, 2).slice(0, "bad")
postfix_slice_missing_to = array.new_int(2, 1).slice(0)
postfix_slice_extra_arg = array.slice(first_values, 0, 1).slice(0, 1, 2)
array.concat(first_values, array.from(First.new(13.0, 130.0))).clear(1)
array.concat(first_values, array.from(First.new(13.0, 130.0))).reverse(1)
pop_extra_arg = array.concat(first_values, array.from(First.new(13.0, 130.0))).pop(1)
shift_extra_arg = array.concat(first_values, array.from(First.new(13.0, 130.0))).shift(1)
