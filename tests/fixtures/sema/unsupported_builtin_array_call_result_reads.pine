remove_extra_arg = array.concat(first_values, array.from(First.new(13.0, 130.0))).remove(0, 1)
array.from(1, 2).push("bad")
array.copy(first_values).push(Second.new(13.0, 130.0))
array.from(1, 2).push()
array.from(1, 2).push(3, 4)
array.from(1, 2).unshift("bad")
array.copy(first_values).unshift(Second.new(13.0, 130.0))
array.from(1, 2).unshift()
array.from(1, 2).unshift(0, 1)
array.from(1, 2).insert("bad", 0)
array.from(1, 2).insert(0, "bad")
array.copy(first_values).insert(0, Second.new(13.0, 130.0))
array.from(1, 2).insert(0)
array.from(1, 2).insert(0, 3, 4)
array.from(1, 2).set("bad", 0)
array.from(1, 2).set(0, "bad")
