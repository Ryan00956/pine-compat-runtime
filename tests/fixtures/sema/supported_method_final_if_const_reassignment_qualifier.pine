//@version=6
indicator("Supported method final-if const reassignment qualifier")
type Box
    int seed
method choose_length(Box this, bool flag, int x) =>
    local = x
    if flag
        local := bar_index
        local
    else
        local
length = input.int(2, "Length")
box = Box.new(1)
chosen = box.choose_length(false, length)
plot(ta.ema(close, chosen))
