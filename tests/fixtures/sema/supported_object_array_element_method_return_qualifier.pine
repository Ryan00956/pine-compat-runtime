//@version=6
indicator("Supported object array element method return qualifier")

type Tool
    float base

method label_value(Tool tool, label value) =>
    tool.base + 1

method line_value(Tool tool, line value) =>
    tool.base + 1

method linefill_value(Tool tool, linefill value) =>
    tool.base + 1

method polyline_value(Tool tool, polyline value) =>
    tool.base + 1

method box_value(Tool tool, box value) =>
    tool.base + 1

method table_value(Tool tool, table value) =>
    tool.base + 1

method point_value(Tool tool, chart.point value) =>
    tool.base + 1

tool = Tool.new(close)
first_label = label.new(bar_index, high, "a")
second_label = label.new(bar_index + 1, low, "b")
first_line = line.new(bar_index, high, bar_index + 1, low)
second_line = line.new(bar_index + 2, high + 1, bar_index + 3, low + 1)
third_line = line.new(bar_index + 4, close, bar_index + 5, close + 1)
first_fill = linefill.new(first_line, second_line, color.green)
second_fill = linefill.new(second_line, third_line, color.red)
points = array.from(chart.point.from_index(bar_index, close), chart.point.from_index(bar_index + 1, close + 1))
first_polyline = polyline.new(points, line_color=color.red)
second_polyline = polyline.new(points, line_color=color.green)
first_box = box.new(bar_index, high, bar_index + 1, low)
second_box = box.new(bar_index + 2, high + 1, bar_index + 3, low + 1)
first_table = table.new(position.top_left, 1, 1)
second_table = table.new(position.bottom_right, 1, 1)
labels = array.from(first_label, second_label)
lines = array.from(first_line, second_line)
fills = array.from(first_fill, second_fill)
polylines = array.from(first_polyline, second_polyline)
boxes = array.from(first_box, second_box)
tables = array.from(first_table, second_table)

result = tool.label_value(array.get(labels, 0)) + tool.line_value(lines.get(0))
result := result + tool.linefill_value(array.get(fills, 0)) + tool.polyline_value(polylines.get(0))
result := result + tool.box_value(array.get(boxes, 0)) + tool.table_value(tables.get(0)) + tool.point_value(array.get(points, 0))

result := result + tool.label_value(array.first(labels)) + tool.line_value(lines.first())
result := result + tool.linefill_value(array.first(fills)) + tool.polyline_value(polylines.first())
result := result + tool.box_value(array.first(boxes)) + tool.table_value(tables.first()) + tool.point_value(array.first(points))

result := result + tool.label_value(array.last(labels)) + tool.line_value(lines.last())
result := result + tool.linefill_value(array.last(fills)) + tool.polyline_value(polylines.last())
result := result + tool.box_value(array.last(boxes)) + tool.table_value(tables.last()) + tool.point_value(array.last(points))

removed_label = array.remove(labels, 0)
removed_line = lines.remove(0)
removed_fill = array.remove(fills, 0)
removed_polyline = polylines.remove(0)
removed_box = array.remove(boxes, 0)
removed_table = tables.remove(0)
removed_point = array.remove(points, 0)
result := result + tool.label_value(removed_label) + tool.line_value(removed_line)
result := result + tool.linefill_value(removed_fill) + tool.polyline_value(removed_polyline)
result := result + tool.box_value(removed_box) + tool.table_value(removed_table) + tool.point_value(removed_point)

popped_label = array.pop(labels)
popped_line = lines.pop()
popped_fill = array.pop(fills)
popped_polyline = polylines.pop()
popped_box = array.pop(boxes)
popped_table = tables.pop()
popped_point = array.pop(points)
result := result + tool.label_value(popped_label) + tool.line_value(popped_line)
result := result + tool.linefill_value(popped_fill) + tool.polyline_value(popped_polyline)
result := result + tool.box_value(popped_box) + tool.table_value(popped_table) + tool.point_value(popped_point)

shifted_label = array.shift(labels)
shifted_line = lines.shift()
shifted_fill = array.shift(fills)
shifted_polyline = polylines.shift()
shifted_box = array.shift(boxes)
shifted_table = tables.shift()
shifted_point = array.shift(points)
result := result + tool.label_value(shifted_label) + tool.line_value(shifted_line)
result := result + tool.linefill_value(shifted_fill) + tool.polyline_value(shifted_polyline)
result := result + tool.box_value(shifted_box) + tool.table_value(shifted_table) + tool.point_value(shifted_point)

plot(result)
