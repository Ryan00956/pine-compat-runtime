//@version=5
indicator("Supported ta Bollinger series length")
length = bar_index % 2 + 2
[basis, upper, lower] = ta.bb(close, length, 2)
[named_basis, named_upper, named_lower] = ta.bb(source=close, length=length, mult=2)
plot(basis)
plot(upper)
plot(lower)
plot(named_basis)
plot(named_upper)
plot(named_lower)
plot(ta.bbw(close, length, 2))
plot(ta.bbw(source=close, length=length, mult=2))
