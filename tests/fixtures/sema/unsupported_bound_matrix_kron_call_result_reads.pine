//@version=6
indicator("Unsupported bound matrix.kron call-result reads")

values = matrix.new<float>(2, 2, 1.0)
bools = matrix.new<bool>(2, 2, true)
array_values = array.from(1.0, 2.0)

bad_other = values.kron(array_values).rows()
bad_row = values.kron(values).get("bad", 0)
values.kron(values).set(0, 0, "bad")
size_result = values.kron(values).size()
bad_receiver_kind = bools.kron(values).rows()
wrong_receiver = array_values.kron(values).rows()

plot(close)
