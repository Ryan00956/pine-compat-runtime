//@version=6
indicator("Unsupported builtin namespace matrix call-result reads")

left = matrix.new<float>(2, 2, 1.0)
right = matrix.new<float>(2, 2, 2.0)
vector = array.from(3.0, 4.0)
bool_values = matrix.new<bool>(2, 2, true)

matrix_bad_row = matrix.mult(left, right).get("bad", 0)
matrix_bad_column = matrix.mult(left, right).get(0, "bad")
matrix_set = matrix.mult(left, right).set(0, 0, 3.0)
matrix_reverse = matrix.mult(left, 2.0).copy().reverse()
matrix_size = matrix.mult(2.0, left).size()
copy_bad_row = matrix.copy(left).get("bad", 0)
copy_set = matrix.copy(left).set(0, 0, 3.0)
copy_sum = matrix.copy(left).sum()
copy_size = matrix.copy(left).size()
copy_wrong_receiver = matrix.copy(vector).rows()
transpose_bad_column = matrix.transpose(left).get(0, "bad")
transpose_set = matrix.transpose(left).set(0, 0, 3.0)
transpose_sum = matrix.transpose(left).sum()
transpose_size = matrix.transpose(left).size()
transpose_wrong_receiver = matrix.transpose(vector).rows()
submatrix_bad_from = matrix.submatrix(left, "bad").rows()
submatrix_bad_row = matrix.submatrix(left).get("bad", 0)
submatrix_set = matrix.submatrix(left).set(0, 0, 3.0)
submatrix_sum = matrix.submatrix(left).sum()
submatrix_size = matrix.submatrix(left).size()
submatrix_wrong_receiver = matrix.submatrix(vector).rows()
kron_bad_right = matrix.kron(left, vector).rows()
kron_bad_row = matrix.kron(left, right).get("bad", 0)
kron_set = matrix.kron(left, right).set(0, 0, 3.0)
kron_sum = matrix.kron(left, right).sum()
kron_size = matrix.kron(left, right).size()
diff_bad_right = matrix.diff(left, vector).rows()
diff_bad_row = matrix.diff(left, right).get("bad", 0)
diff_set = matrix.diff(left, right).set(0, 0, 3.0)
diff_sum = matrix.diff(left, right).sum()
diff_size = matrix.diff(left, right).size()
pow_bad_receiver = matrix.pow(vector, 2).rows()
pow_bad_power = matrix.pow(left, "bad").rows()
pow_bad_row = matrix.pow(left, 2).get("bad", 0)
pow_set = matrix.pow(left, 2).set(0, 0, 3.0)
pow_sum = matrix.pow(left, 2).sum()
pow_size = matrix.pow(left, 2).size()
inv_bad_receiver = matrix.inv(vector).rows()
inv_bad_row = matrix.inv(left).get("bad", 0)
inv_set = matrix.inv(left).set(0, 0, 3.0)
inv_sum = matrix.inv(left).sum()
inv_size = matrix.inv(left).size()
pinv_bad_receiver = matrix.pinv(vector).rows()
pinv_bad_row = matrix.pinv(left).get("bad", 0)
pinv_set = matrix.pinv(left).set(0, 0, 3.0)
pinv_sum = matrix.pinv(left).sum()
pinv_size = matrix.pinv(left).size()
eigenvectors_bad_receiver = matrix.eigenvectors(vector).rows()
eigenvectors_bad_row = matrix.eigenvectors(left).get("bad", 0)
eigenvectors_set = matrix.eigenvectors(left).set(0, 0, 3.0)
eigenvectors_sum = matrix.eigenvectors(left).sum()
eigenvectors_size = matrix.eigenvectors(left).size()
new_bad_rows = matrix.new<float>("bad", 2, 0.0).rows()
new_bad_get = matrix.new<int>(2, 2, 1).get("bad", 0)
new_set = matrix.new<bool>(1, 1, true).set(0, 0, false)
new_sum = matrix.new<float>(1, 1, 1.0).sum()
new_size = matrix.new<string>(1, 1, "value").size()

array_rows = matrix.mult(left, vector).rows()
array_columns = matrix.mult(vector, left).columns()
array_elements = matrix.mult(vector, vector).elements_count()
array_matrix_get = matrix.mult(left, vector).get(0, 0)
array_copy_rows = matrix.mult(vector, left).copy().rows()
row_bad_index = matrix.mult(left, right).row("bad")
row_push = matrix.mult(left, right).row(0).push(3.0)
col_bad_index = matrix.mult(left, right).col("bad")
col_push = matrix.mult(left, right).col(0).push(3.0)
eigenvalues_push = matrix.mult(left, right).eigenvalues().push(3.0)
bool_eigenvalues = matrix.copy(bool_values).eigenvalues()
is_square_extra_arg = matrix.copy(left).is_square(0)
bool_is_zero = matrix.copy(bool_values).is_zero()
is_zero_extra_arg = matrix.copy(left).is_zero(0)
bool_is_binary = matrix.copy(bool_values).is_binary()
is_binary_extra_arg = matrix.copy(left).is_binary(0)

plot(close)
