//@version=6
indicator("Unsupported drawing getter return qualifier")

label_id = label.new(bar_index, high, "label")
line_id = line.new(bar_index, low, bar_index + 1, high)
box_id = box.new(bar_index, high, bar_index + 1, low)

label_x = label.get_x(label_id)
label_y = label.get_y(label_id)
label_text = label.get_text(label_id)
line_price = line.get_price(line_id, bar_index)
line_x1 = line.get_x1(line_id)
line_y1 = line.get_y1(line_id)
line_x2 = line.get_x2(line_id)
line_y2 = line.get_y2(line_id)
box_left = box.get_left(box_id)
box_top = box.get_top(box_id)
box_right = box.get_right(box_id)
box_bottom = box.get_bottom(box_id)
label_x_method = label_id.get_x()
label_y_method = label_id.get_y()
label_text_method = label_id.get_text()
line_price_method = line_id.get_price(bar_index)
line_x1_method = line_id.get_x1()
line_y1_method = line_id.get_y1()
line_x2_method = line_id.get_x2()
line_y2_method = line_id.get_y2()
box_left_method = box_id.get_left()
box_top_method = box_id.get_top()
box_right_method = box_id.get_right()
box_bottom_method = box_id.get_bottom()

hline(label_x)
hline(label_y)
syminfo.prefix(symbol=label_text)
hline(line_price)
hline(line_x1)
hline(line_y1)
hline(line_x2)
hline(line_y2)
hline(box_left)
hline(box_top)
hline(box_right)
hline(box_bottom)
hline(label_x_method)
hline(label_y_method)
syminfo.prefix(symbol=label_text_method)
hline(line_price_method)
hline(line_x1_method)
hline(line_y1_method)
hline(line_x2_method)
hline(line_y2_method)
hline(box_left_method)
hline(box_top_method)
hline(box_right_method)
hline(box_bottom_method)
