//@version=6
indicator("Supported UDT array control-flow results")

type Point
    float x
    float y

type Wrapper
    Point inner
    float weight

type Marker
    float value

left = array.new<Wrapper>(1, Wrapper.new(Point.new(close, open), 10.0))
right = array.from(Wrapper.new(Point.new(high, low), 20.0))

ternary_selected = bar_index % 2 == 0 ? left : right
nullable = bar_index == 0 ? left : (bar_index == 1 ? na : na)

if_selected = if bar_index % 2 == 0
    made = left.copy()
    made
else
    made = right.copy()
    made

switch_selected = switch bar_index % 2
    0 =>
        made = left.copy()
        made
    =>
        made = right.copy()
        made

for_selected = for i = 0 to 0
    made = left.copy()
    made

for_in_selected = for item in array.from(0)
    made = right.copy()
    made

int iterations = 0
while_selected = while iterations < 1
    iterations := iterations + 1
    made = right.copy()
    made

nested = if bar_index % 2 == 0
    for i = 0 to 0
        made = left.copy()
        made
else
    int nested_iterations = 0
    while nested_iterations < 1
        nested_iterations := nested_iterations + 1
        made = right.copy()
        made

aliased_na = if bar_index == 0
    left
else
    nothing = na
    nothing

array<Wrapper> typed = if bar_index % 2 == 0
    left
else
    na
Wrapper[] typed_alias = switch bar_index % 2
    0 => left
    => right

assigned = left
assigned := for i = 0 to 0
    right

made = left
markers = array.from(Marker.new(30.0))
shadowed = if bar_index % 2 == 0
    made = markers.copy()
    made
else
    made = markers.copy()
    made

ternary_value = array.get(ternary_selected, 0)
nullable_size = array.size(nullable)
if_value = if_selected.get(0)
switch_copy = switch_selected.copy()
switch_value = switch_copy.get(0)
for_value = for_selected.first()
for_in_value = for_in_selected.last()
while_value = while_selected.get(0)
nested_value = nested.get(0)
typed_value = typed.get(0)
typed_alias_value = typed_alias.get(0)
assigned_value = assigned.get(0)
history_value = array.get(ternary_selected[1], 0)
shadowed_value = shadowed.get(0)

float iterated_weight = 0.0
for value in ternary_selected
    iterated_weight := iterated_weight + value.weight

plot(ternary_value.inner.x + nullable_size + if_value.weight + switch_value.weight + for_value.weight + for_in_value.weight + while_value.weight + nested_value.weight + typed_value.weight + typed_alias_value.weight + assigned_value.weight + nz(history_value.weight) + shadowed_value.value + iterated_weight)
