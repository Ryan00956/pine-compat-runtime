//@version=6
import user/udt_array_returns/1 as lib
indicator("Unsupported imported UDT array tuple returns")

values = array.from(lib.First.new(10.0, 100.0))
[udf_first, udf_second] = lib.tupleReturn(values)

anchor = lib.First.new(20.0, 200.0)
[method_first, method_second] = anchor.tupleFirst(values)

udf_item = array.first(udf_first)
method_item = array.first(method_first)
plot(udf_item.shared + method_item.shared)
