//@version=5
indicator("Supported ta named reordered history metadata")
len = input.int(2, "Length")
plot(ta.change(length=2, source=open))
plot(ta.mom(length=3, source=close))
plot(ta.roc(length=len, source=high))
plot(ta.highest(length=5, source=low))
plot(ta.lowest(source=high, length=5))
plot(ta.highestbars(length=5, source=close))
plot(ta.lowestbars(source=open, length=5))
plot(ta.highestbars(length=5))
plot(ta.lowest(length=5))
plot(ta.rising(source=volume, length=4) ? 1 : 0)
plot(ta.falling(length=4, source=volume) ? 1 : 0)
plot(ta.valuewhen(occurrence=len, source=close, condition=close > open))
