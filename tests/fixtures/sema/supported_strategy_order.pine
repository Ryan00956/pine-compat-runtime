//@version=5
strategy("Supported strategy order")
strategy.order("O", strategy.long, qty=1)
strategy.order("OD", strategy.long)
strategy.order("R", strategy.short, qty=1)
strategy.order("L", strategy.long, qty=1, limit=close)
strategy.order("LD", strategy.long, limit=close)
strategy.order("LS", strategy.short, qty=1, limit=close)
strategy.order("S", strategy.long, qty=1, stop=close)
strategy.order("SD", strategy.long, stop=close)
strategy.order("SS", strategy.short, qty=1, stop=close)
strategy.order("SL", strategy.long, qty=1, limit=close, stop=close)
strategy.order("SLD", strategy.long, limit=close, stop=close)
strategy.order("SLS", strategy.short, qty=1, limit=close, stop=close)
