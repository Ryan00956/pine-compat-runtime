//@version=6
indicator("Supported chart point return qualifier")

new_point = chart.point.new(time, bar_index, close)
now_point = chart.point.now(close)
index_point = chart.point.from_index(bar_index + 1, high)
time_point = chart.point.from_time(time + 60000, low)
copied_point = chart.point.copy(index_point)

label.new(point=new_point, text="new")
label.new(point=now_point, text="now")
label.new(point=index_point, text="index")
label.new(point=time_point, text="time")
label.new(point=copied_point, text="copy")
