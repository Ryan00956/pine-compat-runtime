pivot_lastindexof_wrong_type = ta.pivot_point_levels("Traditional", true, true).lastindexof("bad")
matrix_row_lastindexof_wrong_type = matrix.row(float_matrix, 0).lastindexof("bad")
map_keys_lastindexof_wrong_type = map.keys(prices).lastindexof(1)
map_values_lastindexof_wrong_type = map.values(prices).lastindexof("bad")
mult_lastindexof_wrong_type = matrix.mult(float_matrix, mult_vector).lastindexof("bad")
lastindexof_extra_arg = str.split("a,b", ",").lastindexof("a", "b")
split_binary_search = str.split("a,b", ",").binary_search("a")
matrix_bool_binary_search = matrix.row(matrix.new<bool>(1, 1, true), 0).binary_search(true)
matrix_string_binary_search = matrix.row(matrix.new<string>(1, 1, "a"), 0).binary_search("a")
matrix_color_binary_search = matrix.row(matrix.new<color>(1, 1, color.red), 0).binary_search(color.red)
map_bool_binary_search = map.values(flags).binary_search(true)
map_string_binary_search = map.keys(prices).binary_search("a")
numeric_binary_search_wrong_value = matrix.row(float_matrix, 0).binary_search("bad")
