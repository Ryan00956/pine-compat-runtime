//@version=6
indicator("Unsupported builtin namespace array call-result reads")

float_matrix = matrix.new<float>(1, 1, 0.0)
mult_vector = array.from(2.0)
prices = map.new<string, float>()
prices.put("open", 1.0)
flags = map.new<string, bool>()
flags.put("open", true)

split_bad_index = str.split("a,b", ",").get("bad")
split_pop = str.split("a,b", ",").pop()
split_push = str.split("a,b", ",").push("c")
