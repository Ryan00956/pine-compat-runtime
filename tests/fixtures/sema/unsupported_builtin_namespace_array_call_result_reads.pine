map_values_set = map.values(prices).set(0, 2.0)
mult_bad_get = matrix.mult(float_matrix, mult_vector).get("bad")
mult_pop = matrix.mult(float_matrix, mult_vector).pop()
mult_reverse = matrix.mult(mult_vector, float_matrix).copy().reverse()
