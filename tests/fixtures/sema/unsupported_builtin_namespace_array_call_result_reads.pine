matrix_row_includes_wrong_type = matrix.row(float_matrix, 0).includes("bad")
map_keys_includes_wrong_type = map.keys(prices).includes(1)
map_values_includes_wrong_type = map.values(prices).includes("bad")
mult_includes_wrong_type = matrix.mult(float_matrix, mult_vector).includes("bad")
includes_extra_arg = str.split("a,b", ",").includes("a", "b")
split_indexof_wrong_type = str.split("a,b", ",").indexof(1)
pivot_indexof_wrong_type = ta.pivot_point_levels("Traditional", true, true).indexof("bad")
matrix_row_indexof_wrong_type = matrix.row(float_matrix, 0).indexof("bad")
map_keys_indexof_wrong_type = map.keys(prices).indexof(1)
map_values_indexof_wrong_type = map.values(prices).indexof("bad")
mult_indexof_wrong_type = matrix.mult(float_matrix, mult_vector).indexof("bad")
indexof_extra_arg = str.split("a,b", ",").indexof("a", "b")
