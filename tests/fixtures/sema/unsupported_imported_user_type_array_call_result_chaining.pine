//@version=6
import user/udt_array_returns/1 as lib
indicator("Unsupported imported UDT array call result chaining")

values = array.from(lib.First.new(10.0, 100.0))
second_values = array.from(lib.Second.new(200.0, 20.0))
anchor = lib.First.new(20.0, 200.0)

udf_pop = lib.direct(values).pop()
method_slice = anchor.retainFirst(values).slice(0, 1)
builtin_copy_pop = array.copy(values).pop()
builtin_slice_again = array.slice(values, 0, 1).slice(0, 1)
builtin_concat_mixed = array.concat(values, second_values).copy()
builtin_sort_missing_field = array.sort_indices(values).size()
udf_includes_wrong_identity = lib.direct(values).includes(lib.Second.new(200.0, 20.0))
method_includes_wrong_identity = anchor.retainFirst(values).copy().includes(lib.Second.new(200.0, 20.0))
scalar_includes_wrong_type = lib.direct(array.from(1, 2)).includes("bad")
includes_extra_arg = lib.direct(values).includes(lib.First.new(10.0, 100.0), lib.First.new(10.0, 100.0))
udf_indexof_wrong_identity = lib.direct(values).indexof(lib.Second.new(200.0, 20.0))
method_indexof_wrong_identity = anchor.retainFirst(values).copy().indexof(lib.Second.new(200.0, 20.0))
scalar_indexof_wrong_type = lib.direct(array.from(1, 2)).indexof("bad")
indexof_extra_arg = lib.direct(values).indexof(lib.First.new(10.0, 100.0), lib.First.new(10.0, 100.0))
udf_lastindexof_wrong_identity = lib.direct(values).lastindexof(lib.Second.new(200.0, 20.0))
method_lastindexof_wrong_identity = anchor.retainFirst(values).copy().lastindexof(lib.Second.new(200.0, 20.0))
scalar_lastindexof_wrong_type = lib.direct(array.from(1, 2)).lastindexof("bad")
lastindexof_extra_arg = lib.direct(values).lastindexof(lib.First.new(10.0, 100.0), lib.First.new(10.0, 100.0))
udf_binary_search_udt = lib.direct(values).binary_search(lib.First.new(10.0, 100.0))
method_binary_search_udt = anchor.retainFirst(values).copy().binary_search(lib.First.new(10.0, 100.0))
scalar_binary_search_string = lib.direct(array.from("a", "b")).binary_search("a")
binary_search_extra_arg = lib.direct(array.from(1, 2)).binary_search(1, 2)
udf_binary_search_leftmost_udt = lib.direct(values).binary_search_leftmost(lib.First.new(10.0, 100.0))
method_binary_search_leftmost_udt = anchor.retainFirst(values).copy().binary_search_leftmost(lib.First.new(10.0, 100.0))
scalar_binary_search_leftmost_string = lib.direct(array.from("a", "b")).binary_search_leftmost("a")
binary_search_leftmost_extra_arg = lib.direct(array.from(1, 2)).binary_search_leftmost(1, 2)
udf_binary_search_rightmost_udt = lib.direct(values).binary_search_rightmost(lib.First.new(10.0, 100.0))
method_binary_search_rightmost_udt = anchor.retainFirst(values).copy().binary_search_rightmost(lib.First.new(10.0, 100.0))
scalar_binary_search_rightmost_string = lib.direct(array.from("a", "b")).binary_search_rightmost("a")
binary_search_rightmost_extra_arg = lib.direct(array.from(1, 2)).binary_search_rightmost(1, 2)
udf_abs_udt = lib.direct(values).abs()
method_abs_udt = anchor.retainFirst(values).copy().abs()
scalar_abs_string = lib.direct(array.from("a", "b")).abs()
abs_extra_arg = lib.direct(array.from(1, 2)).abs(1)
udf_min_udt = lib.direct(values).min()
method_min_udt = anchor.retainFirst(values).copy().min()
scalar_min_string = lib.direct(array.from("a", "b")).min()
min_bad_nth = lib.direct(array.from(1, 2)).min(1.5)
min_extra_arg = lib.direct(array.from(1, 2)).min(0, 1)
