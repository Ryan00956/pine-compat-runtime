//@version=6
indicator("Supported matrix.new<bool>")

values = matrix.new<bool>(2, 2, true)
matrix<bool> typed = na
typed := matrix.new<bool>(1, 1, false)
matrix.set(values, 0, 0, false)
values.set(0, 1, na)
copy = values.copy()
matrix.fill(copy, true)
copy.fill(na)
slice = matrix.submatrix(values, 0, 1, 0, 2)
row_values = values.row(0)
column_values = matrix.col(values, 1)
row_values.set(0, true)
column_values.set(0, false)
matrix.swap_rows(values, 0, 1)
values.swap_columns(0, 1)
matrix.remove_row(values, 1)
values.remove_col(0)
matrix.add_row(values, 0, array.from(true))
values.add_col(1, array.from(false, na))
reshaped = values.copy()
reshaped.reshape(1, 4)
plot(matrix.rows(reshaped) + reshaped.columns() + matrix.elements_count(values) + (typed.get(0, 0) ? 1 : 0) + (na(slice.get(0, 1)) ? 1 : 0))
matrix.reverse(reshaped)
