//@version=6
indicator("Unsupported bound matrix.eigenvectors call-result reads")

values = matrix.new<float>(2, 2, 1.0)
bools = matrix.new<bool>(2, 2, true)
array_values = array.from(1.0, 2.0)

bad_row = values.eigenvectors().get("bad", 0)
set_result = values.eigenvectors().set(0, 0, 2.0)
sum_result = values.eigenvectors().sum()
size_result = values.eigenvectors().size()
bad_receiver_kind = bools.eigenvectors().rows()
wrong_receiver = array_values.eigenvectors().rows()
mult_result = values.mult(values).rows()

plot(close)
