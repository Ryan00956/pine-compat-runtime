//@version=6
indicator("Supported constructed local non-scalar UDT history")

type Marker
    label id
    line trend
    box zone
    chart.point anchor

marker = Marker.new(label.new(bar_index, close), line.new(bar_index, close, bar_index + 1, high), box.new(bar_index, high, bar_index + 1, low), chart.point.from_index(bar_index, close))
prior = marker[1]
plot(na(prior.id) ? 1 : label.get_x(prior.id))
plot(na(prior.trend) ? 1 : line.get_x1(prior.trend))
plot(na(prior.zone) ? 1 : box.get_left(prior.zone))
plot(na(prior.anchor) ? 1 : prior.anchor.index)
