//@version=6
indicator("Supported matrix.new fixed simple return qualifier")

matrix.fill(matrix.new<int>(1, 1, 0), 1)
matrix.fill(matrix.new<float>(1, 1, 0.0), 1.0)
matrix.fill(matrix.new<bool>(1, 1, false), true)
matrix.fill(matrix.new<string>(1, 1, ""), "ok")
matrix.fill(matrix.new<color>(1, 1, color.red), color.blue)
int_values = matrix.new<int>(1, 1, 0)
float_values = matrix.new<float>(1, 1, 0.0)
bool_values = matrix.new<bool>(1, 1, false)
string_values = matrix.new<string>(1, 1, "")
color_values = matrix.new<color>(1, 1, color.red)
int_values.fill(1)
float_values.fill(1.0)
bool_values.fill(true)
string_values.fill("ok")
color_values.fill(color.blue)
