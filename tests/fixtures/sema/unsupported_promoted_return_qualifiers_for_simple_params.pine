//@version=6
indicator("Unsupported promoted return qualifiers for simple params")
values = array.from(1, 2)
simple_numeric = math.max(array.size(values), 1)
simple_min = math.min(array.size(values), 1)
simple_float = math.avg(array.size(values), 1)
simple_pow = math.pow(array.size(values), 2)
simple_hypot = math.hypot(array.size(values), 1)
simple_int = str.pos(timeframe.period, "D")
hline(simple_numeric)
hline(simple_min)
hline(simple_float)
hline(simple_pow)
hline(simple_hypot)
plot(close, show_last=simple_int)
