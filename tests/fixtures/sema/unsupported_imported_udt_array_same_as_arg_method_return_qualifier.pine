//@version=6
import user/udt/1 as lib
indicator("Unsupported imported UDT array SameAsArg method return qualifier")

type Point
    float x

anchor = lib.Point.new(close)
local_points = array.new<Point>(2, Point.new(close))

first = anchor.firstFrom(array.copy(local_points))
second = lib.secondFrom(anchor, local_points.copy())
third = anchor.firstFrom(array.slice(local_points, 0, 1))
fourth = lib.secondFrom(anchor, local_points.slice(0, 2))

plot(first.x + second.x + third.x + fourth.x)
