//@version=6
import user/udt/1 as lib
indicator("Unsupported imported user-method map call-result reads")

point = lib.Point.new(1.0)

bad_get_key = point.exposeMap().get(1)
bad_contains_key = point.exposeMap().contains(1)
bad_get_arity = point.exposeMap().get("v", "extra")
put_result = point.exposeMap().put("v", 1.0)
clear_result = point.exposeMap().clear()
remove_result = point.exposeMap().remove("v")
keys_result = point.exposeMap().keys()
values_result = point.exposeMap().values()
copy_keys_result = point.exposeMap().copy().keys()
terminal_chain = point.exposeMap().size().copy()
scalar_size = point.shift(1.0).size()

plot(close)
