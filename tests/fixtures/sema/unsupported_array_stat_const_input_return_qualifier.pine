//@version=6
indicator("Unsupported array stat const input return qualifier")

ints = array.from(1, 2, 3)
floats = array.from(1.0, 2.0, 3.0)

hline(array.avg(ints))
hline(array.percentile_linear_interpolation(ints, 50))
hline(array.percentrank(ints, 0))
hline(array.covariance(ints, ints, false))
hline(array.variance(ints, false))
hline(array.stdev(ints, false))
hline(array.avg(floats))
hline(array.percentile_linear_interpolation(floats, 50))
hline(array.percentrank(floats, 0))
hline(array.covariance(floats, floats, false))
hline(array.variance(floats, false))
hline(array.stdev(floats, false))

hline(ints.avg())
hline(ints.percentile_linear_interpolation(50))
hline(ints.percentrank(0))
hline(ints.covariance(ints, false))
hline(ints.variance(false))
hline(ints.stdev(false))
hline(floats.avg())
hline(floats.percentile_linear_interpolation(50))
hline(floats.percentrank(0))
hline(floats.covariance(floats, false))
hline(floats.variance(false))
hline(floats.stdev(false))
