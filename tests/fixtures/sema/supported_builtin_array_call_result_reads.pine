object_na_indexof = array.new_line(1).indexof(na) == 0 and array.new_linefill(1).indexof(na) == 0 and array.new_polyline(1).indexof(na) == 0 and array.new_label(1).indexof(na) == 0 and array.new_box(1).indexof(na) == 0 and array.new_table(1).indexof(na) == 0
constructor_lastindexof = array.new_float(2, 2.0).lastindexof(2) + array.new_int(2, 2).lastindexof(2) + array.new_bool(2, true).lastindexof(true) + array.new_string(2, "pine").lastindexof("pine") + array.new_color(2, color.red).lastindexof(color.red)
object_na_lastindexof = array.new_line(2).lastindexof(na) == 1 and array.new_linefill(2).lastindexof(na) == 1 and array.new_polyline(2).lastindexof(na) == 1 and array.new_label(2).lastindexof(na) == 1 and array.new_box(2).lastindexof(na) == 1 and array.new_table(2).lastindexof(na) == 1

first_values = array.from(First.new(10.0, 100.0), First.new(11.0, 110.0))
second_values = array.from(Second.new(200.0, 20.0), Second.new(210.0, 21.0))
copy_size_first = array.copy(first_values).size()
copy_get_second = array.copy(second_values).get(index=0)
