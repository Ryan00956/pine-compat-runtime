//@version=6
indicator("Supported builtin array call-result reads")

type First
    float shared
    float other

type Second
    float other
    float shared

type Anchor
    int tag

noneFirst() =>
    array<First> values = na
    values

noneInts() =>
    array<int> values = na
    values

readArray(values) =>
    array.copy(values).size() + array.slice(values, 0, 1).size()

readShared(values) =>
    first_item = array.copy(values).first()
    last_item = array.slice(values, 0, 1).last()
    first_item.shared + last_item.shared

method readArray(Anchor self, array<int> values) =>
    array.copy(values).get(index=0) + array.slice(values, 0, 1).first()

constructor_sizes = array.new_float(1).size() + array.new_int(1).size() + array.new_bool(1).size() + array.new_string(1).size() + array.new_color(1).size() + array.new_line(1).size() + array.new_linefill(1).size() + array.new_polyline(1).size() + array.new_label(1).size() + array.new_box(1).size() + array.new_table(1).size() + array.new<chart.point>(1).size()
