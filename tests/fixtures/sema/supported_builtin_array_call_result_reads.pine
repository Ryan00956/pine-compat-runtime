//@version=6
indicator("Supported builtin array call-result reads")

type First
    float shared
    float other

type Second
    float other
    float shared

type Anchor
    int tag

noneFirst() =>
    array<First> values = na
    values

readArray(values) =>
    array.copy(values).size() + array.slice(values, 0, 1).size()

readShared(values) =>
    first_item = array.copy(values).first()
    last_item = array.slice(values, 0, 1).last()
    first_item.shared + last_item.shared

method readArray(Anchor self, array<int> values) =>
    array.copy(values).get(index=0) + array.slice(values, 0, 1).first()

constructor_sizes = array.new_float(1).size() + array.new_int(1).size() + array.new_bool(1).size() + array.new_string(1).size() + array.new_color(1).size() + array.new_line(1).size() + array.new_linefill(1).size() + array.new_polyline(1).size() + array.new_label(1).size() + array.new_box(1).size() + array.new_table(1).size() + array.new<chart.point>(1).size()
constructor_includes = array.new_float(1, 2.0).includes(2) and array.new_int(1, 2).includes(2) and array.new_bool(1, true).includes(true) and array.new_string(1, "pine").includes("pine") and array.new_color(1, color.red).includes(color.red)
object_na_includes = array.new_line(1).includes(na) and array.new_linefill(1).includes(na) and array.new_polyline(1).includes(na) and array.new_label(1).includes(na) and array.new_box(1).includes(na) and array.new_table(1).includes(na)
constructor_indexof = array.new_float(1, 2.0).indexof(2) + array.new_int(1, 2).indexof(2) + array.new_bool(1, true).indexof(true) + array.new_string(1, "pine").indexof("pine") + array.new_color(1, color.red).indexof(color.red)
object_na_indexof = array.new_line(1).indexof(na) == 0 and array.new_linefill(1).indexof(na) == 0 and array.new_polyline(1).indexof(na) == 0 and array.new_label(1).indexof(na) == 0 and array.new_box(1).indexof(na) == 0 and array.new_table(1).indexof(na) == 0
constructor_lastindexof = array.new_float(2, 2.0).lastindexof(2) + array.new_int(2, 2).lastindexof(2) + array.new_bool(2, true).lastindexof(true) + array.new_string(2, "pine").lastindexof("pine") + array.new_color(2, color.red).lastindexof(color.red)
object_na_lastindexof = array.new_line(2).lastindexof(na) == 1 and array.new_linefill(2).lastindexof(na) == 1 and array.new_polyline(2).lastindexof(na) == 1 and array.new_label(2).lastindexof(na) == 1 and array.new_box(2).lastindexof(na) == 1 and array.new_table(2).lastindexof(na) == 1

first_values = array.from(First.new(10.0, 100.0), First.new(11.0, 110.0))
second_values = array.from(Second.new(200.0, 20.0), Second.new(210.0, 21.0))
copy_size_first = array.copy(first_values).size()
copy_get_second = array.copy(second_values).get(index=0)
copy_first_again = array.copy(first_values).first()
copy_last_second = array.copy(second_values).last()
copy_nested_get = array.copy(first_values).copy().get(index=1)
copy_includes_first = array.copy(first_values).includes(value=First.new(10.0, 100.0))
copy_includes_second = array.copy(second_values).copy().includes(Second.new(210.0, 21.0))
copy_indexof_first = array.copy(first_values).indexof(value=First.new(10.0, 100.0))
copy_indexof_second = array.copy(second_values).copy().indexof(Second.new(210.0, 21.0))
copy_lastindexof_first = array.copy(first_values).lastindexof(value=First.new(10.0, 100.0))
copy_lastindexof_second = array.copy(second_values).copy().lastindexof(Second.new(210.0, 21.0))
from_get = array.from(First.new(30.0, 300.0), First.new(31.0, 310.0)).get(index=1)
from_includes = array.from(First.new(30.0, 300.0), First.new(31.0, 310.0)).includes(First.new(31.0, 310.0))
from_indexof = array.from(First.new(30.0, 300.0), First.new(31.0, 310.0)).indexof(First.new(31.0, 310.0))
from_lastindexof = array.from(First.new(30.0, 300.0), First.new(31.0, 310.0), First.new(30.0, 300.0)).lastindexof(First.new(30.0, 300.0))
new_first = array.new<First>(1, First.new(32.0, 320.0)).first()
new_includes = array.new<First>(1, First.new(32.0, 320.0)).includes(First.new(32.0, 320.0))
new_indexof = array.new<First>(1, First.new(32.0, 320.0)).indexof(First.new(32.0, 320.0))
new_lastindexof = array.new<First>(2, First.new(32.0, 320.0)).lastindexof(First.new(32.0, 320.0))
new_second = array.new<Second>(2, Second.new(330.0, 33.0)).last()
new_first_again = array.new<First>(1, First.new(34.0, 340.0)).copy().last()

slice_source = array.from(1, 2, 3)
slice_direct_get = array.slice(id=slice_source, index_from=1, index_to=3).get(index=0)
slice_includes = array.slice(id=slice_source, index_from=1, index_to=3).includes(3)
slice_indexof = array.slice(id=slice_source, index_from=1, index_to=3).indexof(3)
slice_lastindexof = array.slice(id=slice_source, index_from=1, index_to=3).lastindexof(3)
array<int> slice_copy = array.slice(slice_source, 1, 3).copy()
concat_left = array.from(40)
concat_right = array.from(41, 42)
concat_get = array.concat(id=concat_left, id2=concat_right).get(index=2)
concat_includes = array.concat(id=concat_left, id2=concat_right).includes(41)
concat_indexof = array.concat(id=concat_left, id2=concat_right).indexof(41)
concat_lastindexof = array.concat(id=array.from(41), id2=array.from(42, 41)).lastindexof(41)

abs_int_last = array.abs(array.from(-4, 2, -3)).last()
abs_float_first = array.abs(array.from(-1.5, 2.5)).first()
standardized_int_size = array.standardize(array.from(1, 2, 3)).size()
standardized_float_size = array.standardize(array.from(1.0, 2.0)).copy().size()
sort_indices_first = array.sort_indices(id=array.from(3, 1, 2), order=order.ascending).first()
sort_indices_last = array.sort_indices(array.from(3, 1, 2)).last()
abs_includes = array.abs(array.from(-4, 2, -3)).includes(4)
standardized_includes = array.standardize(array.from(1, 2, 3)).includes(0.0)
sort_indices_includes = array.sort_indices(array.from(3, 1, 2)).includes(2)
abs_indexof = array.abs(array.from(-4, 2, -3)).indexof(4)
standardized_indexof = array.standardize(array.from(1, 2, 3)).indexof(0.0)
sort_indices_indexof = array.sort_indices(array.from(3, 1, 2)).indexof(2)
abs_lastindexof = array.abs(array.from(-4, 2, -4)).lastindexof(4)
standardized_lastindexof = array.standardize(array.from(1, 2, 3)).lastindexof(0.0)
sort_indices_lastindexof = array.sort_indices(array.from(3, 1, 2)).lastindexof(2)
udt_sort_values = array.from(First.new(3.0, 30.0), First.new(1.0, 10.0), First.new(2.0, 20.0))
udt_sort_middle = array.sort_indices(udt_sort_values, order.ascending, "shared").get(index=1)

new_int_last = array.new<int>(size=2, initial_value=7).last()
new_int_direct_get = array.new_int(2, 8).get(0)
chart_point_first = array.new<chart.point>(1, chart.point.now(close)).first()
point_value = chart.point.now(close)
chart_point_includes = array.new<chart.point>(1, point_value).includes(point_value)
chart_point_indexof = array.new<chart.point>(1, point_value).indexof(point_value)
chart_point_lastindexof = array.new<chart.point>(2, point_value).lastindexof(point_value)
empty_size = array.new<First>().size()
empty_includes = array.new<First>().includes(First.new(0.0, 0.0))
empty_indexof = array.new<First>().indexof(First.new(0.0, 0.0))
empty_lastindexof = array.new<First>().lastindexof(First.new(0.0, 0.0))
empty_last = array.new<First>().last()
none_size = array.copy(noneFirst()).size()
empty_standardized_size = array.standardize(array.new<int>()).size()
empty_sort_first = array.sort_indices(array.new<int>()).first()

wrapped_int = readArray(array.from(4, 5))
wrapped_float = readArray(array.from(6.0, 7.0))
wrapped_int_again = readArray(array.from(8, 9))
wrapped_first = readShared(first_values)
wrapped_second = readShared(second_values)
wrapped_first_again = readShared(first_values)
anchor = Anchor.new(1)
method_read = anchor.readArray(array.from(10, 11))

plot(constructor_sizes + copy_size_first + copy_get_second.shared + copy_first_again.shared + copy_last_second.shared + copy_nested_get.shared + from_get.shared + new_first.shared + new_second.shared + new_first_again.shared + slice_direct_get + concat_get + abs_int_last + abs_float_first + standardized_int_size + standardized_float_size + sort_indices_first + sort_indices_last + udt_sort_middle + new_int_last + new_int_direct_get + chart_point_first.price + empty_size + (na(empty_last) ? 1 : 0) + (na(none_size) ? 1 : 0) + empty_standardized_size + (na(empty_sort_first) ? 1 : 0) + wrapped_int + wrapped_float + wrapped_int_again + wrapped_first + wrapped_second + wrapped_first_again + method_read + slice_copy.size() + constructor_indexof + copy_indexof_first + copy_indexof_second + from_indexof + new_indexof + slice_indexof + concat_indexof + abs_indexof + standardized_indexof + sort_indices_indexof + chart_point_indexof + empty_indexof + constructor_lastindexof + copy_lastindexof_first + copy_lastindexof_second + from_lastindexof + new_lastindexof + slice_lastindexof + concat_lastindexof + abs_lastindexof + standardized_lastindexof + sort_indices_lastindexof + chart_point_lastindexof + empty_lastindexof + (constructor_includes and object_na_includes and object_na_indexof and object_na_lastindexof and copy_includes_first and copy_includes_second and from_includes and new_includes and slice_includes and concat_includes and abs_includes and standardized_includes and sort_indices_includes and chart_point_includes and not empty_includes ? 1 : 0))
