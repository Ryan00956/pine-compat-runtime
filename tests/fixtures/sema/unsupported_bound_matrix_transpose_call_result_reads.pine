//@version=6
indicator("Unsupported bound matrix.transpose call-result reads")

values = matrix.new<float>(2, 2, 1.0)
array_values = array.from(1.0, 2.0)

bad_row = values.transpose().get("bad", 0)
bad_column = values.transpose().get(0, "bad")
set_result = values.transpose().set(0, 0, 2.0)
reverse_result = values.transpose().reverse()
size_result = values.transpose().size()
wrong_receiver = array_values.transpose().rows()

plot(close)
