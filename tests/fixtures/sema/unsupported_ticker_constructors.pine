//@version=6
indicator("Unsupported ticker constructors")
over_adjusted = ticker.new(syminfo.prefix, syminfo.ticker, session.extended, adjustment.dividends, settlement_as_close.on, backadjustment.inherit, "extra")
modified_over_adjusted = ticker.modify(syminfo.tickerid, session.extended, adjustment.dividends, settlement_as_close.on, backadjustment.inherit, "extra")
over_inherit = ticker.inherit(syminfo.tickerid, "NYSE:PFE", "extra")
over_renko = ticker.renko(syminfo.tickerid, "ATR", 10, "extra")
over_linebreak = ticker.linebreak(syminfo.tickerid, 3, "extra")
over_kagi = ticker.kagi(syminfo.tickerid, "ATR", 10, "extra")
over_pointfigure = ticker.pointfigure(syminfo.tickerid, "hl", "ATR", 14, 3, "extra")
plot(na(over_adjusted) and na(modified_over_adjusted) and na(over_inherit) and na(over_renko) and na(over_linebreak) and na(over_kagi) and na(over_pointfigure) ? 1 : 0)
