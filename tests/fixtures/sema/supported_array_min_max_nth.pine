//@version=6
indicator("Supported array.min/max nth")

ints = array.from(1, 2, 2, 4)
floats = array.from(1.0, 2.0, 2.0, 4.0)
dynamic_nth = bar_index % 4

plot(array.min(nth=dynamic_nth, id=ints))
plot(array.max(id=floats, nth=dynamic_nth))
plot(ints.min(nth=dynamic_nth))
plot(floats.max(dynamic_nth))
