//@version=6
indicator("Supported local UDF matrix call-result reads")

identity(values) => values

blockIdentity(values) =>
    alias = values
    alias

nestedIdentity(values) => identity(values)

pick(first, second, bool choose) => choose ? first : second

matrixFactory(left, right) => matrix.mult(left, right)

makeInt(int value) => matrix.new<int>(1, 1, value)

floats = matrix.new<float>(2, 3, 1.0)
other_floats = matrix.new<float>(2, 3, 2.0)
right = matrix.new<float>(3, 2, 2.0)
ints = matrix.new<int>(1, 1, 3)
bools = matrix.new<bool>(1, 1, true)
strings = matrix.new<string>(1, 1, "pine")
colors = matrix.new<color>(1, 1, color.red)

int direct_rows = identity(floats).rows()
int direct_columns = identity(floats).columns()
int direct_elements = identity(floats).elements_count()
float direct_get = identity(floats).get(row=0, column=0)
matrix<float> float_copy = identity(floats).copy().copy()
int int_get = identity(ints).get(0, 0)
bool bool_get = identity(bools).get(0, 0)
string string_get = identity(strings).get(0, 0)
color color_get = identity(colors).get(0, 0)
float block_get = blockIdentity(floats).get(1, 2)
float nested_get = nestedIdentity(floats).copy().get(0, 1)
float selected_get = pick(second=other_floats, first=floats, choose=true).get(0, 0)
float multiplied_get = matrixFactory(floats, right).get(0, 0)
matrix<int> constructed_copy = makeInt(7).copy()
array<float> float_row = identity(floats).row(1).copy()
array<int> int_row = identity(ints).row(0)
array<bool> bool_row = identity(bools).row(0)
array<string> string_row = identity(strings).row(0)
array<color> color_row = identity(colors).row(0)
array<float> float_col = identity(floats).col(1).copy()
array<int> int_col = identity(ints).col(0)
array<bool> bool_col = identity(bools).col(0)
array<string> string_col = identity(strings).col(0)
array<color> color_col = identity(colors).col(0)
array<float> float_eigenvalues = identity(matrix.new<float>(2, 2, 1.0)).eigenvalues().copy()
array<float> int_eigenvalues = identity(matrix.new<int>(2, 2, 1)).eigenvalues()
bool float_is_square = identity(floats).is_square()
bool bool_is_square = identity(bools).is_square()
bool float_is_zero = identity(floats).is_zero()
bool int_is_zero = identity(ints).is_zero()

plot(direct_rows + direct_columns + direct_elements + direct_get + float_copy.get(0, 0) + int_get + (bool_get ? 1 : 0) + (string_get == "pine" ? 1 : 0) + (color_get == color.red ? 1 : 0) + block_get + nested_get + selected_get + multiplied_get + constructed_copy.get(0, 0) + float_row.size() + int_row.size() + bool_row.size() + string_row.size() + color_row.size() + float_col.size() + int_col.size() + bool_col.size() + string_col.size() + color_col.size() + float_eigenvalues.size() + int_eigenvalues.size() + (float_is_square ? 1 : 0) + (bool_is_square ? 1 : 0) + (float_is_zero ? 1 : 0) + (int_is_zero ? 1 : 0))
