//@version=6
indicator("Supported bound matrix.eigenvectors call-result reads")

eigenvectorRows(values) => values.eigenvectors().copy().rows()

values = matrix.new<float>(2, 2, 0.0)
values.set(0, 0, 2.0)
values.set(1, 1, 3.0)
ints = matrix.new<int>(2, 2, 0)
ints.set(0, 0, 2)
ints.set(1, 1, 3)

int direct_rows = values.eigenvectors().rows()
int direct_columns = values.eigenvectors().columns()
int direct_elements = values.eigenvectors().elements_count()
float direct_get = values.eigenvectors().get(row=0, column=0)
matrix<float> nested_copy = values.eigenvectors().copy()
float int_get = ints.eigenvectors().get(1, 1)

plot(direct_rows + direct_columns + direct_elements + direct_get + nested_copy.get(1, 1) + int_get + eigenvectorRows(values))
