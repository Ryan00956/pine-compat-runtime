//@version=6
indicator("Supported bound matrix.eigenvectors call-result reads")

eigenvectorRows(values) => values.eigenvectors().copy().rows()

values = matrix.new<float>(2, 2, 0.0)
values.set(0, 0, 2.0)
values.set(1, 1, 3.0)
ints = matrix.new<int>(2, 2, 0)
ints.set(0, 0, 2)
ints.set(1, 1, 3)

int direct_rows = values.eigenvectors().rows()
int direct_columns = values.eigenvectors().columns()
int direct_elements = values.eigenvectors().elements_count()
float direct_get = values.eigenvectors().get(row=0, column=0)
matrix<float> nested_copy = values.eigenvectors().copy()
float int_get = ints.eigenvectors().get(1, 1)
array<float> direct_row = values.eigenvectors().row(1).copy()
array<float> direct_col = values.eigenvectors().col(1).copy()
array<float> direct_eigenvalues = values.eigenvectors().eigenvalues().copy()
bool direct_is_square = values.eigenvectors().is_square()
bool direct_is_zero = values.eigenvectors().is_zero()
bool direct_is_binary = values.eigenvectors().is_binary()

plot(direct_rows + direct_columns + direct_elements + direct_get + nested_copy.get(1, 1) + int_get + direct_row.size() + direct_col.size() + direct_eigenvalues.size() + (direct_is_square ? 1 : 0) + (direct_is_zero ? 1 : 0) + (direct_is_binary ? 1 : 0) + eigenvectorRows(values))
