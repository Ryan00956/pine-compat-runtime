//@version=6
indicator("Supported matrix is_diagonal")

values = matrix.new<float>(2, 2, 0)
plot(matrix.is_diagonal(values) ? 1 : 0)
plot(values.is_diagonal() ? 1 : 0)
plot(matrix.is_antidiagonal(values) ? 1 : 0)
plot(values.is_antidiagonal() ? 1 : 0)
plot(matrix.is_triangular(values) ? 1 : 0)
plot(values.is_triangular() ? 1 : 0)
