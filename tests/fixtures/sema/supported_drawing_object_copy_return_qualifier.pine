//@version=6
indicator("Supported drawing object copy return qualifier")

label_id = label.new(bar_index, high, "label")
line_id = line.new(bar_index, low, bar_index + 1, high)
box_id = box.new(bar_index, high, bar_index + 1, low)
second_line = line.new(bar_index + 2, low, bar_index + 3, high)
fill_id = linefill.new(line_id, second_line, color.green)

copied_label = label.copy(label_id)
copied_line = line.copy(line_id)
copied_box = box.copy(box_id)
first_line = linefill.get_line1(fill_id)
returned_second_line = linefill.get_line2(fill_id)
first_line_method = fill_id.get_line1()
returned_second_line_method = fill_id.get_line2()

label.set_text(copied_label, "copy")
line.set_x1(copied_line, bar_index)
box.set_text(copied_box, "copy")
line.set_x1(first_line, bar_index + 1)
line.set_x2(returned_second_line, bar_index + 4)
line.set_x1(first_line_method, bar_index + 2)
line.set_x2(returned_second_line_method, bar_index + 5)
