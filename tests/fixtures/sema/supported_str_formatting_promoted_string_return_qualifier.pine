//@version=6
indicator("Supported str formatting promoted string return qualifier")

value = input.float(1.25, "Value")
format_text = input.string("#.00", "Format")
timestamp_value = input.int(1704067200000, "Timestamp")
time_format = input.string("yyyy-MM-dd", "Time format")
timezone_value = input.string("UTC", "Timezone")

tostring_text = str.tostring(value, format_text)
format_result = str.format("{0,number,#.00}", value)
time_text = str.format_time(timestamp_value, time_format, timezone_value)

tostring_length = str.length(tostring_text)
format_length = str.length(format_result)
time_length = str.length(time_text)

plot(close, show_last=tostring_length)
plot(open, show_last=format_length)
plot(high, show_last=time_length)
