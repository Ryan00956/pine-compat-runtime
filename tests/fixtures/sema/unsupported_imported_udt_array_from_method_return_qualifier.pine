//@version=6
import user/udt/1 as lib
indicator("Unsupported imported UDT array.from method return qualifier")

type Point
    float x

anchor = lib.Point.new(close)
local_points = array.from(Point.new(close), Point.new(open))
first = anchor.firstFrom(local_points)
second = lib.secondFrom(anchor, array.from(Point.new(high), Point.new(low)))

plot(first.x + second.x)
