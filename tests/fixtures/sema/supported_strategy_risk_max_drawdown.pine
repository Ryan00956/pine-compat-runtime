//@version=5
strategy("Supported strategy risk max_drawdown")
limit = 50
kind = strategy.percent_of_equity
strategy.risk.max_drawdown(50, strategy.percent_of_equity)
strategy.risk.max_drawdown(limit, kind)
strategy.risk.max_drawdown(2000, strategy.cash)
if bar_index == 0
    strategy.entry("L", strategy.long, qty=1)
