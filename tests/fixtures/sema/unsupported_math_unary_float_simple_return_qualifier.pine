//@version=6
indicator("Unsupported math unary float simple return qualifier")

values = array.new_int(1, 4)
positive = array.size(values) + 3.0
angle = array.size(values) / 4.0

sqrt_value = math.sqrt(positive)
cbrt_value = math.cbrt(positive)
log_value = math.log(positive)
log10_value = math.log10(positive)
exp_value = math.exp(angle)
acos_value = math.acos(angle)
asin_value = math.asin(angle)
atan_value = math.atan(angle)
sign_value = math.sign(angle)
sin_value = math.sin(angle)
cos_value = math.cos(angle)
tan_value = math.tan(angle)
degrees_value = math.todegrees(angle)
radians_value = math.toradians(angle)
mintick_value = math.round_to_mintick(positive)

hline(sqrt_value)
hline(cbrt_value)
hline(log_value)
hline(log10_value)
hline(exp_value)
hline(acos_value)
hline(asin_value)
hline(atan_value)
hline(sign_value)
hline(sin_value)
hline(cos_value)
hline(tan_value)
hline(degrees_value)
hline(radians_value)
hline(mintick_value)
