//@version=6
indicator("Supported matrix mult")

left = matrix.new<float>(2, 3, close)
right = matrix.new<float>(3, 2, open)
namespace_result = matrix.mult(left, right)
method_result = left.mult(right)
scalar_result = matrix.mult(left, close)
left_scalar_result = matrix.mult(close, left)
scalar_method_result = left.mult(2)
array_result = matrix.mult(left, array.from(close, open, high))
array_left_result = matrix.mult(array.from(close, open), right)
array_method_result = left.mult(array.from(1, 2, 3))
plot(matrix.get(namespace_result, 0, 0))
plot(matrix.get(method_result, 0, 0))
plot(matrix.get(scalar_result, 0, 0))
plot(matrix.get(left_scalar_result, 0, 0))
plot(matrix.get(scalar_method_result, 0, 0))
plot(array.get(array_result, 0))
plot(array.get(array_left_result, 0))
plot(array.get(array_method_result, 0))
