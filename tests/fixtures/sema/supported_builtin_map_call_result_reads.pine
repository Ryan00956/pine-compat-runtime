//@version=6
indicator("Supported builtin map call-result reads")

mapNewExpressionSize() => map.new<string, float>().copy().size()

mapNewBlockReads() =>
    int size = map.new<string, float>().size()
    bool contains = map.new<string, float>().contains("missing")
    float missing = map.new<string, float>().get("missing")
    size + (contains ? 10 : 0) + (na(missing) ? 100 : 0)

int direct_size = map.new<string, float>().size()
float direct_missing = map.new<string, float>().get(key="missing")
bool direct_contains = map.new<string, float>().contains(key="missing")
map<string, float> direct_copy = map.new<string, float>().copy().copy()
array<string> direct_keys = map.new<string, float>().keys()
int direct_keys_size = map.new<string, float>().keys().copy().size()
array<float> direct_values = map.new<string, float>().values()
int direct_values_size = map.new<string, float>().values().copy().size()

bool int_key = map.new<int, float>().contains(1)
bool float_key = map.new<float, bool>().contains(1.5)
bool bool_key = map.new<bool, string>().contains(true)
bool string_key = map.new<string, color>().contains("key")
bool color_key = map.new<color, int>().contains(color.red)

map<int, float> int_float_copy = map.new<int, float>().copy()
map<float, bool> float_bool_copy = map.new<float, bool>().copy()
map<bool, string> bool_string_copy = map.new<bool, string>().copy()
map<string, color> string_color_copy = map.new<string, color>().copy()
map<color, int> color_int_copy = map.new<color, int>().copy()
array<int> int_keys = map.new<int, float>().keys()
array<float> float_keys = map.new<float, bool>().keys()
array<bool> bool_keys = map.new<bool, string>().keys()
array<string> string_keys = map.new<string, color>().keys()
array<color> color_keys = map.new<color, int>().keys()
array<float> float_values = map.new<int, float>().values()
array<bool> bool_values = map.new<float, bool>().values()
array<string> string_values = map.new<bool, string>().values()
array<color> color_values = map.new<string, color>().values()
array<int> int_values = map.new<color, int>().values()

map.new<int, float>().put(1, 1.5)
map.new<float, bool>().put(1.5, true)
map.new<bool, string>().put(true, "value")
map.new<string, color>().put(key="key", value=color.red)
map.new<color, int>().put(color.blue, 2)

int expression_udf = mapNewExpressionSize()
float block_udf = mapNewBlockReads()

plot(direct_size + (na(direct_missing) ? 1 : 0) + (direct_contains ? 1 : 0) + direct_copy.size() + direct_keys.size() + direct_keys_size + direct_values.size() + direct_values_size + (int_key ? 1 : 0) + (float_key ? 1 : 0) + (bool_key ? 1 : 0) + (string_key ? 1 : 0) + (color_key ? 1 : 0) + int_float_copy.size() + float_bool_copy.size() + bool_string_copy.size() + string_color_copy.size() + color_int_copy.size() + int_keys.size() + float_keys.size() + bool_keys.size() + string_keys.size() + color_keys.size() + float_values.size() + bool_values.size() + string_values.size() + color_values.size() + int_values.size() + expression_udf + block_udf)
map.new<string, float>().keys().push("extra")
map.new<string, float>().values().push(1.0)
map.new<string, float>().keys().unshift("first")
map.new<string, float>().values().unshift(0.0)
map.new<string, float>().keys().insert(0, "first")
map.new<string, float>().values().insert(0, 0.0)
map.new<string, float>().keys().set(na, "first")
map.new<string, float>().values().set(na, 0.0)
map.new<string, float>().keys().fill("first")
map.new<string, float>().values().fill(0.0, 0, 0)
map.new<string, float>().keys().sort(order.ascending)
map.new<string, float>().values().sort(order.descending)
