//@version=6
indicator("Supported matrix.mult return qualifier")

left = matrix.new<float>(2, 3, close)
right = matrix.new<float>(3, 2, open)
int_left = matrix.new<int>(2, 3, 1)
int_right = matrix.new<int>(3, 2, 2)
float_rows = matrix.new<float>(1, 2, 0.0)

matrix.fill(matrix.mult(left, right), 1.0)
matrix.fill(left.mult(right), 1.0)
matrix.fill(matrix.mult(left, close), 1.0)
matrix.fill(matrix.mult(close, left), 1.0)
matrix.fill(left.mult(2), 1.0)
matrix.fill(matrix.mult(int_left, int_right), 1.0)
matrix.fill(int_left.mult(int_right), 1.0)
matrix.fill(matrix.mult(int_left, 2), 1.0)
matrix.fill(matrix.mult(2, int_left), 1.0)
matrix.fill(int_left.mult(2), 1.0)
matrix.add_row(float_rows, 0, matrix.mult(left, array.from(close, open, high)))
matrix.add_row(float_rows, 0, matrix.mult(array.from(close, open), right))
matrix.add_row(float_rows, 0, left.mult(array.from(1, 2, 3)))
matrix.add_row(float_rows, 0, matrix.mult(int_left, array.from(1, 2, 3)))
matrix.add_row(float_rows, 0, matrix.mult(array.from(1, 2), int_right))
matrix.add_row(float_rows, 0, int_left.mult(array.from(1, 2, 3)))
matrix.add_row(matrix.new<float>(1, 1, 0.0), 0, matrix.mult(array.from(close, open), array.from(high, low)))
matrix.add_row(matrix.new<float>(1, 1, 0.0), 0, matrix.mult(array.from(1, 2), array.from(3, 4)))
