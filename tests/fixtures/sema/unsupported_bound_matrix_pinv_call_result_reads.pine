//@version=6
indicator("Unsupported bound matrix.pinv call-result reads")

values = matrix.new<float>(2, 3, 1.0)
bools = matrix.new<bool>(2, 2, true)
array_values = array.from(1.0, 2.0)

bad_row = values.pinv().get("bad", 0)
values.pinv().set(0, 0, "bad")
size_result = values.pinv().size()
bad_receiver_kind = bools.pinv().rows()
wrong_receiver = array_values.pinv().rows()

plot(close)
