//@version=6
indicator("Supported max_bars_back block result call")
src = close
plot(switch
    close > open =>
        base = 5
        length = base + 5
        switch
            bar_index >= 0 =>
                max_bars_back(src, length)
                src[bar_index]
            => src[bar_index]
    => src[bar_index]
)
