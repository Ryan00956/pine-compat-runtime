//@version=6
indicator("Supported bound matrix.diff call-result reads")

diffRows(left, right) => left.diff(right).copy().rows()

left = matrix.new<float>(2, 2, 5.0)
right = matrix.new<float>(2, 2, 2.0)
int_left = matrix.new<int>(1, 1, 7)
int_right = matrix.new<int>(1, 1, 2)

int direct_rows = left.diff(right).rows()
int direct_columns = left.diff(right).columns()
int direct_elements = left.diff(right).elements_count()
float direct_get = left.diff(right).get(row=1, column=1)
float scalar_get = left.diff(1.5).get(0, 0)
matrix<float> nested_copy = left.diff(right).copy()
float int_get = int_left.diff(int_right).get(0, 0)
array<float> direct_row = left.diff(right).row(1).copy()
array<float> direct_col = left.diff(right).col(1).copy()
array<float> direct_eigenvalues = left.diff(right).eigenvalues().copy()
bool direct_is_square = left.diff(right).is_square()
bool direct_is_zero = left.diff(right).is_zero()
bool direct_is_binary = left.diff(right).is_binary()
bool direct_is_diagonal = left.diff(right).is_diagonal()
bool direct_is_identity = left.diff(right).is_identity()
bool direct_is_symmetric = left.diff(right).is_symmetric()
bool direct_is_antisymmetric = left.diff(right).is_antisymmetric()
bool direct_is_stochastic = left.diff(right).is_stochastic()
float direct_sum = left.diff(right).sum()
float direct_avg = left.diff(right).avg()
float direct_min = left.diff(right).min()
float direct_max = left.diff(right).max()
float direct_mode = left.diff(right).mode()
float direct_trace = left.diff(right).trace()
float direct_det = left.diff(right).det()
int direct_rank = left.diff(right).rank()
int transposed_columns = left.diff(right).transpose().columns()
int sliced_rows = left.diff(right).submatrix().rows()
int inverted_rows = left.diff(right).inv().rows()
int pseudo_rows = left.diff(right).pinv().rows()

plot(direct_rows + direct_columns + direct_elements + direct_get + scalar_get + nested_copy.get(0, 0) + int_get + direct_row.size() + direct_col.size() + direct_eigenvalues.size() + (direct_is_square ? 1 : 0) + (direct_is_zero ? 1 : 0) + (direct_is_binary ? 1 : 0) + (direct_is_diagonal ? 1 : 0) + (direct_is_identity ? 1 : 0) + (direct_is_symmetric ? 1 : 0) + (direct_is_antisymmetric ? 1 : 0) + (direct_is_stochastic ? 1 : 0) + direct_sum + direct_avg + direct_min + direct_max + direct_mode + direct_trace + direct_det + direct_rank + transposed_columns + diffRows(left, right))
plot(sliced_rows)
plot(inverted_rows)
plot(pseudo_rows)
