//@version=6
indicator("Unsupported UDT array.from method return qualifier")

type Point
    float x

type Other
    float x

method first_x(Point anchor, array<Point> values) =>
    point = array.get(values, 0)
    anchor.x + point.x

anchor = Point.new(close)
others = array.from(Other.new(close))
plot(anchor.first_x(others))
plot(anchor.first_x(array.from(Other.new(open))))
