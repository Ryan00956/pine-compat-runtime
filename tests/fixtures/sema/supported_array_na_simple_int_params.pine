//@version=5
indicator("Supported array na simple int params")
values = array.from(1, 2, 3)
maybe_values = array.new_int(na)
float_values = array.new_float(na)
bool_values = array.new_bool(na)
string_values = array.new_string(na)
color_values = array.new_color(na)
plot(na(maybe_values) ? 1 : 0)
plot(na(float_values) and na(bool_values) and na(string_values) and na(color_values) ? 1 : 0)
plot(array.get(values, na))
array.set(values, na, 9)
array.insert(values, na, 8)
plot(array.remove(values, na))
array.fill(values, 7, na, 2)
array.fill(values, 7, 0, na)
window = array.slice(values, na, 2)
plot(na(window) ? 1 : 0)
plot(array.percentrank(values, na))
plot(values.get(na))
values.set(na, 9)
values.insert(na, 8)
plot(values.remove(na))
values.fill(7, na, 2)
values.fill(7, 0, na)
method_window = values.slice(na, 2)
plot(na(method_window) ? 1 : 0)
plot(values.percentrank(na))
