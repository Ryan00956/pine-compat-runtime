//@version=6
import user/udt/1 as left
import user/udt/1 as right
indicator("Supported imported function matrix call-result reads")

rows = left.exposeMatrixFunction().rows()
columns = left.exposeMatrixFunction().columns()
elements = left.exposeMatrixFunction().elements_count()
get = left.exposeMatrixFunction().get(0, 1)
copy_chain = left.exposeMatrixFunction().copy().get(1, 1)
int_get = left.exposeIntMatrixFunction().get(0, 1)
bool_get = left.exposeBoolMatrixFunction().get(0, 0)
string_get = left.exposeStringMatrixFunction().get(0, 0)
color_get = left.exposeColorMatrixFunction().get(0, 0)
empty = left.exposeEmptyMatrixFunction().columns()
block_return = left.exposeMatrixFunctionBlock().get(1, 1)
nested_return = left.exposeMatrixFunctionNested().get(1, 0)
control_flow = left.exposeMatrixFunctionIf(other=true).get(0, 0)
dual_alias = right.exposeMatrixFunction().get(0, 0)
nested_copy = left.exposeMatrixFunction().copy().copy().get(0, 1)
float_row = left.exposeMatrixFunction().row(1).copy()
int_row = left.exposeIntMatrixFunction().row(0)
dual_alias_row = right.exposeMatrixFunction().row(0).size()
float_col = left.exposeMatrixFunction().col(1).copy()
int_col = left.exposeIntMatrixFunction().col(1)
dual_alias_col = right.exposeMatrixFunction().col(0).size()
float_eigenvalues = left.exposeMatrixFunction().eigenvalues().copy()
dual_alias_eigenvalues = right.exposeMatrixFunction().eigenvalues().size()
float_is_square = left.exposeMatrixFunction().is_square()
color_is_square = left.exposeColorMatrixFunction().is_square()
float_is_zero = left.exposeMatrixFunction().is_zero()
int_is_zero = right.exposeIntMatrixFunction().is_zero()
float_is_binary = left.exposeMatrixFunction().is_binary()
int_is_binary = right.exposeIntMatrixFunction().is_binary()
float_is_diagonal = left.exposeMatrixFunction().is_diagonal()
int_is_diagonal = right.exposeIntMatrixFunction().is_diagonal()
float_is_identity = left.exposeMatrixFunction().is_identity()
int_is_identity = right.exposeIntMatrixFunction().is_identity()
float_is_symmetric = left.exposeMatrixFunction().is_symmetric()
int_is_symmetric = right.exposeIntMatrixFunction().is_symmetric()

plot(rows + columns + elements + get + copy_chain + int_get + empty + block_return + nested_return + control_flow + dual_alias + nested_copy + float_row.size() + int_row.size() + dual_alias_row + float_col.size() + int_col.size() + dual_alias_col + float_eigenvalues.size() + dual_alias_eigenvalues + (float_is_square ? 1 : 0) + (color_is_square ? 1 : 0) + (float_is_zero ? 1 : 0) + (int_is_zero ? 1 : 0) + (float_is_binary ? 1 : 0) + (int_is_binary ? 1 : 0) + (float_is_diagonal ? 1 : 0) + (int_is_diagonal ? 1 : 0) + (float_is_identity ? 1 : 0) + (int_is_identity ? 1 : 0) + (float_is_symmetric ? 1 : 0) + (int_is_symmetric ? 1 : 0))
