//@version=6
indicator("Unsupported matrix SameAsArg return qualifier")

int_matrix = matrix.new<int>(2, 2, 1)
float_matrix = matrix.new<float>(2, 2, 1.0)
bool_matrix = matrix.new<bool>(2, 2, false)
string_matrix = matrix.new<string>(2, 2, "")
color_matrix = matrix.new<color>(2, 2, color.red)

matrix.fill(matrix.copy(int_matrix), 2.5)
matrix.fill(float_matrix.copy(), "bad")
matrix.fill(matrix.copy(bool_matrix), 1)
matrix.fill(string_matrix.copy(), 1)
matrix.fill(color_matrix.copy(), 1)
matrix.fill(matrix.transpose(int_matrix), 3.5)
matrix.fill(float_matrix.transpose(), "bad")
matrix.fill(matrix.transpose(bool_matrix), 1)
matrix.fill(string_matrix.transpose(), 1)
matrix.fill(color_matrix.transpose(), 1)
matrix.fill(matrix.submatrix(int_matrix, 0, 1, 0, 1), 4.5)
matrix.fill(float_matrix.submatrix(0, 1, 0, 1), "bad")
matrix.fill(matrix.submatrix(bool_matrix, 0, 1, 0, 1), 1)
matrix.fill(string_matrix.submatrix(0, 1, 0, 1), 1)
matrix.fill(color_matrix.submatrix(0, 1, 0, 1), 1)
matrix.fill(matrix.concat(int_matrix, int_matrix), 5.5)
matrix.fill(float_matrix.concat(float_matrix), "bad")
matrix.fill(matrix.concat(bool_matrix, bool_matrix), 1)
matrix.fill(string_matrix.concat(string_matrix), 1)
matrix.fill(color_matrix.concat(color_matrix), 1)
