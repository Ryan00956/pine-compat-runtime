//@version=6
indicator("Supported promoted return qualifiers for input params")
numeric_seed = input.float(1.5, "Numeric")
text_seed = input.string("ABCDE", "Text")
promoted_numeric = math.max(numeric_seed, 1)
promoted_min = math.min(numeric_seed, 1)
promoted_float = math.avg(numeric_seed, 1)
promoted_pow = math.pow(numeric_seed, 2)
promoted_hypot = math.hypot(numeric_seed, 1)
promoted_int = str.pos(text_seed, "C")
hline(promoted_numeric)
hline(promoted_min)
hline(promoted_float)
hline(promoted_pow)
hline(promoted_hypot)
plot(close, show_last=promoted_int)
