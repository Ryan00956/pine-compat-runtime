//@version=6
indicator("Supported builtin namespace matrix call-result reads")

matrixMultMatrixExpressionRead(left, right) => matrix.mult(left, right).copy().get(1, 1)

matrixCopyExpressionRead(values) => matrix.copy(values).copy().get(1, 0)

matrixTransposeExpressionRead(values) => matrix.transpose(values).copy().get(2, 1)

matrixSubmatrixExpressionRead(values) => matrix.submatrix(values, 0, 2, 1, 3).copy().get(1, 1)

matrixKronExpressionRead(left, right) => matrix.kron(left, right).copy().get(5, 5)

matrixDiffExpressionRead(left, right) => matrix.diff(left, right).copy().get(1, 2)

matrixPowExpressionRead(values) => matrix.pow(values, 2).copy().get(1, 1)

matrixInvExpressionRead(values) => matrix.inv(values).copy().get(0, 1)

matrixPinvExpressionRead(values) => matrix.pinv(values).copy().get(1, 1)

matrixMultMatrixBlockRead(values, scalar) =>
    int rows = matrix.mult(values, scalar).rows()
    int columns = matrix.mult(scalar, values).columns()
    float first = matrix.mult(values, scalar).copy().get(0, 0)
    rows * 100 + columns * 10 + first

matrixCopyBlockRead(values) =>
    int rows = matrix.copy(values).rows()
    int columns = matrix.copy(values).columns()
    float first = matrix.copy(values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixTransposeBlockRead(values) =>
    int rows = matrix.transpose(values).rows()
    int columns = matrix.transpose(values).columns()
    float first = matrix.transpose(values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixSubmatrixBlockRead(values) =>
    int rows = matrix.submatrix(values).rows()
    int columns = matrix.submatrix(values).columns()
    float first = matrix.submatrix(values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixKronBlockRead(left, right) =>
    int rows = matrix.kron(left, right).rows()
    int columns = matrix.kron(left, right).columns()
    float first = matrix.kron(left, right).get(0, 0)
    rows * 100 + columns * 10 + first

matrixDiffBlockRead(values, scalar) =>
    int rows = matrix.diff(values, scalar).rows()
    int columns = matrix.diff(scalar, values).columns()
    float first = matrix.diff(scalar, values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixPowBlockRead(values) =>
    int rows = matrix.pow(values, 2).rows()
    int columns = matrix.pow(values, 2).columns()
    float first = matrix.pow(values, 2).get(0, 0)
    rows * 100 + columns * 10 + first

matrixInvBlockRead(values) =>
    int rows = matrix.inv(values).rows()
    int columns = matrix.inv(values).columns()
    float first = matrix.inv(values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixPinvBlockRead(values) =>
    int rows = matrix.pinv(values).rows()
    int columns = matrix.pinv(values).columns()
    float first = matrix.pinv(values).get(0, 0)
    rows * 100 + columns * 10 + first

left = matrix.new<float>(2, 3, 1.0)
right = matrix.new<float>(3, 2, 2.0)
diff_right = matrix.new<float>(2, 3, 0.5)
pow_values = matrix.new<float>(2, 2, 1.0)
inv_values = matrix.new<float>(2, 2, 1.0)
pinv_values = matrix.new<float>(2, 3, 1.0)

int matrix_matrix_rows = matrix.mult(left, right).rows()
int matrix_matrix_columns = matrix.mult(left, right).columns()
int matrix_matrix_elements = matrix.mult(left, right).elements_count()
float matrix_matrix_get = matrix.mult(left, right).get(row=0, column=0)
matrix<float> matrix_matrix_copy = matrix.mult(left, right).copy().copy()
float matrix_matrix_copy_get = matrix.mult(left, right).copy().copy().get(1, 1)

int matrix_scalar_rows = matrix.mult(right, 2.0).rows()
int matrix_scalar_columns = matrix.mult(right, 2.0).columns()
int matrix_scalar_elements = matrix.mult(right, 2.0).elements_count()
float matrix_scalar_get = matrix.mult(right, 2.0).get(0, 0)
matrix<float> matrix_scalar_copy = matrix.mult(right, 2.0).copy()
float matrix_scalar_copy_get = matrix.mult(right, 2.0).copy().get(2, 1)

int scalar_matrix_rows = matrix.mult(0.5, right).rows()
int scalar_matrix_columns = matrix.mult(0.5, right).columns()
int scalar_matrix_elements = matrix.mult(0.5, right).elements_count()
float scalar_matrix_get = matrix.mult(0.5, right).get(1, 0)
matrix<float> scalar_matrix_copy = matrix.mult(0.5, right).copy()
float scalar_matrix_copy_get = matrix.mult(0.5, right).copy().get(2, 1)

int matrix_copy_rows = matrix.copy(left).rows()
int matrix_copy_columns = matrix.copy(left).columns()
int matrix_copy_elements = matrix.copy(left).elements_count()
float matrix_copy_named_get = matrix.copy(id=left).get(row=1, column=2)
matrix<float> matrix_copy_nested = matrix.copy(left).copy().copy()
int matrix_transpose_rows = matrix.transpose(left).rows()
int matrix_transpose_columns = matrix.transpose(left).columns()
int matrix_transpose_elements = matrix.transpose(left).elements_count()
float matrix_transpose_named_get = matrix.transpose(id=left).get(row=2, column=1)
matrix<float> matrix_transpose_nested = matrix.transpose(left).copy().copy()
int matrix_submatrix_rows = matrix.submatrix(left, 0, 2, 1, 2).rows()
int matrix_submatrix_columns = matrix.submatrix(left, 0, 2, 1, 2).columns()
int matrix_submatrix_elements = matrix.submatrix(left, 0, 2, 1, 2).elements_count()
float matrix_submatrix_named_get = matrix.submatrix(id=left, from_row=0, to_row=2, from_column=1, to_column=2).get(row=1, column=0)
matrix<float> matrix_submatrix_nested = matrix.submatrix(left).copy().copy()
int matrix_kron_rows = matrix.kron(left, right).rows()
int matrix_kron_columns = matrix.kron(left, right).columns()
int matrix_kron_elements = matrix.kron(left, right).elements_count()
float matrix_kron_named_get = matrix.kron(id1=left, id2=right).get(row=0, column=0)
matrix<float> matrix_kron_nested = matrix.kron(left, right).copy().copy()
int matrix_diff_rows = matrix.diff(left, diff_right).rows()
int matrix_diff_columns = matrix.diff(left, 0.5).columns()
int matrix_diff_elements = matrix.diff(0.5, left).elements_count()
float matrix_diff_named_get = matrix.diff(id1=left, id2=diff_right).get(row=1, column=2)
matrix<float> matrix_diff_nested = matrix.diff(left, diff_right).copy().copy()
float matrix_diff_matrix_scalar_get = matrix.diff(left, 0.5).get(0, 0)
float matrix_diff_scalar_matrix_get = matrix.diff(0.5, left).get(0, 0)
int matrix_pow_rows = matrix.pow(pow_values, 0).rows()
int matrix_pow_columns = matrix.pow(pow_values, 1).columns()
int matrix_pow_elements = matrix.pow(pow_values, 2).elements_count()
float matrix_pow_named_get = matrix.pow(id=pow_values, power=2).get(row=1, column=1)
matrix<float> matrix_pow_nested = matrix.pow(pow_values, 3).copy().copy()
int matrix_inv_rows = matrix.inv(inv_values).rows()
int matrix_inv_columns = matrix.inv(inv_values).columns()
int matrix_inv_elements = matrix.inv(inv_values).elements_count()
float matrix_inv_named_get = matrix.inv(id=inv_values).get(row=0, column=0)
matrix<float> matrix_inv_nested = matrix.inv(inv_values).copy().copy()
int matrix_pinv_rows = matrix.pinv(pinv_values).rows()
int matrix_pinv_columns = matrix.pinv(pinv_values).columns()
int matrix_pinv_elements = matrix.pinv(pinv_values).elements_count()
float matrix_pinv_named_get = matrix.pinv(id=pinv_values).get(row=0, column=0)
matrix<float> matrix_pinv_nested = matrix.pinv(pinv_values).copy().copy()

int_left = matrix.new<int>(2, 2, 1)
int_right = matrix.new<int>(2, 2, 2)
float int_matrix_matrix_get = matrix.mult(int_left, int_right).get(0, 0)
matrix<float> int_matrix_matrix_copy = matrix.mult(int_left, int_right).copy()
float int_matrix_scalar_get = matrix.mult(int_left, 3).get(0, 0)
matrix<float> int_matrix_scalar_copy = matrix.mult(int_left, 3).copy()
float int_scalar_matrix_get = matrix.mult(3, int_left).get(0, 0)
matrix<float> int_scalar_matrix_copy = matrix.mult(3, int_left).copy()
float matrix_kron_int_get = matrix.kron(int_left, int_right).get(0, 0)
matrix<float> matrix_kron_int_copy = matrix.kron(int_left, int_right).copy()
float matrix_diff_int_get = matrix.diff(int_left, int_right).get(0, 0)
matrix<float> matrix_diff_int_copy = matrix.diff(int_left, int_right).copy()
float matrix_pow_int_get = matrix.pow(int_left, 2).get(0, 0)
matrix<float> matrix_pow_int_copy = matrix.pow(int_left, 2).copy()
float matrix_inv_int_get = matrix.inv(int_left).get(0, 0)
matrix<float> matrix_inv_int_copy = matrix.inv(int_left).copy()
float matrix_pinv_int_get = matrix.pinv(int_left).get(0, 0)
matrix<float> matrix_pinv_int_copy = matrix.pinv(int_left).copy()

bool_matrix = matrix.new<bool>(1, 1, true)
string_matrix = matrix.new<string>(1, 1, "copy")
color_matrix = matrix.new<color>(1, 1, color.red)
int matrix_copy_int_get = matrix.copy(int_left).get(0, 0)
bool matrix_copy_bool_get = matrix.copy(bool_matrix).copy().get(0, 0)
string matrix_copy_string_get = matrix.copy(string_matrix).get(0, 0)
color matrix_copy_color_get = matrix.copy(color_matrix).get(0, 0)
int matrix_transpose_int_get = matrix.transpose(int_left).get(0, 0)
bool matrix_transpose_bool_get = matrix.transpose(bool_matrix).copy().get(0, 0)
string matrix_transpose_string_get = matrix.transpose(string_matrix).get(0, 0)
color matrix_transpose_color_get = matrix.transpose(color_matrix).get(0, 0)
int matrix_submatrix_int_get = matrix.submatrix(int_left).get(0, 0)
bool matrix_submatrix_bool_get = matrix.submatrix(bool_matrix).copy().get(0, 0)
string matrix_submatrix_string_get = matrix.submatrix(string_matrix).get(0, 0)
color matrix_submatrix_color_get = matrix.submatrix(color_matrix).get(0, 0)

bound_matrix_result = left.mult(right)
bound_scalar_result = right.mult(2.0)
int bound_matrix_rows = bound_matrix_result.rows()
float bound_matrix_get = bound_matrix_result.get(0, 0)
int bound_scalar_columns = bound_scalar_result.columns()
float bound_scalar_get = bound_scalar_result.get(0, 0)

float matrix_expression_udf = matrixMultMatrixExpressionRead(left, right)
float matrix_block_udf = matrixMultMatrixBlockRead(right, 2.0)
float matrix_copy_expression_udf = matrixCopyExpressionRead(left)
float matrix_copy_block_udf = matrixCopyBlockRead(left)
float matrix_transpose_expression_udf = matrixTransposeExpressionRead(left)
float matrix_transpose_block_udf = matrixTransposeBlockRead(left)
float matrix_submatrix_expression_udf = matrixSubmatrixExpressionRead(left)
float matrix_submatrix_block_udf = matrixSubmatrixBlockRead(left)
float matrix_kron_expression_udf = matrixKronExpressionRead(left, right)
float matrix_kron_block_udf = matrixKronBlockRead(left, right)
float matrix_diff_expression_udf = matrixDiffExpressionRead(left, diff_right)
float matrix_diff_block_udf = matrixDiffBlockRead(left, 10.0)
float matrix_pow_expression_udf = matrixPowExpressionRead(pow_values)
float matrix_pow_block_udf = matrixPowBlockRead(pow_values)
float matrix_inv_expression_udf = matrixInvExpressionRead(inv_values)
float matrix_inv_block_udf = matrixInvBlockRead(inv_values)
float matrix_pinv_expression_udf = matrixPinvExpressionRead(pinv_values)
float matrix_pinv_block_udf = matrixPinvBlockRead(pinv_values)

plot(matrix_matrix_rows + matrix_matrix_columns + matrix_matrix_elements + matrix_matrix_get + matrix_matrix_copy.get(0, 0) + matrix_matrix_copy_get + matrix_scalar_rows + matrix_scalar_columns + matrix_scalar_elements + matrix_scalar_get + matrix_scalar_copy.get(0, 0) + matrix_scalar_copy_get + scalar_matrix_rows + scalar_matrix_columns + scalar_matrix_elements + scalar_matrix_get + scalar_matrix_copy.get(0, 0) + scalar_matrix_copy_get + matrix_copy_rows + matrix_copy_columns + matrix_copy_elements + matrix_copy_named_get + matrix_copy_nested.get(0, 0) + matrix_transpose_rows + matrix_transpose_columns + matrix_transpose_elements + matrix_transpose_named_get + matrix_transpose_nested.get(0, 0) + matrix_submatrix_rows + matrix_submatrix_columns + matrix_submatrix_elements + matrix_submatrix_named_get + matrix_submatrix_nested.get(0, 0) + matrix_kron_rows + matrix_kron_columns + matrix_kron_elements + matrix_kron_named_get + matrix_kron_nested.get(0, 0) + matrix_diff_rows + matrix_diff_columns + matrix_diff_elements + matrix_diff_named_get + matrix_diff_nested.get(0, 0) + matrix_diff_matrix_scalar_get + matrix_diff_scalar_matrix_get + matrix_pow_rows + matrix_pow_columns + matrix_pow_elements + matrix_pow_named_get + matrix_pow_nested.get(0, 0) + matrix_inv_rows + matrix_inv_columns + matrix_inv_elements + matrix_inv_named_get + matrix_inv_nested.get(0, 0) + int_matrix_matrix_get + int_matrix_matrix_copy.get(0, 0) + int_matrix_scalar_get + int_matrix_scalar_copy.get(0, 0) + int_scalar_matrix_get + int_scalar_matrix_copy.get(0, 0) + matrix_kron_int_get + matrix_kron_int_copy.get(0, 0) + matrix_diff_int_get + matrix_diff_int_copy.get(0, 0) + matrix_pow_int_get + matrix_pow_int_copy.get(0, 0) + matrix_inv_int_get + matrix_inv_int_copy.get(0, 0) + matrix_copy_int_get + (matrix_copy_bool_get ? 1 : 0) + (matrix_copy_string_get == "copy" ? 1 : 0) + (matrix_copy_color_get == color.red ? 1 : 0) + matrix_transpose_int_get + (matrix_transpose_bool_get ? 1 : 0) + (matrix_transpose_string_get == "copy" ? 1 : 0) + (matrix_transpose_color_get == color.red ? 1 : 0) + matrix_submatrix_int_get + (matrix_submatrix_bool_get ? 1 : 0) + (matrix_submatrix_string_get == "copy" ? 1 : 0) + (matrix_submatrix_color_get == color.red ? 1 : 0) + bound_matrix_rows + bound_matrix_get + bound_scalar_columns + bound_scalar_get + matrix_expression_udf + matrix_block_udf + matrix_copy_expression_udf + matrix_copy_block_udf + matrix_transpose_expression_udf + matrix_transpose_block_udf + matrix_submatrix_expression_udf + matrix_submatrix_block_udf + matrix_kron_expression_udf + matrix_kron_block_udf + matrix_diff_expression_udf + matrix_diff_block_udf + matrix_pow_expression_udf + matrix_pow_block_udf + matrix_inv_expression_udf + matrix_inv_block_udf)
plot(matrix_pinv_rows + matrix_pinv_columns + matrix_pinv_elements + matrix_pinv_named_get + matrix_pinv_nested.get(0, 0) + matrix_pinv_int_get + matrix_pinv_int_copy.get(0, 0) + matrix_pinv_expression_udf + matrix_pinv_block_udf)
