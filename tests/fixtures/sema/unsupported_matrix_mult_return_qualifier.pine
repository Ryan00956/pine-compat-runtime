//@version=6
indicator("Unsupported matrix.mult return qualifier")

left = matrix.new<float>(2, 3, close)
right = matrix.new<float>(3, 2, open)
int_left = matrix.new<int>(2, 3, 1)
int_right = matrix.new<int>(3, 2, 2)
int_rows = matrix.new<int>(1, 2, 0)

matrix.fill(matrix.mult(left, right), "bad")
matrix.fill(left.mult(right), "bad")
matrix.fill(matrix.mult(left, close), "bad")
matrix.fill(matrix.mult(close, left), "bad")
matrix.fill(left.mult(2), "bad")
matrix.fill(matrix.mult(int_left, int_right), "bad")
matrix.fill(int_left.mult(int_right), "bad")
matrix.fill(matrix.mult(int_left, 2), "bad")
matrix.fill(matrix.mult(2, int_left), "bad")
matrix.fill(int_left.mult(2), "bad")
matrix.add_row(int_rows, 0, matrix.mult(left, array.from(close, open, high)))
matrix.add_row(int_rows, 0, matrix.mult(array.from(close, open), right))
matrix.add_row(int_rows, 0, left.mult(array.from(1, 2, 3)))
matrix.add_row(int_rows, 0, matrix.mult(int_left, array.from(1, 2, 3)))
matrix.add_row(int_rows, 0, matrix.mult(array.from(1, 2), int_right))
matrix.add_row(int_rows, 0, int_left.mult(array.from(1, 2, 3)))
