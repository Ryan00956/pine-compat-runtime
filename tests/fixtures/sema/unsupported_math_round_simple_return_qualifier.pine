//@version=6
indicator("Unsupported math round simple return qualifier")

values = array.from(1, 2)
number = array.size(values) + 0.5
precision = array.size(values) - 1

rounded_count = math.round(number)
rounded_price = math.round(number, precision)

plot(close, show_last=rounded_count)
hline(rounded_price)
