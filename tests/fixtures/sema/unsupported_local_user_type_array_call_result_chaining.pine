udf_string_binary_search_leftmost = identity(array.from("a", "b")).binary_search_leftmost("a")
udf_binary_search_leftmost_extra_arg = identity(array.from(1, 2)).binary_search_leftmost(1, 2)
udf_udt_binary_search_rightmost = identity(values).copy().binary_search_rightmost(First.new(10.0, 100.0))
udf_string_binary_search_rightmost = identity(array.from("a", "b")).binary_search_rightmost("a")
