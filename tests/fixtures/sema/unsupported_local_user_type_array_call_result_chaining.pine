udf_every_extra_arg = identity(array.from(1, 2)).every(true)
method_udt_some = anchor.retain(values).some()
udf_udt_some = identity(values).copy().some()
udf_string_some = identity(array.from("a", "b")).some()
udf_some_extra_arg = identity(array.from(1, 2)).some(true)
udf_join_bad_separator = identity(array.from(1, 2)).join(close)
udf_join_extra_arg = identity(array.from(1, 2)).join("|", "/")
