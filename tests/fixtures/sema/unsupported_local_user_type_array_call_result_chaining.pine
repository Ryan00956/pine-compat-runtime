udf_udt_abs = identity(values).copy().abs()
udf_string_abs = identity(array.from("a", "b")).abs()
udf_abs_extra_arg = identity(array.from(1, 2)).abs(1)
udf_udt_min = identity(values).copy().min()
udf_string_min = identity(array.from("a", "b")).min()
udf_min_bad_nth = identity(array.from(1, 2)).min(1.5)
udf_min_extra_arg = identity(array.from(1, 2)).min(0, 1)
udf_udt_max = identity(values).copy().max()
udf_string_max = identity(array.from("a", "b")).max()
udf_max_bad_nth = identity(array.from(1, 2)).max(1.5)
udf_max_extra_arg = identity(array.from(1, 2)).max(0, 1)
udf_udt_sum = identity(values).copy().sum()
udf_string_sum = identity(array.from("a", "b")).sum()
udf_sum_extra_arg = identity(array.from(1, 2)).sum(0)
udf_udt_avg = identity(values).copy().avg()
udf_string_avg = identity(array.from("a", "b")).avg()
udf_avg_extra_arg = identity(array.from(1, 2)).avg(0)
udf_udt_range = identity(values).copy().range()
udf_string_range = identity(array.from("a", "b")).range()
udf_range_extra_arg = identity(array.from(1, 2)).range(0)
udf_udt_median = identity(values).copy().median()
udf_string_median = identity(array.from("a", "b")).median()
udf_median_extra_arg = identity(array.from(1, 2)).median(0)
udf_udt_mode = identity(values).copy().mode()
udf_string_mode = identity(array.from("a", "b")).mode()
udf_mode_extra_arg = identity(array.from(1, 1)).mode(0)
udf_udt_percentile_nearest = identity(values).copy().percentile_nearest_rank(50)
udf_string_percentile_nearest = identity(array.from("a", "b")).percentile_nearest_rank(50)
udf_percentile_nearest_missing_arg = identity(array.from(1, 2)).percentile_nearest_rank()
udf_percentile_nearest_bad_percentage = identity(array.from(1, 2)).percentile_nearest_rank("50")
udf_percentile_nearest_extra_arg = identity(array.from(1, 2)).percentile_nearest_rank(50, 0)
udf_udt_percentile_linear = identity(values).copy().percentile_linear_interpolation(50)
udf_string_percentile_linear = identity(array.from("a", "b")).percentile_linear_interpolation(50)
udf_percentile_linear_missing_arg = identity(array.from(1, 2)).percentile_linear_interpolation()
udf_percentile_linear_bad_percentage = identity(array.from(1, 2)).percentile_linear_interpolation("50")
udf_percentile_linear_extra_arg = identity(array.from(1, 2)).percentile_linear_interpolation(50, 0)
udf_udt_percentrank = identity(values).copy().percentrank(0)
udf_string_percentrank = identity(array.from("a", "b")).percentrank(0)
udf_percentrank_missing_arg = identity(array.from(1, 2)).percentrank()
udf_percentrank_bad_index = identity(array.from(1, 2)).percentrank("0")
udf_percentrank_series_index = identity(array.from(1, 2)).percentrank(bar_index)
udf_percentrank_extra_arg = identity(array.from(1, 2)).percentrank(0, 1)
udf_udt_covariance = identity(values).copy().covariance(values)
udf_string_covariance = identity(array.from("a", "b")).covariance(array.from(1, 2))
udf_covariance_bad_id2 = identity(array.from(1, 2)).covariance(array.from("a", "b"))
udf_covariance_missing_arg = identity(array.from(1, 2)).covariance()
udf_covariance_bad_biased = identity(array.from(1, 2)).covariance(array.from(2, 4), close)
udf_covariance_extra_arg = identity(array.from(1, 2)).covariance(array.from(2, 4), true, false)
udf_udt_standardize = identity(values).copy().standardize()
udf_string_standardize = identity(array.from("a", "b")).standardize()
udf_standardize_extra_arg = identity(array.from(1, 2)).standardize(0)
udf_udt_variance = identity(values).copy().variance()
udf_string_variance = identity(array.from("a", "b")).variance()
udf_variance_bad_biased = identity(array.from(1, 2)).variance(close)
udf_variance_extra_arg = identity(array.from(1, 2)).variance(true, false)
udf_udt_stdev = identity(values).copy().stdev()
udf_string_stdev = identity(array.from("a", "b")).stdev()
udf_stdev_bad_biased = identity(array.from(1, 2)).stdev(close)
udf_stdev_extra_arg = identity(array.from(1, 2)).stdev(true, false)
method_udt_sort_indices = anchor.retain(values).sort_indices(order.ascending, "shared")
udf_udt_sort_indices = identity(values).copy().sort_indices(order.ascending, "shared")
udf_bool_sort_indices = identity(array.new_bool(1, true)).sort_indices()
udf_sort_indices_bad_order = identity(array.from(2, 1)).sort_indices(close)
udf_sort_indices_extra_arg = identity(array.from(2, 1)).sort_indices(order.ascending, "unused")
method_udt_every = anchor.retain(values).every()
udf_udt_every = identity(values).copy().every()
