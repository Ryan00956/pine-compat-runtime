//@version=6
indicator("Unsupported local UDT array call result chaining")

type First
    float shared
    float other

type Second
    float other
    float shared

type Anchor
    int tag

identity(values) => values

mixedUdf(array<First> first, array<Second> second, bool choose) => choose ? first : second

noneUdf() => na

number() => 1

method retain(Anchor self, array<First> values) => values

method copy(Anchor self, array<First> values) => array.from(First.new(999.0, 9990.0))

method transform(Anchor self, array<First> values) => array.from(First.new(777.0, 7770.0))

method mixed(Anchor self, array<First> first, array<Second> second, bool choose) => choose ? first : second

method first(Anchor self, array<First> values) => collisionMarker()

method size(Anchor self, array<First> values) => sizeCollisionMarker()

method get(Anchor self, array<First> values, int index) => getCollisionMarker()

method last(Anchor self, array<First> values) => lastCollisionMarker()

method none(Anchor self, array<First> values) => na

values = array.from(First.new(10.0, 100.0))
second_values = array.from(Second.new(200.0, 20.0))
anchor = Anchor.new(1)

chained_first = anchor.retain(values).first()
chained_copy = anchor.retain(values).copy()
chained_size = anchor.retain(values).size()
chained_get = anchor.retain(values).get(0)
chained_last = anchor.retain(values).last()
chained_bad_get = anchor.retain(values).get("bad")
chained_bad_includes = anchor.retain(values).includes(Second.new(200.0, 20.0))
chained_extra_includes = anchor.retain(values).includes(First.new(10.0, 100.0), First.new(10.0, 100.0))
chained_bad_indexof = anchor.retain(values).indexof(Second.new(200.0, 20.0))
chained_extra_indexof = anchor.retain(values).indexof(First.new(10.0, 100.0), First.new(10.0, 100.0))
chained_bad_lastindexof = anchor.retain(values).lastindexof(Second.new(200.0, 20.0))
chained_extra_lastindexof = anchor.retain(values).lastindexof(First.new(10.0, 100.0), First.new(10.0, 100.0))
chained_udt_binary_search = anchor.retain(values).binary_search(First.new(10.0, 100.0))
chained_udt_binary_search_leftmost = anchor.retain(values).binary_search_leftmost(First.new(10.0, 100.0))
chained_udt_binary_search_rightmost = anchor.retain(values).binary_search_rightmost(First.new(10.0, 100.0))
chained_udt_abs = anchor.retain(values).abs()
chained_pop = anchor.retain(values).pop()
chained_transform = anchor.retain(values).transform()
mixed_first = anchor.mixed(values, second_values, true).first()
mixed_size = anchor.mixed(values, second_values, true).size()
mixed_get = anchor.mixed(values, second_values, true).get(0)
mixed_last = anchor.mixed(values, second_values, true).last()
none_first = anchor.none(values).first()
none_copy = anchor.none(values).copy()
none_size = anchor.none(values).size()
none_get = anchor.none(values).get(0)
none_last = anchor.none(values).last()
explicit_copy = anchor.copy(values)
explicit_transform = anchor.transform(values)

udf_first = identity(values).first()
udf_copy = identity(values).copy()
udf_size = identity(values).size()
udf_get = identity(values).get(0)
udf_last = identity(values).last()
udf_scalar_size = identity(array.from(1, 2)).size()
udf_scalar_get = identity(array.from(3, 4)).get(index=0)
udf_bad_includes = identity(values).copy().includes(Second.new(200.0, 20.0))
udf_scalar_bad_includes = identity(array.from(1, 2)).includes("bad")
udf_bad_indexof = identity(values).copy().indexof(Second.new(200.0, 20.0))
udf_scalar_bad_indexof = identity(array.from(1, 2)).indexof("bad")
udf_bad_lastindexof = identity(values).copy().lastindexof(Second.new(200.0, 20.0))
udf_scalar_bad_lastindexof = identity(array.from(1, 2)).lastindexof("bad")
udf_udt_binary_search = identity(values).copy().binary_search(First.new(10.0, 100.0))
udf_string_binary_search = identity(array.from("a", "b")).binary_search("a")
udf_binary_search_extra_arg = identity(array.from(1, 2)).binary_search(1, 2)
udf_udt_binary_search_leftmost = identity(values).copy().binary_search_leftmost(First.new(10.0, 100.0))
udf_string_binary_search_leftmost = identity(array.from("a", "b")).binary_search_leftmost("a")
udf_binary_search_leftmost_extra_arg = identity(array.from(1, 2)).binary_search_leftmost(1, 2)
udf_udt_binary_search_rightmost = identity(values).copy().binary_search_rightmost(First.new(10.0, 100.0))
udf_string_binary_search_rightmost = identity(array.from("a", "b")).binary_search_rightmost("a")
udf_binary_search_rightmost_extra_arg = identity(array.from(1, 2)).binary_search_rightmost(1, 2)
udf_udt_abs = identity(values).copy().abs()
udf_string_abs = identity(array.from("a", "b")).abs()
udf_abs_extra_arg = identity(array.from(1, 2)).abs(1)
udf_pop = identity(values).pop()
udf_transform = identity(values).transform()
udf_mixed_copy = mixedUdf(values, second_values, true).copy()
udf_none_first = noneUdf().first()
udf_none_copy = noneUdf().copy()
udf_none_size = noneUdf().size()
udf_none_get = noneUdf().get(0)
udf_none_last = noneUdf().last()
number_size = number().size()
