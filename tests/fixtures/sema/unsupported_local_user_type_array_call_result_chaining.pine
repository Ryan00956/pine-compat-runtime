udf_slice_extra_arg = identity(array.from(1, 2)).slice(0, 1, 2)
identity(values).clear(1)
udf_pop = identity(values).pop()
udf_transform = identity(values).transform()
udf_mixed_copy = mixedUdf(values, second_values, true).copy()
udf_none_first = noneUdf().first()
udf_none_copy = noneUdf().copy()
udf_none_size = noneUdf().size()
udf_none_get = noneUdf().get(0)
udf_none_last = noneUdf().last()
number_size = number().size()
