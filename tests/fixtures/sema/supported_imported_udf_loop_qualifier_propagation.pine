//@version=6
import user/udt/1 as lib
indicator("Supported imported UDF loop qualifier propagation")

length = input.int(2, "Length")
values = array.from(1, 2)
inactive = input.bool(false, "Inactive")
flag = input.bool(true, "Flag")

plot(ta.sma(close, lib.passExportedLengthFor(length)))
plot(ta.sma(close, lib.passExportedLengthForIn(values, length)))
plot(ta.sma(close, lib.passExportedLengthWhile(inactive, length)))
plot(ta.sma(close, lib.passExportedLengthSwitchLoop(flag, length)))
