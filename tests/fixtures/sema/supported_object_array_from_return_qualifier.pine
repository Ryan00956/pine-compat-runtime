//@version=6
indicator("Supported object array.from return qualifier")

label_count(label[] values) =>
    array.size(values)

line_count(line[] values) =>
    array.size(values)

linefill_count(array<linefill> values) =>
    array.size(values)

polyline_count(array<polyline> values) =>
    array.size(values)

box_count(box[] values) =>
    array.size(values)

table_count(array<table> values) =>
    array.size(values)

point_count(array<chart.point> values) =>
    array.size(values)

first_label = label.new(bar_index, high, "a")
second_label = label.new(bar_index + 1, low, "b")
first_line = line.new(bar_index, high, bar_index + 1, low)
second_line = line.new(bar_index + 2, high + 1, bar_index + 3, low + 1)
third_line = line.new(bar_index + 4, close, bar_index + 5, close + 1)
first_fill = linefill.new(first_line, second_line, color.green)
second_fill = linefill.new(second_line, third_line, color.red)
points = array.from(chart.point.from_index(bar_index, close), chart.point.from_index(bar_index + 1, close + 1))
first_polyline = polyline.new(points, line_color=color.red)
second_polyline = polyline.new(points, line_color=color.green)
first_box = box.new(bar_index, high, bar_index + 1, low)
second_box = box.new(bar_index + 2, high + 1, bar_index + 3, low + 1)
first_table = table.new(position.top_left, 1, 1)
second_table = table.new(position.bottom_right, 1, 1)

result = label_count(array.from(first_label, second_label))
result := result + line_count(array.from(first_line, second_line))
result := result + linefill_count(array.from(first_fill, second_fill))
result := result + polyline_count(array.from(first_polyline, second_polyline))
result := result + box_count(array.from(first_box, second_box))
result := result + table_count(array.from(first_table, second_table))
result := result + point_count(points)

plot(result)
