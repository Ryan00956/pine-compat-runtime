//@version=6
indicator("Unsupported bound matrix.submatrix call-result reads")

values = matrix.new<float>(3, 4, 1.0)
array_values = array.from(1.0, 2.0)

bad_from_row = values.submatrix("bad").rows()
bad_row = values.submatrix().get("bad", 0)
bad_column = values.submatrix().get(0, "bad")
values.submatrix().set(0, 0, "bad")
size_result = values.submatrix().size()
wrong_receiver = array_values.submatrix().rows()

plot(close)
