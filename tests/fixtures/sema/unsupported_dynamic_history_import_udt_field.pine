//@version=5
import user/udt/1 as lib
indicator("Unsupported dynamic history imported UDT field")

p = lib.typedPoint(lib.Point.new(close))
wrapped = lib.typedWrapper(lib.Wrapper.new(lib.Point.new(open)))
constructor_point = lib.typedShift(p, close + 1)
constructor_wrapped = lib.typedWrapperShift(wrapped, open + 1)
method_same_point = p.same()
method_same_wrapped = wrapped.sameWrapper()
method_point = p.make(close + 1)
method_wrapped = wrapped.makeWrapper(open + 1)
qualified_method_same_point = lib.same(p)
qualified_method_same_wrapped = lib.sameWrapper(wrapped)
qualified_method_point = lib.make(p, close + 2)
qualified_method_wrapped = lib.makeWrapper(wrapped, open + 2)

plot(close[p.x])
plot(open[wrapped.nested.x])
plot(high[constructor_point.x])
plot(low[constructor_wrapped.nested.x])
plot(close[method_same_point.x])
plot(open[method_same_wrapped.nested.x])
plot(high[method_point.x])
plot(low[method_wrapped.nested.x])
plot(close[qualified_method_same_point.x])
plot(open[qualified_method_same_wrapped.nested.x])
plot(high[qualified_method_point.x])
plot(low[qualified_method_wrapped.nested.x])
