//@version=6
indicator("Supported builtin namespace array call-result reads")

splitExpressionRead() => str.split("udf,left", ",").copy().last()

readMatrixAndMap(matrix_values, map_values) =>
    float row_first = matrix.row(matrix_values, 0).copy().first()
    int key_last = map.keys(map_values).copy().last()
    row_first + key_last

matrixMultExpressionRead(matrix_values, vector_values) => matrix.mult(matrix_values, vector_values).copy().last()

matrixMultBlockRead(matrix_values, vector_values) =>
    float first = matrix.mult(matrix_values, vector_values).copy().first()
    int count = matrix.mult(matrix_values, vector_values).size()
    first + count

