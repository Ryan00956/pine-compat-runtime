//@version=6
indicator("Supported bound matrix.pow call-result reads")

powRows(values, power) => values.pow(power).copy().rows()

values = matrix.new<float>(2, 2, 2.0)
ints = matrix.new<int>(1, 1, 2)

int direct_rows = values.pow(2).rows()
int direct_columns = values.pow(2).columns()
int direct_elements = values.pow(2).elements_count()
float direct_get = values.pow(2).get(row=1, column=1)
float identity_get = values.pow(0).get(0, 0)
matrix<float> nested_copy = values.pow(1).copy()
float int_get = ints.pow(3).get(0, 0)
array<float> direct_row = values.pow(2).row(1).copy()
array<float> direct_col = values.pow(2).col(1).copy()
array<float> direct_eigenvalues = values.pow(2).eigenvalues().copy()

plot(direct_rows + direct_columns + direct_elements + direct_get + identity_get + nested_copy.get(0, 0) + int_get + direct_row.size() + direct_col.size() + direct_eigenvalues.size() + powRows(values, 2))
