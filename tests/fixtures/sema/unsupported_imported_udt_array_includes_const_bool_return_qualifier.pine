//@version=6
import user/udt/1 as lib
indicator("Unsupported imported UDT array.includes const bool return qualifier")

points = array.from(lib.Point.new(close), lib.Point.new(open))
constructed = array.new<lib.Point>(2, lib.Point.new(high))

input.bool(defval=array.includes(points, lib.Point.new(close)))
input.bool(defval=constructed.includes(lib.Point.new(high)))
