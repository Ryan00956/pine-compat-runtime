//@version=5
indicator("Supported ticker na simple string params")

new_prefix = ticker.new(na, "AAPL")
new_ticker = ticker.new("NASDAQ", na)
new_session = ticker.new("NASDAQ", "AAPL", na)
modified_ticker = ticker.modify(na)
modified_session = ticker.modify("NASDAQ:AAPL", na)
standard = ticker.standard(na)
heikinashi = ticker.heikinashi(na)
inherited_from = ticker.inherit(na, "NYSE:PFE")
inherited_symbol = ticker.inherit("NASDAQ:AAPL", na)
linebreak = ticker.linebreak(na, 3)
kagi_ticker = ticker.kagi(na, "ATR", 10)
kagi_style = ticker.kagi("NASDAQ:AAPL", na, 10)
pointfigure_ticker = ticker.pointfigure(na, "hl", "ATR", 14, 3)
pointfigure_source = ticker.pointfigure("NASDAQ:AAPL", na, "ATR", 14, 3)
pointfigure_style = ticker.pointfigure("NASDAQ:AAPL", "hl", na, 14, 3)
renko_ticker = ticker.renko(na, "ATR", 10)
renko_style = ticker.renko("NASDAQ:AAPL", na, 10)

first_half = na(new_prefix) and na(new_ticker) and na(new_session) and na(modified_ticker) and na(modified_session) and na(standard) and na(heikinashi) and na(inherited_from)
second_half = na(inherited_symbol) and na(linebreak) and na(kagi_ticker) and na(kagi_style) and na(pointfigure_ticker) and na(pointfigure_source) and na(pointfigure_style) and na(renko_ticker) and na(renko_style)
plot(first_half and second_half ? 1 : 0)
