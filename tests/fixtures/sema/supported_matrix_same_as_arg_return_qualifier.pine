//@version=6
indicator("Supported matrix SameAsArg return qualifier")

int_matrix = matrix.new<int>(2, 2, 1)
float_matrix = matrix.new<float>(2, 2, 1.0)
bool_matrix = matrix.new<bool>(2, 2, false)
string_matrix = matrix.new<string>(2, 2, "")
color_matrix = matrix.new<color>(2, 2, color.red)

matrix.fill(matrix.copy(int_matrix), 2)
matrix.fill(float_matrix.copy(), 2.0)
matrix.fill(matrix.copy(bool_matrix), true)
matrix.fill(string_matrix.copy(), "copy")
matrix.fill(color_matrix.copy(), color.green)
matrix.fill(matrix.transpose(int_matrix), 3)
matrix.fill(float_matrix.transpose(), 3.0)
matrix.fill(matrix.transpose(bool_matrix), true)
matrix.fill(string_matrix.transpose(), "transpose")
matrix.fill(color_matrix.transpose(), color.blue)
matrix.fill(matrix.submatrix(int_matrix, 0, 1, 0, 1), 4)
matrix.fill(float_matrix.submatrix(0, 1, 0, 1), 4.0)
matrix.fill(matrix.submatrix(bool_matrix, 0, 1, 0, 1), true)
matrix.fill(string_matrix.submatrix(0, 1, 0, 1), "submatrix")
matrix.fill(color_matrix.submatrix(0, 1, 0, 1), color.yellow)
matrix.fill(matrix.concat(int_matrix, int_matrix), 5)
matrix.fill(float_matrix.concat(float_matrix), 5.0)
matrix.fill(matrix.concat(bool_matrix, bool_matrix), true)
matrix.fill(string_matrix.concat(string_matrix), "concat")
matrix.fill(color_matrix.concat(color_matrix), color.aqua)
