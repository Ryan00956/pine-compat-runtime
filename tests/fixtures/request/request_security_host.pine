indicator("request host contract")
same = request.security("NYSE:IBM", timeframe.period, open + close)
higher = request.security("NYSE:IBM", "5", close)
spread = request.security("NYSE:IBM", timeframe.period, math.max(close, open) - math.min(close, open))
stateless_math = request.security("NYSE:IBM", timeframe.period, math.abs(open - close) + math.floor(math.avg(open, close)) + math.pow(2, 2) + math.hypot(3, 4))
sum_value = request.security("NYSE:IBM", timeframe.period, math.sum(close, 2))
mintick_round = request.security("NYSE:IBM", timeframe.period, math.round_to_mintick(close + 0.006))
rsi_value = request.security("NYSE:IBM", timeframe.period, ta.rsi(close, 3))
tr_value = request.security("NYSE:IBM", timeframe.period, ta.tr())
tr_strict = request.security("NYSE:IBM", timeframe.period, ta.tr(false))
atr_value = request.security("NYSE:IBM", timeframe.period, ta.atr(3))
highest_value = request.security("NYSE:IBM", timeframe.period, ta.highest(high, 3))
lowest_value = request.security("NYSE:IBM", timeframe.period, ta.lowest(low, 3))
change_value = request.security("NYSE:IBM", timeframe.period, ta.change(close))
mom_value = request.security("NYSE:IBM", timeframe.period, ta.mom(close, 2))
roc_value = request.security("NYSE:IBM", timeframe.period, ta.roc(close, 2))
range_value = request.security("NYSE:IBM", timeframe.period, ta.range(close, 3))
dev_value = request.security("NYSE:IBM", timeframe.period, ta.dev(close, 3))
rising_value = request.security("NYSE:IBM", timeframe.period, ta.rising(close, 2) ? 1 : 0)
falling_value = request.security("NYSE:IBM", timeframe.period, ta.falling(close, 2) ? 1 : 0)
cross_value = request.security("NYSE:IBM", timeframe.period, ta.cross(close, 20.5) ? 1 : 0)
crossover_value = request.security("NYSE:IBM", timeframe.period, ta.crossover(close, 20.5) ? 1 : 0)
crossunder_value = request.security("NYSE:IBM", timeframe.period, ta.crossunder(close - time / 60000.0, 19.5) ? 1 : 0)
cum_value = request.security("NYSE:IBM", timeframe.period, ta.cum(close))
stdev_value = request.security("NYSE:IBM", timeframe.period, ta.stdev(close, 3))
stdev_sample = request.security("NYSE:IBM", timeframe.period, ta.stdev(close, 3, false))
plot(same)
plot(higher)
plot(spread)
plot(stateless_math)
plot(sum_value)
plot(mintick_round)
plot(rsi_value)
plot(tr_value)
plot(tr_strict)
plot(atr_value)
plot(highest_value)
plot(lowest_value)
plot(change_value)
plot(mom_value)
plot(roc_value)
plot(range_value)
plot(dev_value)
plot(rising_value)
plot(falling_value)
plot(cross_value)
plot(crossover_value)
plot(crossunder_value)
plot(cum_value)
plot(stdev_value)
plot(stdev_sample)
