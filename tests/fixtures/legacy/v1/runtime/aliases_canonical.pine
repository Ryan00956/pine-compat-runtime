//@version=6
indicator("v1 expanded alias equivalence")
crossed = ta.cross(close, open)
changed = ta.change(close)
magnitude = math.abs(close - open)
maximum = math.max(close, open)
minimum = math.min(close, open)
crossed_over = ta.crossover(close, open)
rooted = math.sqrt(magnitude)
deviation = ta.stdev(close, 3)
volume_weighted = ta.vwma(close, 3)
pivot_high = ta.pivothigh(1, 1)
pivot_low = ta.pivotlow(low, 1, 1)
volatility = ta.atr(3)
average = math.avg(close, open)
floored = math.floor(close)
regression = ta.linreg(close, 3, 0)
oscillator = ta.stoch(close, high, low, 3)
rolling_total = math.sum(close, 3)
bars_since = ta.barssince(close > open)
crossed_under = ta.crossunder(close, open)
heikin_ticker = ticker.heikinashi("NYSE:IBM")
decimal_log = math.log10(close)
[macd_line, signal_line, histogram] = ta.macd(close, 2, 3, 2)
direction = math.sign(close - open)
previous = ta.valuewhen(close > open, close, 0)
commodity = ta.cci(close, 3)
rounded_up = math.ceil(close)
natural_log = math.log(close)
money_flow = ta.mfi(hlc3, 3)
momentum = ta.mom(close, 2)
powered = math.pow(close, 2)
true_range_value = ta.tr
true_range_call = ta.tr(true)
balance_volume = ta.obv
vwap_value = ta.vwap
vwap_call = ta.vwap(close)
plot(crossed ? 1 : 0)
plot(math.round(close))
plot(ta.rma(close, 3))
plot(ta.wma(close, 3))
plot(ta.highest(high, 3))
plot(ta.lowest(low, 3))
plot(close, style=plot.style_cross)
plot(changed)
plot(magnitude)
plot(maximum)
plot(minimum)
plot(crossed_over ? 1 : 0)
plot(rooted)
plot(deviation)
plot(volume_weighted)
plot(pivot_high)
plot(pivot_low)
plot(volatility)
plot(average)
plot(floored)
plot(regression)
plot(oscillator)
plot(rolling_total)
plot(bars_since)
plot(crossed_under ? 1 : 0)
plot(heikin_ticker != "" ? 1 : 0)
plot(decimal_log)
plot(macd_line)
plot(signal_line)
plot(histogram)
plot(direction)
plot(previous)
plot(commodity)
plot(rounded_up)
plot(natural_log)
plot(money_flow)
plot(momentum)
plot(powered)
plot(true_range_value)
plot(true_range_call)
plot(balance_volume)
plot(vwap_value)
plot(vwap_call)
