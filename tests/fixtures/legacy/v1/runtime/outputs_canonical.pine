//@version=6
indicator("v1 output compatibility", overlay=true)
p1 = plot(close, title="Close", color=#2196F399, linewidth=2, style=plot.style_line, offset=1, show_last=3)
p2 = plot(open, title="Open", color=color.red)
plotchar(close > open, title="Char", char="C", location=location.abovebar, color=#4CAF50BF, offset=1, text="Up", textcolor=color.white, editable=false, show_last=2)
plotshape(close < open, title="Shape", style=shape.circle, location=location.belowbar, color=#F23645A6, offset=-1, text="Dn", textcolor=color.white, editable=true, show_last=3)
plotarrow(close - open, title="Arrow", colorup=#4CAF508C, colordown=#F236458C, offset=1, minheight=5, maxheight=20, editable=false, show_last=2)
plotbar(open, high, low, close, title="Bars", color=color.blue, editable=false, show_last=2)
plotcandle(open, high, low, close, title="Candles", color=color.blue, wickcolor=color.gray, editable=true, show_last=3, bordercolor=color.black)
h1 = hline(10, title="Ten", color=color.gray, linestyle=hline.style_dotted, linewidth=2, editable=false)
h2 = hline(20, title="Twenty", color=color.blue, linestyle=hline.style_dashed, linewidth=1, editable=true)
fill(p1, p2, color=#4CAF5033, title="Plot fill", editable=false, show_last=2)
fill(h1, h2, color=#F236454D, title="Line fill", editable=true)
fill(p1, p2, color=#2196F31A, title="Default fill")
bgcolor(close > open ? #2196F333 : na, offset=1, editable=false, show_last=2, title="Background")
bgcolor(close < open ? #2196F31A : na, title="Default background")
barcolor(close > open ? color.green : color.red, offset=-1, editable=false, show_last=2, title="Bar color")
