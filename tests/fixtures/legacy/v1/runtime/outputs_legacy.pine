study("v1 output compatibility", overlay=true)
p1 = plot(close, title="Close", color=blue, linewidth=2, style=solid, transp=40, offset=1, show_last=3)
p2 = plot(open, title="Open", color=red)
plotchar(close > open, title="Char", char="C", location=location.abovebar, color=green, transp=25, offset=1, text="Up", textcolor=white, editable=false, show_last=2)
plotshape(close < open, title="Shape", style=shape.circle, location=location.belowbar, color=red, transp=35, offset=-1, text="Dn", textcolor=white, editable=true, show_last=3)
plotarrow(close - open, title="Arrow", colorup=green, colordown=red, transp=45, offset=1, minheight=5, maxheight=20, editable=false, show_last=2)
plotbar(open, high, low, close, title="Bars", color=blue, editable=false, show_last=2)
plotcandle(open, high, low, close, title="Candles", color=blue, wickcolor=gray, editable=true, show_last=3, bordercolor=black)
h1 = hline(10, title="Ten", color=gray, linestyle=dotted, linewidth=2, editable=false)
h2 = hline(20, title="Twenty", color=blue, linestyle=dashed, linewidth=1, editable=true)
fill(p1, p2, color=green, transp=80, title="Plot fill", editable=false, show_last=2)
fill(h1, h2, color=red, transp=70, title="Line fill", editable=true)
fill(p1, p2, color=blue, title="Default fill")
bgcolor(close > open ? blue : na, transp=80, offset=1, editable=false, show_last=2, title="Background")
bgcolor(close < open ? blue : na, title="Default background")
barcolor(close > open ? green : red, offset=-1, editable=false, show_last=2, title="Bar color")
