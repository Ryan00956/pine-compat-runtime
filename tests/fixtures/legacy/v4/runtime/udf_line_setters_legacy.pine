//@version=4
study("Legacy v4 UDF line setters", overlay=true, max_lines_count=10)

adjust_line(value) =>
    var line segment = na
    if barstate.isfirst
        segment := line.new(bar_index, open, bar_index + 1, value, extend=extend.right)
    line.set_x2(segment, bar_index + 2)
    line.set_extend(segment, extend.none)
    value

plot(adjust_line(close))
