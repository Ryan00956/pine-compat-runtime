//@version=4
study("v4 output parity")
selectedStyle = input(5, "Plot style")
p1 = plot(close, title="Close", color=color.blue, linewidth=2, style=selectedStyle, trackprice=true, transp=40, histbase=5, offset=1, join=true, editable=false, show_last=2, display=display.all)
p2 = plot(open, title="Alpha wins", color=#F23645CC, transp=80)
plotchar(close > open, title="Char", char="C", location=location.abovebar, color=color.green, transp=25, offset=1, text="Up", textcolor=color.white, editable=false, size=size.small, show_last=2, display=display.all)
plotshape(close < open, title="Shape", style=shape.circle, location=location.belowbar, color=color.red, transp=35, offset=-1, text="Dn", textcolor=color.white, editable=true, size=size.tiny, show_last=3, display=display.all)
plotarrow(close - open, title="Arrow", colorup=color.green, colordown=color.red, transp=45, offset=1, minheight=5, maxheight=20, editable=false, show_last=2, display=display.all)
plotbar(open, high, low, close, title="Bars", color=color.blue, editable=false, show_last=2, display=display.all)
plotcandle(open, high, low, close, title="Candles", color=color.green, wickcolor=color.white, editable=false, show_last=2, bordercolor=color.red, display=display.all)
h1 = hline(10, title="Ten", color=color.gray, linestyle=1, linewidth=2, editable=false)
h2 = hline(20, title="Twenty", color=color.blue, linestyle=hline.style_dashed, linewidth=1, editable=true)
fill(p1, p2, color=color.green, title="Plot fill", editable=false, show_last=2, fillgaps=true)
fill(hline1=h1, hline2=h2, color=color.red, transp=55, title="Line fill", editable=true, fillgaps=false)
bgcolor(close > open ? color.blue : na, offset=1, editable=false, show_last=2, title="Background")
barcolor(close > open ? color.green : color.red, offset=-1, editable=false, show_last=2, title="Bar color")
