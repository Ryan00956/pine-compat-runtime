//@version=4
study("v4 alias equivalence")
[basis, upper, lower] = bb(close, 3, 2)
fast = ema(close, 3)
slow = sma(close, 4)
selected = crossover(fast, slow) ? fast : slow
crossed = cross(close, open)
changed = change(close)
rooted = sqrt(abs(close - open))
deviation = stdev(close, 3)
volume_weighted = vwma(close, 3)
maximum = max(close, open)
minimum = min(close, open)
pivot_high = pivothigh(1, 1)
pivot_low = pivotlow(low, 1, 1)
volatility = atr(3)
average = avg(close, open)
floored = floor(close)
regression = linreg(close, 3, 0)
oscillator = stoch(close, high, low, 3)
rolling_total = sum(close, 3)
bars_since = barssince(close > open)
crossed_under = crossunder(close, open)
heikin_ticker = heikinashi("NYSE:IBM")
decimal_log = log10(close)
[macd_line, signal_line, histogram] = macd(close, 2, 3, 2)
direction = sign(close - open)
plain_text = tostring(close)
formatted_text = tostring(x=close, y="#.00")
previous = valuewhen(close > open, close, 0)
commodity = cci(close, 3)
rounded_up = ceil(close)
natural_log = log(close)
money_flow = mfi(hlc3, 3)
momentum = mom(close, 2)
powered = pow(close, 2)
true_range_value = tr
true_range_call = tr(true)
balance_volume = obv
vwap_value = vwap
vwap_call = vwap(close)
hull = hma(close, 4)
plot(basis)
plot(upper)
plot(lower)
plot(selected)
plot(changed)
plot(rooted)
plot(deviation)
plot(volume_weighted)
plot(maximum)
plot(minimum)
plot(pivot_high)
plot(pivot_low)
plot(volatility)
plot(average)
plot(floored)
plot(regression)
plot(oscillator)
plot(rolling_total)
plot(bars_since)
plot(crossed_under ? 1 : 0)
plot(heikin_ticker != "" ? 1 : 0)
plot(decimal_log)
plot(macd_line)
plot(signal_line)
plot(histogram)
plot(direction)
plot(plain_text != "" ? 1 : 0)
plot(formatted_text != "" ? 1 : 0)
plot(previous)
plot(commodity)
plot(rounded_up)
plot(natural_log)
plot(money_flow)
plot(momentum)
plot(powered)
plot(true_range_value)
plot(true_range_call)
plot(balance_volume)
plot(vwap_value)
plot(vwap_call)
plot(crossed ? 1 : 0)
plot(round(close))
plot(rma(close, 3))
plot(wma(close, 3))
plot(hull)
