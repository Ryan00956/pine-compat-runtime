//@version=5
indicator(title="v4 output parity")
selectedStyle = input.int(5, "Plot style")
p1 = plot(close, title="Close", color=#2196F399, linewidth=2, style=plot.style_columns, trackprice=true, histbase=5, offset=1, join=true, editable=false, show_last=2, display=display.pane)
p2 = plot(open, title="Alpha wins", color=#F23645CC)
plotchar(close > open, title="Char", char="C", location=location.abovebar, color=#4CAF50BF, offset=1, text="Up", textcolor=color.white, editable=false, size=size.small, show_last=2, display=display.all)
plotshape(close < open, title="Shape", style=shape.circle, location=location.belowbar, color=#F23645A6, offset=-1, text="Dn", textcolor=color.white, editable=true, size=size.tiny, show_last=3, display=display.pane)
plotarrow(close - open, title="Arrow", colorup=#4CAF508C, colordown=#F236458C, offset=1, minheight=5, maxheight=20, editable=false, show_last=2, display=display.all)
plotbar(open, high, low, close, title="Bars", color=color.blue, editable=false, show_last=2, display=display.pane)
plotcandle(open, high, low, close, title="Candles", color=color.green, wickcolor=color.white, editable=false, show_last=2, bordercolor=color.red, display=display.all)
h1 = hline(10, title="Ten", color=color.gray, linestyle=hline.style_dotted, linewidth=2, editable=false)
h2 = hline(20, title="Twenty", color=color.blue, linestyle=hline.style_dashed, linewidth=1, editable=true)
fill(p1, p2, color=#4CAF501A, title="Plot fill", editable=false, show_last=2, fillgaps=true)
fill(h1, h2, color=#F2364573, title="Line fill", editable=true, fillgaps=false)
bgcolor(close > open ? #2196F31A : na, title="Background", offset=1, editable=false, show_last=2)
barcolor(close > open ? color.green : color.red, title="Bar color", offset=-1, editable=false, show_last=2)
