//@version=5
indicator("Dynamic negative history offset UDT field UDF nested passthrough")
type Settings
    int offset
type SettingsBox
    Settings settings

sameSettingsBox(SettingsBox box) => box

box = SettingsBox.new(Settings.new(bar_index == 0 ? 0 : -1))
same = sameSettingsBox(box)
plot(close[same.settings.offset])
