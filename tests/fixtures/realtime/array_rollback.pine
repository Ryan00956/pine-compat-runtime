//@version=5
indicator("Realtime array rollback")
var values = array.new_float()
var counts = array.new_int()
var flags = array.new_bool()
var names = array.new_string()
var colors = array.new_color()
array.push(values, close)
array.push(counts, bar_index)
array.push(flags, bar_index == 0)
array.push(names, "seed")
array.push(colors, color.red)
plot(array.size(values))
plot(array.get(values, 0))
plot(array.size(counts))
plot(array.get(counts, 0))
plot(array.size(flags))
plot(array.get(flags, 0) ? 1 : 0)
plot(array.size(names))
plot(array.get(names, 0) == "seed" ? 1 : 0)
plot(array.size(colors))
plot(array.get(colors, 0) == color.red ? 1 : 0)
